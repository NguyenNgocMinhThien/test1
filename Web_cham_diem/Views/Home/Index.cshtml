@{

    ViewData["Title"] = "Trang chủ - Hệ thống Quản lý Cuộc thi Sinh viên";
}

<section class="banner-section position-relative rounded-4 overflow-hidden mb-5 text-white shadow-lg"
         style="background: linear-gradient(135deg, #0d6efd 0%, #0a429b 100%); min-height: 400px;">
    <div class="position-absolute top-0 end-0 bottom-0 start-0 opacity-25"
         style="background-image: url('https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=1200'); background-size: cover; background-position: center; mix-blend-mode: overlay;">
    </div>

    <div class="container position-relative h-100 py-5 px-4 px-md-5 d-flex align-items-center">
        <div class="row w-100 align-items-center g-4">
            <div class="col-12 col-lg-7 text-center text-lg-start">
                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3 text-uppercase shadow-sm font-monospace animate-pulse">
                    Năm học 2024 - 2025
                </span>
                <h1 class="display-4 fw-black text-white mb-3 lh-sm" style="letter-spacing: -0.5px;">
                    PHÁT ĐỘNG CUỘC THI <br><span class="text-warning">SINH VIÊN NCKH</span> CẤP TRƯỜNG
                </h1>
                <p class="lead text-white-50 mb-4 fs-5 d-none d-md-block">
                    Sân chơi khoa học trực tuyến đỉnh cao dành cho cộng đồng sinh viên đam mê sáng tạo, nghiên cứu và khẳng định năng lực số. Đăng ký ngay để khẳng định bản thân!
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="/Competitions" class="btn btn-warning text-dark fw-bold px-4 py-3 rounded-pill shadow">
                        <i class="bi bi-rocket-takeoff-fill me-2"></i>Tham Gia Ngay
                    </a>
                    <a href="#huong-dan" class="btn btn-outline-light fw-semibold px-4 py-3 rounded-pill">
                        <i class="bi bi-play-circle me-2"></i>Xem Hướng Dẫn
                    </a>
                </div>
            </div>

            <div class="col-12 col-lg-5 text-center position-relative">
                <div class="position-relative d-inline-block">
                    <div class="position-absolute top-50 start-50 translate-middle bg-warning rounded-circle opacity-25 blur-lg" style="width: 300px; height: 300px; filter: blur(50px);"></div>
                    <img src="~/images/uef-students.png"
                         alt="Sinh viên UEF phát động cuộc thi" class="img-fluid position-relative float-animation" style="max-height: 380px;">
                </div>
            </div>
        </div>  
    </div>
</section>


<section id="huong-dan" class="guidelines-section mb-5 scroll-margin">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark position-relative d-inline-block pb-2 text-uppercase">
            CÔNG BỐ KẾT QUẢ & BÁO CÁO
            <span class="position-absolute bottom-0 start-50 translate-middle-x bg-danger rounded-pill" style="width: 60px; height: 4px;"></span>
        </h2>
        <p class="text-secondary small mt-2">Hệ thống hỗ trợ các chức năng cốt lõi cho việc minh bạch kết quả và báo cáo.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4 card-hover-effect">
                <div class="icon-box bg-danger-subtle text-danger mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 65px; height: 65px;">
                    <i class="bi bi-point-aggregator fs-3"></i>
                </div>
                <h5 class="fw-bold fs-6 mb-2 text-dark">Tổng Hợp Điểm</h5>
                <p class="text-secondary small mb-0">Tự động thu thập và tích hợp điểm chi tiết từ hội đồng giám khảo.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4 card-hover-effect">
                <div class="icon-box bg-primary-subtle text-primary mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 65px; height: 65px;">
                    <i class="bi bi-podium-medals fs-3"></i>
                </div>
                <h5 class="fw-bold fs-6 mb-2 text-dark">Xếp Hạng</h5>
                <p class="text-secondary small mb-0">Lập bảng xếp hạng sinh viên/đội thi minh bạch theo nhiều tiêu chí.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4 card-hover-effect">
                <div class="icon-box bg-success-subtle text-success mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 65px; height: 65px;">
                    <i class="bi bi-megaphone-official fs-3"></i>
                </div>
                <h5 class="fw-bold fs-6 mb-2 text-dark">Công Bố Kết Quả</h5>
                <p class="text-secondary small mb-0">Cập nhật và công bố kết quả các vòng thi chính thức trên hệ thống.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4 card-hover-effect">
                <div class="icon-box bg-info-subtle text-info mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 65px; height: 65px;">
                    <i class="bi bi-dashboard-chart fs-3"></i>
                </div>
                <h5 class="fw-bold fs-6 mb-2 text-dark">Dashboard Thống Kê</h5>
                <p class="text-secondary small mb-0">Trực quan hóa dữ liệu thi chi tiết qua các dashboard chuyên nghiệp.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4 card-hover-effect">
                <div class="icon-box bg-warning-subtle text-warning-emphasis mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 65px; height: 65px;">
                    <i class="bi bi-file-earmark-standard fs-3"></i>
                </div>
                <h5 class="fw-bold fs-6 mb-2 text-dark">Xuất PDF/Excel</h5>
                <p class="text-secondary small mb-0">Kết xuất báo cáo kết quả thi dưới dạng chuẩn PDF/Excel.</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4 card-hover-effect">
                <div class="icon-box bg-secondary-subtle text-secondary mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 65px; height: 65px;">
                    <i class="bi bi-comms-hub fs-3"></i>
                </div>
                <h5 class="fw-bold fs-6 mb-2 text-dark">Gửi Notification/Email</h5>
                <p class="text-secondary small mb-0">Gửi thông báo kết quả và cập nhật kịp thời qua email và hệ thống.</p>
            </div>
        </div>
    </div>
</section>


