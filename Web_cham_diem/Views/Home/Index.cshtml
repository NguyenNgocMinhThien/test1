@{
    ViewData["Title"] = "Trang chủ - Hệ thống Quản lý Cuộc thi Sinh viên";
}

<!-- ============================================================
     1. HERO BANNER
     ============================================================ -->
<section class="hero-section position-relative rounded-4 overflow-hidden mb-5 text-white shadow-lg"
         style="background: linear-gradient(135deg, #b91c1c 0%, #dc3545 45%, #7f1d1d 100%); min-height: 420px;">
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10"
         style="background-image: url('~/images/uef-students.png'); background-size: cover; background-position: center;"></div>

    <!-- Decorative circles -->
    <div class="position-absolute rounded-circle opacity-10"
         style="width:350px;height:350px;background:#fff;top:-80px;right:-80px;"></div>
    <div class="position-absolute rounded-circle opacity-5"
         style="width:200px;height:200px;background:#fff;bottom:-50px;left:10%;"></div>

    <div class="container position-relative py-5 px-4 px-md-5">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-7 text-center text-lg-start">
                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3 d-inline-block animate-pulse">
                    <i class="bi bi-calendar-event me-1"></i>NĂM HỌC 2024 – 2025
                </span>
                <h1 class="display-4 fw-black text-white mb-3 lh-sm">
                    HỆ THỐNG QUẢN LÝ<br>
                    <span class="text-warning">CUỘC THI SINH VIÊN</span><br>
                    <span style="font-size:0.65em;" class="text-white-75">CẤP TRƯỜNG TRỰC TUYẾN</span>
                </h1>
                <p class="lead text-white-75 mb-4 d-none d-md-block" style="font-size:1rem; line-height:1.7;">
                    Nền tảng số hóa toàn bộ quy trình tổ chức cuộc thi — từ đăng ký, nộp bài đến chấm điểm
                    và công bố kết quả, giúp sinh viên thể hiện tài năng và khẳng định bản thân.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="/Competitions" class="btn btn-warning text-dark fw-bold px-4 py-3 rounded-pill shadow">
                        <i class="bi bi-trophy-fill me-2"></i>Xem Cuộc Thi Ngay
                    </a>
                    <a href="/HuongDan" class="btn btn-outline-light fw-semibold px-4 py-3 rounded-pill">
                        <i class="bi bi-play-circle me-2"></i>Hướng Dẫn Tham Gia
                    </a>
                </div>
                <div class="d-flex flex-wrap gap-4 mt-4 justify-content-center justify-content-lg-start text-white-75" style="font-size:13px;">
                    <span><i class="bi bi-check-circle-fill text-warning me-1"></i>Đăng ký miễn phí</span>
                    <span><i class="bi bi-check-circle-fill text-warning me-1"></i>Nộp bài trực tuyến 24/7</span>
                    <span><i class="bi bi-check-circle-fill text-warning me-1"></i>Kết quả minh bạch</span>
                </div>
            </div>
            <div class="col-12 col-lg-5 text-center d-none d-lg-block">
                <div class="position-relative d-inline-block">
                    <div class="position-absolute top-50 start-50 translate-middle rounded-circle opacity-20"
                         style="width:320px;height:320px;background:#ffc107;filter:blur(60px);"></div>
                    <img src="~/images/uef-students.png" alt="Sinh viên tham gia cuộc thi"
                         class="img-fluid position-relative float-animation" style="max-height:360px;"
                         onerror="this.style.display='none'">
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     2. GIỚI THIỆU HỆ THỐNG
     ============================================================ -->
<section class="intro-section mb-5">
    <div class="text-center mb-4">
        <span class="badge bg-danger-subtle text-danger fw-semibold px-3 py-2 rounded-pill mb-2">Về hệ thống</span>
        <h2 class="fw-bold text-dark section-title">HỆ THỐNG LÀM ĐƯỢC GÌ CHO BẠN?</h2>
        <p class="text-secondary small mt-2 mx-auto" style="max-width:560px;">
            Một nền tảng duy nhất phục vụ toàn bộ hành trình tham gia cuộc thi từ khi đăng ký đến khi nhận kết quả.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center card-hover-effect">
                <div class="icon-circle bg-danger-subtle text-danger mx-auto mb-3">
                    <i class="bi bi-person-plus-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Đăng Ký Dễ Dàng</h5>
                <p class="text-secondary small mb-0">
                    Đăng ký tài khoản và nộp hồ sơ tham gia cuộc thi hoàn toàn trực tuyến, không cần đến trực tiếp.
                    Theo dõi trạng thái hồ sơ theo thời gian thực.
                </p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center card-hover-effect">
                <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3">
                    <i class="bi bi-cloud-arrow-up-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Nộp Bài Trực Tuyến</h5>
                <p class="text-secondary small mb-0">
                    Tải lên bài thi, đề tài nghiên cứu hoặc sản phẩm dự thi mọi lúc, mọi nơi.
                    Hỗ trợ đa định dạng tệp và quản lý phiên bản nộp bài.
                </p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center card-hover-effect">
                <div class="icon-circle bg-success-subtle text-success mx-auto mb-3">
                    <i class="bi bi-patch-check-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Kết Quả Minh Bạch</h5>
                <p class="text-secondary small mb-0">
                    Hệ thống chấm điểm từ hội đồng giám khảo được số hóa, công khai và có thể tra cứu
                    bất cứ lúc nào sau khi công bố.
                </p>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     3. THỐNG KÊ TỔNG QUAN
     ============================================================ -->
<section class="stats-section mb-5">
    <div class="rounded-4 overflow-hidden shadow-sm"
         style="background: linear-gradient(135deg, #1e3a5f 0%, #dc3545 100%);">
        <div class="row g-0 text-white text-center">
            <div class="col-6 col-md-3 p-4 border-end border-white border-opacity-25">
                <div class="fs-1 fw-black">15+</div>
                <div class="small mt-1 text-white-75">Cuộc thi đang diễn ra</div>
                <i class="bi bi-trophy-fill text-warning mt-2 fs-5"></i>
            </div>
            <div class="col-6 col-md-3 p-4 border-end border-white border-opacity-25">
                <div class="fs-1 fw-black">2.800+</div>
                <div class="small mt-1 text-white-75">Sinh viên tham gia</div>
                <i class="bi bi-people-fill text-info mt-2 fs-5"></i>
            </div>
            <div class="col-6 col-md-3 p-4 border-end border-white border-opacity-25">
                <div class="fs-1 fw-black">18</div>
                <div class="small mt-1 text-white-75">Khoa / Đơn vị</div>
                <i class="bi bi-building-fill text-warning mt-2 fs-5"></i>
            </div>
            <div class="col-6 col-md-3 p-4">
                <div class="fs-1 fw-black">420+</div>
                <div class="small mt-1 text-white-75">Giải thưởng đã trao</div>
                <i class="bi bi-award-fill text-success mt-2 fs-5"></i>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     4. CUỘC THI ĐANG MỞ ĐĂNG KÝ
     ============================================================ -->
<section class="open-competitions-section mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success-subtle text-success fw-semibold px-3 py-2 rounded-pill mb-1">Đang mở đăng ký</span>
            <h2 class="fw-bold text-dark mb-0 section-title">CUỘC THI NỔI BẬT</h2>
        </div>
        <a href="/Competitions" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold d-none d-md-inline-flex align-items-center gap-1">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover-effect">
                <div class="card-header-custom bg-danger text-white p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="badge bg-white text-danger fw-semibold">Lập trình</span>
                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Còn 14 ngày</span>
                    </div>
                    <h5 class="fw-bold mt-2 mb-0">Cuộc Thi Lập Trình Sáng Tạo 2025</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small mb-3">
                        Sân chơi lập trình dành cho sinh viên đam mê công nghệ. Các đội thi sẽ xây dựng
                        sản phẩm giải quyết bài toán thực tế trong 48 giờ.
                    </p>
                    <ul class="list-unstyled small text-secondary mb-3">
                        <li class="mb-1"><i class="bi bi-people me-2 text-danger"></i>Tất cả khoa, tối đa 3 thành viên/đội</li>
                        <li class="mb-1"><i class="bi bi-calendar-check me-2 text-danger"></i>Hạn đăng ký: <strong>30/06/2025</strong></li>
                        <li><i class="bi bi-gift me-2 text-danger"></i>Tổng giải thưởng: <strong class="text-danger">50.000.000đ</strong></li>
                    </ul>
                    <a href="/Competitions/Detail/1" class="btn btn-danger btn-sm rounded-pill px-3 w-100">
                        <i class="bi bi-arrow-right-circle me-1"></i>Đăng ký tham gia
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover-effect">
                <div class="card-header-custom p-3" style="background: linear-gradient(135deg,#0d6efd,#0a58ca);">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="badge bg-white text-primary fw-semibold">Khởi nghiệp</span>
                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Còn 30 ngày</span>
                    </div>
                    <h5 class="fw-bold mt-2 mb-0 text-white">Ý Tưởng Khởi Nghiệp Đổi Mới 2025</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small mb-3">
                        Cuộc thi ý tưởng kinh doanh và đổi mới sáng tạo dành cho sinh viên toàn trường,
                        kết nối với các doanh nghiệp và nhà đầu tư tiềm năng.
                    </p>
                    <ul class="list-unstyled small text-secondary mb-3">
                        <li class="mb-1"><i class="bi bi-people me-2 text-primary"></i>Khoa Kinh tế & các khoa liên quan</li>
                        <li class="mb-1"><i class="bi bi-calendar-check me-2 text-primary"></i>Hạn đăng ký: <strong>15/07/2025</strong></li>
                        <li><i class="bi bi-gift me-2 text-primary"></i>Tổng giải thưởng: <strong class="text-primary">80.000.000đ</strong></li>
                    </ul>
                    <a href="/Competitions/Detail/2" class="btn btn-primary btn-sm rounded-pill px-3 w-100">
                        <i class="bi bi-arrow-right-circle me-1"></i>Đăng ký tham gia
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover-effect">
                <div class="card-header-custom p-3" style="background: linear-gradient(135deg,#198754,#157347);">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="badge bg-white text-success fw-semibold">Nghiên cứu KH</span>
                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Còn 45 ngày</span>
                    </div>
                    <h5 class="fw-bold mt-2 mb-0 text-white">NCKH Sinh Viên Cấp Trường 2025</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small mb-3">
                        Cuộc thi nghiên cứu khoa học sinh viên thường niên cấp trường, cơ hội để
                        công bố và bảo vệ công trình nghiên cứu trước hội đồng khoa học.
                    </p>
                    <ul class="list-unstyled small text-secondary mb-3">
                        <li class="mb-1"><i class="bi bi-people me-2 text-success"></i>Toàn thể sinh viên các khoa</li>
                        <li class="mb-1"><i class="bi bi-calendar-check me-2 text-success"></i>Hạn đăng ký: <strong>31/07/2025</strong></li>
                        <li><i class="bi bi-gift me-2 text-success"></i>Tổng giải thưởng: <strong class="text-success">100.000.000đ</strong></li>
                    </ul>
                    <a href="/Competitions/Detail/3" class="btn btn-success btn-sm rounded-pill px-3 w-100">
                        <i class="bi bi-arrow-right-circle me-1"></i>Đăng ký tham gia
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-3 d-md-none">
        <a href="/Competitions" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-semibold">
            Xem tất cả cuộc thi <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>


<!-- ============================================================
     5. QUY TRÌNH THAM GIA
     ============================================================ -->
<section class="process-section mb-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="text-center mb-5">
            <span class="badge bg-warning-subtle text-warning-emphasis fw-semibold px-3 py-2 rounded-pill mb-2">Hướng dẫn</span>
            <h2 class="fw-bold text-dark section-title">QUY TRÌNH THAM GIA THI</h2>
            <p class="text-secondary small mt-2">Chỉ cần 5 bước đơn giản để tham gia bất kỳ cuộc thi nào trên hệ thống.</p>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">1</div>
                    <div class="step-icon mb-2"><i class="bi bi-person-check-fill fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Tạo tài khoản</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Đăng ký & xác thực email sinh viên</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">2</div>
                    <div class="step-icon mb-2"><i class="bi bi-search fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Chọn cuộc thi</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Tìm cuộc thi phù hợp & đọc thể lệ</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">3</div>
                    <div class="step-icon mb-2"><i class="bi bi-file-earmark-plus-fill fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Đăng ký & Nộp bài</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Điền hồ sơ & tải lên bài thi</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">4</div>
                    <div class="step-icon mb-2"><i class="bi bi-clipboard2-check-fill fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Chấm điểm</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Hội đồng giám khảo chấm điểm online</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-warning text-dark mx-auto mb-3">5</div>
                    <div class="step-icon mb-2"><i class="bi bi-trophy-fill fs-2 text-warning"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Nhận kết quả</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Xem điểm & nhận giải thưởng</p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     6. CHỨC NĂNG NỔI BẬT
     ============================================================ -->
<section class="features-section mb-5">
    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Tính năng</span>
        <h2 class="fw-bold text-dark section-title">CHỨC NĂNG NỔI BẬT</h2>
        <p class="text-secondary small mt-2 mx-auto" style="max-width:520px;">
            Hệ thống tích hợp đầy đủ các công cụ phục vụ mọi vai trò: sinh viên, ban tổ chức và giám khảo.
        </p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover-effect d-flex flex-row gap-3 align-items-start">
                <div class="icon-circle-sm bg-danger-subtle text-danger flex-shrink-0">
                    <i class="bi bi-ui-checks-grid fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Quản Lý Cuộc Thi Toàn Diện</h6>
                    <p class="text-secondary small mb-0">Ban tổ chức tạo và cấu hình cuộc thi, quản lý vòng thi, tiêu chí và thời hạn nộp bài.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover-effect d-flex flex-row gap-3 align-items-start">
                <div class="icon-circle-sm bg-primary-subtle text-primary flex-shrink-0">
                    <i class="bi bi-cloud-upload-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Nộp Bài Trực Tuyến</h6>
                    <p class="text-secondary small mb-0">Hỗ trợ tải lên bài thi, báo cáo, file PDF/DOCX và theo dõi trạng thái bài nộp.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover-effect d-flex flex-row gap-3 align-items-start">
                <div class="icon-circle-sm bg-success-subtle text-success flex-shrink-0">
                    <i class="bi bi-star-half fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Chấm Điểm Nhiều Giám Khảo</h6>
                    <p class="text-secondary small mb-0">Tự động tổng hợp điểm từ nhiều giám khảo, giảm thiểu sai sót và đảm bảo tính khách quan.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover-effect d-flex flex-row gap-3 align-items-start">
                <div class="icon-circle-sm bg-info-subtle text-info flex-shrink-0">
                    <i class="bi bi-bell-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Thông Báo Tức Thời</h6>
                    <p class="text-secondary small mb-0">Nhận thông báo ngay khi có cập nhật về cuộc thi, kết quả chấm điểm và thông tin quan trọng.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover-effect d-flex flex-row gap-3 align-items-start">
                <div class="icon-circle-sm bg-warning-subtle text-warning-emphasis flex-shrink-0">
                    <i class="bi bi-file-earmark-bar-graph-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Báo Cáo & Thống Kê</h6>
                    <p class="text-secondary small mb-0">Kết xuất báo cáo kết quả theo nhiều định dạng PDF/Excel, dashboard phân tích trực quan.</p>
                </div>
