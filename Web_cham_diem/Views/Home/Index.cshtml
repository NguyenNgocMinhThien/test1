@model Web_cham_diem.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - Hệ thống Quản lý Cuộc thi Sinh viên";
}

<!-- ============================================================
     1. HERO BANNER — Split panel style
     ============================================================ -->
<section class="hero-split-section mb-5 rounded-4 overflow-hidden shadow-lg" style="min-height: 460px;">
    <div class="row g-0" style="min-height: 460px;">

        <!-- LEFT PANEL: Dark info panel -->
        <div class="col-12 col-lg-5 d-flex flex-column align-items-center justify-content-center p-4 p-xl-5"
             style="background: #1a3559; min-height: 460px;">

            <!-- Logo + School Name -->
            <div class="text-center mb-4">
                <img src="~/images/logo-uni.png" alt="Logo" width="64"
                     style="filter: brightness(0) invert(1); opacity: 0.9;"
                     onerror="this.style.display='none'">
                <div class="text-white fw-bold mt-2" style="font-size: 11px; letter-spacing: 2.5px; opacity: 0.85;">
                    TRƯỜNG ĐẠI HỌC
                </div>
                <div style="font-size: 10px; letter-spacing: 1.5px; color: rgba(255,255,255,0.55);">
                    HỆ THỐNG THI TRỰC TUYẾN
                </div>
            </div>

            <!-- Orange highlight title box -->
            <div class="w-100 text-center text-white fw-black rounded-3 px-3 py-3 mb-3"
                 style="background: #e87722; font-size: clamp(1.05rem, 2.8vw, 1.55rem); line-height: 1.35; letter-spacing: 0.5px;">
                HỆ THỐNG QUẢN LÝ<br>CUỘC THI SINH VIÊN
            </div>

            <!-- Subtitle info lines -->
            <p class="text-center mb-3" style="color: rgba(255,255,255,0.80); font-size: 13px; line-height: 1.9;">
                Kết quả công bố sau khi kết thúc cuộc thi từ
                <strong class="text-warning">1-2 ngày</strong><br>
                Giấy chứng nhận dự kiến sau khi công bố kết quả
                <strong class="text-warning">5-7 ngày</strong>
            </p>

            <!-- Contact block -->
            <div class="text-center mb-3">
                <div class="fw-bold mb-2" style="color: #e87722; font-size: 12px; letter-spacing: 1px;">
                    BAN TỔ CHỨC CUỘC THI SINH VIÊN
                </div>
                <div style="font-size: 12px; color: rgba(255,255,255,0.75); line-height: 2;">
                    <div><span class="text-white fw-semibold">HOTLINE:</span> 1800.XXXX (Miễn phí)</div>
                    <div><span class="text-white fw-semibold">EMAIL:</span> cuocthi&#64;university.edu.vn</div>
                    <div><span class="text-white fw-semibold">ĐỊA CHỈ:</span> Phòng 302, Tòa nhà Trung tâm</div>
                </div>
            </div>

            <!-- CTA Buttons -->
            <div class="d-flex gap-2 flex-wrap justify-content-center mt-2">
                <a href="/Competitions"
                   class="btn fw-bold px-4 rounded-pill text-white"
                   style="background: #e87722; border-color: #e87722; font-size: 13px;">
                    <i class="bi bi-trophy-fill me-1"></i>Xem Cuộc Thi
                </a>
                <a href="/HuongDan"
                   class="btn btn-outline-light rounded-pill px-4 fw-semibold"
                   style="font-size: 13px;">
                    <i class="bi bi-book me-1"></i>Hướng Dẫn
                </a>
            </div>
        </div>

        <!-- RIGHT PANEL: Campus image with chevron overlays -->
        <div class="col-lg-7 position-relative d-none d-lg-flex align-items-stretch"
             style="overflow: hidden; min-height: 460px;">

            <!-- Background image -->
            <img src="~/images/uef-students.png" alt="Campus"
                 class="position-absolute top-0 start-0 w-100 h-100"
                 style="object-fit: cover; object-position: center;"
                 onerror="this.parentElement.style.background='#546a7b'">

            <!-- Tinted overlay for depth -->
            <div class="position-absolute top-0 start-0 w-100 h-100"
                 style="background: linear-gradient(to right, rgba(26,53,89,0.18) 0%, transparent 50%); z-index: 1;"></div>

            <!-- Chevron decorations (left edge of image panel) -->
            <div class="position-absolute top-0 start-0 h-100" style="z-index: 2; width: 130px;">
                <svg viewBox="0 0 130 460" preserveAspectRatio="none" width="130" height="100%">
                    <!-- White chevron -->
                    <polygon points="0,0 90,230 0,460" fill="white" opacity="0.92"/>
                    <!-- Orange chevron -->
                    <polygon points="0,0 55,230 0,460" fill="#e87722" opacity="0.95"/>
                </svg>
            </div>

            <!-- Stats pills floating top-right -->
            <div class="position-absolute d-flex flex-column gap-2"
                 style="top: 24px; right: 24px; z-index: 3;">
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white shadow-sm"
                     style="font-size: 12px; font-weight: 600; color: #1a3559;">
                    <i class="bi bi-trophy-fill text-warning"></i>
                    @Model.ActiveCompetitionsCount+ Cuộc thi đang mở
                </div>
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white shadow-sm"
                     style="font-size: 12px; font-weight: 600; color: #1a3559;">
                    <i class="bi bi-people-fill" style="color: #e87722;"></i>
                    @Model.TotalParticipantsCount.ToString("N0")+ Sinh viên tham gia
                </div>
            </div>
        </div>

    </div>
</section>


<!-- ============================================================
     2. GIỚI THIỆU HỆ THỐNG
     ============================================================ -->
<section class="intro-section mb-5">
    <div class="text-center mb-4">
        <span class="badge bg-danger-subtle text-danger fw-semibold px-3 py-2 rounded-pill mb-2">Về hệ thống</span>
        <h2 class="fw-bold text-dark section-title">HỆ THỐNG LÀM ĐƯỢC GÌ CHO BẠN?</h2>
        <p class="text-secondary small mt-2 mx-auto" style="max-width:560px;">
            Một nền tảng duy nhất phục vụ toàn bộ hành trình tham gia cuộc thi từ khi đăng ký đến khi nhận kết quả.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center card-hover-effect">
                <div class="icon-circle bg-danger-subtle text-danger mx-auto mb-3">
                    <i class="bi bi-person-plus-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Đăng Ký Dễ Dàng</h5>
                <p class="text-secondary small mb-0">
                    Đăng ký tài khoản và nộp hồ sơ tham gia cuộc thi hoàn toàn trực tuyến, không cần đến trực tiếp.
                    Theo dõi trạng thái hồ sơ theo thời gian thực.
                </p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center card-hover-effect">
                <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3">
                    <i class="bi bi-cloud-arrow-up-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Nộp Bài Trực Tuyến</h5>
                <p class="text-secondary small mb-0">
                    Tải lên bài thi, đề tài nghiên cứu hoặc sản phẩm dự thi mọi lúc, mọi nơi.
                    Hỗ trợ đa định dạng tệp và quản lý phiên bản nộp bài.
                </p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center card-hover-effect">
                <div class="icon-circle bg-success-subtle text-success mx-auto mb-3">
                    <i class="bi bi-patch-check-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Kết Quả Minh Bạch</h5>
                <p class="text-secondary small mb-0">
                    Hệ thống chấm điểm từ hội đồng giám khảo được số hóa, công khai và có thể tra cứu
                    bất cứ lúc nào sau khi công bố.
                </p>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     3. THỐNG KÊ TỔNG QUAN
     ============================================================ -->
<section class="stats-section mb-5">
    <div class="rounded-4 overflow-hidden shadow-sm"
         style="background: linear-gradient(135deg, #1e3a5f 0%, #dc3545 100%);">
        <div class="row g-0 text-white text-center">
            <div class="col-6 col-md-3 p-4 border-end border-white border-opacity-25">
                <div class="fs-1 fw-black">@(Model.ActiveCompetitionsCount > 0 ? Model.ActiveCompetitionsCount + "+" : "0")</div>
                <div class="small mt-1 text-white-75">Cuộc thi đang diễn ra</div>
                <i class="bi bi-trophy-fill text-warning mt-2 fs-5"></i>
            </div>
            <div class="col-6 col-md-3 p-4 border-end border-white border-opacity-25">
                <div class="fs-1 fw-black">@(Model.TotalParticipantsCount > 0 ? Model.TotalParticipantsCount.ToString("N0") + "+" : "0")</div>
                <div class="small mt-1 text-white-75">Sinh viên tham gia</div>
                <i class="bi bi-people-fill text-info mt-2 fs-5"></i>
            </div>
            <div class="col-6 col-md-3 p-4 border-end border-white border-opacity-25">
                <div class="fs-1 fw-black">@Model.TotalCategoriesCount</div>
                <div class="small mt-1 text-white-75">Lĩnh vực thi đấu</div>
                <i class="bi bi-building-fill text-warning mt-2 fs-5"></i>
            </div>
            <div class="col-6 col-md-3 p-4">
                <div class="fs-1 fw-black">@(Model.TotalEvaluatedCount > 0 ? Model.TotalEvaluatedCount + "+" : "0")</div>
                <div class="small mt-1 text-white-75">Bài thi đã chấm điểm</div>
                <i class="bi bi-award-fill text-success mt-2 fs-5"></i>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     4. CUỘC THI NỔI BẬT
     ============================================================ -->
<section class="open-competitions-section mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success-subtle text-success fw-semibold px-3 py-2 rounded-pill mb-1">Đang mở đăng ký</span>
            <h2 class="fw-bold text-dark mb-0 section-title">CUỘC THI NỔI BẬT</h2>
        </div>
        <a href="/Competitions" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold d-none d-md-inline-flex align-items-center gap-1">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @{
        /* Header gradients & accent colors per card index */
        string[] _hdrBg = {
            "linear-gradient(135deg, #b91c1c 0%, #7f1d1d 60%, #450a0a 100%)",
            "linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 60%, #0c2461 100%)",
            "linear-gradient(135deg, #14532d 0%, #166534 60%, #052e16 100%)"
        };
        string[] _accentColor = { "#dc3545", "#2563eb", "#16a34a" };
        string[] _catColor    = { "color:#dc3545;", "color:#2563eb;", "color:#16a34a;" };
        string[] _btnPrimary  = { "btn-danger", "btn-primary", "btn-success" };
    }

    <div class="row g-4">
        @if (!Model.FeaturedCompetitions.Any())
        {
            <div class="col-12 py-5 text-center text-secondary">
                <i class="bi bi-hourglass fs-1 d-block mb-2 opacity-50"></i>
                Hiện chưa có cuộc thi nào đang diễn ra.
            </div>
        }
        else
        {
            for (int _ci = 0; _ci < Model.FeaturedCompetitions.Count; _ci++)
            {
                var _comp   = Model.FeaturedCompetitions[_ci];
                var _idx    = _ci % 3;
                var _bg     = _hdrBg[_idx];
                var _accent = _accentColor[_idx];
                var _cat    = _catColor[_idx];
                var _btn    = _btnPrimary[_idx];
                var _desc   = _comp.Description != null && _comp.Description.Length > 80
                                ? _comp.Description[..80] + "…"
                                : (_comp.Description ?? "");

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="comp-card card h-100 border-0 rounded-4 overflow-hidden shadow-sm">

                        <!-- ── CARD IMAGE HEADER ── -->
                        @{
                            var _imgUrl = !string.IsNullOrEmpty(_comp.BannerImageUrl)
                                ? _comp.BannerImageUrl
                                : Url.Content("~/images/uef-students.png");
                        }
                        <div class="comp-card-img" style="height: 200px; overflow: hidden;">
                            <div class="w-100 h-100"
                                 style="background-image: url('@_imgUrl');
                                        background-size: cover;
                                        background-position: center;
                                        transition: transform 0.35s ease;">
                            </div>
                        </div>

                        <!-- ── CARD BODY ── -->
                        <div class="card-body px-4 pt-3 pb-4 d-flex flex-column">

                            <!-- Category label + status badge -->
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="fw-bold" style="font-size: 12px; @_cat letter-spacing: 0.3px;">
                                    <i class="bi bi-tag-fill me-1"></i>@(_comp.Category ?? "Cuộc thi chung")
                                </div>
                                @if (_comp.DaysRemaining >= 0)
                                {
                                    <span class="badge bg-warning text-dark" style="font-size: 11px;">
                                        <i class="bi bi-clock me-1"></i>Còn @_comp.DaysRemaining ngày
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white" style="font-size: 11px;">
                                        <i class="bi bi-check-circle me-1"></i>Đang diễn ra
                                    </span>
                                }
                            </div>

                            <!-- Competition name row -->
                            <div class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-mortarboard-fill mt-1 flex-shrink-0" style="color: @_accent; font-size: 15px;"></i>
                                <span class="fw-bold text-dark" style="font-size: 14px; line-height: 1.4;">
                                    @_comp.CompetitionName
                                </span>
                            </div>

                            <!-- Description / team type -->
                            <div class="d-flex align-items-start gap-2 mb-2 text-secondary" style="font-size: 12.5px;">
                                <i class="bi bi-file-text mt-1 flex-shrink-0"></i>
                                <span>
                                    @if (!string.IsNullOrEmpty(_desc))
                                    {
                                        @_desc
                                    }
                                    else
                                    {
                                        @(_comp.IsTeamBased
                                            ? $"Thi theo đội — tối đa {_comp.MaxTeamSize} thành viên/đội"
                                            : "Thi cá nhân")
                                    }
                                </span>
                            </div>

                            <!-- Format: team or individual -->
                            <div class="d-flex align-items-center gap-2 mb-2 text-secondary" style="font-size: 12px;">
                                <i class="bi bi-people-fill flex-shrink-0" style="color: @_accent;"></i>
                                <span>
                                    @(_comp.IsTeamBased
                                        ? $"Đội thi — tối đa {_comp.MaxTeamSize} thành viên"
                                        : "Thi cá nhân")
                                    @if (_comp.TotalRegistrations > 0)
                                    {
                                        <span class="ms-1 text-muted">· @_comp.TotalRegistrations đã đăng ký</span>
                                    }
                                </span>
                            </div>

                            <!-- Deadline row -->
                            @if (_comp.RegistrationDeadline.HasValue)
                            {
                                <div class="d-flex align-items-center gap-2 mb-3" style="font-size: 12px; color: #dc3545;">
                                    <i class="bi bi-calendar-x-fill flex-shrink-0"></i>
                                    <span>
                                        Hạn đăng ký:
                                        <strong>@_comp.RegistrationDeadline.Value.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</strong>
                                    </span>
                                </div>
                            }

                            <!-- Prize -->
                            @if (!string.IsNullOrEmpty(_comp.Prize))
                            {
                                <div class="fw-bold mb-3" style="font-size: 18px; color: @_accent;">
                                    <i class="bi bi-gift-fill me-1" style="font-size: 14px;"></i>@_comp.Prize
                                </div>
                            }
                            else
                            {
                                <div class="mb-3"></div>
                            }

                            <!-- Action buttons -->
                            <div class="d-flex gap-2 mt-auto">
                                <a href="/Competitions/@_comp.CompetitionId"
                                   class="btn btn-sm rounded-pill px-3 fw-semibold flex-grow-1"
                                   style="border: 1.5px solid @_accent; color: @_accent; font-size: 13px;">
                                    Xem chi tiết <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                                <a href="/Competitions/@_comp.CompetitionId"
                                   class="btn @_btn btn-sm rounded-pill px-3 fw-bold flex-grow-1"
                                   style="font-size: 13px;">
                                    Đăng ký ngay
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
    </div>

    <div class="text-center mt-3 d-md-none">
        <a href="/Competitions" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-semibold">
            Xem tất cả cuộc thi <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>


<!-- ============================================================
     5. QUY TRÌNH THAM GIA
     ============================================================ -->
<section class="process-section mb-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="text-center mb-5">
            <span class="badge bg-warning-subtle text-warning-emphasis fw-semibold px-3 py-2 rounded-pill mb-2">Hướng dẫn</span>
            <h2 class="fw-bold text-dark section-title">QUY TRÌNH THAM GIA THI</h2>
            <p class="text-secondary small mt-2">Chỉ cần 5 bước đơn giản để tham gia bất kỳ cuộc thi nào trên hệ thống.</p>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">1</div>
                    <div class="step-icon mb-2"><i class="bi bi-person-check-fill fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Tạo tài khoản</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Đăng ký & xác thực email sinh viên</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">2</div>
                    <div class="step-icon mb-2"><i class="bi bi-search fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Chọn cuộc thi</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Tìm cuộc thi phù hợp & đọc thể lệ</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">3</div>
                    <div class="step-icon mb-2"><i class="bi bi-file-earmark-plus-fill fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Đăng ký & Nộp bài</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Điền hồ sơ & tải lên bài thi</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-danger text-white mx-auto mb-3">4</div>
                    <div class="step-icon mb-2"><i class="bi bi-clipboard2-check-fill fs-2 text-danger"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Chấm điểm</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Hội đồng giám khảo chấm điểm online</p>
                </div>
            </div>
            <div class="col d-none d-lg-flex align-items-center justify-content-center" style="max-width:40px;">
                <i class="bi bi-chevron-right text-muted fs-4"></i>
            </div>
            <div class="col-6 col-md-4 col-lg text-center">
                <div class="process-step">
                    <div class="step-number bg-warning text-dark mx-auto mb-3">5</div>
                    <div class="step-icon mb-2"><i class="bi bi-trophy-fill fs-2 text-warning"></i></div>
                    <h6 class="fw-bold mb-1" style="font-size:13px;">Nhận kết quả</h6>
                    <p class="text-secondary mb-0" style="font-size:12px;">Xem điểm & nhận giải thưởng</p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     6. CHỨC NĂNG NỔI BẬT
     ============================================================ -->
<section class="features-section mb-5">
    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Tính năng</span>
        <h2 class="fw-bold text-dark section-title">CHỨC NĂNG NỔI BẬT</h2>
        <p class="text-secondary small mt-2 mx-auto" style="max-width:520px;">
            Hệ thống tích hợp đầy đủ các công cụ phục vụ mọi vai trò: sinh viên, ban tổ chức và giám khảo.
        </p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 card-hover-effect d-flex flex-row gap-3 align-items-start">
                <div class="icon-circle-sm bg-danger-subtle text-danger flex-shrink-0">
                    <i class="bi bi-ui-checks-grid fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Quản Lý Cuộc Thi Toàn Diện</h6>
                    <p class="text-secondary small mb-0">Ban tổ chức tạo và cấu hình cuộc thi, quản lý vòng thi, tiêu chí và thời hạn nộp bài.</p>
                </div>
            </div>
        </div>
