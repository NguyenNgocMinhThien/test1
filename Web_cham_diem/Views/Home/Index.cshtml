<!-- ============================================================
     7. KẾT QUẢ NỔI BẬT
     ============================================================ -->
<section class="results-section mb-5">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center p-4 border-bottom">
                <div>
                    <span class="badge bg-warning-subtle text-warning-emphasis fw-semibold px-3 py-2 rounded-pill mb-1">Vinh danh</span>
                    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center">
                        <i class="bi bi-award-fill text-warning me-2 fs-4"></i>KẾT QUẢ NỔI BẬT GẦN ĐÂY
                    </h3>
                    <p class="text-secondary small mb-0">Những sinh viên/nhóm đã xuất sắc giành giải trong các cuộc thi vừa qua.</p>
                </div>
                <a href="/Results" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-semibold mt-3 mt-md-0">
                    Xem đầy đủ <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-0">
                @{
                    string[] _trophyBadge = { "bg-warning text-dark", "bg-secondary text-white", "bg-danger text-white" };
                }
                @if (!Model.TopResults.Any())
                {
                    <div class="col-12 py-5 text-center text-secondary">
                        <i class="bi bi-hourglass-split fs-2 d-block mb-2 opacity-50"></i>
                        Chưa có kết quả nổi bật. Kết quả sẽ được cập nhật sau khi các cuộc thi kết thúc.
                    </div>
                }
                else
                {
                    for (int _ri = 0; _ri < Model.TopResults.Count; _ri++)
                    {
                        var _r = Model.TopResults[_ri];
                        var _isFirst = _ri == 0;
                        var _isLast  = _ri == Model.TopResults.Count - 1;
                        var _borderCls = (!_isLast ? "border-end-md" : "") + (_ri > 0 ? " border-top border-md-top-0" : "");
                        <div class="col-12 col-md-4 p-4 @_borderCls">
                            <div class="d-flex gap-3 align-items-start">
                                <div class="flex-shrink-0">
                                    <span class="badge @_trophyBadge[_ri % 3] px-2 py-2 rounded-3 fs-6">
                                        <i class="bi bi-trophy-fill"></i>
                                    </span>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@_r.ParticipantName</div>
                                    <div class="small text-success fw-semibold">
                                        Giải @_r.AwardLevel — @_r.CompetitionName
                                    </div>
                                    <div class="small text-muted mt-1">Điểm: <strong>@_r.TotalScore.ToString("F1")</strong></div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>




