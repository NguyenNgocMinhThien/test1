<style>
    /* Hiệu ứng di chuột nhẹ nhàng qua các thẻ hướng dẫn */
    .card-hover-effect {
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }

        .card-hover-effect:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.125) !important;
        }

    /* Hiệu ứng nhịp tim đập nhẹ cho nhãn Năm học */
    .animate-pulse {
        animation: pulse-animation 2s infinite;
    }

    @@keyframes pulse-animation {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.04);
        }

        100% {
            transform: scale(1);
        }
    }

    /* Hiệu ứng hình ảnh trôi nổi mượt mà ở góc phải banner */
    .float-animation {
        animation: float-cycle 4s ease-in-out infinite;
    }

    @@keyframes float-cycle {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-12px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    /* Đảm bảo căn chỉnh khoảng cách khi click anchor link điều hướng */
    .scroll-margin {
        scroll-margin-top: 30px;
    }

    /* Cấu trúc font chữ hiển thị nét đậm cao cấp */
    .fw-black {
        font-weight: 900;
    }
</style>