<style>
    .fw-black { font-weight: 900; }
    .text-white-75 { color: rgba(255,255,255,0.75); }

    /* Hero split section */
    .hero-split-section .row { min-height: inherit; }

    /* Competition card VLU-style */
    .comp-card {
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        cursor: pointer;
    }
    .comp-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.13) !important;
    }
    .comp-card-img { overflow: hidden; }
    .comp-card-img div {
        transition: transform 0.4s ease;
    }
    .comp-card:hover .comp-card-img div {
        transform: scale(1.06);
    }
    .comp-card .btn { transition: opacity 0.15s ease; }
    .comp-card .btn:hover { opacity: 0.88; }

    .section-title {
        font-size: clamp(1.1rem, 2.5vw, 1.4rem);
        letter-spacing: 0.3px;
    }

    /* Icon circles */
    .icon-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-circle-sm {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Card hover */
    .card-hover-effect {
        transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease;
    }
    .card-hover-effect:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.75rem 2rem rgba(0,0,0,.12) !important;
    }

    /* Competition card header */
    .card-header-custom {
        color: white;
        min-height: 90px;
    }

    /* Process step */
    .step-number {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
    }

    /* Sponsor card */
    .sponsor-card {
        transition: background 0.2s ease;
        cursor: default;
    }
    .sponsor-card:hover {
        background: #f8f9fa;
    }

    /* Responsive border helper */
    @@media (min-width: 768px) {
        .border-end-md { border-right: 1px solid #dee2e6 !important; }
        .border-md-top-0 { border-top: none !important; }
    }

    /* Mobile hero */
    @@media (max-width: 991px) {
        .hero-split-section { min-height: auto !important; }
    }
</style>
