@model Web_cham_diem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["UseFluidContainer"] = true;
}
@functions {
    private string GetInvalidClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var state) && state.Errors.Count > 0
            ? "is-invalid"
            : "";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <style>
        .password-input-wrapper {
            position: relative;
        }

        .password-toggle-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #6c757d;
            padding: 5px;
            transition: color 0.2s ease;
        }

        .password-toggle-btn:hover {
            color: #495057;
        }

        .form-control.is-invalid {
            border-color: #dc3545;
        }

        .invalid-feedback {
            display: block;
            color: #dc3545;
            font-size: 0.875em;
            margin-top: 0.25rem;
        }

        .terms-checkbox {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 1rem;
            padding: 0.75rem;
            border-radius: 0.375rem;
        }

        .terms-checkbox input[type="checkbox"] {
            margin-top: 0.35rem;
            cursor: pointer;
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .terms-checkbox label {
            cursor: pointer;
            margin-bottom: 0;
            font-size: 0.95rem;
            color: #6c757d;
        }

        .terms-checkbox a {
            color: #dc3545;
            text-decoration: none;
        }

        .terms-checkbox a:hover {
            text-decoration: underline;
        }

        .terms-checkbox.is-invalid {
            border: 1px solid #dc3545;
            background-color: #fff5f5;
        }

        .password-strength-meter {
            height: 4px;
            background-color: #e9ecef;
            border-radius: 2px;
            margin-top: 0.5rem;
            overflow: hidden;
        }

        .password-strength-meter-fill {
            height: 100%;
            background-color: #dc3545;
            width: 0%;
            transition: width 0.3s ease, background-color 0.3s ease;
            border-radius: 2px;
        }

        .password-strength-meter-fill.weak {
            width: 33%;
            background-color: #dc3545;
        }

        .password-strength-meter-fill.fair {
            width: 66%;
            background-color: #ffc107;
        }

        .password-strength-meter-fill.good {
            width: 100%;
            background-color: #28a745;
        }
    </style>
}

<section class="login-page">
    <div class="container py-4 py-lg-5">
        <div class="login-shell shadow-lg">
            <div class="row g-0">
                <div class="col-lg-6 login-aside">
                    <div class="login-aside-inner p-4 p-lg-5 h-100 d-flex flex-column">
                        <div class="login-aside-header">
                            <div class="login-logo d-flex align-items-center gap-3 mb-3">
                                <img src="https://tse2.mm.bing.net/th/id/OIP.SFZkB5O0ySpL7-f6EG_ExQHaHa?r=0&cb=thfvnextfalcon&rs=1&pid=ImgDetMain&o=7&rm=3" alt="University Logo" onerror="this.src='https://via.placeholder.com/64'" />
                                <div>
                                    <span class="text-uppercase fw-semibold small">University Portal</span>
                                    <h1 class="h4 fw-bold mb-0">Student Competition Management</h1>
                                </div>
                            </div>
                            <p class="login-slogan mb-4">
                                Đăng ký tài khoản để tham gia sân chơi học thuật, đồng hành cùng hệ thống quản trị minh bạch.
                            </p>
                        </div>

                        <div class="login-illustration mb-4">
                            <img src="https://images.unsplash.com/photo-1523580846011-d3a5bc25702b?q=80&w=1200&auto=format&fit=crop" alt="University Collaboration" />
                        </div>

                        <div class="login-stats mb-4">
                            <div>
                                <span class="login-stat-value">120+</span>
                                <span class="login-stat-label">Cuộc thi</span>
                            </div>
                            <div>
                                <span class="login-stat-value">5000+</span>
                                <span class="login-stat-label">Sinh viên</span>
                            </div>
                            <div>
                                <span class="login-stat-value">35+</span>
                                <span class="login-stat-label">Khoa/ngành</span>
                            </div>
                        </div>

                        <ul class="login-features list-unstyled mb-0">
                            <li><i class="bi bi-check2-circle"></i>Quản lý cuộc thi tập trung</li>
                            <li><i class="bi bi-check2-circle"></i>Đăng ký trực tuyến nhanh chóng</li>
                            <li><i class="bi bi-check2-circle"></i>Theo dõi kết quả minh bạch</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="login-card p-4 p-lg-5">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="login-icon"><i class="bi bi-person-plus"></i></span>
                            <div>
                                <h2 class="h4 fw-bold mb-1">Đăng ký tài khoản</h2>
                                <p class="text-muted mb-0">Tạo tài khoản sinh viên để tham gia hệ thống quản lý cuộc thi.</p>
                            </div>
                        </div>

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Lỗi đăng ký!</strong> Vui lòng kiểm tra thông tin bên dưới.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <form asp-action="Index" method="post" class="login-form" novalidate id="registerForm">
                            @Html.AntiForgeryToken()

                            <!-- Họ và Tên -->
                            <div class="form-floating mb-3">
                                <input asp-for="FullName" class="form-control @GetInvalidClass("FullName")" placeholder="Nguyễn Văn A" />
                                <label asp-for="FullName">Họ và tên</label>
                                <span asp-validation-for="FullName" class="invalid-feedback"></span>
                            </div>

                            <!-- Mã sinh viên -->
                            <div class="form-floating mb-3">
                                <input asp-for="StudentCode" class="form-control @GetInvalidClass("StudentCode")" placeholder="SV20240001" />
                                <label asp-for="StudentCode">Mã sinh viên</label>
                                <span asp-validation-for="StudentCode" class="invalid-feedback"></span>
                            </div>

                            <!-- Email -->
                            <div class="form-floating mb-3">
                                <input asp-for="Email" class="form-control @GetInvalidClass("Email")" placeholder="name@university.edu.vn" />
                                <label asp-for="Email">Email trường</label>
                                <span asp-validation-for="Email" class="invalid-feedback"></span>
                            </div>

                            <!-- Mật khẩu -->
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Mật khẩu</label>
                                <div class="password-input-wrapper">
                                    <input asp-for="Password" type="password" class="form-control @GetInvalidClass("Password")" placeholder="••••••••" id="passwordInput" />
                                    <button type="button" class="password-toggle-btn" id="togglePassword" title="Hiển thị/ẩn mật khẩu">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <div class="password-strength-meter">
                                        <div class="password-strength-meter-fill" id="strengthMeter"></div>
                                    </div>
                                </div>
                                <span asp-validation-for="Password" class="invalid-feedback"></span>
                                <small class="text-muted d-block mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    Mật khẩu: tối thiểu 8 ký tự, 1 chữ hoa, 1 chữ thường, 1 số, 1 ký tự đặc biệt (@@$!%*?&)
                                </small>
                            </div>

                            <!-- Xác nhận mật khẩu -->
                            <div class="form-floating mb-4">
                                <input asp-for="ConfirmPassword" type="password" class="form-control @GetInvalidClass("ConfirmPassword")" placeholder="••••••••" id="confirmPasswordInput" />
                                <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                                <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                            </div>

                            <!-- Điều khoản -->
                            <div class="terms-checkbox @GetInvalidClass("AcceptTerms")">
                                <input asp-for="AcceptTerms" type="checkbox" id="acceptTerms" />
                                <label for="acceptTerms">
                                    Tôi đồng ý với <a href="/Terms" target="_blank">Điều khoản sử dụng</a> và <a href="/Privacy" target="_blank">Chính sách bảo mật</a>
                                </label>
                            </div>
                            @if (!string.IsNullOrEmpty(GetInvalidClass("AcceptTerms")))
                            {
                                <span asp-validation-for="AcceptTerms" class="invalid-feedback d-block mb-2"></span>
                            }

                            <button type="submit" class="btn btn-primary w-100 login-submit">
                                <i class="bi bi-person-plus me-2"></i>Tạo tài khoản
                            </button>

                            <p class="text-center text-muted mt-4 mb-0">
                                Đã có tài khoản?
                                <a href="/Login" class="link-primary fw-semibold">Đăng nhập ngay</a>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const passwordInput = document.getElementById('passwordInput');
            const confirmPasswordInput = document.getElementById('confirmPasswordInput');
            const togglePasswordBtn = document.getElementById('togglePassword');
            const strengthMeter = document.getElementById('strengthMeter');
            const acceptTermsCheckbox = document.getElementById('acceptTerms');

            // Toggle password visibility
            if (togglePasswordBtn && passwordInput) {
                togglePasswordBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    const icon = type === 'password' ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
                    this.innerHTML = icon;
                });
            }

            // Password strength checker
            if (passwordInput) {
                passwordInput.addEventListener('input', function () {
                    const password = this.value;
                    let strength = 0;

                    if (password.length >= 8) strength++;
                    if (/[a-z]/.test(password)) strength++;
                    if (/[A-Z]/.test(password)) strength++;
                    if (/\d/.test(password)) strength++;
                    if (/[@@$!%*?&]/.test(password)) strength++;

                    strengthMeter.className = 'password-strength-meter-fill';
                    if (strength <= 2) {
                        strengthMeter.classList.add('weak');
                    } else if (strength <= 4) {
                        strengthMeter.classList.add('fair');
                    } else {
                        strengthMeter.classList.add('good');
                    }
                });
            }
        });
    </script>
}