@{
    ViewData["Title"] = "Ðãng k? thành công";
}

<div class="success-page d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="container">
        <div class="success-card card border-0 shadow-lg rounded-4 p-5 text-center" style="max-width: 500px; margin: 0 auto;">
            <div class="success-icon mb-4">
                <i class="bi bi-check-circle"></i>
            </div>

            <h1 class="h3 fw-bold text-dark mb-2">Ðãng k? thành công!</h1>
            <p class="text-muted mb-4">
                H? sõ ðãng k? c?a b?n ð? ðý?c g?i thành công. Ban t? ch?c s? ki?m tra và xác nh?n trong th?i gian s?m nh?t.
            </p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div class="success-steps mb-5">
                <div class="success-step">
                    <span class="step-number">1</span>
                    <p class="mb-0"><strong>G?i thành công</strong><br><small class="text-muted">H? sõ c?a b?n ð? ðý?c ghi nh?n</small></p>
                </div>
                <div class="success-step">
                    <span class="step-number">2</span>
                    <p class="mb-0"><strong>Ðang xét duy?t</strong><br><small class="text-muted">Ban t? ch?c s? ki?m tra trong 3-5 ngày</small></p>
                </div>
                <div class="success-step">
                    <span class="step-number">3</span>
                    <p class="mb-0"><strong>Nh?n k?t qu?</strong><br><small class="text-muted">Thông báo qua email khi duy?t</small></p>
                </div>
            </div>

            <div class="d-flex flex-column gap-2">
                <a href="/Dashboard" class="btn btn-primary btn-lg rounded-3 fw-semibold">
                    <i class="bi bi-speedometer2 me-2"></i>Xem Dashboard
                </a>
                <a href="/Competitions" class="btn btn-outline-secondary btn-lg rounded-3 fw-semibold">
                    <i class="bi bi-arrow-left me-2"></i>Quay l?i danh sách cu?c thi
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .success-page {
        background: linear-gradient(135deg, #f5f7fb 0%, #eef2f8 100%);
    }

    .success-icon {
        font-size: 4rem;
        color: #10a854;
        animation: scaleIn 0.6s ease;
    }

    .success-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        padding: 24px 0;
    }

    .success-step {
        padding: 16px;
        border-radius: 12px;
        background: #f0f8f5;
    }

    .step-number {
        display: inline-block;
        width: 36px;
        height: 36px;
        line-height: 36px;
        text-align: center;
        background: #10a854;
        color: white;
        border-radius: 50%;
        font-weight: bold;
        margin-bottom: 8px;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@media (max-width: 576px) {
        .success-steps {
            grid-template-columns: 1fr;
        }
    }
</style>
