@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nhật ký Hoạt động Hệ thống";
}

@section Styles {
    <style>
        .log-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        /* --- STAT CARDS --- */
        .log-stat-card {
            background: #fff;
            border-radius: 10px;
            padding: 1.25rem;
            border: 1px solid var(--border-color);
            border-top: 4px solid var(--accent-blue);
        }

            .log-stat-card.danger {
                border-top-color: #ef4444;
            }

            .log-stat-card.warning {
                border-top-color: #f59e0b;
            }

            .log-stat-card.success {
                border-top-color: #22c55e;
            }

        .stat-value {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-top: 5px;
        }

        /* --- PANELS --- */
        .panel-box {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 20px;
            margin-bottom: 24px;
        }

        /* --- AUDIT TABLE --- */
        .audit-table th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
            background-color: #f8fafc;
            border-bottom: 2px solid var(--border-color);
            padding: 12px 15px;
        }

        .audit-table td {
            font-size: 0.85rem;
            vertical-align: middle;
            padding: 12px 15px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-dark);
        }

        .audit-table tr:hover td {
            background-color: #f1f5f9;
        }

        /* --- BADGES & STATUS --- */
        .log-badge {
            font-size: 0.7rem;
            padding: 4px 8px;
            border-radius: 6px;
            font-weight: 600;
        }

        .action-create {
            background: #dcfce7;
            color: #166534;
        }

        .action-update {
            background: #e0f2fe;
            color: #075985;
        }

        .action-delete {
            background: #fee2e2;
            color: #991b1b;
        }

        .action-login {
            background: #f3e8ff;
            color: #6b21a8;
        }

        /* --- TIMELINE --- */
        .timeline {
            position: relative;
            padding-left: 20px;
            list-style: none;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 2px;
                background: var(--border-color);
            }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
        }

        .timeline-indicator {
            position: absolute;
            left: -26px;
            top: 2px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid var(--accent-blue);
        }

            .timeline-indicator.danger {
                border-color: #ef4444;
            }

            .timeline-indicator.warning {
                border-color: #f59e0b;
            }
    </style>
}

<div class="log-wrapper py-4">
    <div class="container-fluid">

        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Nhật ký Hoạt động (Audit Logs)</h3>
                <p class="text-muted small mb-0">Giám sát bảo mật, truy xuất dữ liệu hệ thống và hoạt động của người dùng.</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <button class="btn btn-outline-dark btn-sm fw-bold"><i class="bi bi-file-earmark-pdf"></i> Xuất PDF</button>
                <button class="btn btn-outline-success btn-sm fw-bold"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</button>
            </div>
        </div>

        <!-- 1. Statistics -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="log-stat-card">
                    <div class="text-muted small fw-bold text-uppercase">Log ghi nhận (24h)</div>
                    <div class="stat-value">5,420</div>
                    <div class="small mt-1 text-success"><i class="bi bi-arrow-up-short"></i> Hệ thống ổn định</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="log-stat-card success">
                    <div class="text-muted small fw-bold text-uppercase">Logins (Hôm nay)</div>
                    <div class="stat-value">1,208</div>
                    <div class="small mt-1 text-muted"><i class="bi bi-people"></i> Active Users</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="log-stat-card warning">
                    <div class="text-muted small fw-bold text-uppercase">Cảnh báo Suspicious</div>
                    <div class="stat-value text-warning">14</div>
                    <div class="small mt-1 text-muted">Truy cập khác IP thường dùng</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="log-stat-card danger">
                    <div class="text-muted small fw-bold text-uppercase">Lỗi Hệ thống (Error 500)</div>
                    <div class="stat-value text-danger">3</div>
                    <div class="small mt-1 text-danger fw-bold"><i class="bi bi-exclamation-circle"></i> Cần kiểm tra Logs</div>
                </div>
            </div>
        </div>

        <!-- 2. Search & Filter -->
        <div class="panel-box shadow-sm mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Tìm kiếm User / IP</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Nhập email, ID, hoặc IP...">
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Phân hệ (Module)</label>
                    <select class="form-select form-select-sm">
                        <option value="">Tất cả Module</option>
                        <option value="Auth">Đăng nhập / Auth</option>
                        <option value="Contest">Cuộc thi</option>
                        <option value="Submission">Bài dự thi</option>
                        <option value="Settings">Cài đặt Hệ thống</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Loại hành động</label>
                    <select class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        <option value="CREATE">Thêm mới (Create)</option>
                        <option value="UPDATE">Cập nhật (Update)</option>
                        <option value="DELETE">Xóa (Delete)</option>
                        <option value="LOGIN">Đăng nhập</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Thời gian</label>
                    <input type="date" class="form-control form-control-sm">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary btn-sm w-100 fw-bold"><i class="bi bi-funnel"></i> Lọc Dữ liệu</button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="row g-4">
            <!-- Table Panel -->
            <div class="col-lg-8">
                <div class="panel-box shadow-sm h-100 p-0 overflow-hidden">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-card-list me-2"></i> Chi tiết Nhật ký (Audit Trails)</h6>
                        <span class="badge bg-secondary">Hiển thị 50 bản ghi mới nhất</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table audit-table mb-0">
                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Người dùng / Role</th>
                                    <th>Hành động</th>
                                    <th>Module</th>
                                    <th>IP / Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-muted">10:45:22<br><small>Hôm nay</small></td>
                                    <td>
                                        <div class="fw-bold text-dark">khoait_admin@uni.edu</div>
                                        <span class="badge bg-dark bg-opacity-10 text-dark" style="font-size: 0.65rem;">Ban Tổ Chức</span>
                                    </td>
                                    <td><span class="log-badge action-create">CREATE</span></td>
                                    <td class="fw-bold text-muted">Contests</td>
                                    <td>
                                        <div class="small font-monospace">192.168.1.15</div>
                                        <span class="text-success small fw-bold"><i class="bi bi-check-circle"></i> Success</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-info-circle"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">09:12:05<br><small>Hôm nay</small></td>
                                    <td>
                                        <div class="fw-bold text-dark">system_root</div>
                                        <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size: 0.65rem;">Super Admin</span>
                                    </td>
                                    <td><span class="log-badge action-update">UPDATE</span></td>
                                    <td class="fw-bold text-muted">SystemSettings</td>
                                    <td>
                                        <div class="small font-monospace">10.0.0.5</div>
                                        <span class="text-success small fw-bold"><i class="bi bi-check-circle"></i> Success</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-info-circle"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">08:30:11<br><small>Hôm nay</small></td>
                                    <td>
                                        <div class="fw-bold text-dark">sv_123456@student.edu</div>
                                        <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size: 0.65rem;">Sinh Viên</span>
                                    </td>
                                    <td><span class="log-badge action-login">LOGIN</span></td>
                                    <td class="fw-bold text-muted">Auth</td>
                                    <td>
                                        <div class="small font-monospace text-danger">115.75.12.33</div>
                                        <span class="text-danger small fw-bold"><i class="bi bi-x-circle"></i> Failed (Wrong Pass)</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-info-circle"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">08:15:00<br><small>Hôm nay</small></td>
                                    <td>
                                        <div class="fw-bold text-dark">gv_nguyenvanb@uni.edu</div>
                                        <span class="badge bg-warning bg-opacity-10 text-warning" style="font-size: 0.65rem;">Giám Khảo</span>
                                    </td>
                                    <td><span class="log-badge action-delete">DELETE</span></td>
                                    <td class="fw-bold text-muted">Submissions_Draft</td>
                                    <td>
                                        <div class="small font-monospace">192.168.1.188</div>
                                        <span class="text-success small fw-bold"><i class="bi bi-check-circle"></i> Success</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-info-circle"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="p-3 bg-white d-flex justify-content-end">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Security & Alert Timeline Panel -->
            <div class="col-lg-4">
                <div class="panel-box shadow-sm h-100">
                    <h6 class="fw-bold mb-4" style="color: var(--navy-blue);">
                        <i class="bi bi-shield-lock text-danger me-2"></i> Cảnh báo Bảo mật (Real-time)
                    </h6>

                    <ul class="timeline">
                        <li class="timeline-item">
                            <div class="timeline-indicator danger"></div>
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">Brute Force Alert</div>
                            <p class="small text-muted mb-1">Cảnh báo 10 lần đăng nhập thất bại từ IP <code>115.75.12.33</code> vào tài khoản Admin.</p>
                            <small class="text-danger fw-bold">15 phút trước</small>
                        </li>
                        <li class="timeline-item">
                            <div class="timeline-indicator warning"></div>
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">Xóa dữ liệu nhạy cảm</div>
                            <p class="small text-muted mb-1">Người dùng <code>khoait_admin</code> vừa thực hiện lệnh XÓA (Delete) Cuộc thi ID #105.</p>
                            <small class="text-muted">1 giờ trước</small>
                        </li>
                        <li class="timeline-item">
                            <div class="timeline-indicator"></div>
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">Admin Config Update</div>
                            <p class="small text-muted mb-1">Cấu hình Hệ thống (SystemSettings) đã được sửa đổi bởi Root Admin.</p>
                            <small class="text-muted">3 giờ trước</small>
                        </li>
                    </ul>

                    <hr class="my-4">
                    <button class="btn btn-light border w-100 btn-sm fw-bold">Xem toàn bộ Security Logs Mức cao</button>
                </div>
            </div>
        </div>
    </div>
</div>