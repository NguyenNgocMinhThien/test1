@model Web_cham_diem.Models.ViewModels.ActivityLogsViewModel
@using System.Linq  @* ← Thêm dòng này để dùng .Any() *@

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nhật ký Hoạt động Hệ thống";
}

@section Styles {
    <style>
        .log-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        .log-stat-card {
            background: #fff;
            border-radius: 10px;
            padding: 1.25rem;
            border: 1px solid var(--border-color);
            border-top: 4px solid var(--accent-blue);
        }

            .log-stat-card.danger {
                border-top-color: #ef4444;
            }

            .log-stat-card.warning {
                border-top-color: #f59e0b;
            }

            .log-stat-card.success {
                border-top-color: #22c55e;
            }

        .stat-value {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-top: 5px;
        }

        .panel-box {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 20px;
            margin-bottom: 24px;
        }

        .audit-table th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
            background-color: #f8fafc;
            border-bottom: 2px solid var(--border-color);
            padding: 12px 15px;
        }

        .audit-table td {
            font-size: 0.85rem;
            vertical-align: middle;
            padding: 12px 15px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-dark);
        }

        .audit-table tr:hover td {
            background-color: #f1f5f9;
        }

        .log-badge {
            font-size: 0.7rem;
            padding: 4px 8px;
            border-radius: 6px;
            font-weight: 600;
        }

        .action-create {
            background: #dcfce7;
            color: #166534;
        }

        .action-update {
            background: #e0f2fe;
            color: #075985;
        }

        .action-delete {
            background: #fee2e2;
            color: #991b1b;
        }

        .action-login {
            background: #f3e8ff;
            color: #6b21a8;
        }

        .timeline {
            position: relative;
            padding-left: 20px;
            list-style: none;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 2px;
                background: var(--border-color);
            }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
        }

        .timeline-indicator {
            position: absolute;
            left: -26px;
            top: 2px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid var(--accent-blue);
        }

            .timeline-indicator.danger {
                border-color: #ef4444;
            }

            .timeline-indicator.warning {
                border-color: #f59e0b;
            }
    </style>
}

<div class="log-wrapper py-4">
    <div class="container-fluid">
        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Nhật ký Hoạt động (Audit Logs)</h3>
                <p class="text-muted small mb-0">Giám sát bảo mật, truy xuất dữ liệu hệ thống và hoạt động của người dùng.</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <button class="btn btn-outline-dark btn-sm fw-bold"><i class="bi bi-file-earmark-pdf"></i> Xuất PDF</button>
                <button class="btn btn-outline-success btn-sm fw-bold"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</button>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="log-stat-card">
                    <div class="text-muted small fw-bold text-uppercase">Log ghi nhận (24h)</div>
                    <div class="stat-value">@Model.Stats.Logs24h</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="log-stat-card success">
                    <div class="text-muted small fw-bold text-uppercase">Logins (Hôm nay)</div>
                    <div class="stat-value">@Model.Stats.LoginsToday</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="log-stat-card warning">
                    <div class="text-muted small fw-bold text-uppercase">Cảnh báo Suspicious</div>
                    <div class="stat-value text-warning">@Model.Stats.SuspiciousCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="log-stat-card danger">
                    <div class="text-muted small fw-bold text-uppercase">Lỗi Hệ thống</div>
                    <div class="stat-value text-danger">@Model.Stats.FailedActionsToday</div>
                </div>
            </div>
        </div>

        <!-- Filter -->
        <form asp-action="ActivityLogs" method="get" class="panel-box shadow-sm mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Tìm kiếm User / IP</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.Filter.Search" class="form-control" placeholder="Nhập email, ID, hoặc IP...">
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Phân hệ</label>
                    <select name="module" class="form-select form-select-sm">
                        <option value="">Tất cả Module</option>
                        <option value="Auth" selected="@(Model.Filter.Module == "Auth")">Auth</option>
                        <option value="UserManagement" selected="@(Model.Filter.Module == "UserManagement")">UserManagement</option>
                        <option value="Contests" selected="@(Model.Filter.Module == "Contests")">Contests</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Hành động</label>
                    <select name="actionType" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        <option value="LOGIN" selected="@(Model.Filter.ActionType == "LOGIN")">LOGIN</option>
                        <option value="CREATE" selected="@(Model.Filter.ActionType == "CREATE")">CREATE</option>
                        <option value="UPDATE" selected="@(Model.Filter.ActionType == "UPDATE")">UPDATE</option>
                        <option value="DELETE" selected="@(Model.Filter.ActionType == "DELETE")">DELETE</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Thời gian</label>
                    <input type="date" name="date" value="@(Model.Filter.Date?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold"><i class="bi bi-funnel"></i> Lọc</button>
                </div>
            </div>
        </form>

        <div class="row g-4">
            <!-- Table -->
            <div class="col-lg-8">
                <div class="panel-box shadow-sm h-100 p-0 overflow-hidden">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-card-list me-2"></i> Chi tiết Nhật ký</h6>
                        <span class="badge bg-secondary">@Model.Logs.Count bản ghi</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table audit-table mb-0">
                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Người dùng / Role</th>
                                    <th>Hành động</th>
                                    <th>Module</th>
                                    <th>IP / Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Logs.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">Chưa có dữ liệu nhật ký hoạt động.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var log in Model.Logs)
                                    {
                                        <tr>
                                            <td class="text-muted">@log.CreatedAt.ToLocalTime().ToString("HH:mm:ss")<br><small>@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></td>
                                            <td>
                                                <div class="fw-bold text-dark">@log.UserEmailSnapshot</div>
                                                <span class="badge bg-dark bg-opacity-10 text-dark">@log.UserRoleSnapshot</span>
                                            </td>
                                            <td><span class="log-badge action-@log.ActionType.ToLower()">@log.ActionType</span></td>
                                            <td class="fw-bold text-muted">@log.Module</td>
                                            <td>
                                                <div class="small font-monospace">@log.IpAddress</div>
                                                @if (log.IsSuccess)
                                                {
                                                    <span class="text-success small fw-bold"><i class="bi bi-check-circle"></i> Success</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger small fw-bold"><i class="bi bi-x-circle"></i> @log.StatusDetail</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-light text-primary" title="@log.Description"><i class="bi bi-info-circle"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Alerts -->
            <div class="col-lg-4">
                <div class="panel-box shadow-sm h-100">
                    <h6 class="fw-bold mb-4" style="color: var(--navy-blue);">
                        <i class="bi bi-shield-lock text-danger me-2"></i> Cảnh báo Bảo mật
                    </h6>
                    <ul class="timeline">
                        @foreach (var alert in Model.Alerts)
                        {
                            <li class="timeline-item">
                                <div class="timeline-indicator @(alert.Severity == "danger" ? "danger" : alert.Severity == "warning" ? "warning" : "")"></div>
                                <div class="fw-bold text-dark">@alert.Title</div>
                                <p class="small text-muted mb-1">@alert.Description</p>
                                <small class="text-muted">@alert.OccurredAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                            </li>
                        }
                        @if (!Model.Alerts.Any())
                        {
                            <li class="text-muted">Hiện không có cảnh báo bảo mật.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>