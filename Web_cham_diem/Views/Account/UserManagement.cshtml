            if(data.role === "Admin") {
                window.location.href = '/Account/Admin';
            } else {
                window.location.href = '/Account/UserDashboard';
            }
        } else {
            alert('Đăng nhập thất bại: ' + data.message);
        }
    })
    .catch(err => console.error("Lỗi kết nối đăng nhập:", err));
}
