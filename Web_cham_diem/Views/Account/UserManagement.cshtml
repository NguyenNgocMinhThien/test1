@model Web_cham_diem.Models.ViewModels.UserManagementViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="user-management-page py-4">
    <div class="container-fluid">

        <div class="d-md-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Quản lý người dùng</h3>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/Account/Admin" class="text-decoration-none">Dashboard</a></li>
                        <li class="breadcrumb-item active">Người dùng</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                <button class="btn btn-outline-primary rounded-pill px-4 shadow-sm" onclick="exportData()">
                    <i class="bi bi-download me-2"></i> Xuất dữ liệu
                </button>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
                    <i class="bi bi-person-plus-fill me-2"></i> Thêm người dùng
                </button>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-2">
                <div class="stat-card p-3 shadow-sm border-0 rounded-4 bg-white h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-primary-subtle text-primary rounded-3 p-2">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-600">Tổng tài khoản</div>
                            <h4 class="fw-bold mb-0" id="statTotalUsers">...</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="stat-card p-3 shadow-sm border-0 rounded-4 bg-white h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-info-subtle text-info rounded-3 p-2">
                            <i class="bi bi-mortarboard-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-600">Sinh viên</div>
                            <h4 class="fw-bold mb-0" id="statStudents">...</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="stat-card p-3 shadow-sm border-0 rounded-4 bg-white h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-success-subtle text-success rounded-3 p-2">
                            <i class="bi bi-person-workspace fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-600">Giảng viên</div>
                            <h4 class="fw-bold mb-0" id="statLecturers">...</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="stat-card p-3 shadow-sm border-0 rounded-4 bg-white h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-warning-subtle text-warning rounded-3 p-2">
                            <i class="bi bi-building-fill-check fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-600">Ban tổ chức</div>
                            <h4 class="fw-bold mb-0" id="statOrganizers">...</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="stat-card p-3 shadow-sm border-0 rounded-4 bg-white h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-purple-subtle text-purple rounded-3 p-2" style="background: #f3f0ff; color: #7950f2;">
                            <i class="bi bi-journal-check fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-600">Giám khảo</div>
                            <h4 class="fw-bold mb-0" id="statJudges">...</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-2">
                <div class="stat-card p-3 shadow-sm border-0 rounded-4 bg-white h-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-danger-subtle text-danger rounded-3 p-2">
                            <i class="bi bi-person-lock fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-600">Bị khóa</div>
                            <h4 class="fw-bold mb-0" id="statLocked">...</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <form id="filterForm" class="row g-3 align-items-end" onsubmit="event.preventDefault();">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Tìm kiếm người dùng</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="filterSearch" class="form-control bg-light border-start-0" placeholder="Tên, Email hoặc MSSV...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Vai trò</label>
                        <select id="filterRole" class="form-select bg-light">
                            <option value="">Tất cả vai trò</option>
                            <option value="Student">Sinh viên</option>
                            <option value="Lecturer">Giảng viên</option>
                            <option value="Organizer">Ban tổ chức</option>
                            <option value="Judge">Giám khảo</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Trạng thái</label>
                        <select id="filterStatus" class="form-select bg-light">
                            <option value="">Tất cả trạng thái</option>
                            <option value="Active">Đang hoạt động</option>
                            <option value="Locked">Đã khóa</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Khoa/Phòng ban</label>
                        <select id="filterDepartment" class="form-select bg-light">
                            <option value="">Tất cả đơn vị</option>
                            <option value="Công nghệ thông tin">Công nghệ thông tin</option>
                            <option value="Quản trị kinh doanh">Quản trị kinh doanh</option>
                            <option value="Kỹ thuật công trình">Kỹ thuật công trình</option>
                            <option value="Lý luận chính trị">Lý luận chính trị</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button type="button" id="btnSubmitFilter" class="btn btn-primary w-100 h-100 py-2">
                            <i class="bi bi-funnel"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="fw-bold mb-0">Danh sách người dùng</h5>
                    <div id="bulkActions" class="d-none animate__animated animate__fadeIn">
                        <span class="text-muted small me-2"><span id="selectedCount">0</span> mục đã chọn:</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-danger"><i class="bi bi-lock"></i> Khóa</button>
                            <button class="btn btn-outline-primary"><i class="bi bi-key"></i> Reset Pass</button>
                            <button class="btn btn-outline-dark"><i class="bi bi-trash"></i> Xóa</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted">
                        <tr>
                            <th class="ps-4" style="width: 40px;">
                                <input type="checkbox" class="form-check-input" id="selectAll">
                            </th>
                            <th>Người dùng</th>
                            <th>Role & MSSV/Mã NV</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                Đang tải danh sách người dùng...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                <div class="text-muted small" id="tableSummary">Đang tính toán số lượng...</div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><a class="page-link rounded-start-pill px-3" href="#"><i class="bi bi-chevron-left"></i></a></li>
                        <li class="page-item active"><a class="page-link px-3" href="#">1</a></li>
                        <li class="page-item"><a class="page-link rounded-end-pill px-3" href="#"><i class="bi bi-chevron-right"></i></a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Thêm người dùng mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addUserForm">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Họ và tên</label>
                            <input type="text" name="FullName" class="form-control rounded-3" placeholder="Nhập tên đầy đủ..." required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Email trường</label>
                            <input type="email" name="Email" class="form-control rounded-3" placeholder="abc.sv@uef.edu.vn" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">MSSV / Mã nhân viên</label>
                            <input type="text" name="StudentId" class="form-control rounded-3" placeholder="Số hiệu tài khoản..." required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Vai trò hệ thống</label>
                            <select name="RoleName" class="form-select rounded-3">
                                <option value="Student">Sinh viên</option>
                                <option value="Lecturer">Giảng viên</option>
                                <option value="Organizer">Ban tổ chức</option>
                                <option value="Judge">Giám khảo</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Khoa/Đơn vị</label>
                            <select name="Department" class="form-select rounded-3">
                                <option value="Công nghệ thông tin">Công nghệ thông tin</option>
                                <option value="Quản trị kinh doanh">Quản trị kinh doanh</option>
                                <option value="Kỹ thuật công trình">Kỹ thuật công trình</option>
                                <option value="Lý luận chính trị">Lý luận chính trị</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Mật khẩu ban đầu</label>
                            <input type="text" name="Password" class="form-control rounded-3" value="UEF@12345" readonly>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Lưu thông tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0" id="modalTitle">Chi tiết người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Họ và tên</label>
                        <input type="text" id="modalFullName" class="form-control rounded-3" placeholder="Nhập tên đầy đủ...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Email trường</label>
                        <input type="email" id="modalEmail" class="form-control rounded-3" placeholder="abc.sv@uef.edu.vn">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">MSSV / Mã nhân viên</label>
                        <input type="text" id="modalStudentId" class="form-control rounded-3" placeholder="Số hiệu tài khoản...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Khoa/Đơn vị</label>
                        <select id="modalDepartment" class="form-select rounded-3">
                            <option value="Công nghệ thông tin">Công nghệ thông tin</option>
                            <option value="Quản trị kinh doanh">Quản trị kinh doanh</option>
                            <option value="Kỹ thuật công trình">Kỹ thuật công trình</option>
                            <option value="Lý luận chính trị">Lý luận chính trị</option>
                        </select>
                    </div>
                    <div class="col-md-6" id="modalRoleWrapper">
                        <label class="form-label small fw-bold">Vai trò hệ thống</label>
                        <input type="text" id="modalRoleName" class="form-control rounded-3" disabled />
                    </div>
                    <div class="col-md-6" id="passwordWrapper">
                        <label class="form-label small fw-bold">Mật khẩu</label>
                        <input type="text" id="modalPassword" class="form-control rounded-3" value="********" disabled>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="btnSubmitModal" onclick="saveUserChanges()" class="btn btn-primary rounded-pill px-4 shadow-sm">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-shield-lock me-2 text-success"></i> Thay đổi vai trò hệ thống</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold mb-2">Chọn vai trò hệ thống mới:</label>
                    <select id="roleSelectHUD" class="form-select form-select-lg rounded-3">
                        <option value="Student">Sinh viên</option>
                        <option value="Lecturer">Giảng viên</option>
                        <option value="Organizer">Ban tổ chức</option>
                        <option value="Judge">Giám khảo</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" onclick="saveNewRole()" class="btn btn-success rounded-pill px-4 shadow-sm">Xác nhận phân quyền</button>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --uni-blue: #003d7a;
        --uni-blue-light: #0056b3;
        --uni-accent: #e7f1ff;
    }

    .user-management-page {
        background: #f8fafc;
        min-height: 100vh;
    }

    .user-avatar-initials {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .badge-status {
        padding: 0.35rem 0.8rem;
        font-weight: 600;
        font-size: 0.7rem;
    }

    .table thead th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        border-bottom: 2px solid #f1f5f9;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .table tbody td {
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .table tbody tr:hover {
        background-color: #f8fafc;
    }

    .stat-card {
        transition: transform 0.3s ease;
        border: 1px solid #f1f5f9 !important;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .page-link {
        color: var(--uni-blue);
        border-color: #f1f5f9;
    }

    .active > .page-link {
        background-color: var(--uni-blue);
        border-color: var(--uni-blue);
    }

    .modal.fade .modal-dialog {
        transform: scale(0.95);
        transition: transform 0.2s ease-out;
    }

    .modal.show .modal-dialog {
        transform: scale(1);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAll = document.getElementById('selectAll');
        const bulkActions = document.getElementById('bulkActions');
        const selectedCount = document.getElementById('selectedCount');

        function updateBulkActions() {
            const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
            if(selectedCount) selectedCount.textContent = checkedCount;

            if (checkedCount > 0) {
                bulkActions.classList.remove('d-none');
                bulkActions.classList.add('d-inline-block');
            } else {
                bulkActions.classList.add('d-none');
                bulkActions.classList.remove('d-inline-block');
            }
        }

        if(selectAll) {
            selectAll.addEventListener('change', function() {
                const rowCheckboxes = document.querySelectorAll('.row-checkbox');
                rowCheckboxes.forEach(cb => cb.checked = selectAll.checked);
                updateBulkActions();
            });
        }

        document.getElementById('userTableBody').addEventListener('change', function(e) {
            if (e.target && e.target.classList.contains('row-checkbox')) {
                updateBulkActions();
            }
        });

        const btnSubmitFilter = document.getElementById('btnSubmitFilter');
        if (btnSubmitFilter) {
            btnSubmitFilter.addEventListener('click', function() {
                loadUserTable();
            });
        }

        const filterSearchInput = document.getElementById('filterSearch');
        if (filterSearchInput) {
            filterSearchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    loadUserTable();
                }
            });
        }

        function loadUserTable() {
            const tableBody = document.getElementById('userTableBody');
            tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        Đang lọc danh sách người dùng...
                    </td>
                </tr>`;

            const searchVal = document.getElementById('filterSearch').value.trim();
            const roleVal = document.getElementById('filterRole').value;
            const statusVal = document.getElementById('filterStatus').value;
            const deptVal = document.getElementById('filterDepartment').value;

            const queryParams = new URLSearchParams({
                search: searchVal,
                role: roleVal,
                status: statusVal,
                department: deptVal
            });

            fetch(`/Account/GetUserList?${queryParams.toString()}`, { method: 'GET' })
            .then(response => response.json())
            .then(data => {
                tableBody.innerHTML = '';

                if (data.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-warning fw-600">Không tìm thấy người dùng nào khớp với bộ lọc.</td></tr>';
                    updateStatCards(0, 0, 0, 0, 0, 0);
                    return;
                }

                let total = data.length;
                let students = 0, lecturers = 0, organizers = 0, judges = 0, locked = 0;

                data.forEach(user => {
                    if (!user.isActive) locked++;
                    if (user.roleName === 'Student') students++;
                    else if (user.roleName === 'Lecturer') lecturers++;
                    else if (user.roleName === 'Organizer') organizers++;
                    else if (user.roleName === 'Judge') judges++;

                    let roleBadgeClass = 'bg-secondary';
                    if (user.roleName === 'Student') roleBadgeClass = 'bg-info-subtle text-info';
                    else if (user.roleName === 'Lecturer') roleBadgeClass = 'bg-warning-subtle text-warning';
                    else if (user.roleName === 'Admin') roleBadgeClass = 'bg-danger-subtle text-danger';

                    let statusBadge = user.isActive ?
                        '<span class="badge bg-success-subtle text-success badge-status"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active</span>' :
                        '<span class="badge bg-danger-subtle text-danger badge-status"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Locked</span>';

                    let initials = user.fullName ? user.fullName.substring(0, 2).toUpperCase() : 'US';

                    // ================================================================
                    // 🔥 THAY ĐỔI QUAN TRỌNG: Sửa href="#" sang hàm javascript:void(0)
                    // ================================================================
                    let row = `
                        <tr>
                            <td class="ps-4"><input type="checkbox" class="form-check-input row-checkbox" value="${user.userId}"></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar-initials bg-primary-subtle text-primary fw-bold">${initials}</div>
                                    <div>
                                        <div class="fw-bold mb-0">${user.fullName}</div>
                                        <div class="text-muted small">${user.email}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge ${roleBadgeClass} rounded-pill px-3">${user.roleName}</span>
                                <div class="small text-muted mt-1">Mã: ${user.studentId || 'N/A'}</div>
                            </td>
                            <td>${statusBadge}</td>
                            <td><span class="small text-muted">${user.createdAt}</span></td>
                            <td class="text-end pe-4">
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-circle" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li><a class="dropdown-item py-2" href="javascript:void(0);" onclick="openUserModal(${user.userId}, 'VIEW')"><i class="bi bi-eye me-2"></i> Chi tiết</a></li>
                                        <li><a class="dropdown-item py-2" href="javascript:void(0);" onclick="openUserModal(${user.userId}, 'EDIT')"><i class="bi bi-pencil me-2 text-primary"></i> Sửa thông tin</a></li>
                                        <li><a class="dropdown-item py-2" href="javascript:void(0);" onclick="openRoleModal(${user.userId}, '${user.roleName}')"><i class="bi bi-shield-check me-2 text-success"></i> Phân quyền</a></li>
                                        <li><a class="dropdown-item py-2 text-warning" href="javascript:void(0);" onclick="toggleLockUser(${user.userId}, ${user.isActive})"><i class="bi bi-lock me-2"></i> ${user.isActive ? 'Khóa tài khoản' : 'Mở khóa'}</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item py-2 text-danger" href="javascript:void(0);" onclick="deleteUser(${user.userId})"><i class="bi bi-trash me-2"></i> Xóa</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>`;
                    tableBody.insertAdjacentHTML('beforeend', row);
                });

                updateStatCards(total, students, lecturers, organizers, judges, locked);
            })
            .catch(error => {
                console.error('Lỗi khi tải danh sách người dùng:', error);
                tableBody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Không thể nạp dữ liệu từ máy chủ.</td></tr>';
            });
        }

        function updateStatCards(total, students, lecturers, organizers, judges, locked) {
            document.getElementById('statTotalUsers').textContent = total.toLocaleString();
            document.getElementById('statStudents').textContent = students.toLocaleString();
            document.getElementById('statLecturers').textContent = lecturers.toLocaleString();
            document.getElementById('statOrganizers').textContent = organizers.toLocaleString();
            document.getElementById('statJudges').textContent = judges.toLocaleString();
            document.getElementById('statLocked').textContent = locked.toLocaleString();
            document.getElementById('tableSummary').textContent = `Hiển thị 1 - ${total} trên ${total} người dùng phù hợp`;
        }

        loadUserTable();

        const addUserForm = document.getElementById('addUserForm');
        if(addUserForm) {
            addUserForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);

                fetch('/Account/CreateUser', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        const modalElement = document.getElementById('addUserModal');
                        const modal = bootstrap.Modal.getInstance(modalElement);
                        if (modal) modal.hide();

                        addUserForm.reset();
                        loadUserTable();

                        if(selectAll) selectAll.checked = false;
                        updateBulkActions();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi hệ thống xảy ra khi thực hiện thêm tài khoản.');
                });
            });
        }
    });

    function exportData() {
        alert('Đang chuẩn bị trích xuất dữ liệu người dùng ra tệp Excel...');
    }

    let currentTargetUserId = null;
    let currentMode = "";

    // ==========================================
    // CHỨC NĂNG 1 & 2: XEM CHI TIẾT & SỬA THÔNG TIN (Đã đổi cú pháp hiển thị Modal)
    // ==========================================
    function openUserModal(userId, mode) {
        currentTargetUserId = userId;
        currentMode = mode;

        fetch(`/Account/GetUserDetail?id=${userId}`)
            .then(res => res.json())
            .then(response => {
                if (response.success) {
                    const user = response.data;

                    document.getElementById("modalFullName").value = user.fullName;
                    document.getElementById("modalEmail").value = user.email;
                    document.getElementById("modalStudentId").value = user.studentId;
                    document.getElementById("modalDepartment").value = user.department;
                    document.getElementById("modalRoleName").value = user.roleName;

                    document.getElementById("passwordWrapper").style.display = "none";

                    if (mode === "VIEW") {
                        document.getElementById("modalTitle").innerText = "Chi tiết người dùng";
                        document.getElementById("modalFullName").disabled = true;
                        document.getElementById("modalEmail").disabled = true;
                        document.getElementById("modalStudentId").disabled = true;
                        document.getElementById("modalDepartment").disabled = true;
                        document.getElementById("modalRoleName").disabled = true;
                        document.getElementById("btnSubmitModal").style.display = "none";
                    }
                    else if (mode === "EDIT") {
                        document.getElementById("modalTitle").innerText = "Chỉnh sửa thông tin";
                        document.getElementById("modalFullName").disabled = false;
                        document.getElementById("modalStudentId").disabled = false;
                        document.getElementById("modalDepartment").disabled = false;
                        document.getElementById("modalEmail").disabled = true;
                        document.getElementById("modalRoleName").disabled = true;
                        document.getElementById("btnSubmitModal").style.display = "block";
                    }

                    // 👉 SỬA ĐỔI: Sử dụng thuần Bootstrap 5 Modal thay vì JQuery
                    var myModal = new bootstrap.Modal(document.getElementById('userModal'));
                    myModal.show();
                } else {
                    alert(response.message);
                }
            });
    }

    function saveUserChanges() {
        if (currentMode !== "EDIT") return;

        const fullName = document.getElementById("modalFullName").value;
        const studentId = document.getElementById("modalStudentId").value;
        const department = document.getElementById("modalDepartment").value;

        const formData = new FormData();
        formData.append("userId", currentTargetUserId);
        formData.append("fullName", fullName);
        formData.append("studentId", studentId);
        formData.append("department", department);
        formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/Account/UpdateUser', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Cập nhật thông tin thành công!");

                // Đóng Modal chuẩn Bootstrap 5
                var modalEl = document.getElementById('userModal');
                var modal = bootstrap.Modal.getInstance(modalEl);
                if(modal) modal.hide();

                location.reload(); // Reload nhẹ để tải lại dữ liệu tổng quan
            } else {
                alert("Lỗi: " + data.message);
            }
        });
    }

    // ==========================================
    // CHỨC NĂNG 3: BẬT MODAL PHÂN QUYỀN
    // ==========================================
    function openRoleModal(userId, currentRole) {
        currentTargetUserId = userId;
        document.getElementById("roleSelectHUD").value = currentRole;

        var rModal = new bootstrap.Modal(document.getElementById('roleModal'));
        rModal.show();
    }

    function saveNewRole() {
        const newRole = document.getElementById("roleSelectHUD").value;
        const formData = new FormData();
        formData.append("userId", currentTargetUserId);
        formData.append("roleName", newRole);
        formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/Account/UpdateUserRole', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Phân quyền thành công!");
                var modalEl = document.getElementById('roleModal');
                var modal = bootstrap.Modal.getInstance(modalEl);
                if(modal) modal.hide();
                location.reload();
            } else {
                alert("Lỗi: " + data.message);
            }
        });
    }

    // ==========================================
    // CHỨC NĂNG 4: KHÓA / MỞ KHÓA TÀI KHOẢN
    // ==========================================
    function toggleLockUser(userId, currentStatus) {
        const msg = currentStatus ? "Bạn chắc chắn muốn KHÓA tài khoản này?" : "Bạn muốn MỞ KHÓA cho tài khoản này?";
        if (!confirm(msg)) return;

        const formData = new FormData();
        formData.append("userId", userId);
        formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/Account/ToggleLockUser', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert("Thao tác thất bại: " + data.message);
            }
        });
    }

    function deleteUser(userId) {
        if (!confirm("Hành động này không thể hoàn tác! Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản này?")) return;
        // Thực hiện fetch API xóa nếu backend có viết hàm DeleteUser...
        alert("Tính năng xóa ID " + userId + " đang được phát triển.");
    }
</script>