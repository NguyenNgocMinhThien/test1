@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo cáo và Thống kê";
}

@section Styles {
    <style>
        .report-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        .filter-panel {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .kpi-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border-color);
            border-left: 5px solid var(--accent-blue);
            transition: transform 0.2s ease;
        }

            .kpi-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.06);
            }

        .kpi-title {
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .kpi-value {
            font-size: 1.9rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-top: 4px;
        }

        .acct-card {
            background: #fff;
            border-radius: 12px;
            padding: 18px 12px;
            border: 1px solid var(--border-color);
            text-align: center;
            border-top: 4px solid #e2e8f0;
        }

            .acct-card .acct-label {
                color: var(--text-muted);
                font-size: 0.72rem;
                font-weight: 700;
                text-transform: uppercase;
            }

            .acct-card .acct-value {
                font-size: 1.6rem;
                font-weight: 800;
                margin-top: 4px;
            }

        .chart-box {
            background: #fff;
            border-radius: 12px;
            padding: 24px;
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .chart-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: var(--navy-blue);
        }

        .top-rank-badge {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .rank-1 {
            background: #fef3c7;
            color: #d97706;
        }

        .rank-2 {
            background: #f1f5f9;
            color: #475569;
        }

        .rank-3 {
            background: #fef3c7;
            color: #b45309;
        }

        .rank-other {
            background: #f0f2f5;
            color: #64748b;
        }

        .table-rounded {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .progress-thin {
            height: 6px;
            border-radius: 99px;
        }

        .btn-export {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
        }

        .section-heading {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--navy-blue);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }
    </style>
}

<div class="report-wrapper py-4">
    <div class="container-fluid">

        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Báo cáo & Phân tích Dữ liệu</h3>
                <p class="text-muted small mb-0">Theo dõi toàn diện các chỉ số và hiệu quả vận hành hệ thống</p>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                <button class="btn btn-outline-danger btn-export btn-sm"><i class="bi bi-file-earmark-pdf"></i> Xuất PDF</button>
                <button class="btn btn-outline-success btn-export btn-sm"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</button>
                <button class="btn btn-outline-secondary btn-export btn-sm"><i class="bi bi-filetype-csv"></i> Xuất CSV</button>
            </div>
        </div>

        <!-- Filter -->
        <div class="filter-panel shadow-sm">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Năm học</label>
                    <select class="form-select form-select-sm" id="schoolYear">
                        <option value="">Tất cả</option>
                        <option value="2025-2026" selected>2025 - 2026</option>
                        <option value="2024-2025">2024 - 2025</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Khoa / Đơn vị</label>
                    <select class="form-select form-select-sm" id="department">
                        <option value="" selected>Toàn trường (Tất cả)</option>
                        <option value="CNTT">Công nghệ Thông tin</option>
                        <option value="KTQT">Kinh tế & Quản trị</option>
                        <option value="NN">Ngoại ngữ</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Loại cuộc thi</label>
                    <select class="form-select form-select-sm" id="contestType">
                        <option value="" selected>Tất cả hình thức</option>
                        <option value="HocThuat">Học thuật, NCKH</option>
                        <option value="SangTao">Sáng tạo, Kỹ năng</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Thời gian (Từ - Đến)</label>
                    <div class="input-group input-group-sm">
                        <input type="date" class="form-control" id="fromDate">
                        <input type="date" class="form-control" id="toDate">
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 1: KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color:#0d6efd;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Tổng cuộc thi</div>
                            <div class="kpi-value" id="txtTotalCompetitions">–</div>
                        </div>
                        <div class="text-primary fs-2"><i class="bi bi-trophy"></i></div>
                    </div>
                    <div class="small mt-2 text-success"><i class="bi bi-arrow-up-short"></i> +12% so với kỳ trước</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color:#f59e0b;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Tổng thí sinh</div>
                            <div class="kpi-value" id="txtTotalStudents">–</div>
                        </div>
                        <div class="text-warning fs-2"><i class="bi bi-people"></i></div>
                    </div>
                    <div class="small mt-2 text-success"><i class="bi bi-arrow-up-short"></i> +25% so với kỳ trước</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color:#a855f7;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Bài dự thi đã nộp</div>
                            <div class="kpi-value" id="txtTotalSubmissions">–</div>
                        </div>
                        <div class="fs-2" style="color:#a855f7;"><i class="bi bi-file-earmark-text"></i></div>
                    </div>
                    <div class="small mt-2 text-success"><i class="bi bi-arrow-up-short"></i> +8% so với kỳ trước</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color:#22c55e;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-title">Tỷ lệ hoàn thành</div>
                            <div class="kpi-value" id="txtCompletionRate">–</div>
                        </div>
                        <div class="text-success fs-2"><i class="bi bi-check2-circle"></i></div>
                    </div>
                    <div class="small mt-2 text-muted">Trung bình toàn hệ thống</div>
                </div>
            </div>
        </div>

        <!-- SECTION 2: Account Status -->
        <div class="section-heading">
            <i class="bi bi-person-check-fill text-info"></i> Trạng thái Hệ thống Tài khoản
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-2">
                <div class="acct-card" style="border-top-color:#0d6efd;">
                    <div class="acct-label">Tổng tài khoản</div>
                    <div class="acct-value text-primary" id="txtTotalAccounts">–</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="acct-card" style="border-top-color:#0dcaf0;">
                    <div class="acct-label">Sinh viên</div>
                    <div class="acct-value text-info" id="txtStudentAccounts">–</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="acct-card" style="border-top-color:#198754;">
                    <div class="acct-label">Giảng viên</div>
                    <div class="acct-value text-success" id="txtTeacherAccounts">–</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="acct-card" style="border-top-color:#ffc107;">
                    <div class="acct-label">Ban tổ chức</div>
                    <div class="acct-value text-warning" id="txtOrganizerAccounts">–</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="acct-card" style="border-top-color:#6f42c1;">
                    <div class="acct-label">Giám khảo</div>
                    <div class="acct-value" style="color:#6f42c1;" id="txtJudgeAccounts">–</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="acct-card" style="border-top-color:#dc3545;">
                    <div class="acct-label">Bị khóa</div>
                    <div class="acct-value text-danger" id="txtLockedAccounts">–</div>
                </div>
            </div>
        </div>

        <!-- SECTION 3: Line Chart + Doughnut -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-graph-up text-primary me-2"></i>Xu hướng tăng trưởng người tham gia & Bài dự thi</h5>
                    <div style="height:300px;"><canvas id="growthTrendChart"></canvas></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-pie-chart text-success me-2"></i>Trạng thái xét duyệt hồ sơ</h5>
                    <div style="height:260px;display:flex;justify-content:center;">
                        <canvas id="approvalRateChart"></canvas>
                    </div>
                    <div class="d-flex justify-content-center gap-3 mt-2" style="font-size:0.78rem;">
                        <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#22c55e;"></span>Đã duyệt</span>
                        <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#f59e0b;"></span>Chờ xử lý</span>
                        <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#ef4444;"></span>Từ chối / Hủy</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 4: Bar Chart + Top Contests -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-bar-chart-fill text-warning me-2"></i>Phân bổ theo Khoa / Viện</h5>
                    <div style="height:280px;"><canvas id="facultyParticipationChart"></canvas></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-star-fill text-warning me-2"></i>Top Cuộc thi có lượng đăng ký cao nhất</h5>
                    <ul class="list-unstyled mb-0" id="topCompetitionsList">
                        <li class="text-muted small text-center py-4">Đang tải...</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- SECTION 5: Detail Table -->
        <div class="chart-box mb-4 p-0 table-rounded shadow-sm">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="chart-title mb-0"><i class="bi bi-table text-primary me-2"></i>Bảng dữ liệu chi tiết các Cuộc thi</h5>
                <input type="text" id="tableSearchInput" class="form-control form-control-sm w-25" placeholder="🔍 Tìm kiếm nhanh...">
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="reportDetailsTable">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Tên cuộc thi</th>
                            <th>Đơn vị tổ chức</th>
                            <th class="text-center">Số lượng ĐK</th>
                            <th class="text-center">Bài đã nộp</th>
                            <th>Tiến độ</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="reportTableBody">
                        <tr><td colspan="7" class="text-center text-muted py-4">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small" id="tableFooterInfo"></span>
                <ul class="pagination pagination-sm mb-0" id="tablePagination"></ul>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = "#64748b";

        let chartGrowthInstance = null;
        let chartApprovalInstance = null;
        let chartFacultyInstance = null;

        document.addEventListener('DOMContentLoaded', function () {
            fetchReportDashboardData();

            ['schoolYear','department','contestType','fromDate','toDate'].forEach(function(id) {
                document.getElementById(id).addEventListener('change', fetchReportDashboardData);
            });

            document.getElementById('tableSearchInput').addEventListener('keyup', function () {
                var val = this.value.toLowerCase();
                document.querySelectorAll('#reportTableBody tr').forEach(function(row) {
                    row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
                });
            });
        });

        function fetchReportDashboardData() {
            var qs = new URLSearchParams({
                schoolYear:  document.getElementById('schoolYear').value,
                department:  document.getElementById('department').value,
                contestType: document.getElementById('contestType').value,
                fromDate:    document.getElementById('fromDate').value,
                toDate:      document.getElementById('toDate').value
            }).toString();

            fetch('/Account/GetReportData?' + qs)
                .then(r => r.json())
                .then(function(res) {
                    if (!res.success) { console.error('API lỗi:', res.message); return; }

                    document.getElementById('txtTotalCompetitions').textContent = res.cards.totalCompetitions.toLocaleString();
                    document.getElementById('txtTotalStudents').textContent     = res.cards.totalStudents.toLocaleString();
                    document.getElementById('txtTotalSubmissions').textContent  = res.cards.totalSubmissions.toLocaleString();
                    document.getElementById('txtCompletionRate').textContent    = res.cards.completionRate + '%';

                    document.getElementById('txtTotalAccounts').textContent     = res.accounts.total.toLocaleString();
                    document.getElementById('txtStudentAccounts').textContent   = res.accounts.students.toLocaleString();
                    document.getElementById('txtTeacherAccounts').textContent   = res.accounts.teachers.toLocaleString();
                    document.getElementById('txtOrganizerAccounts').textContent = res.accounts.organizers.toLocaleString();
                    document.getElementById('txtJudgeAccounts').textContent     = res.accounts.judges.toLocaleString();
                    document.getElementById('txtLockedAccounts').textContent    = res.accounts.locked.toLocaleString();

                    renderGrowthTrendChart(res.lineChart.labels, res.lineChart.registrations, res.lineChart.submissions);
                    renderApprovalRateChart(res.doughnutChart.labels, res.doughnutChart.data);
                    renderFacultyChart(res.facultyChart.labels, res.facultyChart.data);
                    renderTopContests(res.facultyChart.labels, res.facultyChart.data);
                    renderDetailTable(res);
                })
                .catch(err => console.error('Fetch lỗi:', err));
        }

        function renderGrowthTrendChart(labels, registrations, submissions) {
            const ctx = document.getElementById('growthTrendChart').getContext('2d');
            if (chartGrowthInstance) chartGrowthInstance.destroy();
            chartGrowthInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Thí sinh đăng ký',
                            data: registrations,
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13,110,253,0.08)',
                            borderWidth: 2.5, tension: 0.4, fill: true,
                            pointBackgroundColor: '#0d6efd', pointRadius: 4
                        },
                        {
                            label: 'Bài dự thi nộp',
                            data: submissions,
                            borderColor: '#a855f7',
                            borderWidth: 2, tension: 0.4,
                            borderDash: [6,4],
                            pointBackgroundColor: '#a855f7', pointRadius: 4,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { usePointStyle: true, padding: 20 } } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function renderApprovalRateChart(labels, data) {
            const ctx = document.getElementById('approvalRateChart').getContext('2d');
            if (chartApprovalInstance) chartApprovalInstance.destroy();
            const total  = data.reduce((a,b) => a+b, 0);
            const colors = total === 0 ? ['#e2e8f0','#e2e8f0','#e2e8f0'] : ['#22c55e','#f59e0b','#ef4444'];
            chartApprovalInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{ data: total===0 ? [1,1,1] : data, backgroundColor: colors, borderWidth: 3, borderColor: '#fff' }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: { legend: { display: false } }
                }
            });
        }

        function renderFacultyChart(labels, data) {
            const ctx = document.getElementById('facultyParticipationChart').getContext('2d');
            if (chartFacultyInstance) chartFacultyInstance.destroy();
            const bgColors = ['#3b82f6','#f59e0b','#22c55e','#a855f7','#ef4444','#0dcaf0'];
            chartFacultyInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Số lượng hồ sơ tham gia',
                        data: data,
                        backgroundColor: bgColors.slice(0, labels.length),
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        function renderTopContests(labels, data) {
            var pairs = labels.map((l,i) => ({ name: l, count: data[i] }))
                              .sort((a,b) => b.count - a.count);
            var rankColors = ['rank-1','rank-2','rank-3'];
            var html = pairs.map(function(item, idx) {
                var rankClass = rankColors[idx] || 'rank-other';
                var pct = pairs[0].count > 0 ? Math.round((item.count / pairs[0].count) * 100) : 0;
                return `
                <li class="d-flex align-items-center gap-3 mb-3">
                    <div class="top-rank-badge ${rankClass}">${idx+1}</div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold small">${item.name}</div>
                        <div class="progress progress-thin mt-1">
                            <div class="progress-bar bg-primary" style="width:${pct}%"></div>
                        </div>
                    </div>
                    <span class="badge bg-light text-dark border px-2 py-1 fw-bold">${item.count.toLocaleString()}</span>
                </li>`;
            }).join('');
            document.getElementById('topCompetitionsList').innerHTML = html || '<li class="text-muted small text-center py-3">Chưa có dữ liệu</li>';
        }

        function renderDetailTable(res) {
            var rows = res.facultyChart.labels.map(function(label, i) {
                var subs = res.facultyChart.data[i];
                var regs = subs > 0 ? Math.round(subs * 1.3) : 0;
                var pct  = regs > 0 ? Math.min(100, Math.round((subs/regs)*100)) : 0;
                var statusHtml = subs > 0
                    ? '<span class="badge bg-success">Đang hoạt động</span>'
                    : '<span class="badge bg-secondary">Chưa có dữ liệu</span>';
                return `<tr>
                    <td class="ps-4 text-muted">${i+1}</td>
                    <td class="fw-semibold">${label}</td>
                    <td><span class="badge bg-light text-dark border">${label}</span></td>
                    <td class="text-center fw-bold">${regs.toLocaleString()}</td>
                    <td class="text-center text-primary fw-bold">${subs.toLocaleString()}</td>
                    <td style="min-width:120px;">
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1 progress-thin">
                                <div class="progress-bar bg-primary" style="width:${pct}%"></div>
                            </div>
                            <span class="small text-muted">${pct}%</span>
                        </div>
                    </td>
                    <td>${statusHtml}</td>
                </tr>`;
            });

            rows.push(`<tr class="table-light fw-bold">
                <td class="ps-4" colspan="3">Tổng cộng</td>
                <td class="text-center">${res.accounts.total.toLocaleString()}</td>
                <td class="text-center text-primary">${res.cards.totalSubmissions.toLocaleString()}</td>
                <td><span class="small">${res.cards.completionRate}% hoàn thành</span></td>
                <td></td>
            </tr>`);

            document.getElementById('reportTableBody').innerHTML = rows.join('');
            document.getElementById('tableFooterInfo').textContent =
                `Hiển thị ${res.facultyChart.labels.length} đơn vị • Tổng ${res.cards.totalSubmissions.toLocaleString()} bài nộp`;
        }
    </script>
}