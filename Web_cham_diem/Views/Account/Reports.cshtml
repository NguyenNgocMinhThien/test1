@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo cáo và Thống kê";
}

@section Styles {
    <style>
        .report-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        .filter-panel {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .kpi-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border-color);
            border-left: 5px solid var(--accent-blue);
            transition: transform 0.2s ease;
        }

            .kpi-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            }

        .kpi-title {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .kpi-value {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-top: 5px;
        }

        .chart-box {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.01);
        }

        .chart-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: var(--navy-blue);
        }

        .btn-export {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
        }

        .table-rounded {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }
    </style>
}

<div class="report-wrapper py-4">
    <div class="container-fluid">
        <!-- Header & Export Buttons -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Báo cáo & Phân tích Dữ liệu</h3>
                <p class="text-muted small mb-0">Theo dõi toàn diện các chỉ số và hiệu quả vận hành hệ thống</p>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                <button class="btn btn-outline-danger btn-export btn-sm"><i class="bi bi-file-earmark-pdf"></i> Xuất PDF</button>
                <button class="btn btn-outline-success btn-export btn-sm"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</button>
                <button class="btn btn-outline-secondary btn-export btn-sm"><i class="bi bi-filetype-csv"></i> Xuất CSV</button>
            </div>
        </div>

        <!-- 1. Filter Panel -->
        <div class="filter-panel shadow-sm">
            <form class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Năm học</label>
                    <select class="form-select form-select-sm">
                        <option>Tất cả</option>
                        <option selected>2025 - 2026</option>
                        <option>2024 - 2025</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Khoa / Đơn vị</label>
                    <select class="form-select form-select-sm">
                        <option selected>Toàn trường (Tất cả)</option>
                        <option>Công nghệ Thông tin</option>
                        <option>Kinh tế & Quản trị</option>
                        <option>Ngoại ngữ</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Loại cuộc thi</label>
                    <select class="form-select form-select-sm">
                        <option selected>Tất cả hình thức</option>
                        <option>Học thuật, NCKH</option>
                        <option>Sáng tạo, Kỹ năng</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Thời gian (Từ - Đến)</label>
                    <div class="input-group input-group-sm">
                        <input type="date" class="form-control">
                        <input type="date" class="form-control">
                    </div>
                </div>
            </form>
        </div>

        <!-- 2. Report Cards (KPIs) -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color: #0d6efd;">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-title">Tổng cuộc thi</div>
                            <div class="kpi-value">45</div>
                        </div>
                        <div class="text-primary fs-2"><i class="bi bi-trophy"></i></div>
                    </div>
                    <div class="small mt-2 text-success"><i class="bi bi-arrow-up-short"></i> +12% so với kỳ trước</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color: #f59e0b;">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-title">Tổng thí sinh</div>
                            <div class="kpi-value">2,850</div>
                        </div>
                        <div class="text-warning fs-2"><i class="bi bi-people"></i></div>
                    </div>
                    <div class="small mt-2 text-success"><i class="bi bi-arrow-up-short"></i> +25% so với kỳ trước</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color: #a855f7;">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-title">Bài dự thi đã nộp</div>
                            <div class="kpi-value">1,120</div>
                        </div>
                        <div class="text-purple fs-2" style="color: #a855f7;"><i class="bi bi-file-earmark-text"></i></div>
                    </div>
                    <div class="small mt-2 text-success"><i class="bi bi-arrow-up-short"></i> +8% so với kỳ trước</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="kpi-card" style="border-left-color: #22c55e;">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="kpi-title">Tỷ lệ hoàn thành</div>
                            <div class="kpi-value">84.5%</div>
                        </div>
                        <div class="text-success fs-2"><i class="bi bi-check2-circle"></i></div>
                    </div>
                    <div class="small mt-2 text-muted">Trung bình toàn hệ thống</div>
                </div>
            </div>
        </div>

        <!-- 3. Visual Charts -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-graph-up text-primary me-2"></i> Xu hướng tăng trưởng người tham gia & Bài dự thi</h5>
                    <div style="height: 300px;">
                        <canvas id="growthTrendChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-pie-chart text-success me-2"></i> Trạng thái xét duyệt hồ sơ</h5>
                    <div style="height: 300px; display: flex; justify-content: center;">
                        <canvas id="approvalRateChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-bar-chart-fill text-warning me-2"></i> Phân bổ theo Khoa / Viện</h5>
                    <div style="height: 300px;">
                        <canvas id="facultyParticipationChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <!-- Top Competitions List -->
                <div class="chart-box h-100">
                    <h5 class="chart-title"><i class="bi bi-star-fill text-warning me-2"></i> Top Cuộc thi có lượng đăng ký cao nhất</h5>
                    <ul class="list-group list-group-flush mt-3">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-0 mb-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="badge bg-primary rounded-circle p-2 px-3 fs-6">1</div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Hackathon Sinh viên 2026</h6>
                                    <small class="text-muted">Khoa Công nghệ Thông tin</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border px-3 py-2 fw-bold">850 thí sinh</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-0 mb-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="badge bg-secondary rounded-circle p-2 px-3 fs-6">2</div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Nghiên cứu Khoa học Trẻ</h6>
                                    <small class="text-muted">Phòng QLKH</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border px-3 py-2 fw-bold">420 thí sinh</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-0 mb-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="badge bg-secondary rounded-circle p-2 px-3 fs-6">3</div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Khởi nghiệp sáng tạo (Startup)</h6>
                                    <small class="text-muted">Khoa Kinh tế</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border px-3 py-2 fw-bold">380 thí sinh</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-0">
                            <div class="d-flex align-items-center gap-3">
                                <div class="badge bg-light text-muted rounded-circle p-2 px-3 fs-6 border">4</div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Olympic Tiếng Anh Toàn Trường</h6>
                                    <small class="text-muted">Khoa Ngoại ngữ</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border px-3 py-2 fw-bold">290 thí sinh</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- 4. Detailed Table -->
        <div class="chart-box mb-4 p-0 table-rounded shadow-sm">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="chart-title mb-0">Bảng dữ liệu chi tiết các Cuộc thi</h5>
                <input type="text" class="form-control form-control-sm w-25" placeholder="Tìm kiếm nhanh...">
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th class="ps-4">Tên cuộc thi</th>
                            <th>Đơn vị tổ chức</th>
                            <th>Loại hình</th>
                            <th class="text-center">Số lượng ĐK</th>
                            <th class="text-center">Bài đã nộp</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-4 fw-bold">Hackathon Sinh viên 2026</td>
                            <td>Khoa CNTT</td>
                            <td>Kỹ năng/IT</td>
                            <td class="text-center fw-bold">850</td>
                            <td class="text-center text-primary">760</td>
                            <td><span class="badge bg-success">Đã hoàn thành</span></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">Nghiên cứu Khoa học Trẻ</td>
                            <td>Phòng QLKH</td>
                            <td>Học thuật</td>
                            <td class="text-center fw-bold">420</td>
                            <td class="text-center text-primary">120</td>
                            <td><span class="badge bg-warning text-dark">Đang nộp bài</span></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">Khởi nghiệp sáng tạo</td>
                            <td>Khoa Kinh tế</td>
                            <td>Thực tế</td>
                            <td class="text-center fw-bold">380</td>
                            <td class="text-center text-primary">0</td>
                            <td><span class="badge bg-info text-dark">Đang mở đăng ký</span></td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">Olympic Tiếng Anh Toàn Trường</td>
                            <td>Khoa Ngoại ngữ</td>
                            <td>Học thuật</td>
                            <td class="text-center fw-bold">290</td>
                            <td class="text-center text-primary">290</td>
                            <td><span class="badge bg-success">Đã hoàn thành</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Phân trang -->
            <div class="p-3 border-top d-flex justify-content-end">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mặc định font và màu chart chung
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = "#64748b";

        // 1. Biểu đồ Đường (Xu hướng tăng trưởng)
        const ctxGrowth = document.getElementById('growthTrendChart').getContext('2d');
        new Chart(ctxGrowth, {
            type: 'line',
            data: {
                labels: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6'],
                datasets: [
                    {
                        label: 'Thí sinh đăng ký',
                        data: [150, 400, 300, 600, 850, 650],
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    },
                    {
                        label: 'Bài dự thi nộp',
                        data: [100, 250, 200, 450, 700, 500],
                        borderColor: '#a855f7',
                        borderWidth: 2,
                        tension: 0.4,
                        borderDash: [5, 5]
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: { y: { beginAtZero: true, grid: { borderDash: [2, 4] } } }
            }
        });

        // 2. Biểu đồ Tròn (Tỷ lệ xét duyệt hồ sơ)
        const ctxApproval = document.getElementById('approvalRateChart').getContext('2d');
        new Chart(ctxApproval, {
            type: 'doughnut',
            data: {
                labels: ['Đã duyệt', 'Chờ xử lý', 'Từ chối / Hủy'],
                datasets: [{
                    data: [65, 25, 10],
                    backgroundColor: ['#22c55e', '#f59e0b', '#ef4444'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // 3. Biểu đồ Cột ngang (Khoa tham gia)
        const ctxFaculty = document.getElementById('facultyParticipationChart').getContext('2d');
        new Chart(ctxFaculty, {
            type: 'bar',
            data: {
                labels: ['Khoa CNTT', 'Khoa Kinh tế', 'Phòng QLKH', 'Khoa Ngoại ngữ', 'Khoa Điện'],
                datasets: [{
                    label: 'Số lượng hồ sơ tham gia',
                    data: [850, 520, 420, 290, 180],
                    backgroundColor: '#3b82f6',
                    borderRadius: 5
                }]
            },
            options: {
                indexAxis: 'y', // Đổi biểu đồ dọc sang ngang
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { grid: { borderDash: [3, 3] } },
                    y: { grid: { display: false } }
                }
            }
        });
    </script>
}
