<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Organizer Portal</title>

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --primary-bg: #f0f2f5;
                --sidebar-color: #ffffff;
                --navy-blue: #003d7a;
                --accent-blue: #0d6efd;
                --organizer-accent: #059669; /* Đổi màu nhấn cho Ban tổ chức sang tông xanh lá đậm để phân biệt với Admin */
                --text-dark: #1e293b;
                --text-muted: #64748b;
                --border-color: #e2e8f0;
                --sidebar-width: 280px;
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--primary-bg);
                color: var(--text-dark);
                overflow-x: hidden;
            }

            /* --- SIDEBAR --- */
            .sidebar {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: var(--sidebar-color);
                border-right: 1px solid var(--border-color);
                z-index: 1030;
                transition: var(--transition);
            }

            .sidebar-header {
                padding: 1.5rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .nav-section-title {
                padding: 1.5rem 1.5rem 0.5rem;
                font-size: 0.7rem;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.8rem 1.5rem;
                color: var(--text-dark);
                font-weight: 500;
                transition: var(--transition);
                border-radius: 0 50px 50px 0;
                margin-right: 1rem;
            }

            .nav-link:hover, .nav-link.active {
                color: var(--organizer-accent);
                background: #ecfdf5; /* Nền xanh lá cực nhạt khi active */
            }

            .nav-link.active {
                border-left: 4px solid var(--organizer-accent);
                font-weight: 600;
            }

            .nav-link i {
                font-size: 1.2rem;
            }

            /* --- MAIN CONTENT & NAVBAR --- */
            .main-wrapper {
                margin-left: var(--sidebar-width);
                transition: var(--transition);
            }

            .navbar-top {
                height: 70px;
                background: #fff;
                border-bottom: 1px solid var(--border-color);
                padding: 0 2rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 1020;
            }

            .search-container {
                width: 400px;
                position: relative;
            }

            .search-container input {
                padding-left: 2.5rem;
                border-radius: 8px;
                background: #f8fafc;
                border: 1px solid var(--border-color);
            }

            .search-container i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
            }

            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
            }

            .bg-soft-organizer {
                background: #d1fae5;
                color: #059669;
            }

            @@media (max-width: 992px) {
                .sidebar { left: -var(--sidebar-width); }
                .main-wrapper { margin-left: 0; }
                .sidebar.mobile-show { left: 0; }
            }

            /* Render styles từ các trang con */
            @RenderSection("Styles", required: false)
    </style>
</head>
<body>

    <!-- SIDEBAR SECTION -->
    <aside class="sidebar d-flex flex-column">
        <div class="sidebar-header">
            <div class="stat-icon bg-soft-organizer"><i class="bi bi-diagram-3-fill"></i></div>
            <span class="fw-bold text-dark fs-5">ORGANIZER</span>
        </div>

        <div class="overflow-y-auto">
            <div class="nav-section-title">Tổng quan</div>

            <!-- 1. Dashboard -->
            <a href="/Organizer/Dashboard" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section-title">Hoạt động Cuộc thi</div>

            <!-- 2. Quản lý cuộc thi -->
            <a href="/Organizer/Contests" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contests" ? "active" : "")">
                <i class="bi bi-trophy"></i> Quản lý cuộc thi
            </a>

            <!-- 3. Quản lý đăng ký & bài dự thi -->
            <a href="/Organizer/Submissions" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Submissions" ? "active" : "")">
                <i class="bi bi-file-earmark-text"></i> Khảo thí & Bài dự thi
            </a>

            <!-- 4. Quản lý chấm điểm -->
            <a href="/Organizer/Grading" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Grading" ? "active" : "")">
                <i class="bi bi-ui-checks"></i> Quản lý chấm điểm
            </a>

            <div class="nav-section-title">Giám sát & Tương tác</div>

            <!-- 5. Kết quả & báo cáo -->
            <a href="/Organizer/Results" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Results" ? "active" : "")">
                <i class="bi bi-bar-chart-steps"></i> Kết quả & Báo cáo
            </a>

            <!-- 6. Thông báo cuộc thi -->
            <a href="/Organizer/Notifications" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Notifications" ? "active" : "")">
                <i class="bi bi-megaphone"></i> Thông báo cuộc thi
            </a>

       
        </div>

        <!-- Trạng thái / Support ở dưới cùng -->
        <div class="mt-auto p-4 border-top">
            <div class="bg-light p-3 rounded-4 small">
                <div class="fw-bold mb-1"><i class="bi bi-info-circle text-primary"></i> Hỗ trợ IT</div>
                <div class="text-muted" style="font-size: 0.75rem;">Nếu gặp lỗi hệ thống, vui lòng liên hệ Admin.</div>
                <button class="btn btn-sm btn-outline-secondary w-100 mt-2">Gửi Ticket hỗ trợ</button>
            </div>
        </div>
    </aside>

    <!-- MAIN WRAPPER SECTION -->
    <div class="main-wrapper">

        <!-- HEADER (NAVBAR) -->
        <nav class="navbar-top shadow-sm">
            <div class="search-container">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control border-0" placeholder="Tìm kiếm bài thi, sinh viên, giám khảo...">
            </div>

            <div class="d-flex align-items-center gap-4">
                <div class="dropdown">
                    <!-- Quick action cho BTC -->
                    <button class="btn border-0 rounded-pill px-3 shadow-sm btn-sm text-white" style="background-color: var(--organizer-accent);" data-bs-toggle="dropdown">
                        <i class="bi bi-plus-lg me-1"></i> Tạo nhanh
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 mt-2">
                        <li><a class="dropdown-item rounded-2" href="#"><i class="bi bi-trophy me-2"></i>Tạo cuộc thi mới</a></li>
                        <li><a class="dropdown-item rounded-2" href="#"><i class="bi bi-bell me-2"></i>Gửi thông báo</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item rounded-2" href="#"><i class="bi bi-person-plus me-2"></i>Thêm Giám khảo</a></li>
                    </ul>
                </div>

                <!-- Noti Icon -->
                <div class="position-relative" style="cursor:pointer;">
                    <i class="bi bi-bell fs-5 text-muted"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </div>

                <!-- User Profile -->
                <div class="d-flex align-items-center gap-3" style="cursor:pointer;" data-bs-toggle="dropdown">
                    <div class="text-end lh-1">
                        <div class="fw-bold small">Khoa CNTT (BTC)</div>
                        <span class="text-muted" style="font-size: 0.7rem;">Phân quyền: Ban Tổ Chức</span>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=BTC&background=059669&color=fff" class="rounded-circle shadow-sm" width="40">
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Cài đặt tài khoản</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                </ul>
            </div>
        </nav>

        <!-- CONTENT BODY RENDER -->
        <div class="p-4 p-md-5">
            @RenderBody()
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>