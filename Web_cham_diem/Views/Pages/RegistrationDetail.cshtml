@model Web_cham_diem.Models.Registrations
@using Web_cham_diem.Services

@{
    ViewData["Title"] = "Hồ sơ đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isLecturer    = ViewBag.IsLecturerView as bool? ?? false;
    var currentUserId = ViewBag.CurrentUserId  as int?  ?? 0;
    var tz = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
    var editHistory   = ViewBag.EditHistory as List<RegistrationHistoryItemDto> ?? new();

    var statusBadge = Model.Status switch
    {
        "Pending"  => ("bg-warning text-dark", "Chờ duyệt"),
        "Approved" => ("bg-success",            "Đã duyệt"),
        "Rejected" => ("bg-danger",             "Từ chối"),
        _          => ("bg-secondary",           Model.Status)
    };

    // Kiểm tra còn trong hạn đăng ký không
    var nowUtc = DateTime.UtcNow;
    var regDeadline = Model.RegistrationRound?.EndDate;
    var canEdit = !isLecturer
        && Model.UserId == currentUserId
        && (regDeadline.HasValue ? nowUtc <= regDeadline.Value : nowUtc < Model.Competition.StartDate);

    var files = (Model.SubmissionDocument ?? "")
        .Split(';', StringSplitOptions.RemoveEmptyEntries)
        .Select(f => f.Trim()).ToList();

    var teamMembers = Model.Team?.TeamMembers?.ToList() ?? new();
    var allTasks    = Model.Team?.TeamTasks?.ToList()   ?? new();

    // Student chỉ thấy task giao cho mình hoặc cho cả nhóm
    var myTasks = allTasks
        .Where(t => !t.AssignedTo.HasValue || t.AssignedTo == currentUserId)
        .ToList();
}

@section Styles {
<style>
    .info-card  { border:none; border-radius:1rem; box-shadow:0 3px 14px rgba(0,0,0,.07); }
    .task-panel { border:none; border-radius:1rem; box-shadow:0 3px 14px rgba(0,0,0,.07); position:sticky; top:80px; }

    .task-item {
        border:1px solid #e3eaf4;
        border-radius:.75rem;
        padding:14px 16px;
        margin-bottom:10px;
        background:#fafcff;
        transition: box-shadow .18s;
    }
    .task-item:hover { box-shadow:0 3px 10px rgba(0,0,0,.08); }
    .task-item.done  { background:#f0fff4; border-color:#a3d9b1; }
    .task-item.overdue { border-color:#f5c6cb; background:#fff8f8; }

    .member-pill {
        display:inline-flex; align-items:center; gap:6px;
        background:#eef2ff; border:1px solid #c7d5f5;
        border-radius:50px; padding:4px 12px; font-size:.82rem;
    }
    .member-avatar {
        width:26px; height:26px; border-radius:50%;
        background:linear-gradient(135deg,#0A4A91,#42A5F5);
        color:#fff; font-size:.72rem; font-weight:700;
        display:flex; align-items:center; justify-content:center; flex-shrink:0;
    }
    .section-heading {
        font-size:.72rem; font-weight:700; letter-spacing:.07em;
        text-transform:uppercase; color:#888; margin-bottom:12px;
    }
    .complete-form { display:none; margin-top:10px; }

    /* ── Timeline lịch sử ── */
    .history-timeline { position:relative; padding-left:28px; }
    .history-timeline::before {
        content:''; position:absolute; left:9px; top:0; bottom:0;
        width:2px; background:#dee2e6;
    }
    .history-item { position:relative; margin-bottom:18px; }
    .history-dot {
        position:absolute; left:-28px; top:3px;
        width:18px; height:18px; border-radius:50%;
        display:flex; align-items:center; justify-content:center;
        font-size:.65rem; color:#fff; flex-shrink:0;
    }
    .dot-edit     { background:#0d6efd; }
    .dot-approved { background:#198754; }
    .dot-rejected { background:#dc3545; }
    .dot-supplement { background:#fd7e14; }

    .toast-msg {
        position:fixed; bottom:24px; right:24px;
        padding:10px 20px; border-radius:8px;
        color:#fff; font-size:.88rem; z-index:9999;
        box-shadow:0 4px 14px rgba(0,0,0,.2);
        display:none;
    }
</style>
}

@Html.AntiForgeryToken()

<div id="toastMsg" class="toast-msg"></div>

<div class="container py-5">
    <div class="row g-4">

        <!-- ── LEFT: Thông tin hồ sơ ─────────────────────────────────── -->
        <div class="col-lg-7">
            <div class="info-card card p-4">

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <h4 class="fw-bold text-primary mb-0">Hồ sơ đăng ký</h4>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge @statusBadge.Item1 rounded-pill px-3 py-2 fs-6">
                            @statusBadge.Item2
                        </span>
                        @if (canEdit)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill"
                                    data-bs-toggle="modal" data-bs-target="#editRegModal">
                                <i class="bi bi-pencil-square me-1"></i>Sửa hồ sơ
                            </button>
                        }
                    </div>
                </div>

                @* Banner trạng thái chỉnh sửa *@
                @if (canEdit)
                {
                    <div class="alert alert-info d-flex align-items-center gap-2 py-2 px-3 mb-3"
                         style="border-radius:.75rem; font-size:.88rem;">
                        <i class="bi bi-pencil-fill flex-shrink-0"></i>
                        <div>
                            <strong>Bạn có thể chỉnh sửa hồ sơ.</strong>
                            @if (regDeadline.HasValue)
                            {
                                var tz2 = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
                                <span class="ms-1 text-muted">
                                    Hạn đăng ký: @TimeZoneInfo.ConvertTimeFromUtc(regDeadline.Value, tz2).ToString("dd/MM/yyyy HH:mm")
                                </span>
                            }
                        </div>
                    </div>
                }
                else if (!isLecturer && Model.UserId == currentUserId)
                {
                    <div class="alert alert-secondary d-flex align-items-center gap-2 py-2 px-3 mb-3"
                         style="border-radius:.75rem; font-size:.88rem;">
                        <i class="bi bi-lock-fill flex-shrink-0"></i>
                        <span>Đã hết hạn đăng ký. Hồ sơ không thể chỉnh sửa.</span>
                    </div>
                }

                @* Nút nộp sản phẩm — hiện khi cuộc thi đã bắt đầu *@
                @if (Model.Competition.StartDate <= DateTime.UtcNow)
                {
                    var deadlinePassed = DateTime.UtcNow > Model.Competition.SubmissionDeadline;
                    var approvedAndOpen = Model.Status == "Approved" && !deadlinePassed;

                    <div class="alert @(approvedAndOpen ? "alert-success" : "alert-secondary") d-flex align-items-center justify-content-between gap-3 py-2 px-3 mb-3"
                         style="border-radius:.75rem;">
                        <div class="small">
                            @if (deadlinePassed)
                            {
                                <i class="bi bi-calendar-x me-2"></i>
                                <strong>Đã hết hạn nộp bài</strong>
                                <span class="ms-1 text-muted">(@TimeZoneInfo.ConvertTimeFromUtc(Model.Competition.SubmissionDeadline, tz).ToString("dd/MM/yyyy HH:mm"))</span>
                            }
                            else if (Model.Status == "Approved")
                            {
                                <i class="bi bi-play-circle-fill me-2"></i>
                                <strong>Cuộc thi đã bắt đầu!</strong>
                                <span class="ms-1">Bạn có thể nộp sản phẩm ngay bây giờ.</span>
                            }
                            else
                            {
                                <i class="bi bi-hourglass-split me-2"></i>
                                <strong>Cuộc thi đã bắt đầu</strong>
                                <span class="ms-1">— Đăng ký cần được duyệt trước khi nộp bài.</span>
                            }
                        </div>
                        @if (!deadlinePassed)
                        {
                            <a href="/Competitions/@Model.Competition.CompetitionId/Submit"
                               class="btn btn-sm @(approvedAndOpen ? "btn-success" : "btn-outline-secondary disabled") rounded-pill flex-shrink-0"
                               style="white-space:nowrap;">
                                <i class="bi bi-upload me-1"></i>Nộp sản phẩm
                            </a>
                        }
                    </div>
                }

                <!-- Cuộc thi -->
                <div class="mb-4">
                    <p class="section-heading"><i class="bi bi-trophy me-1"></i>Thông tin cuộc thi</p>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="small text-muted">Tên cuộc thi</div>
                            <div class="fw-semibold">@Model.Competition.CompetitionName</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Lĩnh vực</div>
                            <div>@(Model.Competition.Category ?? "—")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Trạng thái cuộc thi</div>
                            <div>@Model.Competition.Status</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Hạn nộp bài</div>
                            <div>@TimeZoneInfo.ConvertTimeFromUtc(Model.Competition.SubmissionDeadline, tz).ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>

                <hr class="my-2" />

                <!-- Đăng ký -->
                <div class="mb-4">
                    <p class="section-heading"><i class="bi bi-person-lines-fill me-1"></i>Thông tin đăng ký</p>
                    @* Mã số dự thi / mã đội — hiện nổi bật ở đầu section *@
                    @if (!string.IsNullOrEmpty(Model.RegistrationCode) || !string.IsNullOrEmpty(Model.Team?.TeamCode))
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (!string.IsNullOrEmpty(Model.RegistrationCode))
                            {
                                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3"
                                     style="background:#eef2ff; border:1.5px solid #c7d5f5;">
                                    <i class="bi bi-person-badge-fill text-primary" style="font-size:1rem;"></i>
                                    <div>
                                        <div style="font-size:.68rem; color:#666; font-weight:600; text-transform:uppercase; letter-spacing:.05em;">Mã số dự thi</div>
                                        <div class="fw-bold text-primary" style="font-size:1.05rem; letter-spacing:.04em;" id="regCodeText">@Model.RegistrationCode</div>
                                    </div>
                                    <button type="button" class="btn btn-xs ms-1 p-1 text-muted"
                                            onclick="copyCode('regCodeText', this)" title="Sao chép mã">
                                        <i class="bi bi-clipboard" style="font-size:.85rem;"></i>
                                    </button>
                                </div>
                            }
                            @if (Model.Team != null && !string.IsNullOrEmpty(Model.Team.TeamCode))
                            {
                                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3"
                                     style="background:#fff3cd; border:1.5px solid #ffc107;">
                                    <i class="bi bi-people-fill text-warning" style="font-size:1rem;"></i>
                                    <div>
                                        <div style="font-size:.68rem; color:#666; font-weight:600; text-transform:uppercase; letter-spacing:.05em;">Mã đội thi</div>
                                        <div class="fw-bold text-warning" style="font-size:1.05rem; letter-spacing:.04em;" id="teamCodeText">@Model.Team.TeamCode</div>
                                    </div>
                                    <button type="button" class="btn btn-xs ms-1 p-1 text-muted"
                                            onclick="copyCode('teamCodeText', this)" title="Sao chép mã">
                                        <i class="bi bi-clipboard" style="font-size:.85rem;"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="small text-muted">Thí sinh chính</div>
                            <div class="fw-semibold">@Model.User.FullName</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">MSSV</div>
                            <div>@(Model.User.StudentId ?? "—")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Email</div>
                            <div>@Model.User.Email</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Hình thức</div>
                            <div>
                                @if (Model.RegistrationType == "Team")
                                { <span class="badge bg-info text-white"><i class="bi bi-people-fill me-1"></i>Đội nhóm</span> }
                                else
                                { <span class="badge bg-success text-white"><i class="bi bi-person-fill me-1"></i>Cá nhân</span> }
                            </div>
                        </div>
                        @if (Model.Team != null)
                        {
                            <div class="col-sm-6">
                                <div class="small text-muted">Tên nhóm</div>
                                <div class="fw-semibold">@Model.Team.TeamName</div>
                            </div>
                        }
                        @if (Model.Advisor != null)
                        {
                            <div class="col-sm-6">
                                <div class="small text-muted">Giảng viên hướng dẫn</div>
                                <div class="fw-semibold">@Model.Advisor.FullName</div>
                            </div>
                        }
                        @if (Model.RegistrationRound != null)
                        {
                            <div class="col-sm-6">
                                <div class="small text-muted">Đợt đăng ký</div>
                                <div>@Model.RegistrationRound.RoundName</div>
                            </div>
                        }
                        <div class="col-12">
                            <div class="small text-muted">Ngày đăng ký</div>
                            <div>@TimeZoneInfo.ConvertTimeFromUtc(Model.RegistrationDate, tz).ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="col-12">
                                <div class="small text-muted">Ghi chú</div>
                                <div style="white-space:pre-wrap; word-break:break-word;">@Model.Notes</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Thành viên nhóm -->
                @if (teamMembers.Any())
                {
                    <hr class="my-2" />
                    <div class="mb-4">
                        <p class="section-heading"><i class="bi bi-people me-1"></i>Thành viên nhóm</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tm in teamMembers)
                            {
                                var initial = string.Concat(tm.User.FullName.Split(' ')
                                    .Where(w => w.Length > 0).Select(w => w[0])).ToUpper();
                                <div class="member-pill">
                                    <div class="member-avatar">@initial</div>
                                    <div>
                                        <div style="font-weight:600;">@tm.User.FullName</div>
                                        <div class="text-muted" style="font-size:.75rem;">@(tm.User.StudentId ?? tm.User.Email) · @(tm.Role == "Leader" ? "Trưởng nhóm" : "Thành viên")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Files -->
                <hr class="my-2" />
                <div>
                    <p class="section-heading"><i class="bi bi-paperclip me-1"></i>Hồ sơ đính kèm</p>
                    @if (files.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @for (int fi = 0; fi < files.Count; fi++)
                            {
                                var file = files[fi];
                                var fileExt = System.IO.Path.GetExtension(file).TrimStart('.').ToUpper();
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span class="small">
                                        <i class="bi bi-file-earmark me-1 text-muted"></i>
                                        File đính kèm @(fi + 1)
                                        @if (!string.IsNullOrEmpty(fileExt))
                                        {
                                            <span class="badge bg-light text-dark border ms-1" style="font-size:.7rem;">@fileExt</span>
                                        }
                                    </span>
                                    <a href="@file" class="btn btn-sm btn-outline-primary" target="_blank">
                                        <i class="bi bi-eye me-1"></i>Xem
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted fst-italic small">Chưa có file đính kèm.</p>
                    }
                </div>

                @* ── Thông tin bổ sung (custom fields) ── *@
                @{
                    var compFormFields = ViewBag.CompetitionFormFields as List<Web_cham_diem.Models.ViewModels.FormFieldReadDto> ?? new();
                    var fieldValMap = Model.FieldValues.ToDictionary(v => v.FieldId, v => v);
                }
                @if (compFormFields.Any())
                {
                    <hr class="my-2" />
                    <div>
                        <p class="section-heading"><i class="bi bi-ui-checks me-1"></i>Thông tin bổ sung</p>
                        <div class="row g-2">
                            @foreach (var cf in compFormFields)
                            {
                                fieldValMap.TryGetValue(cf.FieldId, out var cfv);
                                <div class="col-sm-6">
                                    <div class="small text-muted">@cf.FieldLabel</div>
                                    @if (cfv == null || string.IsNullOrEmpty(cfv.Value))
                                    {
                                        <div class="text-muted fst-italic small">—</div>
                                    }
                                    else if (cf.FieldType == "File")
                                    {
                                        <a href="@cfv.Value" target="_blank" class="btn btn-sm btn-outline-primary mt-1">
                                            <i class="bi bi-file-earmark me-1"></i>@(cfv.FileName ?? System.IO.Path.GetFileName(cfv.Value))
                                        </a>
                                    }
                                    else if (cf.FieldType == "Checkbox")
                                    {
                                        @if (cfv.Value == "true")
                                        { <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Có</span> }
                                        else
                                        { <span class="badge bg-secondary">Không</span> }
                                    }
                                    else
                                    {
                                        <div class="fw-semibold" style="word-break:break-word;">@cfv.Value</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

        <!-- ── RIGHT: Task Panel ──────────────────────────────────────── -->
        <div class="col-lg-5">
            <div class="task-panel card p-4">

                @if (Model.Team == null)
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-people fs-1 d-block mb-2 opacity-40"></i>
                        <p class="small">Chức năng quản lý task chỉ áp dụng cho cuộc thi theo đội nhóm.</p>
                    </div>
                }
                else if (isLecturer)
                {
                    <!-- ══ LECTURER VIEW ════════════════════════════════════ -->
                    <h5 class="fw-bold mb-1"><i class="bi bi-list-task me-2 text-primary"></i>Quản lý Task nhóm</h5>
                    <p class="text-muted small mb-3">Phân công nhiệm vụ cho thành viên trong nhóm</p>

                    <!-- Form tạo task -->
                    <div class="p-3 mb-4" style="background:#f0f4ff; border:1.5px solid #c7d5f5; border-radius:.75rem;">
                        <p class="section-heading mb-2">Tạo task mới</p>

                        <div class="mb-2">
                            <input type="text" id="taskTitle" class="form-control form-control-sm" placeholder="Tiêu đề task *" maxlength="200">
                        </div>
                        <div class="mb-2">
                            <textarea id="taskDesc" class="form-control form-control-sm" rows="2"
                                      placeholder="Mô tả / ghi chú (tuỳ chọn)"></textarea>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-7">
                                <select id="taskAssignTo" class="form-select form-select-sm">
                                    <option value="">Giao cho cả nhóm</option>
                                    @foreach (var tm in teamMembers)
                                    {
                                        <option value="@tm.UserId">@tm.User.FullName (@(tm.Role == "Leader" ? "Trưởng nhóm" : "TV"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-5">
                                <input type="datetime-local" id="taskDueDate" class="form-control form-control-sm" title="Hạn hoàn thành (tuỳ chọn)">
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm w-100" onclick="createTask(@Model.Team.TeamId)">
                            <i class="bi bi-plus-circle me-1"></i>Tạo task
                        </button>
                        <div id="createTaskMsg" class="small mt-1"></div>
                    </div>

                    <!-- Danh sách task -->
                    <p class="section-heading">Danh sách task (@allTasks.Count)</p>
                    <div id="taskList">
                        @if (!allTasks.Any())
                        {
                            <div id="taskEmptyMsg" class="text-center text-muted py-3 small">
                                <i class="bi bi-inbox fs-3 d-block mb-1 opacity-40"></i>Chưa có task nào.
                            </div>
                        }
                        @foreach (var task in allTasks)
                        {
                            var isDone    = task.Status == "Completed";
                            var isOverdue = task.DueDate.HasValue && task.DueDate < DateTime.UtcNow && !isDone;
                            var doneClass = isDone ? "done" : (isOverdue ? "overdue" : "");
                            var completions = task.TaskCompletions?.ToList() ?? new();
                            var taskCreated = TimeZoneInfo.ConvertTimeFromUtc(task.CreatedAt, tz);
                            <div class="task-item @doneClass" id="lec-task-@task.TaskId">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold" style="font-size:.92rem;">@task.Title</div>
                                        @if (!string.IsNullOrEmpty(task.Description))
                                        {
                                            <div class="text-muted small mt-1">@task.Description</div>
                                        }
                                        <div class="mt-1 d-flex flex-wrap gap-2">
                                            <span class="badge @(isDone ? "bg-success" : isOverdue ? "bg-danger" : "bg-warning text-dark")" style="font-size:.7rem;">
                                                @(isDone ? "Hoàn thành" : isOverdue ? "Quá hạn" : "Chờ")
                                            </span>
                                            @if (task.AssignedToUser != null)
                                            {
                                                <span class="badge bg-light text-dark border" style="font-size:.7rem;">
                                                    <i class="bi bi-person me-1"></i>@task.AssignedToUser.FullName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border" style="font-size:.7rem;">
                                                    <i class="bi bi-people me-1"></i>Cả nhóm
                                                </span>
                                            }
                                            @if (task.DueDate.HasValue)
                                            {
                                                <span class="text-muted" style="font-size:.75rem;">
                                                    <i class="bi bi-alarm me-1"></i>@TimeZoneInfo.ConvertTimeFromUtc(task.DueDate.Value, tz).ToString("dd/MM HH:mm")
                                                </span>
                                            }
                                        </div>
                                        <div class="text-muted mt-1" style="font-size:.73rem;">
                                            Tạo lúc @taskCreated.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                        @if (completions.Any())
                                        {
                                            <div class="mt-2">
                                                @foreach (var c in completions)
                                                {
                                                    var cTime = TimeZoneInfo.ConvertTimeFromUtc(c.CompletedAt, tz);
                                                    <div class="small" style="color:#28a745;">
                                                        <i class="bi bi-check-circle-fill me-1"></i>
                                                        <strong>@c.CompletedByUser.FullName</strong> hoàn thành lúc @cTime.ToString("dd/MM HH:mm")
                                                        @if (!string.IsNullOrEmpty(c.Note))
                                                        {
                                                            <span class="text-muted ms-1">— @c.Note</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <button class="btn btn-xs btn-outline-danger btn-sm flex-shrink-0"
                                            onclick="deleteTask(@task.TaskId)" title="Xóa task">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- ══ STUDENT VIEW ════════════════════════════════════ -->
                    <h5 class="fw-bold mb-1"><i class="bi bi-check2-square me-2 text-success"></i>Nhiệm vụ của tôi</h5>
                    <p class="text-muted small mb-3">
                        Danh sách task giảng viên hướng dẫn đã giao cho bạn
                    </p>

                    @if (!myTasks.Any())
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-2 d-block mb-2 opacity-40"></i>
                            <p class="small">Chưa có task nào được giao cho bạn.</p>
                        </div>
                    }

                    <div id="studentTaskList">
                        @foreach (var task in myTasks)
                        {
                            var myCompletion = task.TaskCompletions?
                                .FirstOrDefault(tc => tc.CompletedBy == currentUserId);
                            var isDone    = myCompletion != null;
                            var isOverdue = task.DueDate.HasValue && task.DueDate < DateTime.UtcNow && !isDone;
                            var doneClass = isDone ? "done" : (isOverdue ? "overdue" : "");
                            var taskCreated = TimeZoneInfo.ConvertTimeFromUtc(task.CreatedAt, tz);

                            <div class="task-item @doneClass" id="stu-task-@task.TaskId">
                                <div class="fw-semibold mb-1" style="font-size:.92rem;">@task.Title</div>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <div class="text-muted small mb-1">@task.Description</div>
                                }
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                    <span class="badge @(isDone ? "bg-success" : isOverdue ? "bg-danger" : "bg-warning text-dark")" style="font-size:.7rem;">
                                        @(isDone ? "Đã hoàn thành" : isOverdue ? "Quá hạn" : "Chờ hoàn thành")
                                    </span>
                                    @if (task.AssignedToUser == null)
                                    {
                                        <span class="badge bg-info text-white" style="font-size:.7rem;">
                                            <i class="bi bi-people me-1"></i>Giao cả nhóm
                                        </span>
                                    }
                                    @if (task.DueDate.HasValue)
                                    {
                                        <span class="text-muted" style="font-size:.75rem;">
                                            <i class="bi bi-alarm me-1"></i>Hạn: @TimeZoneInfo.ConvertTimeFromUtc(task.DueDate.Value, tz).ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                </div>
                                <div class="text-muted mb-2" style="font-size:.73rem;">
                                    Giao bởi: @task.AssignedByUser.FullName · @taskCreated.ToString("dd/MM/yyyy HH:mm")
                                </div>

                                @if (isDone)
                                {
                                    var doneTime = TimeZoneInfo.ConvertTimeFromUtc(myCompletion!.CompletedAt, tz);
                                    <div class="p-2 rounded" style="background:#e8f5e9; font-size:.82rem;">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i>
                                        <strong>Bạn đã hoàn thành</strong> lúc @doneTime.ToString("dd/MM/yyyy HH:mm")
                                        @if (!string.IsNullOrEmpty(myCompletion.Note))
                                        {
                                            <div class="text-muted mt-1">Ghi chú: @myCompletion.Note</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-outline-success btn-sm"
                                            onclick="toggleCompleteForm(@task.TaskId)">
                                        <i class="bi bi-check2-circle me-1"></i>Đánh dấu hoàn thành
                                    </button>
                                    <div class="complete-form" id="cf-@task.TaskId">
                                        <textarea id="note-@task.TaskId" class="form-control form-control-sm mb-2"
                                                  rows="2" placeholder="Ghi chú (tuỳ chọn)..."></textarea>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-success btn-sm" onclick="completeTask(@task.TaskId)">
                                                <i class="bi bi-check-lg me-1"></i>Xác nhận
                                            </button>
                                            <button class="btn btn-outline-secondary btn-sm"
                                                    onclick="toggleCompleteForm(@task.TaskId)">Hủy</button>
                                        </div>
                                        <div id="completeMsg-@task.TaskId" class="small mt-1"></div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

            </div>
        </div>

    </div>

    <!-- ── LỊCH SỬ CHỈNH SỬA ───────────────────────────────────────── -->
    @if (editHistory.Any())
    {
        <div class="row g-4 mt-0">
            <div class="col-12">
                <div class="info-card card p-4">

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0">
                            <i class="bi bi-clock-history me-2 text-secondary"></i>Lịch sử thay đổi hồ sơ
                        </h6>
                        <span class="badge bg-secondary rounded-pill">@editHistory.Count lần</span>
                    </div>

                    <div class="history-timeline">
                        @foreach (var item in editHistory)
                        {
                            var (dotClass, icon, label) = item.ActionType switch
                            {
                                "StudentEdit"        => ("dot-edit",       "bi-pencil-fill",    "Thí sinh chỉnh sửa"),
                                "OrganizerApproved"  => ("dot-approved",   "bi-check-lg",       "Ban tổ chức duyệt"),
                                "OrganizerRejected"  => ("dot-rejected",   "bi-x-lg",           "Ban tổ chức từ chối"),
                                "OrganizerSupplement"=> ("dot-supplement", "bi-exclamation-lg", "Yêu cầu bổ sung"),
                                _                    => ("dot-edit",       "bi-activity",       item.ActionType)
                            };
                            var localTime = TimeZoneInfo.ConvertTimeFromUtc(item.EditedAt, tz);
                            <div class="history-item">
                                <div class="history-dot @dotClass">
                                    <i class="bi @icon"></i>
                                </div>
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-1">
                                    <div>
                                        <div class="fw-semibold" style="font-size:.88rem;">@label</div>
                                        @if (!string.IsNullOrEmpty(item.ChangesSummary))
                                        {
                                            <div class="text-muted small">@item.ChangesSummary</div>
                                        }
                                        @if (item.PreviousStatus != null && item.PreviousStatus != item.NewStatus)
                                        {
                                            <div class="small mt-1">
                                                <span class="badge bg-secondary" style="font-size:.68rem;">@item.PreviousStatus</span>
                                                <i class="bi bi-arrow-right mx-1 text-muted" style="font-size:.7rem;"></i>
                                                @{
                                                    var nbadge = item.NewStatus switch
                                                    {
                                                        "Approved" => "bg-success",
                                                        "Rejected" => "bg-danger",
                                                        _          => "bg-warning text-dark"
                                                    };
                                                }
                                                <span class="badge @nbadge" style="font-size:.68rem;">@item.NewStatus</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="text-end text-muted" style="font-size:.78rem; white-space:nowrap;">
                                        <div>@item.EditorName</div>
                                        <div>@localTime.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    }

    <!-- ── LỊCH SỬ GIAO TASK ─────────────────────────────────────────────── -->
    @{
        var taskHistory = isLecturer ? allTasks : myTasks;
    }
    @if (Model.Team != null && taskHistory.Any())
    {
        <div class="row g-4 mt-0">
            <div class="col-12">
                <div class="info-card card p-4">

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0">
                            <i class="bi bi-list-task me-2 text-primary"></i>
                            @(isLecturer ? "Lịch sử giao task (tất cả thành viên)" : "Lịch sử task được giao cho tôi")
                        </h6>
                        <div class="d-flex align-items-center gap-2">
                            @{
                                var doneCount    = taskHistory.Count(t => t.Status == "Completed");
                                var overdueCount = taskHistory.Count(t => t.DueDate.HasValue && t.DueDate < DateTime.UtcNow && t.Status != "Completed");
                            }
                            <span class="badge bg-success rounded-pill" title="Hoàn thành">@doneCount / @taskHistory.Count</span>
                            @if (overdueCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill" title="Quá hạn">@overdueCount quá hạn</span>
                            }
                        </div>
                    </div>

                    <div class="history-timeline">
                        @foreach (var task in taskHistory.OrderByDescending(t => t.CreatedAt))
                        {
                            var isDone    = task.Status == "Completed";
                            var isOverdue = task.DueDate.HasValue && task.DueDate < DateTime.UtcNow && !isDone;
                            var dotCls    = isDone ? "dot-approved" : isOverdue ? "dot-rejected" : "dot-edit";
                            var iconCls   = isDone ? "bi-check-lg"  : isOverdue ? "bi-alarm"     : "bi-list-task";
                            var createdLocal = TimeZoneInfo.ConvertTimeFromUtc(task.CreatedAt, tz);
                            var completions  = task.TaskCompletions?.ToList() ?? new();

                            <div class="history-item">
                                <div class="history-dot @dotCls">
                                    <i class="bi @iconCls"></i>
                                </div>
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-1">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold" style="font-size:.88rem;">@task.Title</div>
                                        @if (!string.IsNullOrEmpty(task.Description))
                                        {
                                            <div class="text-muted small">@task.Description</div>
                                        }
                                        <div class="d-flex flex-wrap gap-2 mt-1 align-items-center">
                                            <span class="badge @(isDone ? "bg-success" : isOverdue ? "bg-danger" : "bg-warning text-dark")" style="font-size:.68rem;">
                                                @(isDone ? "Hoàn thành" : isOverdue ? "Quá hạn" : "Đang chờ")
                                            </span>
                                            @if (task.AssignedToUser != null)
                                            {
                                                <span class="badge bg-light text-dark border" style="font-size:.68rem;">
                                                    <i class="bi bi-person me-1"></i>@task.AssignedToUser.FullName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border" style="font-size:.68rem;">
                                                    <i class="bi bi-people me-1"></i>Cả nhóm
                                                </span>
                                            }
                                            @if (task.DueDate.HasValue)
                                            {
                                                <span class="text-muted" style="font-size:.73rem;">
                                                    <i class="bi bi-alarm me-1"></i>Hạn: @TimeZoneInfo.ConvertTimeFromUtc(task.DueDate.Value, tz).ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            }
                                        </div>
                                        @if (completions.Any())
                                        {
                                            <div class="mt-2 ps-2 border-start border-success border-2">
                                                @foreach (var c in completions)
                                                {
                                                    var cTime = TimeZoneInfo.ConvertTimeFromUtc(c.CompletedAt, tz);
                                                    <div class="small" style="color:#198754;">
                                                        <i class="bi bi-check-circle-fill me-1"></i>
                                                        <strong>@c.CompletedByUser.FullName</strong> hoàn thành lúc @cTime.ToString("dd/MM/yyyy HH:mm")
                                                        @if (!string.IsNullOrEmpty(c.Note))
                                                        {
                                                            <span class="text-muted ms-1">— @c.Note</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="text-end text-muted" style="font-size:.78rem; white-space:nowrap;">
                                        <div>Giao bởi: @(task.AssignedByUser?.FullName ?? "—")</div>
                                        <div>@createdLocal.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@* ══ MODAL CHỈNH SỬA HỒ SƠ ══════════════════════════════════════════════ *@
@if (canEdit)
{
    <div class="modal fade" id="editRegModal" tabindex="-1" aria-labelledby="editRegModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editRegModalLabel">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>Chỉnh sửa hồ sơ đăng ký
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-2">
                    <div id="editRegAlert" class="d-none alert alert-danger py-2" style="border-radius:.5rem;"></div>

                    <form id="editRegForm" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()

                        @* ── Ghi chú ─────────────────────────────────────── *@
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                <i class="bi bi-chat-text me-1 text-muted"></i>Ghi chú / Giới thiệu đề tài
                            </label>
                            <textarea name="Notes" class="form-control" rows="4"
                                      maxlength="1000" placeholder="Mô tả ngắn về đề tài hoặc lý do tham gia...">@Model.Notes</textarea>
                            <div class="form-text text-end"><span id="notesCount">@(Model.Notes?.Length ?? 0)</span>/1000</div>
                        </div>

                        @* ── Giảng viên hướng dẫn (chỉ hiện khi không do GV đăng ký) *@
                        @if (Model.AdvisorId == null || (Model.Advisor != null && !isLecturer))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">
                                    <i class="bi bi-person-badge me-1 text-muted"></i>Giảng viên hướng dẫn
                                    <span class="text-muted fw-normal">(tuỳ chọn)</span>
                                </label>
                                <div class="input-group">
                                    <input type="text" id="editAdvisorInput" name="AdvisorStudentId"
                                           class="form-control" placeholder="Nhập MSSV / mã giảng viên"
                                           value="@Model.Advisor?.StudentId">
                                    <button type="button" class="btn btn-outline-secondary" id="lookupAdvisorBtn"
                                            onclick="lookupAdvisor()">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                <div id="advisorInfo" class="mt-1 small">
                                    @if (Model.Advisor != null)
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-check-circle me-1"></i>@Model.Advisor.FullName (@Model.Advisor.Email)
                                        </span>
                                    }
                                </div>
                                @if (Model.Advisor != null)
                                {
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox" id="clearAdvisor"
                                               onchange="toggleClearAdvisor(this)">
                                        <label class="form-check-label small text-danger" for="clearAdvisor">
                                            Xóa giảng viên hướng dẫn hiện tại
                                        </label>
                                    </div>
                                }
                            </div>
                        }

                        @* ── Tên nhóm (chỉ khi đăng ký nhóm) ─────────────── *@
                        @if (Model.RegistrationType == "Team" && Model.Team != null)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">
                                    <i class="bi bi-people me-1 text-muted"></i>Tên nhóm
                                </label>
                                <input type="text" name="TeamName" class="form-control"
                                       value="@Model.Team.TeamName" maxlength="200">
                            </div>
                        }

                        @* ── Trường biểu mẫu tùy chỉnh (render server-side) ── *@
                        @{
                            var editCompFields = ViewBag.CompetitionFormFields as List<Web_cham_diem.Models.ViewModels.FormFieldReadDto> ?? new();
                            var editFieldValMap = Model.FieldValues.ToDictionary(v => v.FieldId, v => v);
                        }
                        @if (editCompFields.Any())
                        {
                            <hr class="my-2" />
                            <div class="fw-semibold small text-muted mb-2">
                                <i class="bi bi-ui-checks me-1"></i>Thông tin bổ sung
                            </div>
                            @foreach (var ef in editCompFields)
                            {
                                editFieldValMap.TryGetValue(ef.FieldId, out var efv);
                                var efCurVal = efv?.Value ?? "";
                                <div class="mb-3"
                                     id="edit-df-wrapper-@ef.FieldId"
                                     data-df-id="@ef.FieldId"
                                     data-df-required="@ef.IsRequired.ToString().ToLower()"
                                     data-df-label="@ef.FieldLabel"
                                     data-df-type="@ef.FieldType">
                                    <label class="form-label fw-semibold small">
                                        @ef.FieldLabel
                                        @if (ef.IsRequired) { <span class="text-danger">*</span> }
                                    </label>
                                    @if (ef.FieldType == "Text")
                                    {
                                        <input type="text" name="df_@ef.FieldId" class="form-control form-control-sm"
                                               placeholder="@ef.Placeholder" value="@efCurVal" />
                                    }
                                    else if (ef.FieldType == "Textarea")
                                    {
                                        <textarea name="df_@ef.FieldId" class="form-control form-control-sm" rows="3"
                                                  placeholder="@ef.Placeholder">@efCurVal</textarea>
                                    }
                                    else if (ef.FieldType == "Email")
                                    {
                                        <input type="email" name="df_@ef.FieldId" class="form-control form-control-sm"
                                               placeholder="@ef.Placeholder" value="@efCurVal" />
                                    }
                                    else if (ef.FieldType == "Number")
                                    {
                                        <input type="number" name="df_@ef.FieldId" class="form-control form-control-sm"
                                               placeholder="@ef.Placeholder" value="@efCurVal" />
                                    }
                                    else if (ef.FieldType == "Date")
                                    {
                                        <input type="date" name="df_@ef.FieldId" class="form-control form-control-sm"
                                               value="@efCurVal" />
                                    }
                                    else if (ef.FieldType == "Select" && !string.IsNullOrEmpty(ef.Options))
                                    {
                                        var efOpts = System.Text.Json.JsonSerializer.Deserialize<List<string>>(ef.Options) ?? new();
                                        <select name="df_@ef.FieldId" class="form-select form-select-sm">
                                            <option value="">-- Chọn --</option>
                                            @foreach (var opt in efOpts)
                                            {
                                                <option value="@opt" @@(opt == efCurVal ? "selected" : "")>@opt</option>
                                            }
                                        </select>
                                    }
                                    else if (ef.FieldType == "Checkbox")
                                    {
                                        <div class="form-check">
                                            <input type="hidden" name="df_@ef.FieldId" value="false" />
                                            <input type="checkbox" name="df_@ef.FieldId" value="true"
                                                   class="form-check-input" id="edit_df_cb_@ef.FieldId"
                                                   @(efCurVal == "true" ? "checked" : "") />
                                            <label class="form-check-label small" for="edit_df_cb_@ef.FieldId">
                                                @(string.IsNullOrEmpty(ef.Placeholder) ? "Có" : ef.Placeholder)
                                            </label>
                                        </div>
                                    }
                                    else if (ef.FieldType == "File")
                                    {
                                        @if (!string.IsNullOrEmpty(efv?.Value))
                                        {
                                            <div class="d-flex align-items-center gap-2 p-2 rounded mb-1"
                                                 style="background:#f8f9fa;border:1px solid #e0e0e0;">
                                                <i class="bi bi-file-earmark text-muted"></i>
                                                <span class="small flex-grow-1">@(efv.FileName ?? System.IO.Path.GetFileName(efv.Value))</span>
                                                <a href="@efv.Value" target="_blank"
                                                   class="btn btn-outline-secondary btn-sm" style="padding:2px 8px;font-size:.75rem;">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </div>
                                            <div class="form-text text-muted">Để trống để giữ nguyên file cũ</div>
                                        }
                                        <input type="file" name="df_file_@ef.FieldId" class="form-control form-control-sm" />
                                    }
                                    <div class="invalid-feedback" id="edit-df-err-@ef.FieldId"></div>
                                    @if (!string.IsNullOrEmpty(ef.HelpText))
                                    {
                                        <div class="form-text text-muted">@ef.HelpText</div>
                                    }
                                </div>
                            }
                            <hr class="my-2" />
                        }

                        @* ── Hồ sơ đính kèm hiện tại ─────────────────────── *@
                        @if (files.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">
                                    <i class="bi bi-paperclip me-1 text-muted"></i>Hồ sơ đính kèm hiện tại
                                </label>
                                <div class="border rounded-3 p-2">
                                    @foreach (var file in files)
                                    {
                                        var fname = System.IO.Path.GetFileName(file);
                                        <div class="d-flex align-items-center justify-content-between py-1 px-2 rounded hover-bg mb-1"
                                             style="background:#f8f9fa;">
                                            <span class="small">
                                                <i class="bi bi-file-earmark me-1 text-muted"></i>@fname
                                            </span>
                                            <div class="d-flex align-items-center gap-2">
                                                <a href="@file" target="_blank" class="btn btn-xs btn-outline-secondary"
                                                   style="padding:2px 8px; font-size:.78rem;">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <div class="form-check mb-0">
                                                    <input class="form-check-input" type="checkbox"
                                                           name="RemoveFiles" value="@file"
                                                           id="rm-@fname.Replace(".", "-")"
                                                           title="Xóa file này">
                                                    <label class="form-check-label text-danger small"
                                                           for="rm-@fname.Replace(".", "-")">Xóa</label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* ── Thêm file mới ────────────────────────────────── *@
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">
                                <i class="bi bi-cloud-upload me-1 text-muted"></i>Thêm file mới
                                <span class="text-muted fw-normal">(PDF/DOC/DOCX/ZIP/RAR, tối đa 3 file)</span>
                            </label>
                            <div class="d-grid gap-2">
                                <input type="file" name="NewFile1" class="form-control form-control-sm"
                                       accept=".pdf,.doc,.docx,.zip,.rar">
                                <input type="file" name="NewFile2" class="form-control form-control-sm"
                                       accept=".pdf,.doc,.docx,.zip,.rar">
                                <input type="file" name="NewFile3" class="form-control form-control-sm"
                                       accept=".pdf,.doc,.docx,.zip,.rar">
                            </div>
                        </div>

                        @* Cảnh báo khi status Approved *@
                        @if (Model.Status == "Approved")
                        {
                            <div class="alert alert-warning py-2 small mb-0" style="border-radius:.5rem;">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Lưu ý: hồ sơ đã được duyệt. Sau khi chỉnh sửa, trạng thái sẽ được đặt lại về
                                <strong>Chờ duyệt</strong> để ban tổ chức xem xét lại.
                            </div>
                        }
                    </form>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4"
                            data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4"
                            id="saveEditBtn" onclick="submitEditForm()">
                        <i class="bi bi-floppy me-1"></i>Lưu thay đổi
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    const TEAM_ID = @(Model.Team?.TeamId.ToString() ?? "0");

    // Sao chép mã vào clipboard
    function copyCode(elementId, btn) {
        const text = document.getElementById(elementId)?.textContent?.trim();
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            const icon = btn.querySelector('i');
            icon.className = 'bi bi-clipboard-check text-success';
            setTimeout(() => { icon.className = 'bi bi-clipboard'; }, 1800);
        });
    }

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function showToast(msg, type) {
        const el = document.getElementById('toastMsg');
        el.textContent = msg;
        el.style.background = type === 'success' ? '#28a745' : '#dc3545';
        el.style.display = 'block';
        setTimeout(() => { el.style.display = 'none'; }, 3000);
    }

    // ── LECTURER: Create task ───────────────────────────────────────────────
    async function createTask(teamId) {
        const title      = document.getElementById('taskTitle').value.trim();
        const desc       = document.getElementById('taskDesc').value.trim();
        const assignToEl = document.getElementById('taskAssignTo');
        const dueDateEl  = document.getElementById('taskDueDate');
        const msgEl      = document.getElementById('createTaskMsg');

        if (!title) { msgEl.innerHTML = '<span class="text-danger">Vui lòng nhập tiêu đề task.</span>'; return; }

        const assignTo = assignToEl.value ? parseInt(assignToEl.value) : null;
        const dueDate  = dueDateEl.value  ? new Date(dueDateEl.value).toISOString() : null;

        msgEl.innerHTML = '<span class="text-secondary">Đang tạo...</span>';
        try {
            const res = await fetch(`/api/teams/${teamId}/tasks`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({ title, description: desc || null, assignedTo: assignTo, dueDate })
            });
            const data = await res.json();
            if (res.ok) {
                msgEl.innerHTML = '<span class="text-success">✓ Đã tạo task thành công!</span>';
                document.getElementById('taskTitle').value   = '';
                document.getElementById('taskDesc').value    = '';
                document.getElementById('taskDueDate').value = '';
                assignToEl.value = '';

                // Remove empty message
                const emptyMsg = document.getElementById('taskEmptyMsg');
                if (emptyMsg) emptyMsg.remove();

                // Append new task card
                appendTaskCard(data);
                setTimeout(() => { msgEl.innerHTML = ''; }, 3000);
            } else {
                msgEl.innerHTML = `<span class="text-danger">${data.message}</span>`;
            }
        } catch {
            msgEl.innerHTML = '<span class="text-danger">Lỗi kết nối.</span>';
        }
    }

    function appendTaskCard(task) {
        const list = document.getElementById('taskList');
        const now  = new Date().toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
        const assigneeHtml = task.assignedToName
            ? `<span class="badge bg-light text-dark border" style="font-size:.7rem;"><i class="bi bi-person me-1"></i>${task.assignedToName}</span>`
            : `<span class="badge bg-light text-dark border" style="font-size:.7rem;"><i class="bi bi-people me-1"></i>Cả nhóm</span>`;
        const dueDateHtml = task.dueDate
            ? `<span class="text-muted" style="font-size:.75rem;"><i class="bi bi-alarm me-1"></i>${new Date(task.dueDate).toLocaleString('vi-VN', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</span>`
            : '';

        const html = `
        <div class="task-item" id="lec-task-${task.taskId}">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="flex-grow-1">
                    <div class="fw-semibold" style="font-size:.92rem;">${task.title}</div>
                    ${task.description ? `<div class="text-muted small mt-1">${task.description}</div>` : ''}
                    <div class="mt-1 d-flex flex-wrap gap-2">
                        <span class="badge bg-warning text-dark" style="font-size:.7rem;">Chờ</span>
                        ${assigneeHtml}
                        ${dueDateHtml}
                    </div>
                    <div class="text-muted mt-1" style="font-size:.73rem;">Tạo lúc ${now}</div>
                </div>
                <button class="btn btn-xs btn-outline-danger btn-sm flex-shrink-0"
                        onclick="deleteTask(${task.taskId})" title="Xóa task">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>`;
        list.insertAdjacentHTML('afterbegin', html);
    }

    // ── LECTURER: Delete task ───────────────────────────────────────────────
    async function deleteTask(taskId) {
        if (!confirm('Xóa task này? Hành động không thể hoàn tác.')) return;
        try {
            const res = await fetch(`/api/tasks/${taskId}/delete`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() }
            });
            if (res.ok) {
                document.getElementById(`lec-task-${taskId}`)?.remove();
                showToast('Đã xóa task.', 'success');
            } else {
                const data = await res.json();
                showToast(data.message || 'Lỗi khi xóa.', 'error');
            }
        } catch {
            showToast('Lỗi kết nối.', 'error');
        }
    }

    // ── STUDENT: Toggle complete form ────────────────────────────────────────
    function toggleCompleteForm(taskId) {
        const form = document.getElementById(`cf-${taskId}`);
        form.style.display = form.style.display === 'none' || form.style.display === '' ? 'block' : 'none';
    }

    // ── EDIT REGISTRATION ────────────────────────────────────────────────────

    // Đếm ký tự ghi chú
    document.querySelector('[name="Notes"]')?.addEventListener('input', function () {
        document.getElementById('notesCount').textContent = this.value.length;
    });

    // Tra cứu giảng viên hướng dẫn
    async function lookupAdvisor() {
        const input = document.getElementById('editAdvisorInput');
        const infoEl = document.getElementById('advisorInfo');
        const val = input?.value?.trim();
        if (!val) { if (infoEl) infoEl.innerHTML = ''; return; }

        if (infoEl) infoEl.innerHTML = '<span class="text-secondary">Đang tra cứu...</span>';
        try {
            const res = await fetch(`/api/users/lookup?studentId=${encodeURIComponent(val)}&role=Lecturer`);
            const data = await res.json();
            if (res.ok && infoEl) {
                infoEl.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>${data.fullName} (${data.email})</span>`;
            } else if (infoEl) {
                infoEl.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>${data.message}</span>`;
            }
        } catch {
            if (infoEl) infoEl.innerHTML = '<span class="text-danger">Lỗi kết nối.</span>';
        }
    }

    // Bấm Enter trong ô tìm kiếm GV
    document.getElementById('editAdvisorInput')?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); lookupAdvisor(); }
    });

    // Checkbox xóa giảng viên
    function toggleClearAdvisor(cb) {
        const input = document.getElementById('editAdvisorInput');
        const infoEl = document.getElementById('advisorInfo');
        const btn = document.getElementById('lookupAdvisorBtn');
        if (!input) return;
        if (cb.checked) {
            input.value = '';
            input.disabled = true;
            if (btn) btn.disabled = true;
            if (infoEl) infoEl.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Sẽ xóa giảng viên hướng dẫn sau khi lưu.</span>';
        } else {
            input.disabled = false;
            if (btn) btn.disabled = false;
            if (infoEl) infoEl.innerHTML = '';
        }
    }

    // Gửi form chỉnh sửa hồ sơ
    async function submitEditForm() {
        const form = document.getElementById('editRegForm');
        const alertEl = document.getElementById('editRegAlert');
        const saveBtn = document.getElementById('saveEditBtn');
        if (!form) return;

        // Validate required dynamic fields
        let dfValid = true;
        form.querySelectorAll('[data-df-required="true"]').forEach(wrapper => {
            const fieldId   = wrapper.dataset.dfId;
            const fieldType = wrapper.dataset.dfType;
            const label     = wrapper.dataset.dfLabel;
            const errEl     = document.getElementById(`edit-df-err-${fieldId}`);
            wrapper.querySelectorAll('input:not([type=hidden]), textarea, select')
                   .forEach(el => el.classList.remove('is-invalid'));
            if (errEl) { errEl.style.display = 'none'; errEl.textContent = ''; }

            let empty = false;
            let targetEl = null;
            if (fieldType === 'File') {
                targetEl = wrapper.querySelector(`[name="df_file_${fieldId}"]`);
                // File bắt buộc chỉ cần check nếu chưa có file cũ (server xử lý)
                empty = targetEl && targetEl.files.length === 0 && !wrapper.querySelector('.bi-file-earmark');
            } else if (fieldType === 'Checkbox') {
                targetEl = wrapper.querySelector(`[name="df_${fieldId}"][type="checkbox"]`);
                empty = !targetEl || !targetEl.checked;
            } else {
                targetEl = wrapper.querySelector(`[name="df_${fieldId}"]`);
                empty = !targetEl || !targetEl.value.trim();
            }

            if (empty) {
                dfValid = false;
                if (targetEl) targetEl.classList.add('is-invalid');
                if (errEl) {
                    errEl.textContent = fieldType === 'Checkbox'
                        ? `Vui lòng xác nhận "${label}".`
                        : `"${label}" là trường bắt buộc.`;
                    errEl.style.display = 'block';
                }
            }
        });
        if (!dfValid) {
            const first = form.querySelector('.is-invalid');
            if (first) first.closest('[data-df-id]').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }

        alertEl.classList.add('d-none');
        alertEl.textContent = '';
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu...';

        const formData = new FormData(form);

        try {
            const res = await fetch('/Competitions/Registration/@Model.CompetitionId/Edit', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() },
                body: formData
            });
            const data = await res.json();

            if (res.ok) {
                // Đóng modal và hiển thị thông báo thành công
                bootstrap.Modal.getInstance(document.getElementById('editRegModal'))?.hide();
                showToast(data.message, 'success');
                // Reload sau 1.2s để cập nhật nội dung mới
                setTimeout(() => location.reload(), 1200);
            } else {
                alertEl.textContent = data.message || 'Có lỗi xảy ra.';
                alertEl.classList.remove('d-none');
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-floppy me-1"></i>Lưu thay đổi';
            }
        } catch {
            alertEl.textContent = 'Lỗi kết nối. Vui lòng thử lại.';
            alertEl.classList.remove('d-none');
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="bi bi-floppy me-1"></i>Lưu thay đổi';
        }
    }

    // ── STUDENT: Mark complete ───────────────────────────────────────────────
    async function completeTask(taskId) {
        const note  = document.getElementById(`note-${taskId}`).value.trim();
        const msgEl = document.getElementById(`completeMsg-${taskId}`);

        msgEl.innerHTML = '<span class="text-secondary">Đang lưu...</span>';
        try {
            const res = await fetch(`/api/tasks/${taskId}/complete`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({ note: note || null })
            });
            const data = await res.json();
            if (res.ok) {
                const card = document.getElementById(`stu-task-${taskId}`);
                card.classList.add('done');

                const doneTime = new Date(data.completedAt).toLocaleString('vi-VN', {
                    day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'
                });
                // Replace the button + form area with "done" indicator
                const completeArea = card.querySelector(`#cf-${taskId}`).parentElement;
                completeArea.innerHTML = `
                    <div class="p-2 rounded" style="background:#e8f5e9; font-size:.82rem; margin-top:6px;">
                        <i class="bi bi-check-circle-fill text-success me-1"></i>
                        <strong>Bạn đã hoàn thành</strong> lúc ${doneTime}
                        ${note ? `<div class="text-muted mt-1">Ghi chú: ${note}</div>` : ''}
                    </div>`;
                showToast('Đã xác nhận hoàn thành!', 'success');
            } else {
                msgEl.innerHTML = `<span class="text-danger">${data.message}</span>`;
            }
        } catch {
            msgEl.innerHTML = '<span class="text-danger">Lỗi kết nối.</span>';
        }
    }

    // ── Xóa lỗi khi người dùng nhập vào custom fields (edit modal) ─────────────
    function clearDfError(el) {
        el.classList.remove('is-invalid');
        const wrapper = el.closest('[data-df-id]');
        if (wrapper) {
            const errEl = document.getElementById(`edit-df-err-${wrapper.dataset.dfId}`);
            if (errEl) { errEl.style.display = 'none'; errEl.textContent = ''; }
        }
    }

    // Gắn event listener xóa lỗi cho custom fields trong edit modal (render server-side)
    document.querySelectorAll('#editRegForm [data-df-id]').forEach(wrapper => {
        wrapper.querySelectorAll('input:not([type=hidden]), textarea, select').forEach(el => {
            el.addEventListener('input', () => clearDfError(el));
            el.addEventListener('change', () => clearDfError(el));
        });
    });
</script>
}
