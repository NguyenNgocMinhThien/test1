@{
    ViewData["Title"] = "Danh Sách Cuộc Thi - Quản Lý Cuộc Thi Sinh Viên";
}

<div class="container py-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-2">
                <i class="bi bi-trophy-fill text-warning me-2"></i>Danh Sách Cuộc Thi
            </h1>
            <p class="text-secondary mb-0">Khám phá các cuộc thi hấp dẫn và đăng ký tham gia ngay</p>
        </div>
        <a href="/admin/competitions/create" class="btn btn-primary rounded-pill px-4 py-2" style="display: none;">
            <i class="bi bi-plus-circle me-2"></i>Tạo Cuộc Thi Mới
        </a>
    </div>

    <!-- Filter & Search Bar -->
    <div class="row mb-4 g-3">
        <div class="col-12 col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border">
                    <i class="bi bi-search text-secondary"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border" placeholder="Tìm kiếm cuộc thi...">
            </div>
        </div>
        <div class="col-12 col-md-3">
            <select id="statusFilter" class="form-select border">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Draft">Bản nháp</option>
                <option value="Active">Đang diễn ra</option>
                <option value="Closed">Đã đóng đăng ký</option>
                <option value="Completed">Hoàn thành</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <select id="categoryFilter" class="form-select border">
                <option value="">-- Tất cả lĩnh vực --</option>
                <option value="Technology">Công Nghệ</option>
                <option value="Science">Khoa Học</option>
                <option value="Business">Kinh Doanh</option>
                <option value="Innovation">Đổi Mới Sáng Tạo</option>
            </select>
        </div>
    </div>

    <!-- Competitions Grid -->
    <div id="competitionsContainer" class="row g-4">
        <!-- Placeholder Skeleton Loaders -->
        @for (int i = 0; i < 6; i++)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden placeholder-glow h-100">
                    <div class="placeholder" style="height: 200px;"></div>
                    <div class="card-body">
                        <h5 class="placeholder-wave"><span class="placeholder col-6"></span></h5>
                        <p class="placeholder-wave"><span class="placeholder col-12"></span></p>
                        <div class="placeholder-wave"><span class="placeholder col-8"></span></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- No Results Message -->
    <div id="noResultsMessage" class="alert alert-info text-center rounded-4 p-5" style="display: none;">
        <i class="bi bi-info-circle-fill fs-1 mb-3"></i>
        <h5 class="fw-bold">Không tìm thấy cuộc thi</h5>
        <p class="text-secondary mb-0">Vui lòng thử lại với từ khóa hoặc bộ lọc khác</p>
    </div>
</div>

<style>
    .competition-card {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
    }

        .competition-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.15) !important;
        }

    .competition-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        z-index: 10;
    }

    .competition-image {
        height: 200px;
        object-fit: cover;
        background: linear-gradient(135deg, #0d6efd 0%, #0a429b 100%);
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 0.75rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-active {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .status-draft {
        background-color: #e2e3e5;
        color: #383d41;
    }

    .status-closed {
        background-color: #f8d7da;
        color: #842029;
    }

    .status-completed {
        background-color: #cfe2ff;
        color: #084298;
    }

    .deadline-info {
        font-size: 0.875rem;
        color: #6c757d;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Fetch competitions data
        fetchCompetitions();

        // Event listeners
        document.getElementById('searchInput').addEventListener('keyup', filterCompetitions);
        document.getElementById('statusFilter').addEventListener('change', filterCompetitions);
        document.getElementById('categoryFilter').addEventListener('change', filterCompetitions);
    });

    async function fetchCompetitions() {
        try {
            const response = await fetch('/api/competitions');
            if (!response.ok) throw new Error('Failed to fetch competitions');

            const competitions = await response.json();
            renderCompetitions(competitions);
        } catch (error) {
            console.error('Error:', error);
            document.getElementById('competitionsContainer').innerHTML =
                '<div class="alert alert-danger col-12">Lỗi tải dữ liệu cuộc thi</div>';
        }
    }

        function renderCompetitions(competitions) {
        const container = document.getElementById('competitionsContainer');
        const noResults = document.getElementById('noResultsMessage');

        if (!competitions || competitions.length === 0) {
            container.innerHTML = '';
            noResults.style.display = 'block';
            return;
        }

        noResults.style.display = 'none';
        container.innerHTML = competitions.map(comp => {
            const name = comp.competitionName || 'Chưa cập nhật';
            const description = comp.description || 'Không có mô tả';
            const category = comp.category || 'Chưa cập nhật';
            const status = comp.status || 'Draft';
            const prize = comp.prize || 'Chưa cập nhật';
            const maxParticipants = Number.isFinite(comp.maxParticipants) ? comp.maxParticipants : 0;
            const maxTeamSize = Number.isFinite(comp.maxTeamSize) ? comp.maxTeamSize : 0;
            const maxScore = Number.isFinite(comp.maxScore) ? comp.maxScore : 0;

            return `
                <div class="col-12 col-md-6 col-lg-4" data-competition-id="${comp.competitionId}">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden competition-card h-100">
                        <div class="position-relative">
                            <div class="competition-image d-flex align-items-center justify-content-center">
                                <i class="bi bi-trophy-fill text-white" style="font-size: 4rem; opacity: 0.3;"></i>
                            </div>
                            <span class="competition-badge">
                                <span class="status-badge status-${status.toLowerCase()}">
                                    ${getStatusLabel(status)}
                                </span>
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-2 text-truncate" data-comp-name="${name}">
                                ${name}
                            </h5>

                            <p class="card-text text-secondary small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                ${description}
                            </p>

                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-light text-dark text-uppercase fw-6" style="font-size: 0.75rem;" data-comp-category="${category}">
                                        ${category}
                                    </span>
                                    ${comp.isTeamBased
                                        ? '<span class="badge bg-info ms-2 text-white"><i class="bi bi-people-fill me-1"></i>Thi theo nhóm</span>'
                                        : '<span class="badge bg-success ms-2 text-white"><i class="bi bi-person-fill me-1"></i>Thi cá nhân</span>'
                                    }
                                </div>
                                <small class="text-secondary">
                                    <i class="bi bi-people me-1"></i>
                                    Tối đa: ${maxParticipants}
                                    ${comp.isTeamBased ? ` / Kích thước đội: ${maxTeamSize}` : ''}
                                </small>
                            </div>

                            <div class="border-top pt-3 mb-3">
                                <div class="deadline-info mb-2">
                                    <i class="bi bi-calendar-event text-danger me-1"></i>
                                    <strong>Bắt đầu:</strong> ${formatDate(comp.startDate)}
                                </div>
                                <div class="deadline-info mb-2">
                                    <i class="bi bi-calendar-check text-primary me-1"></i>
                                    <strong>Kết thúc:</strong> ${formatDate(comp.endDate)}
                                </div>
                                <div class="deadline-info">
                                    <i class="bi bi-clock-history text-warning me-1"></i>
                                    <strong>Đăng ký trước:</strong> ${formatDate(comp.registrationDeadline)}
                                </div>
                            </div>

                            <div class="alert alert-light mb-3 py-2 px-3">
                                <small>
                                    <strong>Giải thưởng:</strong> ${prize}<br>
                                    <strong>Điểm tối đa:</strong> ${maxScore}
                                </small>
                            </div>

                            <div class="d-grid gap-2 mt-auto">
                                <a href="/Competitions/${comp.competitionId}" class="btn btn-primary btn-sm rounded-pill py-2">
                                    <i class="bi bi-eye me-1"></i>Xem Chi Tiết
                                </a>
                                <a href="/Competitions/Register/${comp.competitionId}" class="btn btn-outline-warning btn-sm rounded-pill py-2">
                                    <i class="bi bi-pencil-square me-1"></i>Đăng Ký Tham Gia
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    function filterCompetitions() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const status = document.getElementById('statusFilter').value;
        const category = document.getElementById('categoryFilter').value;

        const cards = document.querySelectorAll('[data-competition-id]');
        let visibleCount = 0;

        cards.forEach(card => {
            const name = card.querySelector('[data-comp-name]')?.textContent.toLowerCase() || '';
            const compStatus = card.querySelector('[data-comp-status]')?.textContent || '';
            const compCategory = card.querySelector('[data-comp-category]')?.textContent || '';

            const matchSearch = name.includes(search);
            const matchStatus = !status || compStatus === status;
            const matchCategory = !category || compCategory === category;

            if (matchSearch && matchStatus && matchCategory) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('noResultsMessage').style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function getStatusLabel(status) {
        const labels = {
            'Draft': 'Bản Nháp',
            'Active': 'Đang Diễn Ra',
            'Closed': 'Đã Đóng',
            'Completed': 'Hoàn Thành'
        };
        return labels[status] || status;
    }

        function formatDate(dateString) {
        if (!dateString) return 'Chưa cập nhật';
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return 'Chưa cập nhật';

        return date.toLocaleDateString('vi-VN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
    }
</script>