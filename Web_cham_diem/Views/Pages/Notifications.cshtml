@model List<Web_cham_diem.Models.ViewModels.PublicAnnouncementDto>
@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var search      = ViewBag.Search as string;
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages  = (int)(ViewBag.TotalPages ?? 1);
    var total       = (int)(ViewBag.Total ?? 0);
}

<style>
    .notif-page-wrap { background: #f0f4fa; min-height: 70vh; }

    .notif-breadcrumb { font-size: 13px; color: #6c757d; padding: 14px 0 6px; }
    .notif-breadcrumb a { color: #6c757d; text-decoration: none; }
    .notif-breadcrumb a:hover { color: #dc3545; }

    .notif-search-wrap { position: relative; width: 280px; }
    .notif-search-wrap .bi-search {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        color: #9ca3af; font-size: 14px;
    }
    .notif-search-wrap input {
        padding-left: 36px; border-radius: 30px;
        border: 1px solid #dee2e6; background: #fff;
        font-size: 13px; height: 38px; width: 100%;
    }
    .notif-search-wrap input:focus {
        outline: none; border-color: #dc3545;
        box-shadow: 0 0 0 3px rgba(220,53,69,0.1);
    }

    .notif-item-card {
        background: #fff; border-radius: 14px; overflow: hidden;
        display: flex; align-items: stretch;
        border: 1px solid #eef0f4;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
        text-decoration: none; color: inherit;
    }
    .notif-item-card:hover {
        box-shadow: 0 6px 24px rgba(0,0,0,0.10);
        transform: translateY(-2px);
        text-decoration: none; color: inherit;
    }

    .notif-thumb {
        width: 220px; min-width: 220px; height: 130px;
        overflow: hidden; flex-shrink: 0; position: relative;
        background: linear-gradient(135deg,#1a3559 0%,#2563eb 100%);
    }
    .notif-thumb img { width:100%;height:100%;object-fit:cover;transition:transform .4s ease; }
    .notif-item-card:hover .notif-thumb img { transform: scale(1.06); }
    .notif-thumb-placeholder {
        width:100%;height:100%;display:flex;align-items:center;
        justify-content:center;font-size:2.2rem;color:rgba(255,255,255,0.4);
    }
    .notif-type-ribbon {
        position:absolute;top:0;left:0;width:5px;height:100%;
    }
    .type-info    { background:#2563eb; }
    .type-success { background:#16a34a; }
    .type-warning { background:#d97706; }
    .type-error   { background:#dc2626; }

    .notif-info { padding:18px 22px;display:flex;flex-direction:column;justify-content:center;flex:1;gap:6px; }
    .notif-info-title {
        font-size:15.5px;font-weight:700;color:#1a1a2e;line-height:1.35;
        display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
    }
    .notif-item-card:hover .notif-info-title { color:#dc3545; }
    .notif-info-meta { display:flex;align-items:center;gap:14px;font-size:12.5px;color:#6c757d;flex-wrap:wrap; }
    .notif-info-excerpt {
        font-size:13px;color:#6c757d;
        display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.5;
    }

    .notif-pagination .page-link {
        border-radius:8px!important;margin:0 2px;border:1px solid #dee2e6;
        color:#333;font-size:13px;padding:5px 12px;
    }
    .notif-pagination .page-item.active .page-link { background:#dc3545;border-color:#dc3545;color:#fff; }
    .notif-pagination .page-link:hover { background:#fff5f5;color:#dc3545; }

    @@media (max-width:576px) {
        .notif-thumb { width:110px;min-width:110px;height:100px; }
        .notif-info  { padding:12px 14px; }
        .notif-info-title { font-size:13.5px; }
        .notif-search-wrap { width:100%; }
    }
</style>

<div class="notif-page-wrap py-2">
    <div class="container">

        <!-- Breadcrumb + Search -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <nav class="notif-breadcrumb">
                <a href="/"><i class="bi bi-house-door me-1"></i>Trang chủ</a>
                <span class="mx-1">/</span>
                <span class="text-dark fw-semibold">Thông báo</span>
            </nav>
            <form method="get" action="/Notifications" class="notif-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@search" placeholder="Tìm kiếm thông báo...">
            </form>
        </div>

        <h4 class="fw-bold text-center mb-4" style="color:#1a1a2e;">
            Thông báo mới nhất
        </h4>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-megaphone fs-1 d-block mb-3 opacity-50"></i>
                <h6 class="fw-semibold">Chưa có thông báo nào</h6>
                @if (!string.IsNullOrEmpty(search))
                {
                    <p class="small">Không tìm thấy kết quả cho "<strong>@search</strong>"</p>
                    <a href="/Notifications" class="btn btn-sm btn-outline-danger rounded-pill mt-2">Xem tất cả</a>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var item in Model)
                {
                    var typeClass = item.Type switch {
                        "Success" => "type-success",
                        "Warning" => "type-warning",
                        "Error"   => "type-error",
                        _         => "type-info"
                    };
                    <a href="/Notifications/@item.AnnouncementId" class="notif-item-card">
                        <div class="notif-thumb">
                            <div class="notif-type-ribbon @typeClass"></div>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title">
                            }
                            else
                            {
                                <div class="notif-thumb-placeholder">
                                    <i class="bi bi-megaphone-fill"></i>
                                </div>
                            }
                        </div>
                        <div class="notif-info">
                            <div class="notif-info-title">@item.Title</div>
                            <div class="notif-info-meta">
                                <span><i class="bi bi-calendar3 me-1 text-danger"></i>
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </span>
                                @if (!string.IsNullOrEmpty(item.AttachmentUrl))
                                {
                                    <span class="text-primary"><i class="bi bi-paperclip me-1"></i>File đính kèm</span>
                                }
                            </div>
                            <div class="notif-info-excerpt">@item.Content</div>
                        </div>
                    </a>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-2">
                    <ul class="pagination notif-pagination gap-1 flex-wrap">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Notifications?page=@(currentPage-1)@(!string.IsNullOrEmpty(search) ? $"&search={Uri.EscapeDataString(search)}" : "")">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        }
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="/Notifications?page=@p@(!string.IsNullOrEmpty(search) ? $"&search={Uri.EscapeDataString(search)}" : "")">@p</a>
                            </li>
                        }
                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/Notifications?page=@(currentPage+1)@(!string.IsNullOrEmpty(search) ? $"&search={Uri.EscapeDataString(search)}" : "")">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }

    </div>
</div>
