@model Web_cham_diem.Models.ViewModels.PublicAnnouncementDto
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var typeBadge = Model.Type switch {
        "Success" => ("bg-success", "bi-check-circle-fill"),
        "Warning" => ("bg-warning text-dark", "bi-exclamation-triangle-fill"),
        "Error"   => ("bg-danger",  "bi-x-circle-fill"),
        _         => ("bg-primary", "bi-info-circle-fill")
    };
}

<style>
    .ann-hero {
        background: linear-gradient(135deg,#1a3559 0%,#2563eb 100%);
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        min-height: 260px;
        display: flex;
        align-items: flex-end;
    }
    .ann-hero-img {
        position:absolute;inset:0;width:100%;height:100%;
        object-fit:cover;opacity:.55;
    }
    .ann-hero-overlay {
        position:absolute;inset:0;
        background: linear-gradient(180deg,transparent 30%,rgba(0,0,0,0.7) 100%);
    }
    .ann-hero-content { position:relative;z-index:1;padding:28px 32px; }

    .ann-body { max-width: 820px; margin: 0 auto; }
    .ann-content-box {
        background: #fff;
        border-radius: 14px;
        padding: 32px 36px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        font-size: 15px;
        line-height: 1.8;
        color: #333;
        white-space: pre-wrap;
    }
    .ann-attach-box {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #333;
        transition: background .2s;
    }
    .ann-attach-box:hover { background: #e9ecef; color: #333; }
    .ann-attach-icon { font-size: 1.8rem; color: #dc3545; flex-shrink: 0; }

    .breadcrumb-link { font-size:13px;color:#6c757d;text-decoration:none; }
    .breadcrumb-link:hover { color:#dc3545; }
</style>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav class="mb-3" style="font-size:13px;color:#6c757d;">
        <a href="/" class="breadcrumb-link"><i class="bi bi-house-door me-1"></i>Trang chủ</a>
        <span class="mx-1">/</span>
        <a href="/Notifications" class="breadcrumb-link">Thông báo</a>
        <span class="mx-1">/</span>
        <span class="text-dark fw-semibold" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;vertical-align:bottom;">
            @Model.Title
        </span>
    </nav>

    <div class="ann-body">
        <!-- Hero banner -->
        <div class="ann-hero mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" class="ann-hero-img">
                <div class="ann-hero-overlay"></div>
            }
            <div class="ann-hero-content w-100">
                <span class="badge @typeBadge.Item1 mb-2" style="font-size:12px;">
                    <i class="bi @typeBadge.Item2 me-1"></i>
                    @(Model.Type switch { "Success"=>"Thành công","Warning"=>"Cảnh báo","Error"=>"Khẩn cấp",_=>"Thông tin" })
                </span>
                <h2 class="text-white fw-bold mb-2" style="font-size:clamp(1.2rem,3vw,1.7rem);line-height:1.3;">
                    @Model.Title
                </h2>
                <div class="d-flex gap-3 flex-wrap" style="font-size:13px;color:rgba(255,255,255,0.80);">
                    <span><i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    @if (!string.IsNullOrEmpty(Model.CreatedByName))
                    {
                        <span><i class="bi bi-person me-1"></i>@Model.CreatedByName</span>
                    }
                    <span><i class="bi bi-clock me-1"></i>@Model.TimeAgo</span>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="ann-content-box mb-4">@Model.Content</div>

        <!-- Attachment -->
        @if (!string.IsNullOrEmpty(Model.AttachmentUrl))
        {
            var ext = System.IO.Path.GetExtension(Model.AttachmentFileName ?? "").ToLower();
            var fileIcon = ext switch {
                ".pdf"            => "bi-file-earmark-pdf-fill",
                ".doc" or ".docx" => "bi-file-earmark-word-fill",
                ".xls" or ".xlsx" => "bi-file-earmark-excel-fill",
                _                 => "bi-file-earmark-fill"
            };
            bool isPdf = ext == ".pdf";

            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                    <div class="fw-semibold" style="font-size:14px;">
                        <i class="bi bi-paperclip me-1 text-danger"></i>File đính kèm
                    </div>
                    <a href="@Model.AttachmentUrl" download class="btn btn-sm btn-outline-danger rounded-pill px-3" style="font-size:12px;">
                        <i class="bi bi-download me-1"></i>Tải xuống
                    </a>
                </div>

                @if (isPdf)
                {
                    <!-- PDF inline viewer -->
                    <div style="border:1px solid #dee2e6;border-radius:10px;overflow:hidden;">
                        <iframe src="@Model.AttachmentUrl"
                                width="100%" height="680"
                                style="display:block;border:none;"
                                title="@(Model.AttachmentFileName ?? "Tài liệu")">
                            <p class="p-3 text-muted small">
                                Trình duyệt không hỗ trợ xem PDF trực tiếp.
                                <a href="@Model.AttachmentUrl" class="text-danger">Nhấn để tải xuống</a>.
                            </p>
                        </iframe>
                    </div>
                }
                else
                {
                    <!-- Word/Excel — download card -->
                    <a href="@Model.AttachmentUrl" download class="ann-attach-box">
                        <i class="bi @fileIcon ann-attach-icon"></i>
                        <div>
                            <div class="fw-semibold" style="font-size:14px;">@(Model.AttachmentFileName ?? "Tải xuống")</div>
                            <div class="text-muted" style="font-size:12px;">Nhấn để tải xuống tệp</div>
                        </div>
                        <i class="bi bi-download ms-auto text-secondary"></i>
                    </a>
                }
            </div>
        }

        <!-- Back button -->
        <div class="d-flex justify-content-center mt-2">
            <a href="/Notifications" class="btn btn-outline-danger rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>
    </div>
</div>
