@{
    ViewData["Title"] = "Danh sách Cuộc thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card border-0 shadow-sm p-4">
    <h3 class="fw-bold text-dark mb-3"><i class="bi bi-trophy text-danger me-2"></i>Các Cuộc Thi Đang Mở Đăng Ký</h3>
    <div class="row g-4 mt-1">
        <div class="col-12 col-md-6">
            <div class="p-3 border rounded-3 bg-light">
                <h5 class="fw-bold text-dark">Nghiên cứu khoa học cấp Trường 2026</h5>
                <p class="small text-muted">Dành cho mọi khối ngành, tập trung vào giải pháp thực tiễn.</p>
                <button class="btn btn-sm btn-danger rounded-pill px-3">Đăng ký tham gia</button>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="p-3 border rounded-3 bg-light">
                <h5 class="fw-bold text-dark">Sáng tạo Khởi nghiệp Công nghệ</h5>
                <p class="small text-muted">Sân chơi phát triển mô hình kinh doanh trên nền tảng số.</p>
                <button class="btn btn-sm btn-danger rounded-pill px-3">Đăng ký tham gia</button>
            </div>
        </div>
    </div>
</div>