@{
    ViewData["Title"] = "Nộp bài dự thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row g-4">
    <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm p-4">
            <h4 class="fw-bold text-success mb-3"><i class="bi bi-cloud-upload me-2"></i>Nộp Bài Giải</h4>
            <form>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Chọn Cuộc Thi</label>
                    <select class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Đính kèm file báo cáo (.zip, .pdf)</label>
                    <input type="file" class="form-control" />
                </div>
                <button type="submit" class="btn btn-success w-100 rounded-pill">Gửi sản phẩm</button>
            </form>
        </div>
    </div>
</div>