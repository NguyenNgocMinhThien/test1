@model OrganizerDashboardViewModel

@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Dashboard Ban Tổ Chức";
}

@section Styles {
    <style>
        .org-dashboard-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        /* --- STAT CARDS --- */
        .stat-card-org {
            background: #fff;
            border-radius: 12px;
            padding: 1.25rem;
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .stat-card-org:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            border-color: var(--organizer-accent);
        }
        .stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
        }
        .stat-val {
            font-size: 1.55rem;
            font-weight: 800;
            color: var(--text-dark);
            line-height: 1.1;
        }
        .stat-label {
            font-size: 0.63rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #94a3b8;
            margin-bottom: 2px;
        }

        /* --- PANELS --- */
        .panel-box {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 20px;
            margin-bottom: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            height: 100%;
        }
        .panel-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--navy-blue);
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* --- ALERT ZONE --- */
        .alert-zone .alert-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 500;
        }
        .alert-zone .alert-item.danger  { background: #fef2f2; border: 1px solid #fca5a5; color: #b91c1c; }
        .alert-zone .alert-item.warning { background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; }
        .alert-zone .alert-item.info    { background: #eff6ff; border: 1px solid #93c5fd; color: #1e40af; }
        .alert-zone .alert-item a       { font-weight: 700; margin-left: auto; white-space: nowrap; text-decoration: none; }
        .alert-zone .alert-item.danger  a { color: #b91c1c; }
        .alert-zone .alert-item.warning a { color: #92400e; }

        /* --- PROGRESS TABLE --- */
        .progress-table th {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #64748b;
            font-weight: 700;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 10px 12px;
        }
        .progress-table td {
            padding: 10px 12px;
            vertical-align: middle;
            font-size: 0.88rem;
            border-bottom: 1px solid #f1f5f9;
        }
        .progress-table tr:last-child td { border-bottom: none; }
        .progress-table tr:hover td { background: #f8fafc; }
        .phase-badge {
            font-size: 0.72rem;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 20px;
        }
        .bar-mini { height: 6px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
        .bar-mini-fill { height: 100%; border-radius: 3px; }

        /* --- TIMELINE --- */
        .timeline-vertical {
            border-left: 2px solid #e2e8f0;
            margin-left: 10px;
            padding-left: 20px;
            list-style: none;
        }
        .timeline-item { position: relative; margin-bottom: 20px; }
        .timeline-item:last-child { margin-bottom: 0; }
        .timeline-dot {
            position: absolute;
            left: -27px;
            top: 3px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid #fff;
        }
        .tl-title { font-size: 0.85rem; font-weight: 700; color: var(--text-dark); margin-bottom: 3px; }
        .progress-micro { height: 5px; border-radius: 3px; }

        /* --- ACTIVITIES --- */
        .activity-list { margin: 0; padding: 0; list-style: none; }
        .activity-item {
            display: flex;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid var(--border-color);
        }
        .activity-item:last-child { border-bottom: none; padding-bottom: 0; }

        /* --- TOP COMPETITIONS --- */
        .top-comp-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 9px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .top-comp-item:last-child { border-bottom: none; }
        .top-rank {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.8rem;
            flex-shrink: 0;
        }
    </style>
}

<div class="org-dashboard-wrapper py-4">
    <div class="container-fluid">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Tổng quan Vận hành Cuộc thi</h3>
                <p class="text-muted small mb-0">Theo dõi tiến độ, duyệt hồ sơ và đôn đốc chấm điểm.</p>
            </div>
            <a href="/Organizer/Create" class="btn text-white fw-bold shadow-sm" style="background-color: var(--organizer-accent);">
                <i class="bi bi-plus-lg me-1"></i> Tạo Cuộc thi mới
            </a>
        </div>

        <!-- ROW 1: Trạng thái cuộc thi -->
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card-org">
                    <div class="stat-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-trophy"></i></div>
                    <div>
                        <div class="stat-label">Tổng cuộc thi</div>
                        <div class="stat-val">@Model.TotalCompetitions</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card-org" style="border-left: 3px solid #22c55e;">
                    <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-person-plus"></i></div>
                    <div>
                        <div class="stat-label">Mở đăng ký</div>
                        <div class="stat-val text-success">@Model.OpenRegistrationCompetitions</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card-org" style="border-left: 3px solid #0ea5e9;">
                    <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-cloud-arrow-up"></i></div>
                    <div>
                        <div class="stat-label">Nhận bài</div>
                        <div class="stat-val text-info">@Model.AcceptingSubmissions</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card-org" style="border-left: 3px solid #f59e0b;">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-clipboard2-check"></i></div>
                    <div>
                        <div class="stat-label">Đang chấm</div>
                        <div class="stat-val text-warning">@Model.GradingCompetitions</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card-org" style="border-left: 3px solid #8b5cf6;">
                    <div class="stat-icon" style="background:rgba(139,92,246,.1);color:#8b5cf6;"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="stat-label">Hoàn thành</div>
                        <div class="stat-val" style="color:#8b5cf6;">@Model.CompletedCompetitions</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="stat-card-org border-danger">
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-hourglass-bottom"></i></div>
                    <div>
                        <div class="stat-label">Sắp kết thúc</div>
                        <div class="stat-val text-danger">@Model.UrgentCompetitions</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 2: Chỉ số hoạt động -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-card-org">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-file-earmark-person"></i></div>
                    <div>
                        <div class="stat-label">Tổng đăng ký</div>
                        <div class="stat-val">@Model.TotalRegistrations
                            @if (Model.PendingRegistrations > 0)
                            {
                                <span class="badge bg-warning text-dark ms-1" style="font-size:.65rem;">@Model.PendingRegistrations chờ</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card-org">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people"></i></div>
                    <div>
                        <div class="stat-label">Tổng đội thi</div>
                        <div class="stat-val">@Model.TotalTeams</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card-org">
                    <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-file-zip"></i></div>
                    <div>
                        <div class="stat-label">Bài dự thi</div>
                        <div class="stat-val">@Model.TotalSubmissions</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card-org" style="border-left: 3px solid #22c55e;">
                    <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-all"></i></div>
                    <div>
                        <div class="stat-label">Tỷ lệ chấm</div>
                        <div class="stat-val text-success">@Model.ScoringCompletionRate%</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ALERT ZONE -->
        @if (Model.Alerts.Any())
        {
            <div class="alert-zone mb-4">
                <div class="panel-box p-0" style="overflow:hidden;">
                    <div class="px-4 pt-3 pb-2 d-flex align-items-center gap-2" style="border-bottom:1px solid #f1f5f9;">
                        <i class="bi bi-bell-fill text-danger"></i>
                        <span class="fw-bold" style="font-size:.95rem;">Cảnh báo cần xử lý</span>
                        <span class="badge bg-danger ms-1">@Model.Alerts.Count</span>
                    </div>
                    <div class="p-3 d-flex flex-column gap-2">
                        @foreach (var alert in Model.Alerts)
                        {
                            <div class="alert-item @alert.Level">
                                <i class="bi @alert.Icon flex-shrink-0"></i>
                                <span>@alert.Message</span>
                                @if (!string.IsNullOrEmpty(alert.ActionUrl))
                                {
                                    <a href="@alert.ActionUrl"><i class="bi bi-arrow-right-circle me-1"></i>@alert.ActionText</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- COMPETITION PROGRESS TABLE -->
        @if (Model.CompetitionProgressTable.Any())
        {
            <div class="panel-box mb-4">
                <div class="panel-title">
                    <span><i class="bi bi-table me-2 text-primary"></i>Tiến độ từng Cuộc thi</span>
                    <a href="/Organizer/Contests" class="small text-decoration-none" style="color:var(--organizer-accent);">Xem tất cả</a>
                </div>
                <div class="table-responsive">
                    <table class="table progress-table mb-0">
                        <thead>
                            <tr>
                                <th style="min-width:200px;">Cuộc thi</th>
                                <th>Giai đoạn</th>
                                <th class="text-center">Đăng ký<br><small class="fw-normal text-muted">(duyệt / tổng)</small></th>
                                <th class="text-center">Chờ duyệt</th>
                                <th class="text-center">Bài nộp</th>
                                <th style="min-width:140px;">Tiến độ chấm</th>
                                <th>Đợt đăng ký</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.CompetitionProgressTable)
                            {
                                var phaseColor = row.Phase switch
                                {
                                    var p when p.Contains("Hồ Sơ") || p.Contains("Nhận") => "background:#dcfce7;color:#166534;",
                                    var p when p.Contains("Bài") => "background:#dbeafe;color:#1e40af;",
                                    var p when p.Contains("Chấm") => "background:#fef9c3;color:#854d0e;",
                                    var p when p.Contains("Kết quả") => "background:#ede9fe;color:#5b21b6;",
                                    _ => "background:#f1f5f9;color:#475569;"
                                };

                                var barColor = row.GradingProgress >= 80 ? "#22c55e"
                                    : row.GradingProgress >= 50 ? "#f59e0b"
                                    : "#ef4444";

                                <tr>
                                    <td>
                                        <a href="/Organizer/Contests" class="fw-semibold text-decoration-none text-dark">@row.Name</a>
                                        @if (row.UnderMinParticipants)
                                        {
                                            <span class="ms-1 badge bg-danger" style="font-size:.65rem;" title="Chưa đạt số người tối thiểu">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Thiếu người
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="phase-badge" style="@phaseColor">@row.Phase</span>
                                    </td>
                                    <td class="text-center fw-semibold">
                                        @row.ApprovedRegistrations / @row.TotalRegistrations
                                    </td>
                                    <td class="text-center">
                                        @if (row.PendingRegistrations > 0)
                                        {
                                            <span class="badge bg-warning text-dark">@row.PendingRegistrations</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center fw-semibold">@row.TotalSubmissions</td>
                                    <td>
                                        @if (row.TotalSubmissions > 0)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="bar-mini flex-grow-1">
                                                    <div class="bar-mini-fill" style="width:@row.GradingProgress%;background:@barColor;"></div>
                                                </div>
                                                <small class="fw-bold" style="color:@barColor;min-width:32px;">@row.GradingProgress%</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chưa có bài</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(row.ActiveRoundName))
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size:.72rem;">
                                                <i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>@row.ActiveRoundName
                                            </span>
                                            <div class="text-muted" style="font-size:.7rem;">Đóng @row.ActiveRoundEnd?.ToString("dd/MM HH:mm")</div>
                                        }
                                        else if (row.NextRoundStart.HasValue)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border" style="font-size:.72rem;">
                                                <i class="bi bi-clock me-1"></i>Sắp mở
                                            </span>
                                            <div class="text-muted" style="font-size:.7rem;">@row.NextRoundStart?.ToString("dd/MM/yyyy")</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ROW 3: Charts + Top Competitions -->
        <div class="row g-4 mb-4">
            <!-- Chart Tiến độ -->
            <div class="col-lg-5">
                <div class="panel-box">
                    <div class="panel-title">
                        <span><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Đăng ký & Bài thi theo tuần</span>
                        <span class="small text-muted">
                            @(Model.ProgressData.Any() ? "Cuộc thi đang hoạt động" : "Chưa có dữ liệu")
                        </span>
                    </div>
                    <div style="height: 240px;">
                        <canvas id="progressChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Tỷ lệ duyệt -->
            <div class="col-lg-3">
                <div class="panel-box">
                    <div class="panel-title">
                        <span><i class="bi bi-pie-chart-fill me-2 text-success"></i>Tỷ lệ Hồ sơ</span>
                    </div>
                    <div style="height: 180px; display:flex; justify-content:center;">
                        <canvas id="approvalChart"></canvas>
                    </div>
                    <div class="mt-3 text-center small text-muted">
                        Đã xử lý <strong>@Model.ApprovalRatio.TotalProcessed</strong> hồ sơ
                    </div>
                </div>
            </div>

            <!-- Top cuộc thi -->
            <div class="col-lg-4">
                <div class="panel-box">
                    <div class="panel-title">
                        <span><i class="bi bi-bar-chart-steps me-2 text-warning"></i>Top đăng ký nhiều nhất</span>
                    </div>
                    @if (Model.TopCompetitionsByRegistrations.Any())
                    {
                        @foreach (var (item, idx) in Model.TopCompetitionsByRegistrations.Select((x, i) => (x, i)))
                        {
                            var rankColors = new[] { "#f59e0b", "#94a3b8", "#cd7c2f", "#0ea5e9", "#8b5cf6" };
                            var rankColor = idx < rankColors.Length ? rankColors[idx] : "#94a3b8";
                            var maxReg = Model.TopCompetitionsByRegistrations.Max(t => t.RegistrationCount);
                            var barWidth = maxReg > 0 ? (int)((decimal)item.RegistrationCount / maxReg * 100) : 0;

                            <div class="top-comp-item">
                                <div class="top-rank" style="background:@(rankColor)22;color:@rankColor;">@(idx + 1)</div>
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div class="fw-semibold text-truncate" style="font-size:.85rem;" title="@item.Name">@item.Name</div>
                                    <div class="bar-mini mt-1" style="width:100%;">
                                        <div class="bar-mini-fill" style="width:@barWidth%;background:@rankColor;"></div>
                                    </div>
                                </div>
                                <div class="fw-bold" style="font-size:.9rem;color:@rankColor;min-width:32px;text-align:right;">@item.RegistrationCount</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small text-center mt-3">Chưa có dữ liệu đăng ký</p>
                    }
                </div>
            </div>
        </div>

        <!-- ROW 4: Deadlines + Activities -->
        <div class="row g-4">
            <!-- Deadlines -->
            <div class="col-lg-5">
                <div class="panel-box">
                    <div class="panel-title">
                        <span><i class="bi bi-calendar-event me-2 text-warning"></i>Deadlines sắp tới</span>
                        <span class="small text-muted">Dựa trên RegistrationRounds</span>
                    </div>
                    <ul class="timeline-vertical mt-3">
                        @if (Model.UpcomingDeadlines.Any())
                        {
                            @foreach (var deadline in Model.UpcomingDeadlines.Take(6))
                            {
                                var dotClass = deadline.Status switch
                                {
                                    "urgent"  => "bg-danger",
                                    "warning" => "bg-warning",
                                    _         => "bg-success"
                                };
                                var badgeClass = deadline.Status switch
                                {
                                    "urgent"  => "bg-danger",
                                    "warning" => "bg-warning text-dark",
                                    _         => "bg-success"
                                };
                                var titleColor = deadline.Status switch
                                {
                                    "urgent"  => "text-danger",
                                    "warning" => "text-warning",
                                    _         => "text-success"
                                };

                                <li class="timeline-item">
                                    <div class="timeline-dot @dotClass"></div>
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="tl-title @titleColor">@deadline.Title</span>
                                        <span class="badge @badgeClass ms-2 flex-shrink-0" style="font-size:.7rem;">
                                            @deadline.DeadlineDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    <p class="small text-muted mb-1">@deadline.Description</p>
                                    @if (deadline.ProgressPercentage.HasValue)
                                    {
                                        var pct = deadline.ProgressPercentage.Value;
                                        var barCol = pct >= 80 ? "bg-success" : pct >= 50 ? "bg-warning" : "bg-danger";
                                        <div class="progress progress-micro">
                                            <div class="progress-bar @barCol" style="width:@pct%"></div>
                                        </div>
                                        <small class="text-muted" style="font-size:.7rem;">Đã chấm @Math.Round(pct)%</small>
                                    }
                                </li>
                            }
                        }
                        else
                        {
                            <li class="text-muted small"><i class="bi bi-check-circle text-success me-1"></i>Không có deadline sắp tới</li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Activities -->
            <div class="col-lg-7">
                <div class="panel-box">
                    <div class="panel-title">
                        <span><i class="bi bi-clock-history me-2 text-info"></i>Hoạt động mới nhất</span>
                        <button class="btn btn-sm btn-light" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i></button>
                    </div>
                    <ul class="activity-list">
                        @if (Model.RecentActivities.Any())
                        {
                            @foreach (var activity in Model.RecentActivities.Take(6))
                            {
                                var iconClass = activity.Type switch
                                {
                                    "score"        => "bi-file-earmark-check-fill text-success",
                                    "registration" => "bi-person-lines-fill text-warning",
                                    "submission"   => "bi-cloud-arrow-up-fill text-info",
                                    "message"      => "bi-chat-left-text-fill text-secondary",
                                    _              => "bi-info-circle text-secondary"
                                };
                                var timespan = DateTime.UtcNow - activity.CreatedAt;
                                var timeText = timespan.TotalMinutes < 1    ? "vừa xong"
                                    : timespan.TotalMinutes < 60 ? $"{(int)timespan.TotalMinutes} phút trước"
                                    : timespan.TotalHours   < 24 ? $"{(int)timespan.TotalHours} giờ trước"
                                    : $"{(int)timespan.TotalDays} ngày trước";

                                <li class="activity-item">
                                    <div class="fs-4 mt-1"><i class="bi @iconClass"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold" style="font-size:.88rem;">@activity.Title</div>
                                        <div class="small text-muted">@activity.Description</div>
                                    </div>
                                    <div class="small text-muted text-end" style="min-width:80px;">@timeText</div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="text-muted small py-3 text-center">Chưa có hoạt động nào</li>
                        }
                    </ul>
                    <div class="mt-3 text-center">
                        <button class="btn btn-link text-decoration-none fw-bold small" style="color:var(--organizer-accent);">Xem tất cả Logs</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        Chart.defaults.font.family = "'Inter', sans-serif";

        // Chart 1: Tiến độ theo tuần
        const progressData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProgressData));
        const ctxProgress = document.getElementById('progressChart').getContext('2d');

        new Chart(ctxProgress, {
            type: 'line',
            data: {
                labels: progressData.length > 0 ? progressData.map(d => d.week) : ['Tuần 1','Tuần 2','Tuần 3','Tuần 4'],
                datasets: [
                    {
                        label: 'Hồ sơ đăng ký',
                        data: progressData.length > 0 ? progressData.map(d => d.registrations) : [0,0,0,0],
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13,110,253,0.08)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4
                    },
                    {
                        label: 'Bài thi đã nộp',
                        data: progressData.length > 0 ? progressData.map(d => d.submissions) : [0,0,0,0],
                        borderColor: '#059669',
                        borderWidth: 2,
                        borderDash: [5,5],
                        tension: 0.3,
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 12 } } } },
                scales: {
                    y: { beginAtZero: true, ticks: { font: { size: 11 } } },
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } }
                }
            }
        });

        // Chart 2: Tỷ lệ duyệt hồ sơ
        const approvalRatio = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApprovalRatio));
        const ctxApproval = document.getElementById('approvalChart').getContext('2d');
        new Chart(ctxApproval, {
            type: 'doughnut',
            data: {
                labels: ['Đã duyệt','Chờ duyệt','Từ chối'],
                datasets: [{
                    data: [approvalRatio.approvedCount, approvalRatio.pendingCount, approvalRatio.rejectedCount],
                    backgroundColor: ['#22c55e','#f59e0b','#ef4444'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } }
                }
            }
        });
    </script>
}
