@model Web_cham_diem.Models.ViewModels.OrganizerDashboardViewModel
@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

@section Styles {
<style>
    .dash-stat-card {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
    }
    .dash-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.11);
    }
    .dash-icon {
        width: 52px; height: 52px;
        border-radius: 13px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.45rem;
        flex-shrink: 0;
    }
    .dash-card-full {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        height: 100%;
    }
    .progress-bar-sm { height: 6px; border-radius: 4px; }
    .status-badge {
        font-size: 0.72rem;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 600;
    }
    .chip-active  { background: #d1fae5; color: #059669; }
    .chip-draft   { background: #e0f2fe; color: #0369a1; }
    .chip-closed  { background: #f1f5f9; color: #64748b; }
    .timeline-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 6px;
    }
    .table-comp th {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 700;
    }
    .table-comp td { vertical-align: middle; font-size: 0.875rem; }
    .top-comp-bar  { height: 8px; border-radius: 4px; background: #e2e8f0; }
    .top-comp-fill { height: 100%; border-radius: 4px; background: var(--organizer-accent); transition: width 0.7s ease; }
    .mini-status-card {
        background: #fff;
        border-radius: 12px;
        padding: 0.85rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border: 1px solid var(--border-color);
        height: 100%;
    }
    .mini-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
    }
    .activity-icon {
        width: 36px; height: 36px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.95rem;
        flex-shrink: 0;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }
</style>
}

<!-- ===== PAGE HEADER ===== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom pb-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 me-2" style="color: var(--organizer-accent);"></i>@(User.IsInRole("Admin") ? "Tổng quan Tất cả Cuộc thi" : "Tổng quan Cuộc thi của tôi")
        </h4>
        <p class="text-muted mb-0 small">
            @(User.IsInRole("Admin")
                ? "Theo dõi tiến độ, duyệt hồ sơ thí sinh và đôn đốc chấm điểm cho toàn bộ cuộc thi trong hệ thống."
                : "Theo dõi tiến độ, duyệt hồ sơ thí sinh và đôn đốc chấm điểm cho các cuộc thi do bạn tổ chức.")
        </p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a href="/Organizer/Submissions" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-file-earmark-text me-1"></i>Duyệt hồ sơ
        </a>
        <a href="/Organizer/Create" class="btn btn-sm fw-semibold text-white" style="background-color: var(--organizer-accent);">
            <i class="bi bi-plus-lg me-1"></i>Tạo Cuộc thi mới
        </a>
    </div>
</div>

<!-- ===== ALERTS ===== -->
@if (Model.Alerts.Any())
{
    <div class="mb-4">
        @foreach (var alert in Model.Alerts.Take(4))
        {
            <div class="alert alert-@alert.Level alert-dismissible fade show d-flex align-items-center justify-content-between mb-2 py-2 px-3 rounded-3 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi @alert.Icon"></i>
                    <span class="small">@alert.Message</span>
                </div>
                <div class="d-flex align-items-center gap-2 ms-2 flex-shrink-0">
                    @if (!string.IsNullOrEmpty(alert.ActionUrl))
                    {
                        <a href="@alert.ActionUrl" class="btn btn-sm btn-outline-@alert.Level py-0 px-2 fw-semibold" style="font-size:0.72rem;">
                            @alert.ActionText
                        </a>
                    }
                    <button type="button" class="btn-close" style="font-size:0.65rem;" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
    </div>
}

<!-- ===== 4 STAT CARDS ===== -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Quy mô chiến dịch</span>
                <div class="dash-icon" style="background:#ecfdf5; color:#059669;">
                    <i class="bi bi-trophy-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-dark">@Model.TotalCompetitions</h2>
            <div class="text-muted small">
                <span class="text-success fw-bold">@Model.ActiveCompetitions</span> Active
                &nbsp;|&nbsp;
                <span style="color:#0369a1;" class="fw-bold">@Model.DraftCompetitions</span> Draft
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Hồ sơ Đăng ký</span>
                <div class="dash-icon" style="background:#f0fdf4; color:#16a34a;">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-dark">@Model.TotalRegistrations</h2>
            <div class="text-muted small">
                Chờ duyệt: <span class="text-warning fw-bold">@Model.PendingRegistrations</span>
                &nbsp;|&nbsp; Đội: <span class="text-info fw-bold">@Model.TotalTeams</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Bài thi đã nhận</span>
                <div class="dash-icon" style="background:#fff7ed; color:#ea580c;">
                    <i class="bi bi-file-earmark-arrow-up-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-dark">@Model.TotalSubmissions</h2>
            <div class="text-muted small">
                Đã chấm: <span class="fw-bold text-dark">@Model.EvaluatedSubmissions</span>
                &nbsp;/&nbsp;@Model.TotalSubmissions bài
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dash-stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Tiến độ chấm điểm</span>
                <div class="dash-icon" style="background:#eff6ff; color:#2563eb;">
                    <i class="bi bi-check2-circle"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-dark">@Model.ScoringCompletionRate.ToString("0.#")%</h2>
            <div class="text-muted small">
                <span class="fw-bold text-dark">@Model.EvaluatedSubmissions</span> / @Model.TotalSubmissions lượt chấm
            </div>
            <div class="progress mt-2 progress-bar-sm">
                <div class="progress-bar" style="width:@Model.ScoringCompletionRate%; background: var(--organizer-accent);"></div>
            </div>
        </div>
    </div>
</div>

<!-- ===== 2 STAT CARDS: TỶ LỆ NỘP ĐÚNG HẠN & TỶ LỆ HỒ SƠ ĐƯỢC DUYỆT ===== -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6">
        <div class="card dash-stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Tỷ lệ nộp bài đúng hạn</span>
                <div class="dash-icon" style="background:#f0fdfa; color:#0d9488;">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-dark">@Model.OnTimeSubmissionRate.ToString("0.#")%</h2>
            <div class="text-muted small">
                Đúng hạn: <span class="fw-bold text-success">@Model.OnTimeSubmissions</span>
                &nbsp;|&nbsp; Trễ hạn: <span class="fw-bold text-danger">@Model.LateSubmissions</span>
            </div>
            <div class="progress mt-2 progress-bar-sm">
                <div class="progress-bar" style="width:@Model.OnTimeSubmissionRate%; background:#0d9488;"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6">
        <div class="card dash-stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted fw-semibold small text-uppercase">Tỷ lệ hồ sơ được duyệt</span>
                <div class="dash-icon" style="background:#f0fdf4; color:#16a34a;">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold mb-1 text-dark">@Model.ApprovalRatio.ApprovalRate.ToString("0.#")%</h2>
            <div class="text-muted small">
                Đã duyệt: <span class="fw-bold text-success">@Model.ApprovalRatio.ApprovedCount</span>
                &nbsp;/&nbsp; @Model.ApprovalRatio.TotalProcessed hồ sơ đã xử lý
            </div>
            <div class="progress mt-2 progress-bar-sm">
                <div class="progress-bar" style="width:@Model.ApprovalRatio.ApprovalRate%; background:#16a34a;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ===== COMPETITION STATUS MINI CARDS ===== -->
<div class="row g-2 mb-4">
    <div class="col-6 col-md-3">
        <div class="mini-status-card">
            <div class="mini-icon" style="background:#d1fae5; color:#059669;">
                <i class="bi bi-door-open-fill"></i>
            </div>
            <div>
                <div class="fw-bold text-dark fs-5 lh-1">@Model.OpenRegistrationCompetitions</div>
                <div class="text-muted" style="font-size:0.7rem; margin-top:2px;">Đang nhận hồ sơ</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mini-status-card">
            <div class="mini-icon" style="background:#fef9c3; color:#ca8a04;">
                <i class="bi bi-inbox-fill"></i>
            </div>
            <div>
                <div class="fw-bold text-dark fs-5 lh-1">@Model.AcceptingSubmissions</div>
                <div class="text-muted" style="font-size:0.7rem; margin-top:2px;">Đang thu bài thi</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mini-status-card">
            <div class="mini-icon" style="background:#eff6ff; color:#2563eb;">
                <i class="bi bi-ui-checks-grid"></i>
            </div>
            <div>
                <div class="fw-bold text-dark fs-5 lh-1">@Model.GradingCompetitions</div>
                <div class="text-muted" style="font-size:0.7rem; margin-top:2px;">Đang chấm điểm</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mini-status-card">
            <div class="mini-icon" style="background:#f1f5f9; color:#64748b;">
                <i class="bi bi-flag-fill"></i>
            </div>
            <div>
                <div class="fw-bold text-dark fs-5 lh-1">@Model.CompletedCompetitions</div>
                <div class="text-muted" style="font-size:0.7rem; margin-top:2px;">Đã hoàn thành</div>
            </div>
        </div>
    </div>
</div>

<!-- ===== CHARTS ROW ===== -->
<div class="row g-4 mb-4">
    <!-- Line chart: Đăng ký & Bài thi theo tuần -->
    <div class="col-12 col-lg-7">
        <div class="card dash-card-full p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0">
                    <i class="bi bi-graph-up text-primary me-2"></i>Thống kê Đăng ký & Bài thi theo tuần
                </h6>
                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">4 Tuần gần nhất</span>
            </div>
            @if (Model.ProgressData.Any())
            {
                <canvas id="weeklyChart" height="90"></canvas>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center"
                     style="height:220px; border:2px dashed #dee2e6; border-radius:8px; background:#fafafa; color:#6c757d;">
                    <i class="bi bi-bar-chart-line fs-2 mb-2 text-black-50"></i>
                    <p class="mb-0 small fw-medium">Chưa có dữ liệu trục thời gian</p>
                    <span style="font-size:11px;">Biểu đồ xu hướng sẽ hiển thị khi cuộc thi chuyển sang Active</span>
                </div>
            }
        </div>
    </div>

    <!-- Doughnut: Tỷ lệ xét duyệt -->
    <div class="col-12 col-lg-5">
        <div class="card dash-card-full p-4">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-pie-chart-fill text-success me-2"></i>Trạng thái xét duyệt hồ sơ
            </h6>
            <div class="row g-0 mb-3 text-center">
                <div class="col-4 border-end">
                    <div class="text-muted small">Chờ duyệt</div>
                    <h4 class="fw-bold text-warning mt-1 mb-0">@Model.ApprovalRatio.PendingCount</h4>
                </div>
                <div class="col-4 border-end">
                    <div class="text-muted small">Đã chấp nhận</div>
                    <h4 class="fw-bold text-success mt-1 mb-0">@Model.ApprovalRatio.ApprovedCount</h4>
                </div>
                <div class="col-4">
                    <div class="text-muted small">Từ chối</div>
                    <h4 class="fw-bold text-danger mt-1 mb-0">@Model.ApprovalRatio.RejectedCount</h4>
                </div>
            </div>
            @if (Model.ApprovalRatio.TotalProcessed > 0)
            {
                <canvas id="approvalChart" height="140"></canvas>
            }
            else
            {
                <div class="text-center text-muted small py-3">
                    <i class="bi bi-pie-chart fs-2 mb-2 d-block text-black-50"></i>
                    Chưa có hồ sơ nào được xử lý.
                </div>
            }
            <hr class="my-3">
            <div class="bg-light rounded-3 px-3 py-2 d-flex align-items-center justify-content-between">
                <span class="text-muted small fw-semibold">
                    <i class="bi bi-person-badge me-1 text-success"></i>Giám khảo đang hoạt động
                </span>
                <span class="fw-bold text-dark">@Model.ActiveJudges người</span>
            </div>
        </div>
    </div>
</div>

<!-- ===== CHARTS ROW 2: NGƯỜI THAM GIA THEO CUỘC THI & PHÂN BỐ ĐIỂM SỐ ===== -->
<div class="row g-4 mb-4">
    <!-- Bar chart: Số lượng người tham gia theo cuộc thi -->
    <div class="col-12 col-lg-6">
        <div class="card dash-card-full p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0">
                    <i class="bi bi-people-fill text-success me-2"></i>Số lượng người tham gia theo cuộc thi
                </h6>
                @if (Model.ParticipantsByCompetition.Count > 10)
                {
                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Top 10</span>
                }
            </div>
            @if (Model.ParticipantsByCompetition.Any())
            {
                <div style="height:260px;"><canvas id="participantsChart"></canvas></div>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center"
                     style="height:220px; border:2px dashed #dee2e6; border-radius:8px; background:#fafafa; color:#6c757d;">
                    <i class="bi bi-people fs-2 mb-2 text-black-50"></i>
                    <p class="mb-0 small fw-medium">Chưa có dữ liệu đăng ký</p>
                </div>
            }
        </div>
    </div>

    <!-- Bar chart: Phân bố điểm số -->
    <div class="col-12 col-lg-6">
        <div class="card dash-card-full p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0">
                    <i class="bi bi-bar-chart-fill text-primary me-2"></i>Phân bố điểm số
                </h6>
                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">@Model.ScoreDistribution.TotalScored bài đã chấm</span>
            </div>
            @if (Model.ScoreDistribution.TotalScored > 0)
            {
                <div style="height:260px;"><canvas id="scoreDistChart"></canvas></div>
                <div class="mt-3 d-flex flex-wrap gap-2 justify-content-center">
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-2 px-3">Dưới 50%: @Model.ScoreDistribution.Below50 bài</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 py-2 px-3">50–65%: @Model.ScoreDistribution.From50To65 bài</span>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 py-2 px-3">65–80%: @Model.ScoreDistribution.From65To80 bài</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 py-2 px-3">80–90%: @Model.ScoreDistribution.From80To90 bài</span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 py-2 px-3">Trên 90%: @Model.ScoreDistribution.Above90 bài</span>
                </div>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center"
                     style="height:220px; border:2px dashed #dee2e6; border-radius:8px; background:#fafafa; color:#6c757d;">
                    <i class="bi bi-bar-chart fs-2 mb-2 text-black-50"></i>
                    <p class="mb-0 small fw-medium">Chưa có bài nào được chấm điểm</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ===== COMPETITION PROGRESS TABLE ===== -->
@if (Model.CompetitionProgressTable.Any())
{
    <div class="card dash-card-full p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-dark m-0">
                <i class="bi bi-table text-primary me-2"></i>Tiến độ Cuộc thi đang vận hành
            </h6>
            <a href="/Organizer/Contests" class="btn btn-sm btn-outline-secondary py-1">
                <i class="bi bi-arrow-right me-1"></i>Xem tất cả
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle table-comp mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Cuộc thi</th>
                        <th>Trạng thái</th>
                        <th>Giai đoạn</th>
                        <th class="text-center">Đăng ký</th>
                        <th class="text-center">Bài thi</th>
                        <th style="min-width:130px;">Tiến độ chấm</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.CompetitionProgressTable)
                    {
                        var chipCls = row.Status == "Active" ? "chip-active" :
                                      row.Status == "Draft"  ? "chip-draft"  : "chip-closed";
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@row.Name</div>
                                @if (row.ActiveRoundName != null)
                                {
                                    <div class="text-muted" style="font-size:0.72rem;">
                                        <i class="bi bi-clock me-1"></i>Đợt: @row.ActiveRoundName
                                        @if (row.ActiveRoundEnd.HasValue)
                                        {
                                            <span> — đến @row.ActiveRoundEnd.Value.ToLocalTime().ToString("dd/MM")</span>
                                        }
                                    </div>
                                }
                                else if (row.NextRoundStart.HasValue)
                                {
                                    <div class="text-muted" style="font-size:0.72rem;">
                                        <i class="bi bi-calendar-event me-1"></i>Đợt tiếp: @row.NextRoundStart.Value.ToLocalTime().ToString("dd/MM")
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="status-badge @chipCls">@row.Status</span>
                            </td>
                            <td>
                                <span class="text-muted small">@row.Phase</span>
                            </td>
                            <td class="text-center">
                                <div class="fw-semibold">@row.TotalRegistrations</div>
                                @if (row.PendingRegistrations > 0)
                                {
                                    <div class="text-warning" style="font-size:0.72rem;">@row.PendingRegistrations chờ duyệt</div>
                                }
                                @if (row.UnderMinParticipants)
                                {
                                    <div class="text-danger" style="font-size:0.72rem;">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Thiếu @(row.MinParticipants - row.ApprovedRegistrations)
                                    </div>
                                }
                            </td>
                            <td class="text-center">
                                <div class="fw-semibold">@row.TotalSubmissions</div>
                                @if (row.GradedSubmissions > 0)
                                {
                                    <div class="text-success" style="font-size:0.72rem;">@row.GradedSubmissions đã chấm</div>
                                }
                            </td>
                            <td>
                                @{
                                    var barColor = row.GradingProgress >= 100 ? "#059669" :
                                                   row.GradingProgress >= 50  ? "#0d6efd" : "#f59e0b";
                                }
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1 progress-bar-sm">
                                        <div class="progress-bar"
                                             style="width:@row.GradingProgress.ToString("0")%; background:@barColor;">
                                        </div>
                                    </div>
                                    <span class="text-muted small" style="min-width:34px;">@row.GradingProgress.ToString("0")%</span>
                                </div>
                            </td>
                            <td>
                                <a href="/Organizer/Edit/@row.CompetitionId"
                                   class="btn btn-sm btn-outline-secondary py-0 px-2" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ===== BOTTOM ROW ===== -->
<div class="row g-4">

    <!-- Hạn chót sắp tới -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card dash-card-full p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0">
                    <i class="bi bi-alarm-fill text-danger me-2"></i>Hạn chót sắp tới
                </h6>
                <span class="badge bg-danger-subtle text-danger rounded-pill" style="font-size:11px;">Quan trọng</span>
            </div>
            @if (Model.UpcomingDeadlines.Any())
            {
                foreach (var dl in Model.UpcomingDeadlines.Take(5))
                {
                    var daysLeft  = (dl.DeadlineDate - DateTime.UtcNow).TotalDays;
                    var dotColor  = dl.Status == "urgent"  ? "#dc2626" :
                                    dl.Status == "warning" ? "#d97706" : "#059669";
                    var bgColor   = dl.Status == "urgent"  ? "#fee2e2" :
                                    dl.Status == "warning" ? "#fff7ed" : "#f0fdf4";
                    var timeLabel = daysLeft < 1 ? "Hôm nay"  :
                                    daysLeft < 2 ? "Ngày mai" :
                                    $"{(int)daysLeft} ngày";
                    <div class="rounded-3 p-2 mb-2" style="background: @bgColor;">
                        <div class="d-flex gap-2 align-items-start">
                            <div class="timeline-dot" style="background: @dotColor;"></div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold text-dark small">@dl.Title</div>
                                <div class="text-muted" style="font-size:0.72rem;">@dl.CompetitionName</div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="text-muted" style="font-size:0.7rem;">
                                        <i class="bi bi-calendar3 me-1"></i>@dl.DeadlineDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    <span class="fw-semibold" style="font-size:0.72rem; color: @dotColor;">@timeLabel</span>
                                </div>
                                @if (dl.ProgressPercentage.HasValue)
                                {
                                    <div class="progress mt-1 progress-bar-sm">
                                        <div class="progress-bar" style="width:@dl.ProgressPercentage.Value.ToString("0")%; background: @dotColor;"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-calendar-check fs-2 mb-2 d-block text-black-50"></i>
                    <p class="small mb-0">Không có mốc thời gian nào sắp đến hạn.</p>
                </div>
            }
        </div>
    </div>

    <!-- Hoạt động vận hành mới nhất -->
    <div class="col-12 col-md-6 col-xl-5">
        <div class="card dash-card-full p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0">
                    <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Hoạt động vận hành mới nhất
                </h6>
                <button class="btn btn-sm btn-light border" onclick="location.reload()" title="Tải lại">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            @if (Model.RecentActivities.Any())
            {
                foreach (var act in Model.RecentActivities.Take(8))
                {
                    var iconCls = act.Type == "score"        ? "bi-star-fill text-warning"              :
                                  act.Type == "registration" ? "bi-person-plus-fill text-primary"       :
                                  act.Type == "submission"   ? "bi-file-earmark-check-fill text-success" :
                                  "bi-chat-text-fill text-info";
                    <div class="d-flex gap-3 mb-3 pb-2 border-bottom">
                        <div class="activity-icon">
                            <i class="bi @iconCls"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark small">@act.Title</div>
                            <div class="text-muted" style="font-size:0.75rem;">@act.Description</div>
                            <div class="text-muted mt-1" style="font-size:0.7rem;">
                                <i class="bi bi-clock me-1"></i>@act.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-activity fs-2 mb-2 d-block text-black-50"></i>
                    <p class="small mb-0">Chưa ghi nhận hoạt động tương tác nào.</p>
                </div>
            }
        </div>
    </div>

    <!-- Top cuộc thi nổi bật -->
    <div class="col-12 col-xl-3">
        <div class="card dash-card-full p-4">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-fire me-2" style="color:#ff5722;"></i>Top Cuộc thi nổi bật
            </h6>
            @if (Model.TopCompetitionsByRegistrations.Any())
            {
                var maxReg = Model.TopCompetitionsByRegistrations.Max(t => t.RegistrationCount);
                int rank = 1;
                foreach (var top in Model.TopCompetitionsByRegistrations)
                {
                    var pct = maxReg > 0 ? (int)((double)top.RegistrationCount / maxReg * 100) : 0;
                    var rankColor = rank == 1 ? "#f59e0b" : rank == 2 ? "#94a3b8" : rank == 3 ? "#cd7f32" : "#e2e8f0";
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                      style="width:22px;height:22px;font-size:0.68rem;background:@rankColor;color:@(rank<=3?"#fff":"#64748b");">
                                    @rank
                                </span>
                                <a href="/Organizer/Edit/@top.CompetitionId" class="small fw-semibold text-dark text-decoration-none">
                                    @(top.Name.Length > 28 ? top.Name[..25] + "..." : top.Name)
                                </a>
                            </div>
                            <span class="small fw-bold text-dark ms-1">@top.RegistrationCount</span>
                        </div>
                        <div class="top-comp-bar ms-4">
                            <div class="top-comp-fill" style="width:@pct%;"></div>
                        </div>
                        <div class="text-muted ms-4" style="font-size:0.68rem; margin-top:2px;">@top.Phase</div>
                    </div>
                    rank++;
                }
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-tags fs-2 mb-2 d-block text-black-50"></i>
                    <p class="small mb-0">Chưa có cuộc thi nào để xếp hạng.</p>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
<script>
    // ─── Weekly Trend Chart ───────────────────────────────────────────────
    @if (Model.ProgressData.Any())
    {
        <text>
        (function () {
            const ctx = document.getElementById('weeklyChart');
            if (!ctx) return;
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProgressData.Select(p => p.Week))),
                    datasets: [
                        {
                            label: 'Đăng ký',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProgressData.Select(p => p.Registrations))),
                            borderColor: '#059669',
                            backgroundColor: 'rgba(5,150,105,0.1)',
                            tension: 0.4,
                            fill: true,
                            pointRadius: 5,
                            pointBackgroundColor: '#059669'
                        },
                        {
                            label: 'Bài thi',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProgressData.Select(p => p.Submissions))),
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13,110,253,0.07)',
                            tension: 0.4,
                            fill: true,
                            pointRadius: 5,
                            pointBackgroundColor: '#0d6efd'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 12 } } }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0, font: { size: 11 } } },
                        x: { ticks: { font: { size: 11 } } }
                    }
                }
            });
        })();
        </text>
    }

    // ─── Approval Doughnut Chart ──────────────────────────────────────────
    @if (Model.ApprovalRatio.TotalProcessed > 0)
    {
        <text>
        (function () {
            const ctx2 = document.getElementById('approvalChart');
            if (!ctx2) return;
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Chờ duyệt', 'Đã chấp nhận', 'Từ chối'],
                    datasets: [{
                        data: [@Model.ApprovalRatio.PendingCount, @Model.ApprovalRatio.ApprovedCount, @Model.ApprovalRatio.RejectedCount],
                        backgroundColor: ['#fbbf24', '#059669', '#ef4444'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 12 } } }
                    }
                }
            });
        })();
        </text>
    }

    // ─── Participants per Competition Bar Chart ────────────────────────────
    @if (Model.ParticipantsByCompetition.Any())
    {
        <text>
        (function () {
            const ctx3 = document.getElementById('participantsChart');
            if (!ctx3) return;
            new Chart(ctx3, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ParticipantsByCompetition.Select(p => p.Name.Length > 20 ? p.Name[..18] + "…" : p.Name))),
                    datasets: [
                        {
                            label: 'Tổng đăng ký',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ParticipantsByCompetition.Select(p => p.RegistrationCount))),
                            backgroundColor: '#0d6efd',
                            borderRadius: 4
                        },
                        {
                            label: 'Đã duyệt',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ParticipantsByCompetition.Select(p => p.ApprovedCount))),
                            backgroundColor: '#16a34a',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 12 } } }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0, font: { size: 11 } } },
                        x: { ticks: { font: { size: 10 } } }
                    }
                }
            });
        })();
        </text>
    }

    // ─── Score Distribution Bar Chart ───────────────────────────────────────
    @if (Model.ScoreDistribution.TotalScored > 0)
    {
        <text>
        (function () {
            const ctx4 = document.getElementById('scoreDistChart');
            if (!ctx4) return;
            new Chart(ctx4, {
                type: 'bar',
                data: {
                    labels: ['Dưới 50%', '50 – 65%', '65 – 80%', '80 – 90%', 'Trên 90%'],
                    datasets: [{
                        label: 'Số bài',
                        data: [@Model.ScoreDistribution.Below50, @Model.ScoreDistribution.From50To65, @Model.ScoreDistribution.From65To80, @Model.ScoreDistribution.From80To90, @Model.ScoreDistribution.Above90],
                        backgroundColor: ['#ef4444', '#f59e0b', '#06b6d4', '#3b82f6', '#10b981'],
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => ` ${ctx.raw} bài` } }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 }, grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        })();
        </text>
    }
</script>
}
