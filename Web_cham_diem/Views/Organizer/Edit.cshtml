@section Scripts {
<script>
    const CID = @cid;

    // ═══════════════════════════════════ CRITERIA ════════════════════════════

    function updateHiddenWeightValues() {
        document.querySelectorAll('#criteriaContainer .criteria-item').forEach(item => {
            const inp = item.querySelector('.criteria-weight-input');
            const hid = item.querySelector('.criteria-weight-value');
            if (!inp || !hid) return;
            hid.value = (parseFloat(inp.value) / 100 || 0).toFixed(4);
        });
    }

    function updateTotalWeight() {
        const total = Array.from(document.querySelectorAll('.criteria-weight-input'))
            .reduce((s, el) => s + (parseFloat(el.value) || 0), 0);
        document.getElementById('totalWeight').textContent = total.toFixed(1);
        document.getElementById('weightFill').style.width = Math.min(total, 100) + '%';
        const ok = Math.abs(total - 100) <= 0.1;
        document.getElementById('weightFill').style.background = ok ? 'var(--organizer-accent)' : '#ef4444';
        const st = document.getElementById('weightStatus');
        st.textContent = ok ? '✓ Đúng' : '❌ Sai';
        st.style.color  = ok ? '#22c55e' : '#ef4444';
    }

    function reindexCriteria() {
        document.querySelectorAll('#criteriaContainer .criteria-item').forEach((item, i) => {
            item.dataset.index = i;
            ['Order','CriteriaName','MaxScore','Weight'].forEach(field => {
                const el = item.querySelector(`[name$=".${field}"]`);
                if (el) el.name = `ScoringCriteria[${i}].${field}`;
            });
        });
    }

    function addCriteria() {
        const container = document.getElementById('criteriaContainer');
        const i = container.children.length;
        container.insertAdjacentHTML('beforeend', `
            <div class="criteria-item" data-index="${i}">
                <div>
                    <input type="hidden" name="ScoringCriteria[${i}].Order" value="${i+1}">
                    <input type="text" name="ScoringCriteria[${i}].CriteriaName" class="form-control criteria-name" placeholder="Tên tiêu chí" required>
                </div>
                <div><input type="number" name="ScoringCriteria[${i}].MaxScore" class="form-control criteria-score" value="100" min="1" step="0.1" required></div>
                <div><div class="input-group">
                    <input type="number" class="form-control criteria-weight-input" value="0" min="0" max="100" step="0.1" required onchange="updateTotalWeight()" oninput="updateTotalWeight()">
                    <input type="hidden" name="ScoringCriteria[${i}].Weight" class="criteria-weight-value" value="0">
                    <span class="input-group-text">%</span>
                </div></div>
                <div><button type="button" class="remove-btn" onclick="removeCriteria(this)"><i class="bi bi-trash"></i></button></div>
            </div>`);
        updateTotalWeight();
    }

    function removeCriteria(btn) {
        btn.closest('.criteria-item').remove();
        reindexCriteria();
        updateTotalWeight();
    }

    // ═══════════════════════════════════ ROUNDS ══════════════════════════════

    async function addRoundAjax() {
        const name  = document.getElementById('newRoundName').value.trim();
        const start = document.getElementById('newRoundStart').value;
        const end   = document.getElementById('newRoundEnd').value;
        const msg   = document.getElementById('roundMsg');

        if (!name || !start || !end) { msg.innerHTML = '<span class="text-danger">Vui lòng điền đầy đủ.</span>'; return; }

        const res = await fetch(`/Organizer/AddRegistrationRound?competitionId=${CID}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ roundName: name, startDate: start, endDate: end })
        });
        const data = await res.json();
        if (data.success) {
            msg.innerHTML = '<span class="text-success">✓ Thêm đợt thành công! Đang tải lại...</span>';
            setTimeout(() => location.reload(), 800);
        } else {
            msg.innerHTML = `<span class="text-danger">${data.message}</span>`;
        }
    }

    // ═══════════════════════════════════ ROUNDS ══════════════════════════════

    async function deleteRound(roundId) {
        const allRounds = document.querySelectorAll('.round-item[id^="round-"]');
        if (allRounds.length <= 1) {
            showToast('Không thể xóa — cuộc thi phải có ít nhất một đợt đăng ký.', 'warning');
            return;
        }
        if (!confirm('Xóa đợt đăng ký này? Hành động không thể hoàn tác.')) return;
        const res = await fetch(`/Organizer/DeleteRound?roundId=${roundId}&competitionId=${CID}`, {
            method: 'POST', headers: { 'RequestVerificationToken': getToken() }
        });
        const data = await res.json();
        if (data.success) {
            document.getElementById(`round-${roundId}`)?.remove();
            showToast('Đã xóa đợt đăng ký.', 'success');
            // Ẩn nút xóa nếu chỉ còn 1 đợt
            const remaining = document.querySelectorAll('.round-item[id^="round-"]');
            if (remaining.length === 1) {
                remaining[0].querySelector('button[onclick^="deleteRound"]')?.remove();
            }
        } else {
            showToast(data.message, 'danger');
        }
    }

    // ═══════════════════════════════════ VÒNG THI ════════════════════════════

    function toUtcIso(localDatetimeStr) {
        if (!localDatetimeStr) return null;
        return new Date(localDatetimeStr).toISOString();
    }

    async function updateCompRound(roundId) {
        const name  = document.getElementById(`crName-${roundId}`)?.value;
        const start = document.getElementById(`crStart-${roundId}`)?.value;
        const end   = document.getElementById(`crEnd-${roundId}`)?.value;
        const maxV  = document.getElementById(`crMax-${roundId}`)?.value;
        const msg   = document.getElementById(`crMsg-${roundId}`);

        if (!name || !start || !end) {
            msg.innerHTML = '<span class="text-danger">Vui lòng điền đầy đủ tên vòng, ngày bắt đầu và kết thúc.</span>';
            return;
        }
        if (new Date(start) >= new Date(end)) {
            msg.innerHTML = '<span class="text-danger">Ngày bắt đầu phải trước ngày kết thúc.</span>';
            return;
        }

        msg.innerHTML = '<span class="text-secondary">Đang lưu...</span>';
        try {
            const res = await fetch(`/Organizer/UpdateCompetitionRound?roundId=${roundId}&competitionId=${CID}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({
                    roundName:    name,
                    startDate:    toUtcIso(start),
                    endDate:      toUtcIso(end),
                    maxAdvancing: maxV ? parseInt(maxV) : null
                })
            });
            const data = await res.json();
            if (data.success) {
                msg.innerHTML = '<span class="text-success">✓ Đã lưu thay đổi.</span>';
                setTimeout(() => { msg.innerHTML = ''; }, 3000);
            } else {
                msg.innerHTML = `<span class="text-danger">${data.message}</span>`;
            }
        } catch (e) {
            msg.innerHTML = '<span class="text-danger">Lỗi kết nối, vui lòng thử lại.</span>';
        }
    }

    async function deleteCompRound(roundId) {
        if (!confirm('Xóa vòng thi này? Hành động không thể hoàn tác.')) return;
        try {
            const res = await fetch(`/Organizer/DeleteCompetitionRound?roundId=${roundId}&competitionId=${CID}`, {
                method: 'POST', headers: { 'RequestVerificationToken': getToken() }
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById(`cr-${roundId}`)?.remove();
                const remaining = document.querySelectorAll('#compRoundList .comp-round-row');
                if (remaining.length === 0) {
                    const emptyEl = document.getElementById('compRoundEmpty');
                    if (emptyEl) emptyEl.style.display = '';
                }
                showToast('Đã xóa vòng thi.', 'success');
            } else {
                showToast(data.message, 'danger');
            }
        } catch (e) {
            showToast('Lỗi kết nối, vui lòng thử lại.', 'danger');
        }
    }

    async function addCompRoundAjax() {
        const name  = document.getElementById('newCrName').value;
        const start = document.getElementById('newCrStart').value;
        const end   = document.getElementById('newCrEnd').value;
        const maxV  = document.getElementById('newCrMax').value;
        const msg   = document.getElementById('newCrMsg');

        if (!name || !start || !end) {
            msg.innerHTML = '<span class="text-danger">Vui lòng chọn tên vòng, ngày bắt đầu và kết thúc.</span>';
            return;
        }
        if (new Date(start) >= new Date(end)) {
            msg.innerHTML = '<span class="text-danger">Ngày bắt đầu phải trước ngày kết thúc.</span>';
            return;
        }

        msg.innerHTML = '<span class="text-secondary">Đang thêm...</span>';
        try {
            const res = await fetch(`/Organizer/AddCompetitionRound?competitionId=${CID}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({
                    roundName:    name,
                    startDate:    toUtcIso(start),
                    endDate:      toUtcIso(end),
                    maxAdvancing: maxV ? parseInt(maxV) : null
                })
            });
            const data = await res.json();
            if (data.success) {
                msg.innerHTML = '<span class="text-success">✓ Đã thêm vòng thi! Đang tải lại...</span>';
                setTimeout(() => location.reload(), 800);
            } else {
                msg.innerHTML = `<span class="text-danger">${data.message}</span>`;
            }
        } catch (e) {
            msg.innerHTML = '<span class="text-danger">Lỗi kết nối, vui lòng thử lại.</span>';
        }
    }

    // ═══════════════════════════════════ IMAGES ══════════════════════════════

    let pendingImages = [];

    function handleImgSelect() {
        const files = document.getElementById('imgInput').files;
        for (const f of files) {
            if (f.size > 5*1024*1024) { alert(`${f.name} vượt quá 5MB`); continue; }
            const reader = new FileReader();
            reader.onload = e => { pendingImages.push({ name: f.name, data: e.target.result }); renderPendingImgs(); };
            reader.readAsDataURL(f);
        }
    }

    function renderPendingImgs() {
        const el = document.getElementById('imgPending');
        el.innerHTML = pendingImages.map((img, i) => `
            <div class="d-flex align-items-center gap-2 mb-1 p-2 bg-light rounded">
                <img src="${img.data}" style="width:50px;height:40px;object-fit:cover;border-radius:4px;">
                <span style="font-size:.85rem;">${img.name}</span>
                <button type="button" class="btn btn-xs btn-outline-danger btn-sm ms-auto" onclick="removePendingImg(${i})">✕</button>
            </div>`).join('');
        document.getElementById('btnUploadImg').style.display = pendingImages.length ? 'inline-block' : 'none';
    }

    function removePendingImg(i) { pendingImages.splice(i, 1); renderPendingImgs(); }

    async function uploadImages() {
        if (!pendingImages.length) return;
        const res = await fetch(`/Organizer/UploadImages?competitionId=${CID}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify(pendingImages.map(i => i.data))
        });
        const data = await res.json();
        if (data.success) { showToast('Upload ảnh thành công!', 'success'); setTimeout(() => location.reload(), 600); }
        else showToast(data.message, 'danger');
    }

    async function deleteImage(imageId) {
        if (!confirm('Xóa ảnh này?')) return;
        const res = await fetch(`/Organizer/DeleteImage?imageId=${imageId}&competitionId=${CID}`, {
            method: 'POST', headers: { 'RequestVerificationToken': getToken() }
        });
        const data = await res.json();
        if (data.success) {
            document.getElementById(`img-${imageId}`)?.remove();
            showToast('Đã xóa ảnh.', 'success');
        } else showToast(data.message, 'danger');
    }

    async function setThumbnail(imageId) {
        const res = await fetch(`/Organizer/SetThumbnail?imageId=${imageId}&competitionId=${CID}`, {
            method: 'POST', headers: { 'RequestVerificationToken': getToken() }
        });
        const data = await res.json();
        if (data.success) { showToast('Đã đặt thumbnail!', 'success'); setTimeout(() => location.reload(), 600); }
        else showToast(data.message, 'danger');
    }

    // ═══════════════════════════════════ DOCUMENTS ═══════════════════════════

    let pendingDocs = [];

    function handleDocSelect() {
        const files = document.getElementById('docInput').files;
        for (const f of files) {
            if (f.size > 10*1024*1024) { alert(`${f.name} vượt quá 10MB`); continue; }
            const reader = new FileReader();
            reader.onload = e => { pendingDocs.push({ name: f.name, data: e.target.result }); renderPendingDocs(); };
            reader.readAsDataURL(f);
        }
    }

    const docIcons = { pdf:'📕', doc:'📗', docx:'📗', xls:'📊', xlsx:'📊', ppt:'📊', pptx:'📊' };

    function renderPendingDocs() {
        const el = document.getElementById('docPending');
        el.innerHTML = pendingDocs.map((d, i) => {
            const ext = d.name.split('.').pop().toLowerCase();
            return `<div class="d-flex align-items-center gap-2 mb-1 p-2 bg-light rounded">
                <span style="font-size:1.3rem;">${docIcons[ext]||'📄'}</span>
                <span style="font-size:.85rem;">${d.name}</span>
                <button type="button" class="btn btn-xs btn-outline-danger btn-sm ms-auto" onclick="removePendingDoc(${i})">✕</button>
            </div>`;
        }).join('');
        document.getElementById('btnUploadDoc').style.display = pendingDocs.length ? 'inline-block' : 'none';
    }

    function removePendingDoc(i) { pendingDocs.splice(i, 1); renderPendingDocs(); }

    async function uploadDocuments() {
        if (!pendingDocs.length) return;
        const res = await fetch(`/Organizer/UploadDocuments?competitionId=${CID}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ dataList: pendingDocs.map(d => d.data), fileNames: pendingDocs.map(d => d.name) })
        });
        const data = await res.json();
        if (data.success) { showToast('Upload tài liệu thành công!', 'success'); setTimeout(() => location.reload(), 600); }
        else showToast(data.message, 'danger');
    }

    async function deleteDocument(docId) {
        if (!confirm('Xóa tài liệu này?')) return;
        const res = await fetch(`/Organizer/DeleteDocument?documentId=${docId}&competitionId=${CID}`, {
            method: 'POST', headers: { 'RequestVerificationToken': getToken() }
        });
        const data = await res.json();
        if (data.success) { document.getElementById(`doc-${docId}`)?.remove(); showToast('Đã xóa tài liệu.', 'success'); }
        else showToast(data.message, 'danger');
    }

    // ═══════════════════════════════════ SPONSORS ════════════════════════════

    let allSponsors = [];
    let selectedSponsorId = null;

    async function openAddSponsorModal() {
        if (!allSponsors.length) {
            const res = await fetch('/Organizer/GetAllSponsors');
            allSponsors = await res.json();
        }
        renderSponsorList(allSponsors);
        new bootstrap.Modal(document.getElementById('addSponsorModal')).show();
    }

    function renderSponsorList(list) {
        document.getElementById('sponsorPickList').innerHTML = list.length
            ? list.map(s => `
                <div class="d-flex align-items-center gap-2 p-2 rounded sponsor-pick-item"
                     style="cursor:pointer; border-bottom:1px solid #f0f0f0;"
                     onclick="selectSponsor(${s.sponsorId}, this)"
                     data-id="${s.sponsorId}">
                    ${s.logoUrl ? `<img src="${s.logoUrl}" style="width:32px;height:32px;object-fit:contain;">` : '<span style="width:32px;text-align:center;">🏢</span>'}
                    <div>
                        <div class="fw-semibold" style="font-size:.9rem;">${s.sponsorName}</div>
                        ${s.email ? `<div class="text-muted" style="font-size:.78rem;">${s.email}</div>` : ''}
                    </div>
                </div>`).join('')
            : '<div class="text-muted text-center py-3">Không có nhà tài trợ nào.</div>';
    }

    function filterSponsors() {
        const q = document.getElementById('sponsorSearch').value.toLowerCase();
        renderSponsorList(allSponsors.filter(s => s.sponsorName.toLowerCase().includes(q)));
    }

    function selectSponsor(id, el) {
        selectedSponsorId = id;
        document.querySelectorAll('.sponsor-pick-item').forEach(e => e.style.background = '');
        el.style.background = '#e8f5e9';
    }

    async function confirmAddSponsor() {
        if (!selectedSponsorId) { alert('Vui lòng chọn một nhà tài trợ.'); return; }
        const dto = {
            sponsorId: selectedSponsorId,
            sponsorshipLevel:   document.getElementById('asl-level').value,
            contributionAmount: parseFloat(document.getElementById('asl-amount').value) || 0,
            currency:           document.getElementById('asl-currency').value,
            notes:              document.getElementById('asl-notes').value,
            isDisplayed:        document.getElementById('asl-display').checked,
            displayOrder:       parseInt(document.getElementById('asl-order').value) || 0
        };
        const res = await fetch(`/Organizer/AddSponsor?competitionId=${CID}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify(dto)
        });
        const data = await res.json();
        if (data.success) { showToast(data.message, 'success'); bootstrap.Modal.getInstance(document.getElementById('addSponsorModal')).hide(); setTimeout(() => location.reload(), 600); }
        else showToast(data.message, 'danger');
    }

    async function confirmCreateSponsor() {
        const name = document.getElementById('cs-name').value.trim();
        if (!name) { alert('Vui lòng nhập tên nhà tài trợ.'); return; }
        const dto = {
            sponsorName: name, email: document.getElementById('cs-email').value,
            sponsorshipLevel: document.getElementById('cs-level').value,
            contributionAmount: parseFloat(document.getElementById('cs-amount').value) || 0,
            currency: document.getElementById('cs-currency').value,
            notes: document.getElementById('cs-notes').value,
            isDisplayed: true, displayOrder: 0
        };
        const res = await fetch(`/Organizer/CreateSponsor?competitionId=${CID}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify(dto)
        });
        const data = await res.json();
        if (data.success) { showToast(data.message, 'success'); bootstrap.Modal.getInstance(document.getElementById('createSponsorModal')).hide(); setTimeout(() => location.reload(), 600); }
        else showToast(data.message, 'danger');
    }

    function openCreateSponsorModal() { new bootstrap.Modal(document.getElementById('createSponsorModal')).show(); }

    function editSponsorLink(csId, level, amount, currency, isDisplayed, order, notes) {
        document.getElementById('edit-csid').value = csId;
        document.getElementById('edit-level').value = level;
        document.getElementById('edit-amount').value = amount;
        document.getElementById('edit-currency').value = currency;
        document.getElementById('edit-display').checked = isDisplayed;
        document.getElementById('edit-order').value = order;
        document.getElementById('edit-notes').value = notes;
        new bootstrap.Modal(document.getElementById('editSponsorModal')).show();
    }

    async function confirmEditSponsor() {
        const csId = document.getElementById('edit-csid').value;
        const dto = {
            sponsorId: 0,
            sponsorshipLevel:   document.getElementById('edit-level').value,
            contributionAmount: parseFloat(document.getElementById('edit-amount').value) || 0,
            currency:           document.getElementById('edit-currency').value,
            notes:              document.getElementById('edit-notes').value,
            isDisplayed:        document.getElementById('edit-display').checked,
            displayOrder:       parseInt(document.getElementById('edit-order').value) || 0
        };
        const res = await fetch(`/Organizer/UpdateSponsorLink?competitionSponsorId=${csId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify(dto)
        });
        const data = await res.json();
        if (data.success) { showToast(data.message, 'success'); bootstrap.Modal.getInstance(document.getElementById('editSponsorModal')).hide(); setTimeout(() => location.reload(), 600); }
        else showToast(data.message, 'danger');
    }

    async function removeSponsor(csId) {
        if (!confirm('Xóa nhà tài trợ này khỏi cuộc thi?')) return;
        const res = await fetch(`/Organizer/RemoveSponsor?competitionSponsorId=${csId}&competitionId=${CID}`, {
            method: 'POST', headers: { 'RequestVerificationToken': getToken() }
        });
        const data = await res.json();
        if (data.success) { document.getElementById(`cs-${csId}`)?.remove(); showToast('Đã xóa nhà tài trợ.', 'success'); }
        else showToast(data.message, 'danger');
    }

    // ═══════════════════════════════════ UTILITIES ═══════════════════════════

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    function showToast(msg, type = 'success') {
        const t = document.createElement('div');
        t.className = `alert alert-${type} shadow position-fixed bottom-0 end-0 m-3`;
        t.style.cssText = 'z-index:9999;min-width:260px;';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3000);
    }

    // Drag & drop ảnh
    const imgArea = document.querySelector('.upload-area');
    if (imgArea) {
        imgArea.addEventListener('dragover', e => { e.preventDefault(); imgArea.style.borderColor='var(--organizer-accent)'; });
        imgArea.addEventListener('dragleave', () => imgArea.style.borderColor='#d0d0d0');
        imgArea.addEventListener('drop', e => {
            e.preventDefault(); imgArea.style.borderColor='#d0d0d0';
            document.getElementById('imgInput').files = e.dataTransfer.files; handleImgSelect();
        });
    }

    // Toggle team size — phải set disabled để browser validation không block submit
    function syncTeamSizeField(isTeam) {
        const g   = document.getElementById('maxTeamSizeGroup');
        const inp = document.getElementById('MaxTeamSize');
        if (g)   g.style.display = isTeam ? '' : 'none';
        if (inp) inp.disabled    = !isTeam;
    }

    document.getElementById('chkTeam')?.addEventListener('change', function() {
        syncTeamSizeField(this.checked);
    });

    const ACTIVE_TAB_KEY = 'editCompetitionTab_@cid';

    document.addEventListener('DOMContentLoaded', () => {
        updateTotalWeight();
        updateHiddenWeightValues();
        const chk = document.getElementById('chkTeam');
        syncTeamSizeField(chk ? chk.checked : false);

        // Khôi phục tab đang mở trước khi submit
        const savedTab = sessionStorage.getItem(ACTIVE_TAB_KEY);
        if (savedTab) {
            const tabEl = document.querySelector(`[href="${savedTab}"]`);
            if (tabEl) bootstrap.Tab.getOrCreateInstance(tabEl).show();
            sessionStorage.removeItem(ACTIVE_TAB_KEY);
        }

        // Nếu có lỗi → scroll lên đầu để thấy thông báo
        const errDiv = document.querySelector('.alert-danger');
        if (errDiv) {
            errDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // Lưu tab hiện tại khi user chuyển tab
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tabBtn => {
            tabBtn.addEventListener('shown.bs.tab', e => {
                const activeHref = e.target.getAttribute('href');
                sessionStorage.setItem(ACTIVE_TAB_KEY, activeHref);
            });
        });
    });

    document.getElementById('editForm').addEventListener('submit', () => {
        updateHiddenWeightValues();
        const chk = document.getElementById('chkTeam');
        syncTeamSizeField(chk ? chk.checked : false);
        // Lưu tab đang active để khôi phục sau reload
        const activeTab = document.querySelector('[data-bs-toggle="tab"].active');
        if (activeTab) sessionStorage.setItem(ACTIVE_TAB_KEY, activeTab.getAttribute('href'));
    });
</script>
}
