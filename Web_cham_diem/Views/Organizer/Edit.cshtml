    async function updateRoundAjax(roundId) {
        const name  = document.getElementById(`rName-${roundId}`)?.value?.trim();
        const start = document.getElementById(`rStart-${roundId}`)?.value;
        const end   = document.getElementById(`rEnd-${roundId}`)?.value;
        const msg   = document.getElementById(`roundEditMsg-${roundId}`);

        if (!name || !start || !end) {
            msg.innerHTML = '<span class="text-danger">Vui lòng điền đầy đủ thông tin.</span>';
            return;
        }
        if (new Date(start) >= new Date(end)) {
            msg.innerHTML = '<span class="text-danger">Ngày bắt đầu phải trước ngày kết thúc.</span>';
            return;
        }

        msg.innerHTML = '<span class="text-secondary">Đang lưu...</span>';
        try {
            const res = await fetch(`/Organizer/UpdateRegistrationRound?roundId=${roundId}&competitionId=${CID}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({ roundName: name, startDate: toUtcIso(start), endDate: toUtcIso(end) })
            });
            const data = await res.json();
            if (data.success) {
                msg.innerHTML = '<span class="text-success">✓ Đã lưu đợt đăng ký.</span>';
                setTimeout(() => { msg.innerHTML = ''; }, 3000);
            } else {
                msg.innerHTML = `<span class="text-danger">${data.message}</span>`;
            }
        } catch (e) {
            msg.innerHTML = '<span class="text-danger">Lỗi kết nối, vui lòng thử lại.</span>';
        }
    }

    async function addRoundAjax() {
        const name  = document.getElementById('newRoundName').value.trim();
        const start = document.getElementById('newRoundStart').value;
        const end   = document.getElementById('newRoundEnd').value;
        const msg   = document.getElementById('roundMsg');

        if (!name || !start || !end) { msg.innerHTML = '<span class="text-danger">Vui lòng điền đầy đủ.</span>'; return; }

        // Lấy ngày bắt đầu cuộc thi hiện tại trong form (có thể chưa được lưu)
        const pendingStartRaw = document.getElementById('StartDate')?.value;
        if (pendingStartRaw && new Date(end) > new Date(pendingStartRaw)) {
            msg.innerHTML = '<span class="text-danger">Hạn đăng ký phải trước hoặc bằng ngày bắt đầu cuộc thi.</span>';
            return;
        }

        const urlBase = `/Organizer/AddRegistrationRound?competitionId=${CID}`;
        const url = pendingStartRaw
            ? `${urlBase}&pendingStartDate=${encodeURIComponent(toUtcIso(pendingStartRaw))}`
            : urlBase;

        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ roundName: name, startDate: toUtcIso(start), endDate: toUtcIso(end) })
        });
        const data = await res.json();
        if (data.success) {
            msg.innerHTML = '<span class="text-success">✓ Thêm đợt thành công! Đang tải lại...</span>';
            setTimeout(() => location.reload(), 800);
        } else {
            msg.innerHTML = `<span class="text-danger">${data.message}</span>`;
        }
    }

