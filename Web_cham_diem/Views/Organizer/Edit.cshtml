            </div>
            <div class="modal-body">
                <input type="text" id="sponsorSearch" class="form-control mb-3" placeholder="Tìm theo tên..." oninput="filterSponsors()">
                <div id="sponsorPickList" style="max-height:260px; overflow-y:auto; border:1px solid #eee; border-radius:6px; padding:8px;"></div>
                <hr>
                <div class="row g-2 mt-1">
                    <div class="col-md-3">
