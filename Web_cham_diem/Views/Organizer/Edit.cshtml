    }

    function openCreateSponsorModal() { new bootstrap.Modal(document.getElementById('createSponsorModal')).show(); }

    function editSponsorLink(csId, level, amount, currency, isDisplayed, order, notes) {
        document.getElementById('edit-csid').value = csId;
        document.getElementById('edit-level').value = level;
        document.getElementById('edit-amount').value = amount;
        document.getElementById('edit-currency').value = currency;
        document.getElementById('edit-display').checked = isDisplayed;
        document.getElementById('edit-order').value = order;
        document.getElementById('edit-notes').value = notes;
        new bootstrap.Modal(document.getElementById('editSponsorModal')).show();
    }

    async function confirmEditSponsor() {
        const csId = document.getElementById('edit-csid').value;
        const dto = {
            sponsorId: 0,
            sponsorshipLevel:   document.getElementById('edit-level').value,
            contributionAmount: parseFloat(document.getElementById('edit-amount').value) || 0,
            currency:           document.getElementById('edit-currency').value,
            notes:              document.getElementById('edit-notes').value,
            isDisplayed:        document.getElementById('edit-display').checked,
            displayOrder:       parseInt(document.getElementById('edit-order').value) || 0
        };
        const res = await fetch(`/Organizer/UpdateSponsorLink?competitionSponsorId=${csId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify(dto)
        });
        const data = await res.json();
        if (data.success) { showToast(data.message, 'success'); bootstrap.Modal.getInstance(document.getElementById('editSponsorModal')).hide(); setTimeout(() => location.reload(), 600); }
        else showToast(data.message, 'danger');
    }

    async function removeSponsor(csId) {
        if (!confirm('Xóa nhà tài trợ này khỏi cuộc thi?')) return;
        const res = await fetch(`/Organizer/RemoveSponsor?competitionSponsorId=${csId}&competitionId=${CID}`, {
            method: 'POST', headers: { 'RequestVerificationToken': getToken() }
        });
        const data = await res.json();
        if (data.success) { document.getElementById(`cs-${csId}`)?.remove(); showToast('Đã xóa nhà tài trợ.', 'success'); }
        else showToast(data.message, 'danger');
    }

    // ═══════════════════════════════════ UTILITIES ═══════════════════════════

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    function showToast(msg, type = 'success') {
        const t = document.createElement('div');
        t.className = `alert alert-${type} shadow position-fixed bottom-0 end-0 m-3`;
        t.style.cssText = 'z-index:9999;min-width:260px;';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3000);
    }

    // Drag & drop ảnh
    const imgArea = document.querySelector('.upload-area');
    if (imgArea) {
        imgArea.addEventListener('dragover', e => { e.preventDefault(); imgArea.style.borderColor='var(--organizer-accent)'; });
        imgArea.addEventListener('dragleave', () => imgArea.style.borderColor='#d0d0d0');
        imgArea.addEventListener('drop', e => {
            e.preventDefault(); imgArea.style.borderColor='#d0d0d0';
            document.getElementById('imgInput').files = e.dataTransfer.files; handleImgSelect();
        });
    }

    // Toggle team size — phải set disabled để browser validation không block submit
    function syncTeamSizeField(isTeam) {
        const g   = document.getElementById('maxTeamSizeGroup');
        const inp = document.getElementById('MaxTeamSize');
        if (g)   g.style.display = isTeam ? '' : 'none';
        if (inp) inp.disabled    = !isTeam;
    }

    document.getElementById('chkTeam')?.addEventListener('change', function() {
        syncTeamSizeField(this.checked);
    });

    const ACTIVE_TAB_KEY = 'editCompetitionTab_@cid';

    document.addEventListener('DOMContentLoaded', () => {
        const chk = document.getElementById('chkTeam');
        syncTeamSizeField(chk ? chk.checked : false);

        // Khôi phục tab đang mở trước khi submit
        const savedTab = sessionStorage.getItem(ACTIVE_TAB_KEY);
        if (savedTab) {
            const tabEl = document.querySelector(`[href="${savedTab}"]`);
            if (tabEl) bootstrap.Tab.getOrCreateInstance(tabEl).show();
            sessionStorage.removeItem(ACTIVE_TAB_KEY);
        }

        // Luôn tải form fields ngay khi trang load
        loadFormFields();

        // Nếu có lỗi → scroll lên đầu để thấy thông báo
        const errDiv = document.querySelector('.alert-danger');
        if (errDiv) {
            errDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // Lưu tab hiện tại khi user chuyển tab
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tabBtn => {
            tabBtn.addEventListener('shown.bs.tab', e => {
                const activeHref = e.target.getAttribute('href');
                sessionStorage.setItem(ACTIVE_TAB_KEY, activeHref);
            });
        });
    });

    document.getElementById('editForm').addEventListener('submit', async function(e) {
        const chk = document.getElementById('chkTeam');
        syncTeamSizeField(chk ? chk.checked : false);
        // Lưu tab đang active để khôi phục sau reload
        const activeTab = document.querySelector('[data-bs-toggle="tab"].active');
        if (activeTab) sessionStorage.setItem(ACTIVE_TAB_KEY, activeTab.getAttribute('href'));

        const hasPendingImages = pendingImages.length > 0;
        const hasPendingDocs   = pendingDocs.length > 0;
        const newCrStart = document.getElementById('newCrStart')?.value;
        const newCrEnd   = document.getElementById('newCrEnd')?.value;
        const hasNewRound = !!(newCrStart && newCrEnd);

        if (hasPendingImages || hasPendingDocs || hasNewRound) {
            e.preventDefault();
            try {
                if (hasPendingImages) {
                    const res = await fetch(`/Organizer/UploadImages?competitionId=${CID}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                        body: JSON.stringify(pendingImages.map(i => i.data))
                    });
                    const data = await res.json();
                    if (!data.success) { showToast('Lỗi upload ảnh: ' + (data.message || 'Có lỗi xảy ra'), 'danger'); return; }
                    pendingImages = [];
                }
                if (hasPendingDocs) {
                    const res = await fetch(`/Organizer/UploadDocuments?competitionId=${CID}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                        body: JSON.stringify({ dataList: pendingDocs.map(d => d.data), fileNames: pendingDocs.map(d => d.name) })
                    });
                    const data = await res.json();
                    if (!data.success) { showToast('Lỗi upload tài liệu: ' + (data.message || 'Có lỗi xảy ra'), 'danger'); return; }
                    pendingDocs = [];
                }
                if (hasNewRound) {
                    // addCompRoundAjax(true) tự gọi form.submit() khi thành công
                    await addCompRoundAjax(true);
                    return;
                }
                document.getElementById('editForm').submit();
            } catch (err) {
                showToast('Lỗi kết nối, vui lòng thử lại.', 'danger');
            }
        }
    });

    // ══════════════════════════ FORM FIELDS (BIỂU MẪU) ═══════════════════════

    let formFieldSortable = null;
    let formFieldsLoaded = false;

    function loadFormFields() {
        if (formFieldsLoaded) return;
        fetch(`/Organizer/GetFormFields?competitionId=${CID}`)
            .then(r => r.json())
            .then(fields => {
                formFieldsLoaded = true;
                renderFormPreview(fields);
            })
            .catch(() => {
                document.getElementById('fpCustomFields').innerHTML =
                    '<div class="alert alert-danger mb-2">Không thể tải dữ liệu.</div>';
            });
    }

    const fieldTypeLabels = {
        Text: 'Text', Textarea: 'Textarea', Select: 'Select',
        Checkbox: 'Checkbox', File: 'File', Date: 'Date',
        Number: 'Number', Email: 'Email'
    };

    function buildFieldInputPreview(f) {
        const ph = escHtml(f.placeholder || '');
        if (f.fieldType === 'Textarea')
            return `<textarea class="form-control form-control-sm" rows="2" disabled placeholder="${ph}"></textarea>`;
        if (f.fieldType === 'Select') {
            let opts = '<option value="">-- Chọn --</option>';
            if (f.options) {
                try { JSON.parse(f.options).forEach(o => { opts += `<option>${escHtml(o)}</option>`; }); } catch {}
            }
            return `<select class="form-select form-select-sm" disabled>${opts}</select>`;
        }
        if (f.fieldType === 'Checkbox')
            return `<div class="form-check mt-1"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label small">${ph || 'Có'}</label></div>`;
        if (f.fieldType === 'File')
            return `<input type="file" class="form-control form-control-sm" disabled>`;
        if (f.fieldType === 'Date')
            return `<input type="date" class="form-control form-control-sm" disabled>`;
        if (f.fieldType === 'Number')
            return `<input type="number" class="form-control form-control-sm" disabled placeholder="${ph}">`;
        if (f.fieldType === 'Email')
            return `<input type="email" class="form-control form-control-sm" disabled placeholder="${ph || 'example@email.com'}">`;
        return `<input type="text" class="form-control form-control-sm" disabled placeholder="${ph}">`;
    }

    function renderFormPreview(fields) {
        const container = document.getElementById('fpCustomFields');
        container.innerHTML = '';

        if (!fields || fields.length === 0) {
            // Để trống — nút "Thêm trường tùy chỉnh" vẫn hiện
            return;
        }

        fields.forEach(f => container.appendChild(buildCustomFieldItem(f)));

        if (formFieldSortable) formFieldSortable.destroy();
        formFieldSortable = Sortable.create(container, {
            handle: '.fp-drag-handle',
            animation: 150,
            ghostClass: 'sortable-ghost',
            onEnd: () => saveFieldOrder()
        });
    }

    function buildCustomFieldItem(f) {
        const wrap = document.createElement('div');
        wrap.className = 'fp-custom-field';
        wrap.dataset.fieldId = f.fieldId;

        const hiddenBadge = !f.isActive
            ? '<span class="badge bg-secondary ms-1" style="font-size:.65rem;">Ẩn</span>' : '';
        const reqMark = f.isRequired ? '<span class="text-danger ms-1">*</span>' : '';
        const helpHtml = f.helpText
            ? `<div class="text-muted mt-1" style="font-size:.75rem;">${escHtml(f.helpText)}</div>` : '';

        wrap.innerHTML = `
            <div class="fp-custom-field-inner">
                <div class="fp-custom-header">
                    <span class="fp-drag-handle bi bi-grip-vertical"></span>
                    <span class="fp-custom-label">${escHtml(f.fieldLabel)}${reqMark}${hiddenBadge}</span>
                    <span class="fp-type-chip ft-${f.fieldType}">${fieldTypeLabels[f.fieldType] || f.fieldType}</span>
                    <div class="fp-custom-actions">
                        <button type="button" class="fp-action-btn fp-action-edit" onclick="openEditFieldModal(${f.fieldId})" title="Sửa">
                            <i class="bi bi-pencil me-1"></i>Sửa
                        </button>
                        <button type="button" class="fp-action-btn fp-action-del" onclick="deleteField(${f.fieldId})" title="Xóa">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                ${buildFieldInputPreview(f)}
                ${helpHtml}
            </div>`;
        return wrap;
    }

    function saveFieldOrder() {
        const container = document.getElementById('fpCustomFields');
        if (!container) return;
        const ids = [...container.querySelectorAll('.fp-custom-field')].map(el => parseInt(el.dataset.fieldId));
        fetch(`/Organizer/ReorderFormFields?competitionId=${CID}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
            body: JSON.stringify(ids)
        })
        .then(r => r.json())
        .then(d => { if (!d.success) showToast(d.message, 'warning'); });
    }

    function openAddFieldModal() {
        document.getElementById('formFieldModalTitle').textContent = 'Thêm trường mới';
        document.getElementById('ff-fieldId').value = '0';
        document.getElementById('ff-label').value = '';
        document.getElementById('ff-type').value = 'Text';
        document.getElementById('ff-required').checked = false;
        document.getElementById('ff-active').checked = true;
        document.getElementById('ff-options').value = '';
        document.getElementById('ff-placeholder').value = '';
        document.getElementById('ff-helptext').value = '';
        onFieldTypeChange();
        new bootstrap.Modal(document.getElementById('formFieldModal')).show();
    }

    function openEditFieldModal(fieldId) {
        const row = document.querySelector(`.field-row[data-field-id="${fieldId}"]`);
        // Re-fetch fresh data
        fetch(`/Organizer/GetFormFields?competitionId=${CID}`)
            .then(r => r.json())
            .then(fields => {
                const f = fields.find(x => x.fieldId === fieldId);
                if (!f) return;
                document.getElementById('formFieldModalTitle').textContent = 'Sửa trường';
                document.getElementById('ff-fieldId').value = f.fieldId;
                document.getElementById('ff-label').value = f.fieldLabel;
                document.getElementById('ff-type').value = f.fieldType;
                document.getElementById('ff-required').checked = f.isRequired;
                document.getElementById('ff-active').checked = f.isActive;
                // Convert JSON options array to one-per-line
                if (f.options) {
                    try { document.getElementById('ff-options').value = JSON.parse(f.options).join('\n'); }
                    catch { document.getElementById('ff-options').value = f.options; }
                } else {
                    document.getElementById('ff-options').value = '';
                }
                document.getElementById('ff-placeholder').value = f.placeholder || '';
                document.getElementById('ff-helptext').value = f.helpText || '';
                onFieldTypeChange();
                new bootstrap.Modal(document.getElementById('formFieldModal')).show();
            });
    }

    function onFieldTypeChange() {
        const type = document.getElementById('ff-type').value;
        const optGrp = document.getElementById('ff-options-group');
        const plhGrp = document.getElementById('ff-placeholder-group');
        optGrp.style.display = type === 'Select' ? '' : 'none';
        plhGrp.style.display = (type === 'Checkbox' || type === 'File') ? 'none' : '';
    }

    async function saveFormField() {
        const fieldId = parseInt(document.getElementById('ff-fieldId').value);
        const label = document.getElementById('ff-label').value.trim();
        const type = document.getElementById('ff-type').value;
        if (!label) { showToast('Vui lòng nhập nhãn trường.', 'warning'); return; }

        let options = null;
        if (type === 'Select') {
            const lines = document.getElementById('ff-options').value
                .split('\n').map(l => l.trim()).filter(l => l.length > 0);
            if (lines.length < 2) { showToast('Vui lòng nhập ít nhất 2 lựa chọn.', 'warning'); return; }
            options = JSON.stringify(lines);
        }

        const dto = {
            fieldLabel:   label,
            fieldType:    type,
            isRequired:   document.getElementById('ff-required').checked,
            isActive:     document.getElementById('ff-active').checked,
            placeholder:  document.getElementById('ff-placeholder').value.trim() || null,
            helpText:     document.getElementById('ff-helptext').value.trim() || null,
            options:      options,
            displayOrder: 0
        };

        const isEdit = fieldId > 0;
        const url = isEdit
            ? `/Organizer/UpdateFormField?fieldId=${fieldId}&competitionId=${CID}`
            : `/Organizer/AddFormField?competitionId=${CID}`;

        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
            body: JSON.stringify(dto)
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.message, 'success');
            bootstrap.Modal.getInstance(document.getElementById('formFieldModal')).hide();
            formFieldsLoaded = false;
            loadFormFields();
        } else {
            showToast(data.message, 'danger');
        }
    }

    async function deleteField(fieldId) {
        if (!confirm('Xóa trường này? Dữ liệu thí sinh đã điền cũng sẽ bị xóa.')) return;
        const res = await fetch(`/Organizer/DeleteFormField?fieldId=${fieldId}&competitionId=${CID}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        const data = await res.json();
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) { formFieldsLoaded = false; loadFormFields(); }
    }

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function escHtml(str) {
        return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
</script>
}
