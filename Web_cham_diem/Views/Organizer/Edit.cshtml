@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
    const CID = @cid;

    // ═══════════════════════════════════ SCHEDULE DATES ═════════════════════════

    async function saveScheduleDates() {
        const startVal = document.getElementById('StartDate')?.value;
        const endVal   = document.getElementById('EndDate')?.value;
        const subVal   = document.getElementById('SubmissionDeadline')?.value;
        const maxP     = document.getElementById('MaxParticipants')?.value;
        const maxT     = document.getElementById('MaxTeamSize')?.value;
        const msg      = document.getElementById('scheduleDatesMsg');

        if (!startVal || !endVal || !subVal) {
            msg.innerHTML = '<span class="text-danger">Vui lòng điền đầy đủ các ngày.</span>';
            return;
        }
        if (new Date(endVal) <= new Date(startVal)) {
            msg.innerHTML = '<span class="text-danger">Ngày kết thúc phải sau ngày bắt đầu.</span>';
            return;
        }
        if (new Date(subVal) > new Date(endVal)) {
            msg.innerHTML = '<span class="text-danger">Hạn nộp bài phải trước hoặc bằng ngày kết thúc.</span>';
            return;
        }

        msg.innerHTML = '<span class="text-secondary">Đang lưu...</span>';
        try {
            const res = await fetch(`/Organizer/UpdateScheduleDates?competitionId=${CID}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({
                    startDate:          toUtcIso(startVal),
                    endDate:            toUtcIso(endVal),
                    submissionDeadline: toUtcIso(subVal),
                    maxParticipants:    parseInt(maxP) || 1,
                    maxTeamSize:        maxT ? parseInt(maxT) : null
                })
            });
            const data = await res.json();
            if (data.success) {
                msg.innerHTML = '<span class="text-success">✓ ' + data.message + '</span>';
                setTimeout(() => { msg.innerHTML = ''; }, 3000);
            } else {
                msg.innerHTML = `<span class="text-danger">${data.message}</span>`;
            }
        } catch (e) {
            msg.innerHTML = '<span class="text-danger">Lỗi kết nối, vui lòng thử lại.</span>';
        }
    }

    // ═══════════════════════════════════ PER-ROUND CRITERIA ════════════════════

    function addRoundCriteria(btn) {
        const roundCard = btn.closest('.comp-round-card');
        const container = roundCard.querySelector('.round-criteria-container');
        const idx = container.querySelectorAll('.round-criteria-item').length;
        container.insertAdjacentHTML('beforeend', `
            <div class="round-criteria-item">
                <div>
                    <label class="form-label" style="font-size:.75rem; margin-bottom:2px;">Tên tiêu chí</label>
                    <input type="text" class="form-control form-control-sm cr-crit-name" placeholder="VD: Sáng tạo...">
                </div>
                <div>
                    <label class="form-label" style="font-size:.75rem; margin-bottom:2px;">Điểm tối đa</label>
                    <input type="number" class="form-control form-control-sm cr-crit-score" value="100" min="1" step="0.1">
                </div>
                <div>
                    <label class="form-label" style="font-size:.75rem; margin-bottom:2px;">Trọng số</label>
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control round-criteria-weight-input" value="0" min="0" max="100" step="0.1"
                               onchange="updateRoundWeight(this.closest('.comp-round-card'))"
                               oninput="updateRoundWeight(this.closest('.comp-round-card'))">
                        <span class="input-group-text" style="font-size:.8rem;">%</span>
                    </div>
                </div>
                <div style="display:flex; align-items:flex-end;">
                    <button type="button" class="btn btn-sm remove-btn" onclick="removeRoundCriteria(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>`);
        updateRoundWeight(roundCard);
    }

    function removeRoundCriteria(btn) {
        const roundCard = btn.closest('.comp-round-card');
        btn.closest('.round-criteria-item').remove();
        updateRoundWeight(roundCard);
    }

    function updateRoundWeight(roundCard) {
        const items = roundCard.querySelectorAll('.round-criteria-item');
        const total = Array.from(items).reduce((s, item) => {
            const inp = item.querySelector('.round-criteria-weight-input');
            return s + (parseFloat(inp?.value) || 0);
        }, 0);
        const display = roundCard.querySelector('.round-weight-display');
        const status  = roundCard.querySelector('.round-weight-status');
        if (display) display.textContent = total.toFixed(1);
        if (status) {
            const ok = items.length > 0 && Math.abs(total - 100) <= 0.1;
            status.innerHTML = items.length === 0 ? '' : (ok ? '<span style="color:#22c55e;">✓</span>' : '<span style="color:#ef4444;">❌</span>');
        }
    }

    function toggleRoundOnline(checkbox) {
        const roundCard = checkbox.closest('.comp-round-card');
        const onlineSection  = roundCard.querySelector('.round-online-section');
        const offlineSection = roundCard.querySelector('.round-offline-section');
        if (checkbox.checked) {
            onlineSection.style.display  = '';
            offlineSection.style.display = 'none';
        } else {
            onlineSection.style.display  = 'none';
            offlineSection.style.display = '';
        }
    }

    function toggleNewRoundOnline(checkbox) {
        document.getElementById('newCrOnlineSection').style.display  = checkbox.checked ? '' : 'none';
        document.getElementById('newCrOfflineSection').style.display = checkbox.checked ? 'none' : '';
    }

    function addNewRoundCriteria() {
        const container = document.getElementById('newCrCriteria');
        const idx = container.querySelectorAll('.round-criteria-item').length;
        container.insertAdjacentHTML('beforeend', `
            <div class="round-criteria-item">
                <div>
                    <label class="form-label" style="font-size:.75rem; margin-bottom:2px;">Tên tiêu chí</label>
                    <input type="text" class="form-control form-control-sm cr-crit-name" placeholder="VD: Sáng tạo...">
                </div>
                <div>
                    <label class="form-label" style="font-size:.75rem; margin-bottom:2px;">Điểm tối đa</label>
                    <input type="number" class="form-control form-control-sm cr-crit-score" value="100" min="1" step="0.1">
                </div>
                <div>
                    <label class="form-label" style="font-size:.75rem; margin-bottom:2px;">Trọng số</label>
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control round-criteria-weight-input" value="0" min="0" max="100" step="0.1"
                               onchange="updateNewRoundWeight()" oninput="updateNewRoundWeight()">
                        <span class="input-group-text" style="font-size:.8rem;">%</span>
                    </div>
                </div>
                <div style="display:flex; align-items:flex-end;">
                    <button type="button" class="btn btn-sm remove-btn" onclick="this.closest('.round-criteria-item').remove(); updateNewRoundWeight();">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>`);
        updateNewRoundWeight();
    }

    function updateNewRoundWeight() {
        const items = document.querySelectorAll('#newCrCriteria .round-criteria-item');
        const total = Array.from(items).reduce((s, item) => {
            return s + (parseFloat(item.querySelector('.round-criteria-weight-input')?.value) || 0);
        }, 0);
        document.getElementById('newCrWeightDisplay').textContent = total.toFixed(1);
        const ok = items.length > 0 && Math.abs(total - 100) <= 0.1;
        document.getElementById('newCrWeightStatus').innerHTML = items.length === 0 ? '' :
            (ok ? '<span style="color:#22c55e;">✓</span>' : '<span style="color:#ef4444;">❌</span>');
    }

    function collectRoundCriteria(container) {
        return Array.from(container.querySelectorAll('.round-criteria-item')).map((item, i) => ({
            criteriaName: item.querySelector('.cr-crit-name')?.value?.trim() || '',
            maxScore: parseFloat(item.querySelector('.cr-crit-score')?.value) || 100,
            weight: (parseFloat(item.querySelector('.round-criteria-weight-input')?.value) || 0) / 100,
            order: i + 1
        })).filter(c => c.criteriaName);
    }

