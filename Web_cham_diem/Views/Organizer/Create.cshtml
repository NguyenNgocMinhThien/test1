                        <input type="text" name="CompetitionRounds[${roundIdx}].ScoringCriteria[${criteriaIdx}].CriteriaName"
                               class="form-control" placeholder="VD: Sáng tạo, Kỹ thuật..." style="font-size:0.9rem;">
                    </div>
                    <div>
                        <label class="form-label" style="font-size:0.8rem; margin-bottom:4px;">Điểm tối đa</label>
                        <input type="number" name="CompetitionRounds[${roundIdx}].ScoringCriteria[${criteriaIdx}].MaxScore"
                               class="form-control" value="100" min="1" step="0.1" style="font-size:0.9rem;">
                    </div>
                    <div>
                        <label class="form-label" style="font-size:0.8rem; margin-bottom:4px;">Trọng số (%)</label>
                        <div class="input-group">
                            <input type="number" class="form-control round-criteria-weight-input"
                                   value="0" min="0" max="100" step="0.1"
                                   onchange="updateRoundWeight(this.closest('.comp-round-item'))"
                                   oninput="updateRoundWeight(this.closest('.comp-round-item'))"
                                   style="font-size:0.9rem;">
                            <input type="hidden" name="CompetitionRounds[${roundIdx}].ScoringCriteria[${criteriaIdx}].Weight"
                                   class="round-criteria-weight-value">
                            <span class="input-group-text" style="font-size:0.85rem;">%</span>
                        </div>
                    </div>
                    <div style="display:flex; align-items:flex-end;">
                        <button type="button" class="remove-criteria-btn" onclick="removeRoundCriteria(this)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            updateRoundWeight(roundCard);
        }

        function removeRoundCriteria(btn) {
            const roundCard = btn.closest('.comp-round-item');
            btn.closest('.round-criteria-item').remove();
            const roundIdx  = parseInt(roundCard.dataset.index);
            const container = roundCard.querySelector('.round-criteria-container');
            container.querySelectorAll('.round-criteria-item').forEach((item, cidx) => {
                item.querySelectorAll('input[name]').forEach(el => {
                    el.name = el.name.replace(/ScoringCriteria\[\d+\]/g, `ScoringCriteria[${cidx}]`);
                });
                const orderEl = item.querySelector('[name$=".Order"]');
                if (orderEl) orderEl.value = cidx + 1;
            });
            updateRoundWeight(roundCard);
        }

        function updateRoundWeight(roundCard) {
            if (!roundCard) return;
            const container = roundCard.querySelector('.round-criteria-container');
            if (!container) return;
            const weights = Array.from(container.querySelectorAll('.round-criteria-weight-input'))
                .map(el => parseFloat(el.value) || 0).reduce((a, b) => a + b, 0);

            const weightDisplay = roundCard.querySelector('.round-weight-display');
            const weightStatus  = roundCard.querySelector('.round-weight-status');
            if (weightDisplay) weightDisplay.textContent = weights.toFixed(1);
            if (weightStatus) {
                const count = container.querySelectorAll('.round-criteria-item').length;
                if (count === 0) {
                    weightStatus.innerHTML = '';
                } else if (Math.abs(weights - 100) > 0.1) {
                    weightStatus.innerHTML = '<span style="color:#ef4444;">❌ Sai</span>';
                } else {
                    weightStatus.innerHTML = '<span style="color:#22c55e;">✓ Đúng</span>';
                }
            }
        }

        function updateAllRoundHiddenWeights() {
            document.querySelectorAll('.comp-round-item').forEach(roundCard => {
                roundCard.querySelectorAll('.round-criteria-item').forEach(item => {
                    const displayInput = item.querySelector('.round-criteria-weight-input');
                    const hiddenInput  = item.querySelector('.round-criteria-weight-value');
                    if (!displayInput || !hiddenInput) return;
                    hiddenInput.value = (parseFloat(displayInput.value) / 100 || 0).toFixed(4);
                });
            });
        }

        // ===== TOGGLE ONLINE/OFFLINE =====
        function toggleRoundOnline(checkbox) {
            const roundCard      = checkbox.closest('.comp-round-item');
            const onlineSection  = roundCard.querySelector('.round-online-section');
            const offlineSection = roundCard.querySelector('.round-offline-section');
            if (checkbox.checked) {
                onlineSection.style.display  = 'block';
                offlineSection.style.display = 'none';
            } else {
                onlineSection.style.display  = 'none';
                offlineSection.style.display = 'block';
            }
        }

        // ===== TEAM SIZE TOGGLE =====
        function toggleTeamSizeField() {
            const isTeamBased = document.querySelector('[name="IsTeamBased"]').checked;
            const groupTeam   = document.getElementById('maxTeamSizeGroup');
            const labelMax    = document.getElementById('labelMaxParticipants');
            groupTeam.style.display = isTeamBased ? 'block' : 'none';
            labelMax.innerHTML = isTeamBased
                ? 'Số đội tối đa <span class="required">*</span>'
                : 'Số thí sinh tối đa <span class="required">*</span>';
        }

        // ===== IMAGE UPLOAD =====
        function handleImageSelect() {
            const files = document.getElementById('imageInput').files;
            for (let file of files) {
                if (file.size > 5 * 1024 * 1024) { alert(`❌ File ${file.name} vượt quá 5MB`); continue; }
                if (!file.type.startsWith('image/')) { alert(`❌ ${file.name} không phải là file ảnh`); continue; }
                const reader = new FileReader();
                reader.onload = (e) => { selectedImages.push({ name: file.name, data: e.target.result }); updateImagePreview(); };
                reader.readAsDataURL(file);
            }
        }

        function updateImagePreview() {
            const fileList = document.getElementById('imageFileList');
            fileList.innerHTML = '';
            document.getElementById('imagePreviewGrid').style.display = selectedImages.length > 0 ? 'grid' : 'none';
            selectedImages.forEach((img, idx) => {
                const item = document.createElement('div');
                item.className = 'file-item';
                item.innerHTML = `<div class="file-info"><span class="file-icon">🖼️</span><span>${img.name}</span></div>
                    <button type="button" class="file-remove" onclick="removeImage(${idx})">Xóa</button>`;
                fileList.appendChild(item);
            });
        }

        function removeImage(index) { selectedImages.splice(index, 1); updateImagePreview(); }

        // ===== DOCUMENT UPLOAD =====
        function handleDocumentSelect() {
            const files = document.getElementById('documentInput').files;
            for (let file of files) {
                if (file.size > 10 * 1024 * 1024) { alert(`❌ File ${file.name} vượt quá 10MB`); continue; }
                const reader = new FileReader();
                reader.onload = (e) => {
                    selectedDocuments.push({ name: file.name, data: e.target.result, type: file.name.split('.').pop().toLowerCase() });
                    updateDocumentList();
                };
                reader.readAsDataURL(file);
            }
        }

        function updateDocumentList() {
            const fileList = document.getElementById('documentFileList');
            fileList.innerHTML = '';
            selectedDocuments.forEach((doc, idx) => {
                const icons = { pdf: '📕', doc: '📗', docx: '📗', xls: '📊', xlsx: '📊', ppt: '📊', pptx: '📊' };
                const icon = icons[doc.type] || '📄';
                const item = document.createElement('div');
                item.className = 'file-item';
                item.innerHTML = `<div class="file-info"><span class="file-icon">${icon}</span><span>${doc.name}</span></div>
                    <button type="button" class="file-remove" onclick="removeDocument(${idx})">Xóa</button>`;
                fileList.appendChild(item);
            });
        }

        function removeDocument(index) { selectedDocuments.splice(index, 1); updateDocumentList(); }

        // ===== SPONSOR =====
        function addSponsor() {
            const container  = document.getElementById('sponsorContainer');
            const emptyState = document.getElementById('sponsorEmptyState');
            if (emptyState) emptyState.style.display = 'none';
            const index = container.querySelectorAll('.sponsor-item').length;
            const html = `
                <div class="sponsor-item" data-index="${index}">
                    <div class="sponsor-card-header">
                        <h6 class="sponsor-card-title">🏢 Nhà tài trợ #${index + 1}</h6>
                        <button type="button" class="remove-sponsor-btn" onclick="removeSponsor(this)"><i class="bi bi-trash"></i> Xóa</button>
                    </div>
                    <div class="row">
                        <div class="col-md-6"><div class="form-group">
                            <label class="form-label">Tên nhà tài trợ <span class="required">*</span></label>
                            <input type="text" name="Sponsors[${index}].SponsorName" class="form-control sponsor-name" placeholder="VD: Công ty ABC">
                        </div></div>
                        <div class="col-md-6"><div class="form-group">
                            <label class="form-label">Mức tài trợ</label>
                            <select name="Sponsors[${index}].SponsorshipLevel" class="form-select sponsor-level" onchange="updateSponsorBadge(this)">
                                <option value="Gold">Vàng (Gold)</option>
                                <option value="Silver">Bạc (Silver)</option>
                                <option value="Bronze">Đồng (Bronze)</option>
                                <option value="General" selected>Đồng hành (General)</option>
                            </select>
                        </div></div>
                    </div>
                    <div class="row">
                        <div class="col-md-6"><div class="form-group">
                            <label class="form-label">Email liên hệ</label>
                            <input type="email" name="Sponsors[${index}].Email" class="form-control" placeholder="contact@sponsor.com">
                        </div></div>
                        <div class="col-md-6"><div class="form-group">
                            <label class="form-label">Website</label>
                            <input type="text" name="Sponsors[${index}].Website" class="form-control" placeholder="https://sponsor.com">
                        </div></div>
                    </div>
                    <div class="row">
                        <div class="col-md-4"><div class="form-group">
                            <label class="form-label">Số tiền tài trợ</label>
                            <input type="number" name="Sponsors[${index}].ContributionAmount" class="form-control" value="0" min="0" step="1000">
                        </div></div>
                        <div class="col-md-4"><div class="form-group">
                            <label class="form-label">Đơn vị tiền tệ</label>
                            <select name="Sponsors[${index}].Currency" class="form-select">
                                <option value="VND" selected>VND</option>
                                <option value="USD">USD</option>
                            </select>
                        </div></div>
                        <div class="col-md-4"><div class="form-group">
                            <label class="form-label">Thứ tự hiển thị</label>
                            <input type="number" name="Sponsors[${index}].DisplayOrder" class="form-control" value="${index}" min="0">
                        </div></div>
                    </div>
                    <div class="row">
                        <div class="col-md-9"><div class="form-group">
                            <label class="form-label">Ghi chú</label>
                            <input type="text" name="Sponsors[${index}].Notes" class="form-control" placeholder="Ghi chú về nhà tài trợ...">
                        </div></div>
                        <div class="col-md-3"><div class="form-group">
                            <label class="form-label d-block">&nbsp;</label>
                            <div class="form-check mt-2">
                                <input type="hidden" name="Sponsors[${index}].IsDisplayed" value="false">
                                <input type="checkbox" name="Sponsors[${index}].IsDisplayed" class="form-check-input" value="true" checked>
                                <label class="form-check-label">Hiển thị công khai</label>
                            </div>
                        </div></div>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
        }

        function removeSponsor(btn) {
            btn.closest('.sponsor-item').remove();
            document.querySelectorAll('#sponsorContainer .sponsor-item').forEach((item, index) => {
                item.dataset.index = index;
                item.querySelector('.sponsor-card-title').textContent = `🏢 Nhà tài trợ #${index + 1}`;
                item.querySelectorAll('input, select').forEach(el => {
                    if (el.name) el.name = el.name.replace(/Sponsors\[\d+\]/, `Sponsors[${index}]`);
                });
            });
            const container = document.getElementById('sponsorContainer');
            if (container.querySelectorAll('.sponsor-item').length === 0) {
                const emptyState = document.getElementById('sponsorEmptyState');
                if (emptyState) emptyState.style.display = '';
            }
        }

        function updateSponsorBadge(select) { /* extensible */ }

        // ===== DRAG & DROP =====
        const imageUploadArea = document.getElementById('imageUploadArea');
        if (imageUploadArea) {
            imageUploadArea.addEventListener('dragover', e => { e.preventDefault(); imageUploadArea.classList.add('dragover'); });
            imageUploadArea.addEventListener('dragleave', () => imageUploadArea.classList.remove('dragover'));
            imageUploadArea.addEventListener('drop', e => {
                e.preventDefault(); imageUploadArea.classList.remove('dragover');
                document.getElementById('imageInput').files = e.dataTransfer.files; handleImageSelect();
            });
        }
        const documentUploadArea = document.getElementById('documentUploadArea');
        if (documentUploadArea) {
            documentUploadArea.addEventListener('dragover', e => { e.preventDefault(); documentUploadArea.classList.add('dragover'); });
            documentUploadArea.addEventListener('dragleave', () => documentUploadArea.classList.remove('dragover'));
            documentUploadArea.addEventListener('drop', e => {
                e.preventDefault(); documentUploadArea.classList.remove('dragover');
                document.getElementById('documentInput').files = e.dataTransfer.files; handleDocumentSelect();
            });
        }

        // ===== INIT =====
        document.addEventListener('DOMContentLoaded', () => {
            const serverErrors = document.getElementById('serverErrors');
            if (serverErrors) {
                const savedStep = parseInt(localStorage.getItem('createFormStep') || '1');
                if (savedStep > 1 && savedStep <= totalSteps) currentStep = savedStep;
                localStorage.removeItem('createFormStep');
            }

            updateStepDisplay();
            toggleTeamSizeField();

            document.querySelector('[name="IsTeamBased"]').addEventListener('change', toggleTeamSizeField);

            // Khôi phục select values (khi validation fail server-side)
            document.querySelectorAll('#sponsorContainer select[data-value]').forEach(sel => { if (sel.dataset.value) sel.value = sel.dataset.value; });
            document.querySelectorAll('#compRoundsContainer .comp-round-name[data-value]').forEach(sel => { if (sel.dataset.value) sel.value = sel.dataset.value; });

            if (serverErrors) serverErrors.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        // ===== FORM SUBMIT =====
        document.getElementById('createForm').addEventListener('submit', () => {
            localStorage.setItem('createFormStep', currentStep);
            updateAllRoundHiddenWeights();
            const form = document.getElementById('createForm');
            selectedImages.forEach(img => {
                const input = document.createElement('input');
                input.type = 'hidden'; input.name = 'SelectedImageData'; input.value = img.data;
                form.appendChild(input);
            });
            selectedDocuments.forEach(doc => {
                const dataInput = document.createElement('input');
                dataInput.type = 'hidden'; dataInput.name = 'SelectedDocumentData'; dataInput.value = doc.data;
                form.appendChild(dataInput);
                const nameInput = document.createElement('input');
                nameInput.type = 'hidden'; nameInput.name = 'DocumentFileNames'; nameInput.value = doc.name;
                form.appendChild(nameInput);
            });
        });
    </script>
}