                    <div>
                        <label class="form-label" style="font-size:0.85rem;">Ngày kết thúc đợt</label>
                        <input type="datetime-local" name="RegistrationRounds[${index}].EndDate" class="form-control round-end" value="${fmt(defaultEnd)}" required>
                    </div>
                    <div style="display:flex; align-items:flex-end;">
                        <button type="button" class="remove-criteria-btn" onclick="removeRound(this)"><i class="bi bi-trash"></i></button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
        }

        function removeRound(btn) {
            const container = document.getElementById('roundsContainer');
            if (container.querySelectorAll('.criteria-item').length <= 1) {
                alert('❌ Phải có ít nhất một đợt đăng ký');
                return;
            }
            btn.closest('.criteria-item').remove();
            container.querySelectorAll('.criteria-item').forEach((item, i) => {
                item.dataset.index = i;
                item.querySelectorAll('input').forEach(el => {
                    if (el.name) el.name = el.name.replace(/RegistrationRounds\[\d+\]/, `RegistrationRounds[${i}]`);
                });
            });
        }

