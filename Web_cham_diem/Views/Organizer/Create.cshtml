        function removeCompRound(btn) {
            btn.closest('.comp-round-item').remove();
            reindexCompRounds();
        }

        function reindexCompRounds() {
            document.querySelectorAll('#compRoundsContainer .comp-round-item').forEach((item, i) => {
                item.dataset.index = i;
                item.querySelectorAll('input[name], select[name]').forEach(el => {
                    el.name = el.name.replace(/CompetitionRounds\[\d+\]/g, `CompetitionRounds[${i}]`);
                });
                const orderInput = item.querySelector('[name$=".RoundOrder"]');
                if (orderInput) orderInput.value = i + 1;
                // Reindex criteria order values
                const critContainer = item.querySelector('.round-criteria-container');
                if (critContainer) {
                    critContainer.querySelectorAll('.round-criteria-item').forEach((critItem, cidx) => {
                        const orderEl = critItem.querySelector('[name$=".Order"]');
                        if (orderEl) orderEl.value = cidx + 1;
                    });
                }
            });
        }

