@model Web_cham_diem.Models.ViewModels.CreateCompetitionViewModel
@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Tạo Cuộc Thi Mới";
}

@section Styles {
    <style>
        .create-wrapper {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 40px 0;
        }

        .form-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            padding: 40px;
            margin-bottom: 30px;
        }

        .step-indicator {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
            padding: 0 10px;
        }

        .step-item {
            flex: 1;
            text-align: center;
            position: relative;
        }

            .step-item::after {
                content: '';
                position: absolute;
                top: 30px;
                left: 50%;
                width: 100%;
                height: 2px;
                background: #e0e0e0;
                z-index: -1;
            }

            .step-item:last-child::after {
                display: none;
            }

            .step-item.active .step-circle {
                background: var(--organizer-accent);
                color: white;
            }

            .step-item.completed .step-circle {
                background: #22c55e;
                color: white;
            }

        .step-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin: 0 auto 10px;
            transition: all 0.3s;
        }

        .step-text {
            font-size: 0.9rem;
            color: #666;
            font-weight: 500;
        }

        .step-item.active .step-text,
        .step-item.completed .step-text {
            color: var(--text-dark);
            font-weight: bold;
        }

        .form-section {
            display: none;
        }

            .form-section.active {
                display: block;
            }

        .section-title {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 30px;
            border-bottom: 3px solid var(--organizer-accent);
            padding-bottom: 15px;
        }

        .section-description {
            color: #666;
            margin-bottom: 20px;
            font-size: 0.95rem;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 8px;
            display: block;
        }

            .form-label .required {
                color: #e53e3e;
            }

        .form-control, .form-select {
            border: 1px solid #d0d0d0;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 0.95rem;
            transition: all 0.3s;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--organizer-accent);
                box-shadow: 0 0 0 3px rgba(var(--organizer-accent-rgb), 0.1);
            }

        .form-text {
            font-size: 0.85rem;
            color: #999;
            margin-top: 5px;
        }

        /* Criteria Section */
        .criteria-list {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
        }

        .criteria-item {
            background: white;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            gap: 15px;
            align-items: end;
        }

            .criteria-item:last-child {
                margin-bottom: 0;
            }

        .remove-criteria-btn {
            background: #fee;
            color: #e53e3e;
            border: none;
            border-radius: 6px;
            padding: 8px 12px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

            .remove-criteria-btn:hover {
                background: #fdd;
            }

        .add-criteria-btn {
            background: #e8f5e9;
            color: #22c55e;
            border: 2px dashed #22c55e;
            border-radius: 8px;
            padding: 12px 20px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
            width: 100%;
        }

            .add-criteria-btn:hover {
                background: #d4f1d4;
            }

        /* Summary */
        .summary-section {
            background: #f8f9fa;
            border-left: 4px solid var(--organizer-accent);
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 0.95rem;
        }

            .summary-item .label {
                color: #666;
                font-weight: 500;
            }

            .summary-item .value {
                color: var(--text-dark);
                font-weight: 600;
            }

        .validation-errors {
            background: #fee;
            border: 1px solid #fcc;
            color: #c33;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

            .validation-errors ul {
                margin: 0;
                padding-left: 20px;
            }

            .validation-errors li {
                margin: 5px 0;
            }

        .btn-container {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #e0e0e0;
        }

        .btn-prev, .btn-next, .btn-submit {
            padding: 10px 24px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-size: 0.95rem;
            transition: all 0.3s;
        }

        .btn-prev {
            background: #e0e0e0;
            color: #333;
        }

            .btn-prev:hover {
                background: #d0d0d0;
            }

        .btn-next, .btn-submit {
            background: var(--organizer-accent);
            color: white;
        }

            .btn-next:hover, .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(var(--organizer-accent-rgb), 0.3);
            }

        .weight-indicator {
            font-size: 0.85rem;
            color: #666;
            text-align: center;
        }

        .weight-bar {
            width: 100%;
            height: 4px;
            background: #e0e0e0;
            border-radius: 2px;
            margin-top: 8px;
            overflow: hidden;
        }

        .weight-fill {
            height: 100%;
            background: var(--organizer-accent);
            transition: width 0.3s;
        }

        .text-danger {
            color: #e53e3e;
        }
    </style>
}

<div class="create-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <!-- Step Indicator -->
                <div class="form-card">
                    <div class="step-indicator">
                        <div class="step-item active" id="step1-indicator">
                            <div class="step-circle">1</div>
                            <div class="step-text">Thông tin cơ bản</div>
                        </div>
                        <div class="step-item" id="step2-indicator">
                            <div class="step-circle">2</div>
                            <div class="step-text">Lịch trình</div>
                        </div>
                        <div class="step-item" id="step3-indicator">
                            <div class="step-circle">3</div>
                            <div class="step-text">Tiêu chí chấm</div>
                        </div>
                        <div class="step-item" id="step4-indicator">
                            <div class="step-circle">4</div>
                            <div class="step-text">Xác nhận</div>
                        </div>
                    </div>
                </div>

                <!-- Form Content -->
                <form method="post" id="createForm" class="form-card">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-errors">
                            <strong>⚠️ Vui lòng kiểm tra các lỗi sau:</strong>
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- STEP 1: Thông tin cơ bản -->
                    <div class="form-section active" id="step1">
                        <div class="section-title">
                            <i class="bi bi-info-circle me-2"></i>Thông tin cơ bản về cuộc thi
                        </div>
                        <p class="section-description">Nhập tên, mô tả và thông tin chung về cuộc thi</p>

                        <div class="form-group">
                            <label class="form-label">
                                Tên cuộc thi <span class="required">*</span>
                            </label>
                            <input type="text" asp-for="CompetitionName" class="form-control"
                                   placeholder="VD: Hackathon Sinh viên 2026" required>
                            <span asp-validation-for="CompetitionName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Lĩnh vực <span class="required">*</span></label>
                                    <select asp-for="Category" class="form-select" required>
                                        <option value="">-- Chọn lĩnh vực --</option>
                                        <option value="Học thuật / NCKH">Học thuật / NCKH</option>
                                        <option value="Công nghệ Thông tin">Công nghệ Thông tin</option>
                                        <option value="Kỹ năng Mềm">Kỹ năng Mềm</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Hình thức thi</label>
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" asp-for="IsTeamBased" id="isTeamBased">
                                        <label class="form-check-label" for="isTeamBased">
                                            Thi theo đội (mặc định: Cá nhân)
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Mô tả cuộc thi</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Mô tả chi tiết về cuộc thi, mục tiêu, đối tượng tham gia..."></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Thể lệ / Quy định</label>
                            <textarea asp-for="Rules" class="form-control" rows="3"
                                      placeholder="Các quy định, hạn chế trong cuộc thi..."></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Giải thưởng</label>
                            <textarea asp-for="Prize" class="form-control" rows="2"
                                      placeholder="Mô tả giải thưởng, phần thưởng..."></textarea>
                        </div>
                    </div>

                    <!-- STEP 2: Lịch trình & Hạn chế -->
                    <div class="form-section" id="step2">
                        <div class="section-title">
                            <i class="bi bi-calendar3 me-2"></i>Lịch trình & Hạn chế
                        </div>
                        <p class="section-description">Cấu hình các mốc thời gian quan trọng</p>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Ngày bắt đầu <span class="required">*</span></label>
                                    <input type="datetime-local" asp-for="StartDate" class="form-control" required>
                                    <span asp-validation-for="StartDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Ngày kết thúc <span class="required">*</span></label>
                                    <input type="datetime-local" asp-for="EndDate" class="form-control" required>
                                    <span asp-validation-for="EndDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Hạn đăng ký <span class="required">*</span></label>
                                    <input type="datetime-local" asp-for="RegistrationDeadline" class="form-control" required>
                                    <span asp-validation-for="RegistrationDeadline" class="text-danger"></span>
                                    <small class="form-text">Hạn cuối cùng để đăng ký tham gia</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Hạn nộp bài <span class="required">*</span></label>
                                    <input type="datetime-local" asp-for="SubmissionDeadline" class="form-control" required>
                                    <span asp-validation-for="SubmissionDeadline" class="text-danger"></span>
                                    <small class="form-text">Hạn cuối cùng để nộp bài dự thi</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Tối đa số lượng tham gia <span class="required">*</span></label>
                                    <input type="number" asp-for="MaxParticipants" class="form-control" min="1" value="100" required>
                                    <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Tối đa người/đội <span class="required">*</span></label>
                                    <input type="number" asp-for="MaxTeamSize" class="form-control" min="1" value="5" required>
                                    <small class="form-text">Tối đa mấy người trong 1 đội/nhóm</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 3: Tiêu chí chấm điểm -->
                    <div class="form-section" id="step3">
                        <div class="section-title">
                            <i class="bi bi-bar-chart me-2"></i>Tiêu chí chấm điểm
                        </div>
                        <p class="section-description">Cấu hình các tiêu chí đánh giá (Tổng trọng số phải = 100%)</p>

                        <div class="criteria-list" id="criteriaContainer">
                            @for (int i = 0; i < Model.ScoringCriteria.Count; i++)
                            {
                                <div class="criteria-item" data-index="@i">
                                    <div>
                                        <input type="hidden" name="ScoringCriteria[@i].Order" value="@Model.ScoringCriteria[i].Order">
                                        <input type="text" name="ScoringCriteria[@i].CriteriaName" class="form-control criteria-name"
                                               placeholder="VD: Ý tưởng" value="@Model.ScoringCriteria[i].CriteriaName" required>
                                    </div>
                                    <div>
                                        <input type="number" name="ScoringCriteria[@i].MaxScore" class="form-control criteria-score"
                                               placeholder="Điểm tối đa" value="@Model.ScoringCriteria[i].MaxScore" min="1" step="0.1" required>
                                    </div>
                                    <div>
                                        <div class="input-group">
                                            <!-- Input hiển thị % cho người dùng nhập -->
                                            <input type="number" class="form-control criteria-weight-input"
                                                   placeholder="%" value="@((Model.ScoringCriteria[i].Weight * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                   min="0" max="100" step="0.1" required onchange="updateTotalWeight()" oninput="updateTotalWeight()">
                                            <!-- Hidden input để lưu giá trị decimal (0.0-1.0) -->
                                            <input type="hidden"
                                                   name="ScoringCriteria[@i].Weight"
                                                   class="criteria-weight-value"
                                                   value="@Model.ScoringCriteria[i].Weight.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div>
                                        <button type="button" class="remove-criteria-btn" onclick="removeCriteria(this)">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <button type="button" class="add-criteria-btn mt-3" onclick="addCriteria()">
                            <i class="bi bi-plus-circle me-2"></i>Thêm tiêu chí
                        </button>

                        <div class="mt-3">
                            <div class="weight-indicator">
                                Tổng trọng số: <strong id="totalWeight">100</strong>%
                                <span id="weightStatus" style="margin-left: 10px; font-weight: bold;"></span>
                            </div>
                            <div class="weight-bar">
                                <div class="weight-fill" id="weightFill"></div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 4: Xác nhận -->
                    <div class="form-section" id="step4">
                        <div class="section-title">
                            <i class="bi bi-check-circle me-2"></i>Xác nhận thông tin
                        </div>
                        <p class="section-description">Vui lòng kiểm tra lại thông tin trước khi tạo cuộc thi</p>

                        <div class="summary-section">
                            <h6 class="fw-bold mb-3">Thông tin cơ bản</h6>
                            <div class="summary-item">
                                <span class="label">Tên cuộc thi:</span>
                                <span class="value" id="summary-name">-</span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Lĩnh vực:</span>
                                <span class="value" id="summary-category">-</span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Hình thức:</span>
                                <span class="value" id="summary-type">Cá nhân</span>
                            </div>
                        </div>

                        <div class="summary-section">
                            <h6 class="fw-bold mb-3">Lịch trình</h6>
                            <div class="summary-item">
                                <span class="label">Ngày bắt đầu:</span>
                                <span class="value" id="summary-start">-</span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Ngày kết thúc:</span>
                                <span class="value" id="summary-end">-</span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Hạn đăng ký:</span>
                                <span class="value" id="summary-reg-deadline">-</span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Hạn nộp bài:</span>
                                <span class="value" id="summary-sub-deadline">-</span>
                            </div>
                        </div>

                        <div class="summary-section">
                            <h6 class="fw-bold mb-3">Tiêu chí chấm điểm</h6>
                            <div id="summary-criteria">
                                <!-- Sẽ được điền bởi JavaScript -->
                            </div>
                        </div>

                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle me-2"></i>
                            Cuộc thi sẽ được tạo ở trạng thái <strong>Nháp (Draft)</strong>.
                            Bạn có thể chỉnh sửa thông tin sau khi tạo và kích hoạt cuộc thi bất cứ lúc nào.
                        </div>
                    </div>

                    <!-- Button Navigation -->
                    <div class="btn-container">
                        <button type="button" class="btn-prev" id="prevBtn" onclick="changeStep(-1)" style="display:none;">
                            <i class="bi bi-chevron-left me-1"></i>Quay lại
                        </button>
                        <button type="button" class="btn-next" id="nextBtn" onclick="changeStep(1)">
                            Tiếp theo <i class="bi bi-chevron-right ms-1"></i>
                        </button>
                        <button type="submit" class="btn-submit" id="submitBtn" style="display:none;">
                            <i class="bi bi-check-circle me-1"></i>Tạo cuộc thi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStep = 1;
        const totalSteps = 4;

        function changeStep(direction) {
            // Validate current step before moving
            if (direction > 0 && !validateStep(currentStep)) {
                return;
            }

            // Cập nhật giá trị hidden fields trước khi chuyển bước
            if (currentStep === 3) {
                updateHiddenWeightValues();
            }

            currentStep += direction;
            updateStepDisplay();
            updateSummary();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function updateStepDisplay() {
            // Hide all sections
            document.querySelectorAll('.form-section').forEach(el => el.classList.remove('active'));

            // Show current section
            document.getElementById(`step${currentStep}`).classList.add('active');

            // Update indicators
            document.querySelectorAll('.step-item').forEach((el, idx) => {
                const stepNum = idx + 1;
                el.classList.remove('active', 'completed');
                if (stepNum < currentStep) {
                    el.classList.add('completed');
                } else if (stepNum === currentStep) {
                    el.classList.add('active');
                }
            });

            // Update buttons
            document.getElementById('prevBtn').style.display = currentStep === 1 ? 'none' : 'block';
            document.getElementById('nextBtn').style.display = currentStep === totalSteps ? 'none' : 'block';
            document.getElementById('submitBtn').style.display = currentStep === totalSteps ? 'block' : 'none';
        }

        function validateStep(step) {
            const form = document.getElementById('createForm');
            if (step === 1) {
                const name = document.querySelector('[name="CompetitionName"]').value;
                const category = document.querySelector('[name="Category"]').value;
                if (!name || !category) {
                    alert('Vui lòng điền tên cuộc thi và chọn lĩnh vực');
                    return false;
                }
            }
            if (step === 2) {
                const start = document.querySelector('[name="StartDate"]').valueAsNumber;
                const end = document.querySelector('[name="EndDate"]').valueAsNumber;
                const regDeadline = document.querySelector('[name="RegistrationDeadline"]').valueAsNumber;
                const subDeadline = document.querySelector('[name="SubmissionDeadline"]').valueAsNumber;

                if (end <= start) {
                    alert('Ngày kết thúc phải sau ngày bắt đầu');
                    return false;
                }
                if (regDeadline >= subDeadline) {
                    alert('Hạn đăng ký phải trước hạn nộp bài');
                    return false;
                }
                if (subDeadline >= end) {
                    alert('Hạn nộp bài phải trước ngày kết thúc');
                    return false;
                }
            }
            if (step === 3) {
                const totalWeight = parseFloat(document.getElementById('totalWeight').textContent);
                if (Math.abs(totalWeight - 100) > 0.1) {
                    alert('Tổng trọng số phải bằng 100%');
                    return false;
                }
            }
            return true;
        }

        function updateSummary() {
            if (currentStep !== totalSteps) return;

            // Cập nhật lại giá trị hidden trước khi hiển thị summary
            updateHiddenWeightValues();

            document.getElementById('summary-name').textContent = document.querySelector('[name="CompetitionName"]').value;
            document.getElementById('summary-category').textContent = document.querySelector('[name="Category"]').value;
            document.getElementById('summary-type').textContent = document.querySelector('[name="IsTeamBased"]').checked ? 'Theo đội' : 'Cá nhân';

            const startDate = new Date(document.querySelector('[name="StartDate"]').value);
            const endDate = new Date(document.querySelector('[name="EndDate"]').value);
            const regDeadline = new Date(document.querySelector('[name="RegistrationDeadline"]').value);
            const subDeadline = new Date(document.querySelector('[name="SubmissionDeadline"]').value);

            document.getElementById('summary-start').textContent = startDate.toLocaleString('vi-VN');
            document.getElementById('summary-end').textContent = endDate.toLocaleString('vi-VN');
            document.getElementById('summary-reg-deadline').textContent = regDeadline.toLocaleString('vi-VN');
            document.getElementById('summary-sub-deadline').textContent = subDeadline.toLocaleString('vi-VN');

            // Tiêu chí chấm điểm
            const criteriaHtml = Array.from(document.querySelectorAll('.criteria-item')).map((item, idx) => {
                const name = item.querySelector('.criteria-name').value;
                const maxScore = item.querySelector('.criteria-score').value;
                const weight = item.querySelector('.criteria-weight-input').value;
                return `
                    <div class="summary-item">
                        <span class="label">${name}:</span>
                        <span class="value">${maxScore} điểm (${weight}%)</span>
                    </div>
                `;
            }).join('');

            document.getElementById('summary-criteria').innerHTML = criteriaHtml;
        }

        function addCriteria() {
            const container = document.getElementById('criteriaContainer');
            const index = container.children.length;

            const html = `
                <div class="criteria-item" data-index="${index}">
                    <div>
                        <input type="hidden" name="ScoringCriteria[${index}].Order" value="${index + 1}">
                        <input type="text" name="ScoringCriteria[${index}].CriteriaName" class="form-control criteria-name"
                               placeholder="Tên tiêu chí" required>
                    </div>
                    <div>
                        <input type="number" name="ScoringCriteria[${index}].MaxScore" class="form-control criteria-score"
                               placeholder="Điểm" value="100" min="1" step="0.1" required>
                    </div>
                    <div>
                        <div class="input-group">
                            <input type="number" class="form-control criteria-weight-input"
                                   placeholder="%" value="0" min="0" max="100" step="0.1" required onchange="updateTotalWeight()">
                            <input type="hidden" name="ScoringCriteria[${index}].Weight" class="criteria-weight-value">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div>
                        <button type="button" class="remove-criteria-btn" onclick="removeCriteria(this)">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
            updateTotalWeight();
        }

        function removeCriteria(btn) {
            btn.closest('.criteria-item').remove();
            updateTotalWeight();
        }

        function updateTotalWeight() {
            // Lấy giá trị từ các input hiển thị (%)
            const weights = Array.from(document.querySelectorAll('.criteria-weight-input'))
                .map(el => parseFloat(el.value) || 0)
                .reduce((a, b) => a + b, 0);

            // Hiển thị tổng %
            document.getElementById('totalWeight').textContent = weights.toFixed(1);

            // Cập nhật thanh progress
            const percentage = Math.min(100, Math.max(0, weights));
            document.getElementById('weightFill').style.width = percentage + '%';

            // Đổi màu dựa trên đúng/sai
            const fillElement = document.getElementById('weightFill');
            const statusElement = document.getElementById('weightStatus');

            if (Math.abs(weights - 100) > 0.1) {
                fillElement.style.background = '#ef4444'; // Đỏ nếu sai
                statusElement.textContent = '❌ Sai';
                statusElement.style.color = '#ef4444';
            } else {
                fillElement.style.background = 'var(--organizer-accent)'; // Xanh nếu đúng
                statusElement.textContent = '✓ Đúng';
                statusElement.style.color = '#22c55e';
            }
        }

        // ⭐ HÀM MỚI: Cập nhật giá trị hidden fields (%) → decimal (0.0-1.0)0
        function updateHiddenWeightValues() {
            document.querySelectorAll('.criteria-item').forEach((item) => {
                const inputDisplay = item.querySelector('.criteria-weight-input');
                const inputHidden = item.querySelector('.criteria-weight-value');

                const percentValue = parseFloat(inputDisplay.value) || 0;
                inputHidden.value = (percentValue / 100).toFixed(4);
            });
        }

        function reindexCriteria() {
            document.querySelectorAll('.criteria-item').forEach((item, index) => {
                item.dataset.index = index;

                item.querySelector('[name$=".Order"]').name = `ScoringCriteria[${index}].Order`;
                item.querySelector('[name$=".CriteriaName"]').name = `ScoringCriteria[${index}].CriteriaName`;
                item.querySelector('[name$=".MaxScore"]').name = `ScoringCriteria[${index}].MaxScore`;
                item.querySelector('[name$=".Weight"]').name = `ScoringCriteria[${index}].Weight`;
            });
        }

        function removeCriteria(btn) {
            btn.closest('.criteria-item').remove();
            reindexCriteria();
            updateTotalWeight();
            updateHiddenWeightValues();
        }

        document.addEventListener('DOMContentLoaded', () => {
            updateStepDisplay();
            updateTotalWeight();
            updateHiddenWeightValues();
        });

        document.getElementById('createForm').addEventListener('submit', () => {
            updateHiddenWeightValues();
        });
    </script>
}