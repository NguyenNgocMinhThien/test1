@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Kết quả & Báo cáo";
}

@section Styles {
    <style>
        .org-results-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        /* --- STAT CARDS --- */
        .res-stat-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* --- TABS --- */
        .result-tabs {
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 20px;
        }

            .result-tabs .nav-link {
                border: none;
                color: var(--text-muted);
                font-weight: 600;
                padding: 12px 20px;
                border-bottom: 3px solid transparent;
                margin-bottom: -2px;
            }

                .result-tabs .nav-link.active {
                    background: none;
                    color: var(--organizer-accent);
                    border-bottom-color: var(--organizer-accent);
                }

        /* --- RANKING TABLE --- */
        .ranking-table-container {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .ranking-table th {
            text-transform: uppercase;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            background: #f8fafc;
            padding: 15px;
            border-bottom: 2px solid var(--border-color);
        }

        .ranking-table td {
            padding: 15px;
            vertical-align: middle;
            font-size: 0.9rem;
            color: var(--text-dark);
            border-bottom: 1px solid var(--border-color);
        }

        /* --- AWARD MEDALS --- */
        .medal-icon {
            font-size: 1.5rem;
            line-height: 1;
        }

        .medal-gold {
            color: #fbbf24;
        }
        /* Vàng */
        .medal-silver {
            color: #94a3b8;
        }
        /* Bạc */
        .medal-bronze {
            color: #b45309;
        }
        /* Đồng */

        .rank-number {
            width: 30px;
            height: 30px;
            background: #f1f5f9;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            color: var(--text-muted);
        }

            .rank-number.top-1 {
                background: #fef3c7;
                color: #d97706;
            }

            .rank-number.top-2 {
                background: #f1f5f9;
                color: #475569;
            }

            .rank-number.top-3 {
                background: #ffedd5;
                color: #92400e;
            }

        /* --- SCORE CHIP --- */
        .score-chip {
            padding: 5px 12px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-weight: 800;
            font-family: monospace;
            font-size: 1.1rem;
        }

        /* --- CHARTS PANEL --- */
        .chart-box {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }
    </style>
}

<div class="org-results-wrapper py-4">
    <div class="container-fluid">
        <!-- Header -->
        <h3 class="fw-bold mb-1 text-dark">Kết quả & Báo cáo Tổng hợp</h3>
        <p class="text-muted small mb-4">Công bố xếp hạng, xuất file dữ liệu điểm và phân tích chất lượng cuộc thi.</p>

        <!-- 1. Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="res-stat-card border-success">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Bài thi đạt giải</div>
                        <div class="fs-3 fw-bold text-success mt-1">12</div>
                    </div>
                    <i class="bi bi-trophy-fill fs-1 text-success opacity-25"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="res-stat-card border-primary">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Điểm trung bình</div>
                        <div class="fs-3 fw-bold text-primary mt-1">76.5<span class="fs-6">/100</span></div>
                    </div>
                    <i class="bi bi-bar-chart-fill fs-1 text-primary opacity-25"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="res-stat-card">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Số bài chấm 100%</div>
                        <div class="fs-3 fw-bold mt-1">120<span class="fs-6 text-muted">/120</span></div>
                    </div>
                    <i class="bi bi-check-all fs-1 text-dark opacity-25"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="res-stat-card">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Tỷ lệ công bố</div>
                        <div class="fs-3 fw-bold mt-1 text-danger">Chưa công bố</div>
                    </div>
                    <button class="btn btn-sm btn-outline-danger mt-2">Công bố ngay</button>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center mb-3">
            <label class="form-label small fw-bold text-muted me-3 mb-0">Hệ thống đang hiển thị Cuộc thi:</label>
            <select class="form-select w-25 border-primary fw-bold text-primary">
                <option selected>Hackathon Sinh viên 2026</option>
                <option>Nghiên cứu Khoa học Trẻ - Kinh tế</option>
            </select>
        </div>

        <!-- 2. TABS -->
        <ul class="nav nav-tabs result-tabs" id="resultTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#ranking" type="button">
                    <i class="bi bi-award me-2"></i> Bảng Xếp hạng
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#details" type="button">
                    <i class="bi bi-list-columns-reverse me-2"></i> Chi tiết Điểm số
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#reports" type="button">
                    <i class="bi bi-graph-up me-2"></i> Phân tích Thống kê
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#export" type="button">
                    <i class="bi bi-cloud-download me-2"></i> Trích xuất Dữ liệu
                </button>
            </li>
        </ul>

        <!-- TABS CONTENT -->
        <div class="tab-content">

            <!-- TAB 1: BẢNG XẾP HẠNG -->
            <div class="tab-pane fade show active" id="ranking">
                <div class="ranking-table-container shadow-sm">
                    <div class="table-responsive">
                        <table class="table ranking-table mb-0 align-middle text-center">
                            <thead>
                                <tr>
                                    <th width="10%">Hạng</th>
                                    <th width="10%">Giải Thưởng</th>
                                    <th class="text-start" width="25%">Đại diện / Đội thi</th>
                                    <th class="text-start">Tên Đề tài / Tác phẩm</th>
                                    <th>Điểm TB</th>
                                    <th>Đánh giá cuối</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color: #fefce8;">
                                    <td><div class="rank-number top-1">1</div></td>
                                    <td><i class="bi bi-award-fill medal-icon medal-gold" title="Giải Nhất"></i></td>
                                    <td class="text-start">
                                        <div class="fw-bold fs-6">Đội thi Innovators</div>
                                        <div class="small text-muted">Khoa Công nghệ Thông tin</div>
                                    </td>
                                    <td class="text-start fw-bold">Ứng dụng điểm danh lớp học bằng AI</td>
                                    <td><span class="score-chip text-success">96.5</span></td>
                                    <td><span class="badge bg-success text-white">Xuất Sắc</span></td>
                                </tr>
                                <tr style="background-color: #f8fafc;">
                                    <td><div class="rank-number top-2">2</div></td>
                                    <td><i class="bi bi-award-fill medal-icon medal-silver" title="Giải Nhì"></i></td>
                                    <td class="text-start">
                                        <div class="fw-bold fs-6">Nguyễn Hoàng Long</div>
                                        <div class="small text-muted">Khoa Kinh tế</div>
                                    </td>
                                    <td class="text-start fw-bold">Hệ thống gợi ý khóa học thông minh</td>
                                    <td><span class="score-chip text-primary">91.0</span></td>
                                    <td><span class="badge bg-primary text-white">Giỏi</span></td>
                                </tr>
                                <tr style="background-color: #fef7f2;">
                                    <td><div class="rank-number top-3">3</div></td>
                                    <td><i class="bi bi-award-fill medal-icon medal-bronze" title="Giải Ba"></i></td>
                                    <td class="text-start">
                                        <div class="fw-bold fs-6">Tech Girls Team</div>
                                        <div class="small text-muted">Khoa CNTT</div>
                                    </td>
                                    <td class="text-start fw-bold">Ứng dụng quản lý stress sinh viên</td>
                                    <td><span class="score-chip">88.5</span></td>
                                    <td><span class="badge bg-info text-dark">Khá Giỏi</span></td>
                                </tr>
                                <tr>
                                    <td><div class="rank-number">4</div></td>
                                    <td>-</td>
                                    <td class="text-start">Trần Đình Bảo</td>
                                    <td class="text-start fw-bold">Chatbot tư vấn tự động</td>
                                    <td><span class="score-chip">84.0</span></td>
                                    <td><span class="badge bg-secondary text-white">Khá</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 2: CHI TIẾT KẾT QUẢ ĐIỂM -->
            <div class="tab-pane fade" id="details">
                <div class="ranking-table-container shadow-sm p-3">
                    <p class="text-muted small fw-bold mb-3">Hiển thị chi tiết bảng điểm các tiêu chí của Bài #1024 - Ứng dụng điểm danh AI</p>
                    <table class="table table-bordered table-sm small">
                        <thead class="table-light">
                            <tr>
                                <th>Tiêu chí đánh giá</th>
                                <th>Thang điểm tối đa</th>
                                <th>Điểm GK1 (Trần Văn B)</th>
                                <th>Điểm GK2 (Lê Thị C)</th>
                                <th>Trung bình cộng</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Tính Sáng tạo</td>
                                <td>30</td>
                                <td>29</td>
                                <td>28</td>
                                <td class="fw-bold">28.5</td>
                            </tr>
                            <tr>
                                <td>Tính Thực tiễn</td>
                                <td>40</td>
                                <td>38</td>
                                <td>39</td>
                                <td class="fw-bold">38.5</td>
                            </tr>
                            <tr>
                                <td>Giao diện (UI/UX)</td>
                                <td>30</td>
                                <td>30</td>
                                <td>29</td>
                                <td class="fw-bold">29.5</td>
                            </tr>
                            <tr class="table-success fw-bold">
                                <td colspan="4" class="text-end">TỔNG ĐIỂM</td>
                                <td>96.5</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mt-3 bg-light p-3 rounded">
                        <h6 class="fw-bold text-dark mb-2">Nhận xét chung của Hội đồng Giám khảo:</h6>
                        <p class="small text-muted fst-italic mb-0">"Sản phẩm hoàn thiện xuất sắc. Ứng dụng AI nhận diện khuôn mặt xử lý mượt mà trên môi trường điện thoại. Tuy nhiên cần tối ưu tốc độ phản hồi Server nếu số lượng người dùng vượt mức 5.000."</p>
                    </div>
                </div>
            </div>

            <!-- TAB 3: PHÂN TÍCH THỐNG KÊ (CHARTS) -->
            <div class="tab-pane fade" id="reports">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="chart-box h-100 shadow-sm">
                            <h6 class="fw-bold mb-4 text-center">Phân bố Phổ điểm</h6>
                            <div style="height: 300px;">
                                <canvas id="scoreDistributionChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="chart-box h-100 shadow-sm">
                            <h6 class="fw-bold mb-4 text-center">Cơ cấu Đạt giải</h6>
                            <div style="height: 250px; display:flex; justify-content:center;">
                                <canvas id="awardRateChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 4: TRÍCH XUẤT DỮ LIỆU -->
            <div class="tab-pane fade" id="export">
                <div class="row mt-3">
                    <div class="col-md-6 offset-md-3">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-5 text-center">
                                <i class="bi bi-cloud-download text-primary mb-3" style="font-size: 3rem;"></i>
                                <h4 class="fw-bold mb-2">Trích xuất Báo cáo</h4>
                                <p class="text-muted small mb-4">Lưu trữ toàn bộ kết quả, bảng điểm chi tiết, và thông tin sinh viên tham gia.</p>

                                <div class="d-grid gap-3">
                                    <button class="btn btn-outline-danger fw-bold"><i class="bi bi-file-earmark-pdf me-2"></i> Xuất Báo cáo PDF</button>
                                    <button class="btn btn-outline-success fw-bold"><i class="bi bi-file-earmark-excel me-2"></i> Tải Bảng điểm Excel (.xlsx)</button>
                                    <button class="btn btn-outline-dark fw-bold"><i class="bi bi-filetype-csv me-2"></i> Xuất Data gốc (.csv)</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tab 3: Phổ Điểm (Bar Chart)
        const ctxScore = document.getElementById('scoreDistributionChart').getContext('2d');
        new Chart(ctxScore, {
            type: 'bar',
            data: {
                labels: ['Dưới 50', '50 - 65', '65 - 80', '80 - 90', 'Trên 90'],
                datasets: [{
                    label: 'Số lượng bài thi',
                    data: [5, 15, 45, 35, 20],
                    backgroundColor: '#0d6efd',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true },
                    x: { grid: { display: false } }
                }
            }
        });

        // Tab 3: Cơ cấu đạt giải (Pie Chart)
        const ctxAward = document.getElementById('awardRateChart').getContext('2d');
        new Chart(ctxAward, {
            type: 'doughnut',
            data: {
                labels: ['Giải Nhất', 'Giải Nhì', 'Giải Ba', 'Khuyến khích', 'Không có giải'],
                datasets: [{
                    data: [1, 2, 3, 5, 109],
                    backgroundColor: ['#f59e0b', '#94a3b8', '#b45309', '#0d6efd', '#e2e8f0'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: { legend: { position: 'right' } }
            }
        });
    </script>
}