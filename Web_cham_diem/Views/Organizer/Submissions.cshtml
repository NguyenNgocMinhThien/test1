@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Quản lý Đăng ký & Bài dự thi";
}

@section Styles {
    <style>
        .org-submission-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        /* --- STAT CARDS --- */
        .sub-stat-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .sub-stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .sub-stat-val {
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1;
            margin-top: 5px;
        }

        /* --- TABS NAVIGATION --- */
        .workflow-tabs {
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 20px;
        }

            .workflow-tabs .nav-link {
                border: none;
                color: var(--text-muted);
                font-weight: 600;
                padding: 12px 25px;
                border-bottom: 3px solid transparent;
                margin-bottom: -2px;
                transition: all 0.3s;
            }

                .workflow-tabs .nav-link:hover {
                    color: var(--organizer-accent);
                }

                .workflow-tabs .nav-link.active {
                    background: none;
                    color: var(--organizer-accent);
                    border-bottom-color: var(--organizer-accent);
                }

        /* --- FILTER PANEL --- */
        .filter-panel {
            background: #fff;
            padding: 15px 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            margin-bottom: 20px;
        }

        /* --- WORKFLOW TABLE --- */
        .workflow-table-container {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .workflow-table th {
            text-transform: uppercase;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            background: #f8fafc;
            padding: 15px;
            border-bottom: 2px solid var(--border-color);
        }

        .workflow-table td {
            padding: 15px;
            vertical-align: middle;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-dark);
        }

        .workflow-table tr:hover td {
            background-color: #f1f5f9;
        }

        /* --- STATUS BADGES --- */
        .w-badge {
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .w-wait {
            background: #fef3c7;
            color: #b45309;
        }

        .w-appr {
            background: #dcfce7;
            color: #166534;
        }

        .w-rej {
            background: #fee2e2;
            color: #991b1b;
        }

        .w-rev {
            background: #e0f2fe;
            color: #075985;
        }

        /* --- FILE CARD --- */
        .file-icon {
            font-size: 2rem;
            color: #ef4444; /* PDF Icon color */
        }

            .file-icon.zip {
                color: #f59e0b;
            }
    </style>
}

<div class="org-submission-wrapper py-4">
    <div class="container-fluid">
        <!-- Header -->
        <h3 class="fw-bold mb-1 text-dark">Quản lý Đăng ký & Bài dự thi</h3>
        <p class="text-muted small mb-4">Luồng tiếp nhận hồ sơ xét duyệt và thu thập bài làm của sinh viên.</p>

        <!-- 1. Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="sub-stat-card border-warning">
                    <div class="sub-stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-person-lines-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Hồ sơ chờ duyệt</div>
                        <div class="sub-stat-val text-warning">45</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="sub-stat-card border-success">
                    <div class="sub-stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Hồ sơ đã duyệt</div>
                        <div class="sub-stat-val text-success">380</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="sub-stat-card" style="border-color: var(--organizer-accent);">
                    <div class="sub-stat-icon bg-primary bg-opacity-10" style="color: var(--organizer-accent);"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Tổng bài đã nộp</div>
                        <div class="sub-stat-val" style="color: var(--organizer-accent);">215</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="sub-stat-card border-danger">
                    <div class="sub-stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-alarm-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Nộp trễ hạn</div>
                        <div class="sub-stat-val text-danger">12</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Search & Filter -->
        <div class="filter-panel shadow-sm d-flex flex-wrap gap-3 align-items-end">
            <div style="width: 250px;">
                <label class="form-label small fw-bold text-muted mb-1">Chọn Cuộc thi</label>
                <select class="form-select form-select-sm border-primary">
                    <option selected>Hackathon Sinh viên 2026</option>
                    <option>Nghiên cứu Khoa học Trẻ</option>
                    <option>Tất cả cuộc thi</option>
                </select>
            </div>
            <div style="flex: 1 1 200px;">
                <label class="form-label small fw-bold text-muted mb-1">Tìm kiếm</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Tên HS, Đề tài, MSSV...">
                </div>
            </div>
            <div style="width: 180px;">
                <label class="form-label small fw-bold text-muted mb-1">Trạng thái</label>
                <select class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option>Chờ duyệt</option>
                    <option>Đã duyệt</option>
                    <option>Yêu cầu bổ sung</option>
                </select>
            </div>
            <div style="width: 150px;">
                <label class="form-label small fw-bold text-muted mb-1">Khoa tham gia</label>
                <select class="form-select form-select-sm">
                    <option>Tất cả khoa</option>
                    <option>Công nghệ Thông tin</option>
                    <option>Kinh tế</option>
                </select>
            </div>
            <div>
                <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-filter"></i> Lọc</button>
            </div>
        </div>

        <!-- 3. WORKFLOW TABS -->
        <ul class="nav nav-tabs workflow-tabs" id="submissionTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#registration-tab" type="button">
                    <i class="bi bi-card-checklist me-2"></i> Hồ sơ Đăng ký <span class="badge bg-warning text-dark ms-1">45</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#files-tab" type="button">
                    <i class="bi bi-file-earmark-zip me-2"></i> File Bài dự thi
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#progress-tab" type="button">
                    <i class="bi bi-graph-up-arrow me-2"></i> Theo dõi Tiến độ
                </button>
            </li>
        </ul>

        <!-- TABS CONTENT -->
        <div class="tab-content">

            <!-- TAB 1: DANH SÁCH HỒ SƠ ĐĂNG KÝ -->
            <div class="tab-pane fade show active" id="registration-tab">
                <div class="workflow-table-container shadow-sm">
                    <div class="table-responsive">
                        <table class="table workflow-table mb-0">
                            <thead>
                                <tr>
                                    <th width="5%">ID</th>
                                    <th width="25%">Đại diện / Đội thi</th>
                                    <th>Đề tài đăng ký</th>
                                    <th>Cập nhật lúc</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-muted">#1024</td>
                                    <td>
                                        <div class="fw-bold text-dark">Nguyễn Văn A <span class="badge bg-light text-muted border border-secondary small ms-1">K. CNTT</span></div>
                                        <div class="small text-muted">Email: nva@student.edu</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">Ứng dụng AI điểm danh lớp học</div>
                                        <a href="#" class="small text-decoration-none"><i class="bi bi-paperclip"></i> FormDangKy.pdf</a>
                                    </td>
                                    <td><small class="text-muted">10:30 AM, Hôm nay</small></td>
                                    <td class="text-center"><span class="w-badge w-wait">Chờ duyệt</span></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-light text-primary" data-bs-toggle="modal" data-bs-target="#previewModal" title="Xem hồ sơ">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-success text-white" title="Duyệt"><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-sm btn-danger text-white" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">#1022</td>
                                    <td>
                                        <div class="fw-bold text-dark">Team CodeX <span class="badge bg-light text-muted border border-secondary small ms-1">K. Kỹ thuật</span></div>
                                        <div class="small text-muted">Trưởng nhóm: Trần Thị B</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">Thiết bị đo lường khí thải IoT</div>
                                        <a href="#" class="small text-decoration-none"><i class="bi bi-paperclip"></i> Outline_Project.docx</a>
                                    </td>
                                    <td><small class="text-muted">Hôm qua</small></td>
                                    <td class="text-center"><span class="w-badge w-appr">Đã duyệt</span></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">#1018</td>
                                    <td>
                                        <div class="fw-bold text-dark">Lê Minh C</div>
                                        <div class="small text-muted">Email: lmc@student.edu</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">Giải pháp thương mại điện tử</div>
                                        <div class="small text-danger fst-italic">Thiếu chữ ký GVHD</div>
                                    </td>
                                    <td><small class="text-muted">2 ngày trước</small></td>
                                    <td class="text-center"><span class="w-badge w-rev">Cần bổ sung</span></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-light text-primary"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Gửi nhắc nhở"><i class="bi bi-envelope"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Phân trang -->
                    <div class="p-3 bg-white d-flex justify-content-end border-top">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- TAB 2: QUẢN LÝ BÀI DỰ THI -->
            <div class="tab-pane fade" id="files-tab">
                <div class="workflow-table-container shadow-sm">
                    <div class="table-responsive">
                        <table class="table workflow-table mb-0">
                            <thead>
                                <tr>
                                    <th>File bài làm</th>
                                    <th>Đại diện / Đội thi</th>
                                    <th>Dung lượng</th>
                                    <th>Thời gian nộp</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <i class="bi bi-file-earmark-zip-fill file-icon zip"></i>
                                            <div>
                                                <div class="fw-bold">SourceCode_UngDungAI_DiemDanh.zip</div>
                                                <small class="text-muted">Mã HS: #1024</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">Nguyễn Văn A</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">15.4 MB</span></td>
                                    <td>
                                        <div class="small fw-bold">14:20, Hôm nay</div>
                                        <small class="text-success border border-success rounded px-1" style="font-size:0.6rem;">Đúng hạn</small>
                                    </td>
                                    <td class="text-center"><span class="w-badge bg-secondary text-white">Chờ chia GK</span></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i> Tải về</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <i class="bi bi-file-earmark-pdf-fill file-icon"></i>
                                            <div>
                                                <div class="fw-bold">BaoCao_ThietBiIoT_CodeX.pdf</div>
                                                <small class="text-muted">Mã HS: #1022</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><div class="fw-bold">Team CodeX</div></td>
                                    <td><span class="badge bg-light text-dark border">4.2 MB</span></td>
                                    <td>
                                        <div class="small fw-bold">23:55, Hôm qua</div>
                                        <small class="text-success border border-success rounded px-1" style="font-size:0.6rem;">Đúng hạn</small>
                                    </td>
                                    <td class="text-center"><span class="w-badge w-appr">Đang chấm</span></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-light text-primary" title="Preview"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i> Tải về</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 3: THEO DÕI TIẾN ĐỘ THU BÀI -->
            <div class="tab-pane fade" id="progress-tab">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="bg-white p-4 rounded-3 border h-100 shadow-sm">
                            <h6 class="fw-bold mb-4" style="color: var(--navy-blue);">Tiến độ Nộp bài (Hackathon 2026)</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted fw-bold">Tổng số đã nộp</span>
                                <span class="fw-bold text-dark">215 / 380 Hội thi (56%)</span>
                            </div>
                            <div class="progress mb-4" style="height: 10px;">
                                <div class="progress-bar" style="width: 56%; background-color: var(--organizer-accent);"></div>
                            </div>

                            <div class="alert alert-warning mb-0 border-warning">
                                <div class="fw-bold text-dark"><i class="bi bi-clock-history text-danger"></i> Cảnh báo Hạn chót!</div>
                                <p class="small mb-0 mt-1">Chỉ còn <strong>1 ngày 12 giờ</strong> nữa sẽ đóng cổng nộp bài. Có <span class="text-danger fw-bold">165 sinh viên/đội</span> chưa nộp bài.</p>
                                <button class="btn btn-sm btn-warning fw-bold mt-2">Gửi Email nhắc nhở hàng loạt</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="bg-white p-4 rounded-3 border h-100 shadow-sm">
                            <h6 class="fw-bold mb-4" style="color: var(--navy-blue);">Phân tích Trạng thái Bài nộp</h6>
                            <div style="height: 200px; display:flex; justify-content:center;">
                                <canvas id="submissionStatusChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal Duyệt / Xem trước Hồ sơ -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0" style="border-radius: 12px;">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-card-heading me-2"></i> Hồ sơ Đăng ký #1024</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row info-row mb-3">
                    <div class="col-sm-4 text-muted fw-bold small text-uppercase">Tên Đề tài</div>
                    <div class="col-sm-8 fw-bold">Ứng dụng AI điểm danh lớp học</div>
                </div>
                <div class="row info-row mb-3">
                    <div class="col-sm-4 text-muted fw-bold small text-uppercase">Đại diện</div>
                    <div class="col-sm-8">Nguyễn Văn A (MSSV: 2012345) - Khoa CNTT</div>
                </div>
                <div class="row info-row mb-4">
                    <div class="col-sm-4 text-muted fw-bold small text-uppercase">File Đăng ký</div>
                    <div class="col-sm-8">
                        <a href="#" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-pdf"></i> Xem FormDangKy.pdf</a>
                    </div>
                </div>

                <hr />
                <h6 class="fw-bold text-dark mb-3">Phản hồi / Nhận xét của BTC</h6>
                <textarea class="form-control" rows="3" placeholder="Nhập lý do từ chối hoặc yêu cầu bổ sung chỉnh sửa (nếu có)..."></textarea>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-info text-white"><i class="bi bi-arrow-counterclockwise"></i> Yêu cầu bổ sung</button>
                <button type="button" class="btn btn-danger"><i class="bi bi-x-circle"></i> Từ chối</button>
                <button type="button" class="btn text-white fw-bold" style="background-color: var(--organizer-accent);"><i class="bi bi-check-circle"></i> Phê duyệt Hồ sơ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tab 3 Chart
        const ctxStatus = document.getElementById('submissionStatusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Nộp đúng hạn', 'Nộp trễ hạn', 'Chưa nộp'],
                datasets: [{
                    data: [203, 12, 165],
                    backgroundColor: ['#10b981', '#ef4444', '#cbd5e1'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: { position: 'right' }
                }
            }
        });
    </script>
}