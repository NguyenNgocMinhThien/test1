@model Web_cham_diem.Models.ViewModels.OrganizerSubmissionsViewModel
@using System.IO

@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Quản lý Đăng ký & Bài dự thi";
}

@section Styles {
    <style>
        .org-submission-wrapper {
            background-color: var(--primary-bg);
            min-height: calc(100vh - 70px);
        }

        /* --- STAT CARDS --- */
        .sub-stat-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .sub-stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .sub-stat-val {
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1;
            margin-top: 5px;
        }

        /* --- TABS NAVIGATION --- */
        .workflow-tabs {
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 20px;
        }

            .workflow-tabs .nav-link {
                border: none;
                color: var(--text-muted);
                font-weight: 600;
                padding: 12px 25px;
                border-bottom: 3px solid transparent;
                margin-bottom: -2px;
                transition: all 0.3s;
            }

                .workflow-tabs .nav-link:hover {
                    color: var(--organizer-accent);
                }

                .workflow-tabs .nav-link.active {
                    background: none;
                    color: var(--organizer-accent);
                    border-bottom-color: var(--organizer-accent);
                }

        /* --- FILTER PANEL --- */
        .filter-panel {
            background: #fff;
            padding: 15px 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            margin-bottom: 20px;
        }

        /* --- WORKFLOW TABLE --- */
        .workflow-table-container {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .workflow-table th {
            text-transform: uppercase;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            background: #f8fafc;
            padding: 15px;
            border-bottom: 2px solid var(--border-color);
        }

        .workflow-table td {
            padding: 15px;
            vertical-align: middle;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-dark);
        }

        .workflow-table tr:hover td {
            background-color: #f1f5f9;
        }

        /* --- STATUS BADGES --- */
        .w-badge {
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .w-wait {
            background: #fef3c7;
            color: #b45309;
        }

        .w-appr {
            background: #dcfce7;
            color: #166534;
        }

        .w-rej {
            background: #fee2e2;
            color: #991b1b;
        }

        .w-rev {
            background: #e0f2fe;
            color: #075985;
        }

        /* --- FILE CARD --- */
        .file-icon {
            font-size: 2rem;
            color: #ef4444;
        }

            .file-icon.zip {
                color: #f59e0b;
            }
    </style>
}

<div class="org-submission-wrapper py-4">
    <div class="container-fluid">
        <!-- Header -->
        <h3 class="fw-bold mb-1 text-dark">Quản lý Đăng ký & Bài dự thi</h3>
        <p class="text-muted small mb-4">Luồng tiếp nhận hồ sơ xét duyệt và thu thập bài làm của sinh viên.</p>

        <!-- 1. Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="sub-stat-card border-warning">
                    <div class="sub-stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-person-lines-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Hồ sơ chờ duyệt</div>
                        <div class="sub-stat-val text-warning">@Model.PendingRegistrations</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="sub-stat-card border-success">
                    <div class="sub-stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Hồ sơ đã duyệt</div>
                        <div class="sub-stat-val text-success">@Model.ApprovedRegistrations</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="sub-stat-card" style="border-color: var(--organizer-accent);">
                    <div class="sub-stat-icon bg-primary bg-opacity-10" style="color: var(--organizer-accent);"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Tổng bài đã nộp</div>
                        <div class="sub-stat-val" style="color: var(--organizer-accent);">@Model.TotalSubmissions</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="sub-stat-card border-danger">
                    <div class="sub-stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-alarm-fill"></i></div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Nộp trễ hạn</div>
                        <div class="sub-stat-val text-danger">@Model.LateSubmissions</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Search & Filter -->
        <div class="filter-panel shadow-sm d-flex flex-wrap gap-3 align-items-end">
            <div style="width: 250px;">
                <label class="form-label small fw-bold text-muted mb-1">Chọn Cuộc thi</label>
                <select class="form-select form-select-sm border-primary" id="competitionFilter">
                    <option value="">Tất cả cuộc thi</option>
                    @foreach (var comp in Model.Competitions)
                    {
                        var isSelected = Model.SelectedCompetitionId == comp.CompetitionId;
                        <option value="@comp.CompetitionId" selected="@(isSelected)">
                            @comp.CompetitionName
                        </option>
                    }
                </select>
            </div>
            <div style="flex: 1 1 200px;">
                <label class="form-label small fw-bold text-muted mb-1">Tìm kiếm</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" id="searchInput" placeholder="Tên HS, Đề tài, MSSV..." value="@Model.SearchQuery">
                </div>
            </div>
            <div style="width: 180px;">
                <label class="form-label small fw-bold text-muted mb-1">Trạng thái</label>
                <select class="form-select form-select-sm" id="statusFilter">
                    <option value="">Tất cả</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Chờ duyệt</option>
                    <option value="Approved" selected="@(Model.StatusFilter == "Approved")">Đã duyệt</option>
                    <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Từ chối</option>
                </select>
            </div>
            <div style="width: 150px;">
                <label class="form-label small fw-bold text-muted mb-1">Khoa tham gia</label>
                <select class="form-select form-select-sm" id="departmentFilter">
                    <option value="">Tất cả khoa</option>
                    <option value="CNTT">Công nghệ Thông tin</option>
                    <option value="KT">Kinh tế</option>
                </select>
            </div>
            <div>
                <button class="btn btn-outline-secondary btn-sm" onclick="applyFilters()"><i class="bi bi-filter"></i> Lọc</button>
            </div>
        </div>

        <!-- 3. WORKFLOW TABS -->
        <ul class="nav nav-tabs workflow-tabs" id="submissionTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#registration-tab" type="button">
                    <i class="bi bi-card-checklist me-2"></i> Hồ sơ Đăng ký <span class="badge bg-warning text-dark ms-1">@Model.PendingRegistrations</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#files-tab" type="button">
                    <i class="bi bi-file-earmark-zip me-2"></i> File Bài dự thi <span class="badge bg-info text-white ms-1">@Model.TotalSubmissions</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#progress-tab" type="button">
                    <i class="bi bi-graph-up-arrow me-2"></i> Theo dõi Tiến độ
                </button>
            </li>
        </ul>

        <!-- TABS CONTENT -->
        <div class="tab-content">

            <!-- TAB 1: DANH SÁCH HỒ SƠ ĐĂNG KÝ -->
            <div class="tab-pane fade show active" id="registration-tab">
                <div class="workflow-table-container shadow-sm">
                    <div class="table-responsive">
                        <table class="table workflow-table mb-0">
                            <thead>
                                <tr>
                                    <th width="5%">ID</th>
                                    <th width="25%">Đại diện / Đội thi</th>
                                    <th>Đề tài đăng ký</th>
                                    <th>Cập nhật lúc</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AllRegistrationsList.Any())
                                {
                                    @foreach (var reg in Model.AllRegistrationsList)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">#@reg.RegistrationId</td>
                                            <td>
                                                <div class="fw-bold text-dark">@reg.RepresentativeName <span class="badge bg-light text-muted border border-secondary small ms-1">@reg.Department</span></div>
                                                <div class="small text-muted">Email: @reg.Email</div>
                                            </td>
                                            <td>
                                                <div class="fw-bold">@reg.Topic</div>
                                                @if (!string.IsNullOrEmpty(reg.SubmissionDocument))
                                                {
                                                    var fileName = System.IO.Path.GetFileName(reg.SubmissionDocument);
                                                    <a href="#" class="small text-decoration-none"><i class="bi bi-paperclip"></i> @fileName</a>
                                                }
                                            </td>
                                            <td><small class="text-muted">@reg.RegistrationDate.ToString("HH:mm, dd/MM/yyyy")</small></td>
                                            <td class="text-center">
                                                @{
                                                    var statusClass = reg.Status switch
                                                    {
                                                        "Pending" => "w-wait",
                                                        "Approved" => "w-appr",
                                                        "Rejected" => "w-rej",
                                                        _ => "w-rev"
                                                    };
                                                    var statusDisplay = reg.Status switch
                                                    {
                                                        "Pending" => "Chờ duyệt",
                                                        "Approved" => "Đã duyệt",
                                                        "Rejected" => "Từ chối",
                                                        _ => reg.Status
                                                    };
                                                }
                                                <span class="w-badge @statusClass">@statusDisplay</span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-light text-primary" data-bs-toggle="modal" data-bs-target="#previewModal" onclick="loadRegistrationDetail(@reg.RegistrationId)" title="Xem hồ sơ">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                @if (reg.Status == "Pending")
                                                {
                                                    <button class="btn btn-sm btn-success text-white" onclick="approveRegistration(@reg.RegistrationId)" title="Duyệt"><i class="bi bi-check-lg"></i></button>
                                                    <button class="btn btn-sm btn-danger text-white" onclick="rejectRegistration(@reg.RegistrationId)" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Không có dữ liệu</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 2: QUẢN LÝ BÀI DỰ THI -->
            <div class="tab-pane fade" id="files-tab">
                <div class="workflow-table-container shadow-sm">
                    <div class="table-responsive">
                        <table class="table workflow-table mb-0">
                            <thead>
                                <tr>
                                    <th>File bài làm</th>
                                    <th>Đại diện / Đội thi</th>
                                    <th>Dung lượng</th>
                                    <th>Thời gian nộp</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SubmissionsList.Any())
                                {
                                    @foreach (var sub in Model.SubmissionsList)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    @{
                                                        var iconClass = sub.FileType == "zip" ? "file-earmark-zip-fill zip" : "file-earmark-pdf-fill";
                                                    }
                                                    <i class="bi bi-@iconClass file-icon"></i>
                                                    <div>
                                                        <div class="fw-bold">@sub.FileName</div>
                                                        <small class="text-muted">Mã HS: #@sub.SubmissionId</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-bold">@sub.RepresentativeName</div>
                                                <small class="text-muted">@sub.TeamName</small>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@sub.FileSizeInMB.ToString("F2") MB</span></td>
                                            <td>
                                                <div class="small fw-bold">@sub.SubmissionDate.ToString("HH:mm, dd/MM/yyyy")</div>
                                                @if (sub.IsLate)
                                                {
                                                    <small class="text-danger border border-danger rounded px-1" style="font-size:0.6rem;">Nộp trễ</small>
                                                }
                                                else
                                                {
                                                    <small class="text-success border border-success rounded px-1" style="font-size:0.6rem;">Đúng hạn</small>
                                                }
                                            </td>
                                            <td class="text-center"><span class="w-badge w-appr">@sub.Status</span></td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary" title="Preview"><i class="bi bi-eye"></i></button>
                                                <button class="btn btn-sm btn-outline-primary" title="Tải về"><i class="bi bi-download"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Không có bài nộp</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 3: THEO DÕI TIẾN ĐỘ THU BÀI -->
            <div class="tab-pane fade" id="progress-tab">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="bg-white p-4 rounded-3 border h-100 shadow-sm">
                            <h6 class="fw-bold mb-4" style="color: var(--navy-blue);">Tiến độ Nộp bài (@Model.ProgressStatistics.DeadlineDate.ToString("dd/MM/yyyy"))</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted fw-bold">Tổng số đã nộp</span>
                                <span class="fw-bold text-dark">
                                    @{
                                        var totalSubmitted = Model.ProgressStatistics.OnTimeSubmissions + Model.ProgressStatistics.LateSubmissions;
                                        var percentage = Model.ProgressStatistics.TotalExpected > 0 
                                            ? Math.Round((totalSubmitted * 100.0) / Model.ProgressStatistics.TotalExpected, 0)
                                            : 0;
                                    }
                                    @totalSubmitted / @Model.ProgressStatistics.TotalExpected (@percentage%)
                                </span>
                            </div>
                            <div class="progress mb-4" style="height: 10px;">
                                @{
                                    var progressPercent = Model.ProgressStatistics.TotalExpected > 0 
                                        ? (totalSubmitted * 100.0) / Model.ProgressStatistics.TotalExpected
                                        : 0;
                                }
                                <div class="progress-bar" style="width: @progressPercent%; background-color: var(--organizer-accent);"></div>
                            </div>

                            @if (Model.ProgressStatistics.IsDeadlinePassing)
                            {
                                <div class="alert alert-danger mb-0 border-danger">
                                    <div class="fw-bold text-dark"><i class="bi bi-exclamation-triangle text-danger"></i> Hạn chót Đã Qua!</div>
                                    <p class="small mb-0 mt-1">Đóng cổng nộp bài cách đây <strong>@(Math.Abs(Model.ProgressStatistics.HoursUntilDeadline / 24)) ngày</strong>.</p>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0 border-warning">
                                    <div class="fw-bold text-dark"><i class="bi bi-clock-history text-danger"></i> Cảnh báo Hạn chót!</div>
                                    <p class="small mb-0 mt-1">Chỉ còn <strong>@(Model.ProgressStatistics.HoursUntilDeadline / 24) ngày @(Model.ProgressStatistics.HoursUntilDeadline % 24) giờ</strong> nữa. Có <span class="text-danger fw-bold">@Model.ProgressStatistics.NotSubmitted sinh viên/đội</span> chưa nộp bài.</p>
                                    <button class="btn btn-sm btn-warning fw-bold mt-2" onclick="sendReminderEmail()">Gửi Email nhắc nhở hàng loạt</button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="bg-white p-4 rounded-3 border h-100 shadow-sm">
                            <h6 class="fw-bold mb-4" style="color: var(--navy-blue);">Phân tích Trạng thái Bài nộp</h6>
                            <div style="height: 200px; display:flex; justify-content:center;">
                                <canvas id="submissionStatusChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal Duyệt / Xem trước Hồ sơ -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0" style="border-radius: 12px;">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-card-heading me-2"></i> Chi tiết Hồ sơ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row info-row mb-3">
                    <div class="col-sm-4 text-muted fw-bold small text-uppercase">Tên Đề tài</div>
                    <div class="col-sm-8 fw-bold" id="modalTopic">-</div>
                </div>
                <div class="row info-row mb-3">
                    <div class="col-sm-4 text-muted fw-bold small text-uppercase">Đại diện</div>
                    <div class="col-sm-8" id="modalRepresentative">-</div>
                </div>
                <div class="row info-row mb-4">
                    <div class="col-sm-4 text-muted fw-bold small text-uppercase">File Đăng ký</div>
                    <div class="col-sm-8" id="modalDocument">-</div>
                </div>

                <hr />
                <h6 class="fw-bold text-dark mb-3">Phản hồi / Nhận xét của BTC</h6>
                <textarea class="form-control" id="modalFeedback" rows="3" placeholder="Nhập lý do từ chối hoặc yêu cầu bổ sung chỉnh sửa (nếu có)..."></textarea>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-info text-white" onclick="requestSupplement()"><i class="bi bi-arrow-counterclockwise"></i> Yêu cầu bổ sung</button>
                <button type="button" class="btn btn-danger" onclick="rejectRegistrationModal()"><i class="bi bi-x-circle"></i> Từ chối</button>
                <button type="button" class="btn text-white fw-bold" style="background-color: var(--organizer-accent);" onclick="approveRegistrationModal()"><i class="bi bi-check-circle"></i> Phê duyệt Hồ sơ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let currentRegistrationId = 0;

        // Lọc dữ liệu
        function applyFilters() {
            const competitionId = document.getElementById('competitionFilter').value;
            const search = document.getElementById('searchInput').value;
            const status = document.getElementById('statusFilter').value;
            const department = document.getElementById('departmentFilter').value;

            const params = new URLSearchParams();
            if (competitionId) params.append('competitionId', competitionId);
            if (search) params.append('search', search);
            if (status) params.append('status', status);
            if (department) params.append('department', department);

            window.location.href = `?${params.toString()}`;
        }

        // Tải chi tiết hồ sơ
        async function loadRegistrationDetail(registrationId) {
            currentRegistrationId = registrationId;
            try {
                const rows = document.querySelectorAll('tbody tr');
                let found = false;
                rows.forEach(row => {
                    if (row.querySelector('td:first-child').textContent.includes(`#${registrationId}`)) {
                        const cells = row.querySelectorAll('td');
                        document.getElementById('modalRepresentative').textContent = cells[1].querySelector('.fw-bold').textContent;
                        document.getElementById('modalTopic').textContent = cells[2].querySelector('.fw-bold').textContent;
                        document.getElementById('modalDocument').innerHTML = cells[2].innerHTML;
                        found = true;
                    }
                });
            } catch (error) {
                console.error('Error loading registration detail:', error);
            }
        }

        // Duyệt hồ sơ
        async function approveRegistration(registrationId) {
            if (!confirm('Bạn chắc chắn muốn duyệt hồ sơ này?')) return;

            try {
                const response = await fetch(`/Organizer/ApproveRegistration`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        registrationId: registrationId,
                        feedback: null
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alert('Duyệt hồ sơ thành công!');
                    location.reload();
                } else {
                    alert('Lỗi: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra');
            }
        }

        // Từ chối hồ sơ
        async function rejectRegistration(registrationId) {
            const reason = prompt('Vui lòng nhập lý do từ chối:');
            if (!reason) return;

            try {
                const response = await fetch(`/Organizer/RejectRegistration`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        registrationId: registrationId,
                        reason: reason
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alert('Từ chối hồ sơ thành công!');
                    location.reload();
                } else {
                    alert('Lỗi: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra');
            }
        }

        // Từ modal
        async function approveRegistrationModal() {
            await approveRegistration(currentRegistrationId);
        }

        async function rejectRegistrationModal() {
            await rejectRegistration(currentRegistrationId);
        }

        async function requestSupplement() {
            const feedback = document.getElementById('modalFeedback').value;
            if (!feedback) {
                alert('Vui lòng nhập yêu cầu bổ sung');
                return;
            }

            try {
                const response = await fetch(`/Organizer/RequestSupplement`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        registrationId: currentRegistrationId,
                        feedback: feedback
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alert('Yêu cầu bổ sung đã gửi!');
                    location.reload();
                } else {
                    alert('Lỗi: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra');
            }
        }

        // Gửi email nhắc nhở
        function sendReminderEmail() {
            if (confirm('Bạn chắc chắn muốn gửi email nhắc nhở cho các sinh viên chưa nộp bài?')) {
                alert('Email nhắc nhở sẽ được gửi');
            }
        }

        // Tab 3 Chart
        const ctxStatus = document.getElementById('submissionStatusChart');
        if (ctxStatus) {
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['Nộp đúng hạn', 'Nộp trễ hạn', 'Chưa nộp'],
                    datasets: [{
                        data: [@Model.ProgressStatistics.OnTimeSubmissions, @Model.ProgressStatistics.LateSubmissions, @Model.ProgressStatistics.NotSubmitted],
                        backgroundColor: ['#10b981', '#ef4444', '#cbd5e1'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        }
    </script>
}