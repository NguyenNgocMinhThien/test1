@model Web_cham_diem.Models.ViewModels.OrganizerNotificationsViewModel
@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Quản lý Thông báo";

    string MilestoneDefaultMessage(string key, string compName) => key switch
    {
        "RegistrationOpen"    => $"Cuộc thi \"{compName}\" đã chính thức mở đăng ký. Hãy nhanh tay đăng ký tham gia để không bỏ lỡ cơ hội!",
        "ReviewResults"       => $"Kết quả xét duyệt hồ sơ đăng ký cuộc thi \"{compName}\" đã được công bố. Vui lòng kiểm tra trạng thái đăng ký của bạn trong hệ thống.",
        "SubmissionDeadline"  => $"Nhắc nhở: Hạn chót nộp bài dự thi \"{compName}\" đang đến gần. Vui lòng hoàn thiện và nộp bài đúng hạn để tránh bị loại.",
        "GradingSchedule"     => $"Lịch chấm thi cuộc thi \"{compName}\" đã được xác nhận. Kính mời quý giám khảo kiểm tra lịch phân công và chuẩn bị theo đúng lịch trình.",
        "ResultsAnnouncement" => $"Kết quả chính thức cuộc thi \"{compName}\" đã được công bố. Xem chi tiết bảng xếp hạng tại trang Kết quả cuộc thi.",
        _                     => ""
    };

    string MilestoneDefaultTitle(string key) => key switch
    {
        "RegistrationOpen"    => "Mở đăng ký cuộc thi",
        "ReviewResults"       => "Công bố kết quả xét duyệt",
        "SubmissionDeadline"  => "Nhắc nhở hạn nộp bài",
        "GradingSchedule"     => "Thông báo lịch chấm thi",
        "ResultsAnnouncement" => "Công bố kết quả cuộc thi",
        _                     => "Thông báo"
    };
}

@section Styles {
<style>
.ms-row {
    transition: box-shadow .15s;
}
.ms-row:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,.07);
}
.audience-card {
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    padding: 10px 14px;
    cursor: pointer;
    min-width: 150px;
    transition: all .15s;
}
.audience-card.selected {
    border-color: #6366f1;
    background: #f5f3ff;
}
</style>
}

<div class="container-fluid py-4 px-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="font-size:1.45rem;">
                <i class="bi bi-bell-fill text-warning me-2"></i>Quản lý Thông báo
            </h2>
            <p class="text-muted mb-0 small">Gửi thông báo các mốc quan trọng đến thí sinh và giám khảo</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-warning btn-sm rounded-pill fw-semibold px-4"
                    data-bs-toggle="modal" data-bs-target="#composeModal">
                <i class="bi bi-send-fill me-1"></i>Thông báo nhỏ
            </button>
            <button class="btn btn-danger btn-sm rounded-pill fw-semibold px-4"
                    data-bs-toggle="modal" data-bs-target="#largeNotifModal">
                <i class="bi bi-megaphone-fill me-1"></i>Thông báo lớn
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #6366f1!important;">
                <div class="card-body py-3 d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:44px;height:44px;background:#ede9fe;color:#6366f1;font-size:20px;">
                        <i class="bi bi-send-check"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 lh-1">@Model.TotalSentAll.ToString("N0")</div>
                        <div class="text-muted small">Tổng đã gửi</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #f59e0b!important;">
                <div class="card-body py-3 d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:44px;height:44px;background:#fef3c7;color:#d97706;font-size:20px;">
                        <i class="bi bi-envelope-open"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 lh-1">@Model.UnreadByRecipients.ToString("N0")</div>
                        <div class="text-muted small">Chưa được đọc</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #10b981!important;">
                <div class="card-body py-3 d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:44px;height:44px;background:#d1fae5;color:#059669;font-size:20px;">
                        <i class="bi bi-trophy"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 lh-1">@Model.ActiveCompetitionCount</div>
                        <div class="text-muted small">Cuộc thi đang diễn ra</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #ef4444!important;">
                <div class="card-body py-3 d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:44px;height:44px;background:#fee2e2;color:#dc2626;font-size:20px;">
                        <i class="bi bi-alarm"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 lh-1">@Model.UpcomingMilestoneCount</div>
                        <div class="text-muted small">Mốc cần gửi (7 ngày)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- LEFT: Milestone tracker + history -->
        <div class="col-lg-8">

            <!-- Competition selector -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body py-3">
                    <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
                        <label class="fw-semibold mb-0 text-nowrap small">
                            <i class="bi bi-trophy me-1 text-warning"></i>Cuộc thi:
                        </label>
                        <select name="competitionId" class="form-select form-select-sm" style="max-width:340px;"
                                onchange="this.form.submit()">
                            @foreach (var c in Model.Competitions)
                            {
                                @if (c.CompetitionId == Model.SelectedCompetitionId)
                                {
                                    <option value="@c.CompetitionId" selected>@c.CompetitionName</option>
                                }
                                else
                                {
                                    <option value="@c.CompetitionId">@c.CompetitionName</option>
                                }
                            }
                        </select>
                    </form>
                </div>
            </div>

            @if (Model.MilestoneStatus != null)
            {
                var ms = Model.MilestoneStatus;
                int sentCount = ms.Milestones.Count(m => m.IsSent);
                int pct = ms.Milestones.Count > 0 ? (sentCount * 100 / ms.Milestones.Count) : 0;

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span class="fw-bold">
                            <i class="bi bi-flag-fill text-warning me-2"></i>Mốc thông báo — @ms.CompetitionName
                        </span>
                        <div class="d-flex gap-3 small text-muted">
                            <span><i class="bi bi-people me-1"></i>@ms.ApprovedRegistrations thí sinh</span>
                            <span><i class="bi bi-person-badge me-1"></i>@ms.TotalJudges giám khảo</span>
                            <span class="fw-semibold" style="color:#6366f1;">@sentCount/@ms.Milestones.Count mốc đã gửi</span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <!-- Overall progress -->
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span class="text-muted">Tiến độ gửi thông báo</span>
                                    <span style="color:#6366f1;">@pct%</span>
                                </div>
                                <div class="progress" style="height:8px;border-radius:4px;">
                                    <div class="progress-bar" role="progressbar"
                                         style="width:@pct%;background:linear-gradient(90deg,#6366f1,#8b5cf6);"
                                         aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Milestone steps -->
                        <div class="d-flex flex-column gap-3">
                            @foreach (var m in ms.Milestones)
                            {
                                <div class="d-flex gap-3 p-3 rounded-3 border ms-row"
                                     style="@(m.IsSent ? "border-color:#bbf7d0!important;background:#f0fdf4;" : "border-color:#e5e7eb!important;background:#fafafa;")">
                                    <!-- Icon -->
                                    <div style="min-width:44px;">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                                             style="width:44px;height:44px;font-size:18px;background:@(m.IsSent ? "#d1fae5" : "#f3f4f6");color:@(m.IsSent ? "#059669" : m.ThemeColor);">
                                            <i class="bi @(m.IsSent ? "bi-check-circle-fill" : m.IconClass)"></i>
                                        </div>
                                    </div>
                                    <!-- Content -->
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-1 mb-1">
                                            <div>
                                                <div class="fw-semibold" style="font-size:14px;">@m.Name</div>
                                                <div class="text-muted small">@m.Description</div>
                                            </div>
                                            @if (m.IsSent)
                                            {
                                                <span class="badge bg-success rounded-pill" style="font-size:11px;">
                                                    <i class="bi bi-check2 me-1"></i>Đã gửi (@m.SentCount người)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill" style="font-size:11px;">Chưa gửi</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-3 flex-wrap small text-muted">
                                            <span>
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @(m.Date.HasValue ? m.Date.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa xác định")
                                            </span>
                                            <span>
                                                <i class="bi bi-people me-1"></i>
                                                @(m.AudienceHint switch {
                                                    "Students"       => "Thí sinh đã duyệt",
                                                    "AllRegistrants" => "Tất cả đăng ký",
                                                    "Judges"         => "Giám khảo",
                                                    _                => "Thí sinh & Giám khảo"
                                                })
                                            </span>
                                            @if (m.IsSent && m.SentAt.HasValue)
                                            {
                                                <span class="text-success">
                                                    <i class="bi bi-clock-history me-1"></i>@m.SentAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            }

                                            @{
                                                var safeMsg = MilestoneDefaultMessage(m.Key, ms.CompetitionName)
                                                    .Replace("\\", "\\\\").Replace("'", "\\'").Replace("\r", "").Replace("\n", "\\n");
                                                var safeTitle = MilestoneDefaultTitle(m.Key).Replace("'", "\\'");
                                            }
                                            @if (!m.IsSent)
                                            {
                                                <button class="btn btn-sm btn-outline-primary rounded-pill ms-auto fw-semibold"
                                                        style="font-size:12px;"
                                                        onclick="openMilestoneModal('@m.Key','@ms.CompetitionId','@safeTitle','@safeMsg','@m.AudienceHint','@m.NotifType')">
                                                    <i class="bi bi-send me-1"></i>Gửi thông báo
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill ms-auto fw-semibold"
                                                        style="font-size:12px;"
                                                        onclick="openMilestoneModal('@m.Key','@ms.CompetitionId','@safeTitle','@safeMsg','@m.AudienceHint','@m.NotifType')">
                                                    <i class="bi bi-arrow-repeat me-1"></i>Gửi lại
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (!Model.Competitions.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body text-center py-5 text-muted">
                        <i class="bi bi-trophy fs-1 d-block mb-3"></i>
                        <h5>Chưa có cuộc thi nào</h5>
                        <p class="small">Tạo cuộc thi để bắt đầu quản lý thông báo.</p>
                        <a href="/Organizer/Create" class="btn btn-danger btn-sm rounded-pill">
                            <i class="bi bi-plus-circle me-1"></i>Tạo cuộc thi mới
                        </a>
                    </div>
                </div>
            }

            <!-- Notification History -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom fw-bold py-3">
                    <i class="bi bi-clock-history me-2 text-secondary"></i>Lịch sử thông báo đã gửi
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentBatches.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 small align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="py-2 ps-3">Thông báo</th>
                                        <th class="py-2">Phân loại</th>
                                        <th class="py-2 text-center">Người nhận</th>
                                        <th class="py-2 text-center">Tỷ lệ đọc</th>
                                        <th class="py-2">Thời gian</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in Model.RecentBatches)
                                    {
                                        int rPct = b.RecipientCount > 0 ? (b.ReadCount * 100 / b.RecipientCount) : 0;
                                        string typeCss = b.Type switch { "Success" => "text-success", "Warning" => "text-warning", "Error" => "text-danger", _ => "text-info" };
                                        <tr>
                                            <td class="ps-3 py-2">
                                                <div class="fw-semibold @typeCss">@b.Title</div>
                                                <div class="text-muted text-truncate" style="max-width:280px;font-size:11px;">@b.Message</div>
                                            </td>
                                            <td class="py-2">
                                                <span class="badge rounded-pill bg-light border text-secondary" style="font-size:10px;">
                                                    @b.CategoryLabel
                                                </span>
                                            </td>
                                            <td class="py-2 text-center fw-semibold">@b.RecipientCount</td>
                                            <td class="py-2">
                                                <div class="d-flex align-items-center gap-1 justify-content-center">
                                                    <div class="progress" style="width:55px;height:6px;border-radius:3px;">
                                                        <div class="progress-bar bg-success" style="width:@rPct%"></div>
                                                    </div>
                                                    <span class="text-muted" style="font-size:11px;">@rPct%</span>
                                                </div>
                                            </td>
                                            <td class="py-2 text-muted" style="font-size:11px;">@b.SentAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            <p class="small">Chưa có thông báo nào được gửi</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: Upcoming milestones + guide -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="position:sticky;top:16px;">
                <div class="card-header bg-white border-bottom fw-bold py-3">
                    <i class="bi bi-calendar-event me-2 text-danger"></i>Mốc sắp đến (30 ngày tới)
                </div>
                <div class="card-body p-0" style="max-height:460px;overflow-y:auto;">
                    @if (Model.UpcomingMilestones.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var u in Model.UpcomingMilestones)
                            {
                                <div class="list-group-item border-0 py-3">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="badge @u.BadgeCss rounded-pill mt-1 text-nowrap" style="font-size:10px;min-width:54px;">
                                            @if (u.IsOverdue) { <text>Quá hạn</text> }
                                            else if (u.DaysUntil == 0) { <text>Hôm nay</text> }
                                            else { <text>@u.DaysUntil ngày</text> }
                                        </span>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold small">@u.Name</div>
                                            <div class="text-muted" style="font-size:11px;">@u.CompetitionName</div>
                                            <div class="text-muted" style="font-size:11px;">
                                                <i class="bi bi-calendar3 me-1"></i>@u.Date.ToLocalTime().ToString("dd/MM/yyyy")
                                            </div>
                                        </div>
                                        @if (!u.NotificationSent)
                                        {
                                            <i class="bi bi-bell-fill text-warning mt-1" title="Chưa gửi" style="font-size:14px;"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-circle-fill text-success mt-1" title="Đã gửi" style="font-size:14px;"></i>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-check fs-1 d-block mb-2"></i>
                            <p class="small">Không có mốc nào trong 30 ngày tới</p>
                        </div>
                    }
                </div>

                <!-- Guide -->
                <div class="card-footer bg-light border-top pt-3 pb-2 small">
                    <div class="fw-semibold text-muted mb-2">Các mốc thông báo tiêu chuẩn</div>
                    @{
                        var guide = new (string Icon, string Color, string Name, string Hint)[]
                        {
                            ("bi-door-open",       "#10b981", "Mở đăng ký",        "Gửi: thí sinh & GK"),
                            ("bi-check-circle-fill","#3b82f6", "Kết quả xét duyệt", "Gửi: tất cả đăng ký"),
                            ("bi-clock-fill",       "#f59e0b", "Hạn nộp bài",       "Gửi: thí sinh đã duyệt"),
                            ("bi-journal-check",    "#6366f1", "Lịch chấm thi",     "Gửi: giám khảo"),
                            ("bi-megaphone-fill",   "#8b5cf6", "Công bố kết quả",   "Gửi: tất cả"),
                        };
                    }
                    @foreach (var g in guide)
                    {
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi @g.Icon" style="color:@g.Color;width:16px;font-size:13px;"></i>
                            <span class="fw-semibold">@g.Name</span>
                            <span class="text-muted"> — @g.Hint</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ====== Compose / Send Modal ====== -->
<div class="modal fade" id="composeModal" tabindex="-1" aria-labelledby="composeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                <h5 class="modal-title text-white fw-bold" id="composeModalLabel">
                    <i class="bi bi-send-fill me-2"></i>Gửi thông báo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="modalMilestoneKey" value="">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Cuộc thi <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="modalCompetitionId">
                            @foreach (var c in Model.Competitions)
                            {
                                @if (c.CompetitionId == Model.SelectedCompetitionId)
                                {
                                    <option value="@c.CompetitionId" selected>@c.CompetitionName</option>
                                }
                                else
                                {
                                    <option value="@c.CompetitionId">@c.CompetitionName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold small">Tiêu đề <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" id="modalTitle"
                               placeholder="Nhập tiêu đề thông báo..." maxlength="200">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Loại thông báo</label>
                        <select class="form-select form-select-sm" id="modalType">
                            <option value="Info">Thông tin</option>
                            <option value="Success">Thành công</option>
                            <option value="Warning">Cảnh báo</option>
                            <option value="Error">Khẩn cấp</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Nội dung <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm" id="modalMessage" rows="4"
                                  placeholder="Nhập nội dung thông báo..." maxlength="1000"></textarea>
                        <div class="text-end small text-muted mt-1"><span id="charCount">0</span>/1000 ký tự</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Gửi đến</label>
                        <div class="d-flex gap-2 flex-wrap" id="audienceGroup">
                            @{
                                var audItems = new (string Val, string Icon, string Color, string Label)[]
                                {
                                    ("All",            "bi-people-fill",      "#6366f1", "Tất cả"),
                                    ("Students",       "bi-person-fill",      "#10b981", "Thí sinh đã duyệt"),
                                    ("AllRegistrants", "bi-person-badge",     "#3b82f6", "Tất cả đăng ký"),
                                    ("Judges",         "bi-person-workspace", "#f59e0b", "Giám khảo"),
                                };
                            }
                            @foreach (var a in audItems)
                            {
                                <div class="audience-card @(a.Val == "All" ? "selected" : "")" data-val="@a.Val"
                                     onclick="selectAudience('@a.Val')">
                                    <input class="form-check-input me-1" type="radio" name="audience"
                                           id="aud_@a.Val" value="@a.Val" @(a.Val == "All" ? "checked" : "")>
                                    <label class="fw-semibold small" for="aud_@a.Val" style="cursor:pointer;">
                                        <i class="bi @a.Icon me-1" style="color:@a.Color;"></i>@a.Label
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div id="sendResult" class="mt-3" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-light rounded-pill px-4" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold" id="sendBtn"
                        onclick="sendNotification()">
                    <i class="bi bi-send me-1"></i>Gửi thông báo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ====== Large Announcement Modal ====== -->
<div class="modal fade" id="largeNotifModal" tabindex="-1" aria-labelledby="largeNotifModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0" style="background:linear-gradient(135deg,#dc2626,#e87722);">
                <h5 class="modal-title text-white fw-bold" id="largeNotifModalLabel">
                    <i class="bi bi-megaphone-fill me-2"></i>Đăng thông báo lớn (công khai)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-4">
                    <i class="bi bi-info-circle me-1 text-danger"></i>
                    Thông báo lớn sẽ hiển thị công khai tại trang <strong>/Thông báo</strong>, kèm hình ảnh và file đính kèm (nếu có).
                </p>

                <form id="largeNotifForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <!-- Title -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Tiêu đề <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="lnTitle" class="form-control form-control-sm"
                                   placeholder="Nhập tiêu đề thông báo..." maxlength="300" required>
                        </div>

                        <!-- Type + Competition row -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Loại thông báo</label>
                            <select name="type" id="lnType" class="form-select form-select-sm">
                                <option value="Info">Thông tin</option>
                                <option value="Success">Thành công</option>
                                <option value="Warning">Cảnh báo</option>
                                <option value="Error">Khẩn cấp</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">Cuộc thi liên quan (tuỳ chọn)</label>
                            <select name="relatedCompetitionId" id="lnCompetition" class="form-select form-select-sm">
                                <option value="">-- Không chọn --</option>
                                @foreach (var c in Model.Competitions)
                                {
                                    <option value="@c.CompetitionId">@c.CompetitionName</option>
                                }
                            </select>
                        </div>

                        <!-- Content -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Nội dung <span class="text-danger">*</span></label>
                            <textarea name="content" id="lnContent" class="form-control form-control-sm" rows="6"
                                      placeholder="Nhập nội dung chi tiết thông báo..." maxlength="5000" required></textarea>
                            <div class="text-end small text-muted mt-1"><span id="lnCharCount">0</span>/5000 ký tự</div>
                        </div>

                        <!-- Image upload -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">
                                <i class="bi bi-image me-1 text-primary"></i>Hình ảnh (tuỳ chọn)
                            </label>
                            <input type="file" name="imageFile" id="lnImageFile" class="form-control form-control-sm"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" onchange="previewLnImage(this)">
                            <div class="form-text">JPG, PNG, GIF, WEBP — tối đa 5MB</div>
                            <div id="lnImagePreview" class="mt-2" style="display:none;">
                                <img id="lnImgPreviewEl" src="" alt="preview"
                                     style="max-height:160px;border-radius:8px;object-fit:cover;border:1px solid #dee2e6;">
                            </div>
                        </div>

                        <!-- Attachment upload -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">
                                <i class="bi bi-paperclip me-1 text-danger"></i>File đính kèm (tuỳ chọn)
                            </label>
                            <input type="file" name="attachmentFile" id="lnAttachFile" class="form-control form-control-sm"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx">
                            <div class="form-text">PDF, Word, Excel — tối đa 20MB</div>
                            <div id="lnAttachName" class="mt-2 small text-success" style="display:none;">
                                <i class="bi bi-check-circle me-1"></i><span></span>
                            </div>
                        </div>
                    </div>

                    <div id="lnResult" class="mt-3" style="display:none;"></div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-light rounded-pill px-4" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn btn-sm btn-danger rounded-pill px-5 fw-semibold" id="lnSendBtn"
                        onclick="submitLargeNotif()">
                    <i class="bi bi-megaphone me-1"></i>Đăng thông báo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function selectAudience(val) {
    document.querySelectorAll('.audience-card').forEach(c => c.classList.remove('selected'));
    const card = document.querySelector(`.audience-card[data-val="${val}"]`);
    if (card) card.classList.add('selected');
    const radio = document.getElementById('aud_' + val);
    if (radio) radio.checked = true;
}

document.getElementById('modalMessage')?.addEventListener('input', function () {
    document.getElementById('charCount').textContent = this.value.length;
});

function openMilestoneModal(key, competitionId, defaultTitle, defaultMsg, audience, type) {
    document.getElementById('modalMilestoneKey').value = key;
    document.getElementById('modalTitle').value = defaultTitle;
    document.getElementById('modalMessage').value = defaultMsg;
    document.getElementById('charCount').textContent = defaultMsg.length;
    const compSel = document.getElementById('modalCompetitionId');
    if (compSel) compSel.value = String(competitionId);
    const typeSel = document.getElementById('modalType');
    if (typeSel) typeSel.value = type || 'Info';
    selectAudience(audience || 'All');
    document.getElementById('sendResult').style.display = 'none';
    new bootstrap.Modal(document.getElementById('composeModal')).show();
}

async function sendNotification() {
    const title    = document.getElementById('modalTitle').value.trim();
    const message  = document.getElementById('modalMessage').value.trim();
    const compId   = parseInt(document.getElementById('modalCompetitionId').value);
    const type     = document.getElementById('modalType').value;
    const mkey     = document.getElementById('modalMilestoneKey').value;
    const audience = document.querySelector('input[name="audience"]:checked')?.value ?? 'All';

    if (!title)   { showResult('danger', 'Vui lòng nhập tiêu đề.'); return; }
    if (!message) { showResult('danger', 'Vui lòng nhập nội dung.'); return; }

    const btn = document.getElementById('sendBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...';

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const res = await fetch('/Organizer/SendNotification', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId: compId, title, message, type, audience, milestoneKey: mkey })
        });
        const data = await res.json();
        if (data.ok) {
            showResult('success', `<i class="bi bi-check-circle me-1"></i>Đã gửi thành công đến <strong>${data.count}</strong> người nhận!`);
            setTimeout(() => { bootstrap.Modal.getInstance(document.getElementById('composeModal'))?.hide(); location.reload(); }, 2000);
        } else {
            showResult('danger', data.message ?? 'Gửi thất bại.');
        }
    } catch {
        showResult('danger', 'Lỗi kết nối. Vui lòng thử lại.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send me-1"></i>Gửi thông báo';
    }
}

function showResult(type, html) {
    const el = document.getElementById('sendResult');
    el.style.display = '';
    el.innerHTML = `<div class="alert alert-${type} alert-dismissible small py-2 mb-0">${html}<button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button></div>`;
}

// ---- Large Notification ----
document.getElementById('lnContent')?.addEventListener('input', function () {
    document.getElementById('lnCharCount').textContent = this.value.length;
});

document.getElementById('lnAttachFile')?.addEventListener('change', function () {
    const nameEl = document.getElementById('lnAttachName');
    if (this.files.length > 0) {
        nameEl.style.display = '';
        nameEl.querySelector('span').textContent = this.files[0].name;
    } else {
        nameEl.style.display = 'none';
    }
});

function previewLnImage(input) {
    const preview = document.getElementById('lnImagePreview');
    const img     = document.getElementById('lnImgPreviewEl');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { img.src = e.target.result; preview.style.display = ''; };
        reader.readAsDataURL(input.files[0]);
    } else {
        preview.style.display = 'none';
    }
}

async function submitLargeNotif() {
    const title   = document.getElementById('lnTitle').value.trim();
    const content = document.getElementById('lnContent').value.trim();
    if (!title)   { showLnResult('danger', 'Vui lòng nhập tiêu đề.'); return; }
    if (!content) { showLnResult('danger', 'Vui lòng nhập nội dung.'); return; }

    const btn = document.getElementById('lnSendBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang đăng...';

    const formData = new FormData(document.getElementById('largeNotifForm'));

    try {
        const res  = await fetch('/Organizer/CreateAnnouncement', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.ok) {
            showLnResult('success', '<i class="bi bi-check-circle me-1"></i>Đăng thông báo thành công!');
            setTimeout(() => { bootstrap.Modal.getInstance(document.getElementById('largeNotifModal'))?.hide(); location.reload(); }, 1800);
        } else {
            showLnResult('danger', data.message ?? 'Đăng thông báo thất bại.');
        }
    } catch {
        showLnResult('danger', 'Lỗi kết nối. Vui lòng thử lại.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-megaphone me-1"></i>Đăng thông báo';
    }
}

function showLnResult(type, html) {
    const el = document.getElementById('lnResult');
    el.style.display = '';
    el.innerHTML = `<div class="alert alert-${type} alert-dismissible small py-2 mb-0">${html}<button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button></div>`;
}
</script>
}
