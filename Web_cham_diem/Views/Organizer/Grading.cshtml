@section Scripts {
<script>
    const CID = @cid;

    // ── Toast ────────────────────────────────────────────────────
    function showToast(msg, type = 'success') {
        const el = document.getElementById('actionToast');
        el.className = `toast align-items-center text-white bg-${type} border-0`;
        document.getElementById('toastMsg').textContent = msg;
        new bootstrap.Toast(el, { delay: 3000 }).show();
    }

    async function postJson(url, body) {
        const r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
        return r.json();
    }
    async function postForm(url, params) {
        const r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams(params).toString() });
        return r.json();
    }

    // ── Tab 1: Pool filter ───────────────────────────────────────
    document.getElementById('pool-filter-input')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('#pool-table tbody tr.pool-row').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });

    // ── Tab 1: Add to Pool Modal ─────────────────────────────────
    function openAddToPoolModal() {
        document.getElementById('pool-search-input').value = '';
        document.getElementById('pool-suggestions').classList.add('d-none');
        document.getElementById('pool-selected-info').classList.add('d-none');
        document.getElementById('pool-selected-id').value = '0';
        new bootstrap.Modal(document.getElementById('addToPoolModal')).show();
    }

    let poolSearchTimeout;
    document.getElementById('pool-search-input')?.addEventListener('input', function () {
        clearTimeout(poolSearchTimeout);
        const q = this.value.trim();
        if (q.length < 2) { document.getElementById('pool-suggestions').classList.add('d-none'); return; }
        poolSearchTimeout = setTimeout(async () => {
            const res  = await fetch(`/Organizer/SearchUsersForJudgePool?search=${encodeURIComponent(q)}`);
            const users = await res.json();
            renderSuggestions('pool-suggestions', users, selectPoolUser);
        }, 300);
    });

    function selectPoolUser(u) {
        document.getElementById('pool-selected-id').value = u.userId;
        document.getElementById('pool-selected-name').textContent = u.fullName;
        document.getElementById('pool-selected-email').textContent = u.email;
        document.getElementById('pool-selected-info').classList.remove('d-none');
        document.getElementById('pool-suggestions').classList.add('d-none');
        document.getElementById('pool-search-input').value = u.fullName;
    }

    async function submitAddToPool() {
        const userId = parseInt(document.getElementById('pool-selected-id').value);
        if (!userId) { showToast('Vui lòng chọn người dùng.', 'warning'); return; }
        const data = await postJson('/Organizer/AddUserToJudgePool', { userId });
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('addToPoolModal'))?.hide();
            setTimeout(() => location.reload(), 900);
        }
    }

    async function removeFromPool(userId, name) {
        if (!confirm(`Xóa "${name}" khỏi danh sách giám khảo?\n\nLưu ý: Người này không được phân công vòng thi nào mới hết.`)) return;
        const data = await postForm('/Organizer/RemoveUserFromJudgePool', { userId });
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) setTimeout(() => location.reload(), 900);
    }

    // ── Judge data per round (for assign modal) ──────────────────
    const ROUND_JUDGES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.CompetitionRounds.ToDictionary(
            r2 => r2.RoundId.ToString(),
            r2 => Model.Judges.Where(j => j.RoundId == r2.RoundId)
                       .Select(j => new { id = j.JudgeId, name = j.FullName, role = j.JudgeRole, assigned = j.TotalAssigned, done = j.Completed })
                       .ToList()
        )
    ));

    // ── Tab 2: Round pill switching ───────────────────────────────
    function switchRound(roundId, btn) {
        document.querySelectorAll('#round-pills .nav-link').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.round-panel').forEach(p => {
            p.style.display = p.id === 'round-panel-' + roundId ? 'block' : 'none';
        });
    }

    // ── Tab 2: Add to Round Modal ─────────────────────────────────
    function openAddToRoundModal(roundId, roundName) {
        document.getElementById('round-search-input').value = '';
        document.getElementById('round-suggestions').classList.add('d-none');
        document.getElementById('round-selected-info').classList.add('d-none');
        document.getElementById('round-selected-id').value = '0';
        document.getElementById('round-role-select').value = 'Member';
        document.getElementById('round-expertise-input').value = '';
        document.getElementById('conflict-warning').classList.add('d-none');
        document.getElementById('round-modal-id').value = roundId;
        document.getElementById('round-modal-label').textContent = '🏆 ' + roundName;
        new bootstrap.Modal(document.getElementById('addToRoundModal')).show();
    }

    let roundSearchTimeout;
    document.getElementById('round-search-input')?.addEventListener('input', function () {
        clearTimeout(roundSearchTimeout);
        const q = this.value.trim();
        if (q.length < 2) { document.getElementById('round-suggestions').classList.add('d-none'); return; }
        const rid = document.getElementById('round-modal-id').value;
        roundSearchTimeout = setTimeout(async () => {
            const res   = await fetch(`/Organizer/SearchJudgesForRound?competitionId=${CID}&roundId=${rid}&search=${encodeURIComponent(q)}`);
            const users = await res.json();
            renderSuggestions('round-suggestions', users, selectRoundUser);
        }, 300);
    });

    async function selectRoundUser(u) {
        document.getElementById('round-selected-id').value = u.userId;
        document.getElementById('round-selected-name').textContent = u.fullName;
        document.getElementById('round-selected-email').textContent = u.email;
        document.getElementById('round-selected-info').classList.remove('d-none');
        document.getElementById('round-suggestions').classList.add('d-none');
        document.getElementById('round-search-input').value = u.fullName;

        // Live conflict check
        const rid = document.getElementById('round-modal-id').value;
        await checkConflicts(u.userId, rid);
    }

    async function checkConflicts(judgeUserId, roundId) {
        const res       = await fetch(`/Organizer/CheckJudgeConflict?judgeUserId=${judgeUserId}&roundId=${roundId}`);
        const conflicts = await res.json();
        const warningEl = document.getElementById('conflict-warning');
        const detailEl  = document.getElementById('conflict-details');
        if (!conflicts.length) { warningEl.classList.add('d-none'); return; }

        let html = '<ul class="mb-0 ps-3">';
        conflicts.forEach(c => {
            const s = new Date(c.existingStartDate).toLocaleDateString('vi-VN');
            const e = new Date(c.existingEndDate).toLocaleDateString('vi-VN');
            const roleVi = c.existingRole === 'HeadJudge' ? 'Trưởng ban' : c.existingRole === 'ViceHead' ? 'Phó ban' : 'Thành viên';
            html += `<li class="small"><strong>${c.existingRoundName}</strong> (${c.existingCompetitionName}) — ${s} → ${e} [${roleVi}]</li>`;
        });
        html += '</ul>';
        detailEl.innerHTML = html;
        warningEl.classList.remove('d-none');
    }

    async function submitAddToRound() {
        const userId = parseInt(document.getElementById('round-selected-id').value);
        if (!userId) { showToast('Vui lòng chọn giám khảo.', 'warning'); return; }
        const roundId = parseInt(document.getElementById('round-modal-id').value);
        const data = await postJson(`/Organizer/AddJudge?competitionId=${CID}`, {
            userId,
            role:      document.getElementById('round-role-select').value,
            expertise: document.getElementById('round-expertise-input').value,
            roundId
        });
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('addToRoundModal'))?.hide();
            setTimeout(() => location.reload(), 900);
        }
    }

    // ── Edit Judge Modal ─────────────────────────────────────────
    function openEditJudgeModal(judgeId, name, role, expertise) {
        document.getElementById('edit-judge-id').value = judgeId;
        document.getElementById('edit-judge-name').textContent = name;
        document.getElementById('edit-role-select').value = role;
        document.getElementById('edit-expertise-input').value = expertise;
        new bootstrap.Modal(document.getElementById('editJudgeModal')).show();
    }

    async function submitEditJudge() {
        const judgeId = document.getElementById('edit-judge-id').value;
        const data = await postJson(`/Organizer/UpdateJudgeRole?judgeId=${judgeId}&competitionId=${CID}`, {
            role:      document.getElementById('edit-role-select').value,
            expertise: document.getElementById('edit-expertise-input').value
        });
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) { bootstrap.Modal.getInstance(document.getElementById('editJudgeModal'))?.hide(); setTimeout(() => location.reload(), 900); }
    }

    async function removeJudge(judgeId, name) {
        if (!confirm(`Xóa "${name}" khỏi vòng thi này?`)) return;
        const data = await postForm('/Organizer/RemoveJudge', { judgeId, competitionId: CID });
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) setTimeout(() => location.reload(), 900);
    }

    // ── Tab 2: Assign Submission Modal ───────────────────────────
    function openAssignModal(submissionId, title, team, roundId) {
        document.getElementById('assign-submission-id').value = submissionId;
        document.getElementById('assign-round-id').value = roundId;
        document.getElementById('assign-modal-title').textContent = title;
        document.getElementById('assign-modal-team').textContent = team;
        document.getElementById('assign-deadline').value = '';
        document.getElementById('assign-judge-workload').classList.add('d-none');

        const select = document.getElementById('assign-judge-select');
        select.innerHTML = '<option value="">— Chọn giám khảo —</option>';
        const judges = ROUND_JUDGES[roundId] || [];
        const roleLabel = { HeadJudge: 'Trưởng ban', ViceHead: 'Phó ban', Member: 'Thành viên' };
        judges.forEach(j => {
            const opt = document.createElement('option');
            opt.value = j.id;
            opt.dataset.assigned = j.assigned;
            opt.dataset.done = j.done;
            opt.textContent = `${j.name} (${roleLabel[j.role] || j.role}) — ${j.done}/${j.assigned} bài`;
            select.appendChild(opt);
        });

        new bootstrap.Modal(document.getElementById('assignSubmissionModal')).show();
    }

    document.getElementById('assign-judge-select')?.addEventListener('change', function () {
        const opt = this.options[this.selectedIndex];
        const wl = document.getElementById('assign-judge-workload');
        const wt = document.getElementById('assign-workload-text');
        if (!this.value) { wl.classList.add('d-none'); return; }
        wt.textContent = `Đã được phân công ${opt.dataset.assigned} bài, hoàn thành ${opt.dataset.done} bài.`;
        wl.classList.remove('d-none');
    });

    async function submitAssignSubmission() {
        const submissionId = parseInt(document.getElementById('assign-submission-id').value);
        const judgeId      = parseInt(document.getElementById('assign-judge-select').value);
        const roundId      = parseInt(document.getElementById('assign-round-id').value);
        const deadlineRaw  = document.getElementById('assign-deadline').value;

        if (!judgeId) { showToast('Vui lòng chọn giám khảo.', 'warning'); return; }

        const body = { submissionIds: [submissionId], judgeId, roundId, gradingDeadline: deadlineRaw ? new Date(deadlineRaw).toISOString() : null };
        const data = await postJson(`/Organizer/AssignSubmissions?competitionId=${CID}`, body);
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('assignSubmissionModal'))?.hide();
            setTimeout(() => location.reload(), 900);
        }
    }

    async function revokeAssignment(assignmentId, judgeName) {
        if (!confirm(`Thu hồi phân công của "${judgeName}"?\n\nGiám khảo sẽ không còn thấy bài này.`)) return;
        const data = await postForm('/Organizer/RevokeAssignment', { assignmentId, competitionId: CID });
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) setTimeout(() => location.reload(), 900);
    }

    // ── Judge assignment data (for manage-assignments modal) ─────
    const JUDGE_ASSIGNMENTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Assignments
            .Where(a => a.Status != "Reassigned")
            .GroupBy(a => a.JudgeId)
            .ToDictionary(
                g => g.Key.ToString(),
                g => g.OrderBy(a => a.Status == "Completed" ? 1 : 0)
                       .ThenByDescending(a => a.AssignedDate)
                       .Select(a => new {
                           id          = a.AssignmentId,
                           title       = a.SubmissionTitle,
                           team        = a.TeamOrRep,
                           status      = a.Status,
                           deadline    = a.GradingDeadline.HasValue
                                         ? a.GradingDeadline.Value.ToString("yyyy-MM-ddTHH:mm:ssZ")
                                         : (string?)null,
                           isOverdue   = a.IsOverdue,
                           completedAt = a.CompletedAt.HasValue
                                         ? a.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                         : (string?)null
                       }).ToList()
            )
    ));

    function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function escAttr(s) { return String(s).replace(/'/g,"\\'"); }

    function openJudgeAssignmentsModal(judgeId, judgeName, judgeRole) {
        document.getElementById('jm-judge-name').textContent = judgeName;
        document.getElementById('jm-judge-role').textContent = judgeRole;

        const assignments = JUDGE_ASSIGNMENTS[judgeId] || [];
        const noEl    = document.getElementById('jm-no-assignments');
        const tblWrap = document.getElementById('jm-table-wrap');
        const tbody   = document.getElementById('jm-tbody');
        tbody.innerHTML = '';

        if (!assignments.length) {
            noEl.classList.remove('d-none');
            tblWrap.classList.add('d-none');
            document.getElementById('jm-summary').textContent = '';
        } else {
            noEl.classList.add('d-none');
            tblWrap.classList.remove('d-none');

            const done     = assignments.filter(a => a.status === 'Completed').length;
            const revokable= assignments.filter(a => a.status !== 'Completed').length;
            document.getElementById('jm-summary').textContent =
                `Tổng ${assignments.length} bài · Hoàn thành ${done} · Có thể hủy ${revokable}`;

            const statusMap = {
                Pending:    { cls: 'bg-warning text-dark', txt: 'Chờ chấm' },
                InProgress: { cls: 'bg-primary',           txt: 'Đang chấm' },
                Completed:  { cls: 'bg-success',           txt: 'Đã xong' }
            };

            assignments.forEach(a => {
                const st  = statusMap[a.status] || { cls: 'bg-secondary', txt: a.status };
                const dl  = a.deadline
                    ? new Date(a.deadline).toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' })
                    : '—';
                const overdueHtml = a.isOverdue
                    ? '<br><span class="badge bg-danger mt-1" style="font-size:.6rem">Quá hạn!</span>'
                    : '';
                const completedHtml = a.completedAt
                    ? `<br><small class="text-muted">Xong: ${a.completedAt}</small>`
                    : '';
                const actionHtml = a.status !== 'Completed'
                    ? `<button class="btn btn-sm btn-outline-danger"
                           onclick="revokeFromModal(${a.id},'${escAttr(judgeName)}')">
                           <i class="bi bi-x-circle me-1"></i>Hủy phân công
                       </button>`
                    : `<span class="text-success small"><i class="bi bi-check-circle me-1"></i>Hoàn thành</span>`;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <div class="fw-bold text-dark" style="font-size:.84rem;">${escHtml(a.title)}</div>
                        <div class="text-muted" style="font-size:.74rem;"><i class="bi bi-person me-1"></i>${escHtml(a.team)}</div>
                    </td>
                    <td><span class="badge ${st.cls}" style="font-size:.7rem;">${st.txt}</span></td>
                    <td class="small">${dl}${overdueHtml}${completedHtml}</td>
                    <td class="text-center">${actionHtml}</td>`;
                tbody.appendChild(tr);
            });
        }

        new bootstrap.Modal(document.getElementById('judgeAssignmentsModal')).show();
    }

    async function revokeFromModal(assignmentId, judgeName) {
        if (!confirm(`Hủy phân công bài này của giám khảo "${judgeName}"?\n\nSau khi hủy, giám khảo sẽ không còn thấy bài này.`)) return;
        const data = await postForm('/Organizer/RevokeAssignment', { assignmentId, competitionId: CID });
        showToast(data.message, data.success ? 'success' : 'danger');
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('judgeAssignmentsModal'))?.hide();
            setTimeout(() => location.reload(), 900);
        }
    }

    // ── Tab 2: Submission search filter ──────────────────────────
    document.querySelectorAll('.sub-filter-input').forEach(input => {
        input.addEventListener('input', function () {
            const q = this.value.toLowerCase();
            const roundId = this.dataset.round;
            document.querySelectorAll(`.sub-assign-table[data-round="${roundId}"] tbody .sub-row`).forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    });

    // ── Tab 3: Reminder ────────────────────────────────────────
    async function sendReminder(judgeId, name) {
        if (!confirm(`Gửi nhắc nhở đến "${name}"?`)) return;
        const data = await postForm('/Organizer/SendJudgeReminder', { judgeId });
        showToast(data.message, data.success ? 'success' : 'secondary');
    }

    // ── Shared: render suggestions dropdown ───────────────────
    function renderSuggestions(containerId, users, onSelect) {
        const box = document.getElementById(containerId);
        box.innerHTML = '';
        if (!users.length) {
            box.innerHTML = '<div class="p-3 text-muted small">Không tìm thấy kết quả phù hợp.</div>';
            box.classList.remove('d-none');
            return;
        }
        users.forEach(u => {
            const d = document.createElement('div');
            d.className = 'user-suggestion';
            d.innerHTML = `<div class="fw-bold small">${u.fullName}</div><div class="text-muted" style="font-size:.78rem">${u.email}${u.studentId ? ' · ' + u.studentId : ''}</div>`;
            d.onclick = () => onSelect(u);
            box.appendChild(d);
        });
        box.classList.remove('d-none');
    }

    // ── Chart ────────────────────────────────────────────────
    let chartInited = false;
    document.getElementById('btn-tab-monitor')?.addEventListener('shown.bs.tab', () => {
        if (chartInited) return;
        const ctx = document.getElementById('gradingStatusChart');
        if (!ctx) return;
        chartInited = true;
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: ['Đã chấm xong', 'Đang chấm', 'Chờ chấm'],
                datasets: [{ data: [@completed, @inProg, @pending], backgroundColor: ['#10b981','#3b82f6','#f59e0b'], borderWidth: 0 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: { callbacks: { label: ctx => { const t = ctx.dataset.data.reduce((a,b)=>a+b,0); const p = t > 0 ? Math.round(ctx.parsed*100/t) : 0; return ` ${ctx.label}: ${ctx.parsed} (${p}%)`; } } }
                }
            }
        });
    });

    // ── Tab persistence + activeTab from URL ─────────────────────
    const urlParams  = new URLSearchParams(window.location.search);
    const activeTab  = urlParams.get('activeTab');
    const targetId   = activeTab === 'assign' ? '#tab-assign' : (localStorage.getItem('grading-tab') || null);
    if (targetId) {
        const el = document.querySelector(`[data-bs-target="${targetId}"]`);
        if (el) bootstrap.Tab.getOrCreateInstance(el).show();
    }
    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(btn => {
        btn.addEventListener('shown.bs.tab', () => localStorage.setItem('grading-tab', btn.dataset.bsTarget));
    });
</script>
}
