@model Web_cham_diem.Models.ViewModels.OrganizerGradingViewModel
@{
    Layout = "~/Views/Shared/_OrganizerLayout.cshtml";
    ViewData["Title"] = "Quản lý Chấm điểm & Phân công";
    var cid = Model.SelectedCompetitionId ?? 0;
    var firstRound = Model.CompetitionRounds.FirstOrDefault();
}

@functions {
    string RoleBadge(string r) => r switch { "HeadJudge" => "bg-danger", "ViceHead" => "bg-warning text-dark", _ => "bg-secondary" };
    string RoleText(string r)  => r switch { "HeadJudge" => "Trưởng ban", "ViceHead" => "Phó ban", _ => "Thành viên" };
    string AssignBadge(string s) => s switch { "Completed" => "bg-success", "InProgress" => "bg-primary", "Reassigned" => "bg-secondary", _ => "bg-warning text-dark" };
    string AssignText(string s)  => s switch { "Completed" => "Hoàn thành", "InProgress" => "Đang chấm", "Reassigned" => "Đã thu hồi", _ => "Chờ chấm" };
    string ProgressColor(double pct) => pct >= 80 ? "bg-success" : pct >= 40 ? "bg-warning" : "bg-danger";
    string RoundStatusBadge(string s) => s switch { "Active" => "bg-success", "Completed" => "bg-secondary", _ => "bg-info text-dark" };
    string RoundStatusText(string s)  => s switch { "Active" => "Đang diễn ra", "Completed" => "Hoàn thành", _ => "Sắp diễn ra" };
}

@section Styles {
<style>
    .org-grading-wrapper { background-color: var(--primary-bg); min-height: calc(100vh - 70px); }

    .grade-stat-card { background: #fff; padding: 18px 22px; border-radius: 12px; border: 1px solid var(--border-color); transition: box-shadow .2s; }
    .grade-stat-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.08); }
    .grade-stat-title { font-size: .73rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
    .grade-stat-val { font-size: 1.9rem; font-weight: 800; color: var(--text-dark); margin-top: 4px; line-height: 1; }

    .grading-tabs { border-bottom: 2px solid var(--border-color); margin-top: 20px; margin-bottom: 0; }
    .grading-tabs .nav-link { border: none; color: var(--text-muted); font-weight: 600; padding: 12px 20px; border-bottom: 3px solid transparent; margin-bottom: -2px; transition: all .3s; }
    .grading-tabs .nav-link:hover { color: var(--organizer-accent); }
    .grading-tabs .nav-link.active { background: none; color: var(--organizer-accent); border-bottom-color: var(--organizer-accent); }

    .grade-table-container { background: #fff; border-radius: 0 0 12px 12px; border: 1px solid var(--border-color); border-top: none; overflow: hidden; }
    .grade-table th { text-transform: uppercase; font-size: .72rem; font-weight: 700; color: var(--text-muted); background: #f8fafc; padding: 13px 15px; border-bottom: 2px solid var(--border-color); white-space: nowrap; }
    .grade-table td { padding: 13px 15px; vertical-align: middle; font-size: .87rem; border-bottom: 1px solid var(--border-color); color: var(--text-dark); }
    .grade-table tbody tr:last-child td { border-bottom: none; }
    .grade-table tbody tr:hover td { background: #f8fafc; }

    .workload-bar { height: 7px; border-radius: 10px; background: #e2e8f0; margin-top: 5px; overflow: hidden; }

    .avatar-sm { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
    .avatar-placeholder { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: .8rem; flex-shrink: 0; }

    .user-suggestion { padding: 10px 14px; cursor: pointer; border-bottom: 1px solid #f1f5f9; transition: background .15s; }
    .user-suggestion:hover { background: #f0f9ff; }
    .user-suggestion:last-child { border-bottom: none; }

    .empty-state { padding: 50px 20px; text-align: center; color: var(--text-muted); }
    .empty-state i { font-size: 2.8rem; opacity: .25; }

    /* Pool table assignment chips */
    .round-chip { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: .68rem; font-weight: 600; margin: 2px; }
    .round-chip.head { background: #fee2e2; color: #dc2626; }
    .round-chip.vice { background: #fef3c7; color: #d97706; }
    .round-chip.member { background: #e5e7eb; color: #374151; }

    /* Round pills in Tab 2 */
    .round-pills .nav-link { padding: 8px 18px; border-radius: 20px; font-weight: 600; font-size: .85rem; color: var(--text-muted); background: #f1f5f9; border: 1px solid transparent; margin-right: 6px; transition: all .2s; }
    .round-pills .nav-link:hover { background: #e2e8f0; color: var(--text-dark); }
    .round-pills .nav-link.active { background: var(--organizer-accent); color: #fff; border-color: var(--organizer-accent); }
    .round-pills .nav-link .badge { font-size: .6rem; }

    /* Round header card */
    .round-header-card { background: linear-gradient(135deg,#f0f4ff,#e8f0fe); border: 1px solid #dce3f0; border-radius: 10px; padding: 14px 18px; margin-bottom: 16px; }

    .conflict-badge { background: #fef3c7; border: 1px solid #f59e0b; color: #92400e; border-radius: 8px; padding: 8px 12px; font-size: .82rem; }

    /* Submission Assignment Section */
    .submission-assign-section { background: #f8fafc; border: 1px solid var(--border-color); border-radius: 10px; padding: 14px 16px; }
    .submission-assign-header { margin-bottom: 12px; }
    .submission-empty-state { text-align: center; padding: 28px 16px; color: var(--text-muted); }
    .submission-empty-state i { font-size: 2rem; opacity: .25; display: block; margin-bottom: 8px; }

    /* Assignment chips */
    .assign-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px 3px 9px; border-radius: 20px; font-size: .75rem; font-weight: 600; border: 1px solid; }
    .assign-chip-pending   { background: #fef9c3; border-color: #fbbf24; color: #92400e; }
    .assign-chip-inprogress{ background: #dbeafe; border-color: #60a5fa; color: #1e40af; }
    .assign-chip-done      { background: #dcfce7; border-color: #4ade80; color: #166534; }
    .assign-chip-remove { background: none; border: none; padding: 0; margin-left: 2px; cursor: pointer; font-size: .85rem; line-height: 1; color: inherit; opacity: .6; }
    .assign-chip-remove:hover { opacity: 1; }
    .assign-btn { font-size: .78rem; white-space: nowrap; }
    .sub-row:hover td { background: #f0f4ff !important; }
</style>
}

<div class="org-grading-wrapper py-4">
    <div class="container-fluid">

        <!-- Header -->
        <div class="mb-4">
            <h3 class="fw-bold mb-1 text-dark">Quản lý Chấm điểm & Phân công</h3>
            <p class="text-muted small mb-0">Quản lý danh sách giám khảo và phân công ban giám khảo cho từng vòng thi.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Statistics -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="grade-stat-card border-bottom border-3 border-primary">
                    <div class="grade-stat-title">Giám khảo trong pool</div>
                    <div class="grade-stat-val text-primary">@Model.JudgePool.Count</div>
                    <div class="small text-muted mt-1">toàn hệ thống</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="grade-stat-card border-bottom border-3 border-warning">
                    <div class="grade-stat-title">Tổng bài phân công</div>
                    <div class="grade-stat-val text-warning">@Model.TotalAssignments</div>
                    <div class="small text-muted mt-1">@Model.Assignments.Count(a => a.IsOverdue) quá hạn</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="grade-stat-card border-bottom border-3" style="border-color:var(--organizer-accent)!important">
                    <div class="grade-stat-title">Bài đã chấm xong</div>
                    <div class="grade-stat-val" style="color:var(--organizer-accent)">@Model.CompletedAssignments</div>
                    <div class="small text-muted mt-1">/ @Model.TotalAssignments bài</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="grade-stat-card border-bottom border-3 border-success">
                    <div class="grade-stat-title">Tỷ lệ hoàn thành</div>
                    <div class="grade-stat-val text-success">@Model.CompletionRate%</div>
                    <div class="small text-muted mt-1">@Model.Alerts.Count cảnh báo</div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs grading-tabs" id="gradingTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-pool" type="button" id="btn-tab-pool">
                    <i class="bi bi-people me-2"></i>Danh sách Giám khảo
                    @if (Model.JudgePool.Any())
                    { <span class="badge bg-light text-dark border ms-1">@Model.JudgePool.Count</span> }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-assign" type="button" id="btn-tab-assign">
                    <i class="bi bi-person-check me-2"></i>Phân công Ban Giám khảo
                    @if (Model.Judges.Any())
                    { <span class="badge bg-secondary ms-1">@Model.Judges.Count</span> }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-monitor" type="button" id="btn-tab-monitor">
                    <i class="bi bi-activity me-2"></i>Theo dõi & Cảnh báo
                    @if (Model.Alerts.Any())
                    { <span class="badge bg-danger ms-1">@Model.Alerts.Count</span> }
                </button>
            </li>
        </ul>

        <div class="tab-content">

            <!-- ═══ TAB 1: DANH SÁCH GIÁM KHẢO (Pool) ═══ -->
            <div class="tab-pane fade show active" id="tab-pool">
                <div class="d-flex justify-content-between align-items-center py-3">
                    <div class="input-group input-group-sm" style="max-width:260px">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" id="pool-filter-input" class="form-control" placeholder="Lọc tên giám khảo...">
                    </div>
                    <button class="btn btn-sm btn-primary" onclick="openAddToPoolModal()">
                        <i class="bi bi-person-plus me-1"></i>Thêm Giám khảo
                    </button>
                </div>

                <div class="grade-table-container shadow-sm">
                    @if (!Model.JudgePool.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-people d-block mb-3"></i>
                            <p class="fw-bold mb-1">Chưa có giám khảo nào</p>
                            <p class="small mb-0">Nhấn "Thêm Giám khảo" để đưa một người dùng vào danh sách giám khảo của hệ thống.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table grade-table mb-0" id="pool-table">
                                <thead>
                                    <tr>
                                        <th width="28%">Họ tên / Email</th>
                                        <th width="10%" class="text-center">Số vòng</th>
                                        <th>Cuộc thi & Vòng đang tham gia</th>
                                        <th class="text-center" width="10%">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.JudgePool)
                                    {
                                        var initials = string.Concat(p.FullName.Split(' ').TakeLast(2).Select(w => w.Length > 0 ? w[0].ToString() : ""));
                                        <tr class="pool-row">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-placeholder text-white" style="background:#0ea5e9">@initials</div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@p.FullName</div>
                                                        <div class="small text-muted">@p.Email</div>
                                                        @if (!string.IsNullOrEmpty(p.StudentId))
                                                        { <div class="small text-muted">MSSV: @p.StudentId</div> }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @if (p.TotalRoundsAssigned > 0)
                                                { <span class="badge bg-primary">@p.TotalRoundsAssigned vòng</span> }
                                                else
                                                { <span class="text-muted small">Chưa phân công</span> }
                                            </td>
                                            <td>
                                                @if (p.RoundAssignments.Any())
                                                {
                                                    foreach (var ra in p.RoundAssignments)
                                                    {
                                                        var chipClass = ra.JudgeRole == "HeadJudge" ? "head" : ra.JudgeRole == "ViceHead" ? "vice" : "member";
                                                        <span class="round-chip @chipClass" title="@ra.CompetitionName">
                                                            @RoleText(ra.JudgeRole) · @ra.RoundName
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-light text-danger"
                                                        onclick="removeFromPool(@p.UserId, '@p.FullName.Replace("'", "\\'")')"
                                                        title="Xóa khỏi danh sách giám khảo">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="p-3 bg-white border-top">
                            <small class="text-muted">Tổng: @Model.JudgePool.Count giám khảo trong hệ thống</small>
                        </div>
                    }
                </div>
            </div>

            <!-- ═══ TAB 2: PHÂN CÔNG BAN GIÁM KHẢO (per round) ═══ -->
            <div class="tab-pane fade" id="tab-assign">

                <!-- Bước 1: Chọn cuộc thi -->
                <div class="bg-white border rounded-3 p-4 mt-3 shadow-sm mb-3">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div>
                            <div class="fw-bold mb-1"><i class="bi bi-trophy-fill text-warning me-2"></i>Bước 1 — Chọn cuộc thi cần phân công giám khảo</div>
                            <div class="small text-muted">Sau khi chọn, các vòng thi của cuộc thi đó sẽ hiện ra bên dưới.</div>
                        </div>
                        @if (Model.Competitions.Any())
                        {
                            <form method="get" asp-action="Grading" asp-controller="Organizer"
                                  class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
                                <input type="hidden" name="activeTab" value="assign" />
                                <select name="competitionId" class="form-select border-primary" style="min-width:260px"
                                        onchange="this.form.submit()">
                                    <option value="">— Chọn cuộc thi —</option>
                                    @foreach (var c in Model.Competitions)
                                    {
                                        if (Model.SelectedCompetitionId == c.CompetitionId)
                                        { <option value="@c.CompetitionId" selected>@c.CompetitionName</option> }
                                        else
                                        { <option value="@c.CompetitionId">@c.CompetitionName</option> }
                                    }
                                </select>
                                @if (cid > 0)
                                {
                                    <span class="badge bg-success py-2 px-3 text-nowrap">
                                        <i class="bi bi-check-circle me-1"></i>Đã chọn
                                    </span>
                                }
                            </form>
                        }
                    </div>
                </div>

                @if (cid == 0)
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-trophy" style="font-size:3rem;opacity:.2;"></i>
                        <p class="mt-3 mb-1 fw-bold">Chưa chọn cuộc thi</p>
                        <p class="small">Hãy chọn cuộc thi ở bước 1 phía trên để bắt đầu phân công.</p>
                    </div>
                }
                else if (!Model.CompetitionRounds.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Cuộc thi này chưa có vòng thi nào. Hãy tạo vòng thi trước khi phân công giám khảo.
                    </div>
                }
                else
                {
                    <!-- Bước 2: Chọn vòng thi -->
                    <div class="pt-1 pb-2 d-flex align-items-center gap-3 flex-wrap">
                        <span class="small fw-bold text-muted text-nowrap"><i class="bi bi-signpost-split me-1"></i>Bước 2 — Chọn vòng thi:</span>
                        <ul class="nav round-pills flex-wrap mb-0" id="round-pills" role="tablist">
                            @foreach (var r in Model.CompetitionRounds)
                            {
                                var roundJudges = Model.Judges.Where(j => j.RoundId == r.RoundId).ToList();
                                var hasHead = roundJudges.Any(j => j.JudgeRole == "HeadJudge");
                                var isFirst = r == Model.CompetitionRounds.First();
                                <li class="nav-item">
                                    <button class="nav-link @(isFirst ? "active" : "")"
                                            data-round-id="@r.RoundId"
                                            onclick="switchRound(@r.RoundId, this)">
                                        Vòng @r.RoundOrder: @r.RoundName
                                        <span class="badge @(hasHead ? "bg-light text-dark border" : "bg-warning text-dark") ms-1">
                                            @roundJudges.Count
                                        </span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Per-Round Panels -->
                    @foreach (var r in Model.CompetitionRounds)
                    {
                        var roundJudges   = Model.Judges.Where(j => j.RoundId == r.RoundId).OrderBy(j => j.JudgeRole == "HeadJudge" ? 0 : j.JudgeRole == "ViceHead" ? 1 : 2).ThenBy(j => j.FullName).ToList();
                        var hasHead       = roundJudges.Any(j => j.JudgeRole == "HeadJudge");
                        var isFirst       = r == Model.CompetitionRounds.First();
                        var localTz       = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
                        var startLocal    = TimeZoneInfo.ConvertTimeFromUtc(r.StartDate, localTz);
                        var endLocal      = TimeZoneInfo.ConvertTimeFromUtc(r.EndDate, localTz);

                        <div class="round-panel mt-3" id="round-panel-@r.RoundId"
                             style="@(isFirst ? "" : "display:none")">

                            <!-- Round header -->
                            <div class="round-header-card d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span style="font-size:1.1rem">🏆</span>
                                        <strong class="fs-6">Vòng @r.RoundOrder: @r.RoundName</strong>
                                        <span class="badge @RoundStatusBadge(r.Status)">@RoundStatusText(r.Status)</span>
                                        @if (!hasHead)
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size:.65rem">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Chưa có Trưởng ban
                                            </span>
                                        }
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-calendar2-range me-1"></i>
                                        @startLocal.ToString("dd/MM/yyyy") – @endLocal.ToString("dd/MM/yyyy")
                                        <span class="ms-3"><i class="bi bi-people me-1"></i>@roundJudges.Count giám khảo</span>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-primary"
                                        onclick="openAddToRoundModal(@r.RoundId, '@r.RoundName.Replace("'", "\\'")')">
                                    <i class="bi bi-person-plus me-1"></i>Thêm vào vòng này
                                </button>
                            </div>

                            <!-- Judge table for this round -->
                            <div class="grade-table-container shadow-sm" style="border-radius:10px">
                                @if (!roundJudges.Any())
                                {
                                    <div class="empty-state" style="padding:35px 20px;">
                                        <i class="bi bi-person-dash d-block mb-2" style="font-size:2rem;opacity:.25;"></i>
                                        <p class="small mb-1 fw-bold">Chưa có giám khảo nào trong vòng này</p>
                                        <p class="small mb-0 text-muted">Nhấn "Thêm vào vòng này" để chỉ định giám khảo từ danh sách.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table grade-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th width="26%">Họ tên / Email</th>
                                                    <th width="12%">Vai trò</th>
                                                    <th>Chuyên môn</th>
                                                    <th width="17%">Workload</th>
                                                    <th width="15%">Tiến độ chấm</th>
                                                    <th class="text-center" width="14%">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var j in roundJudges)
                                                {
                                                    var initials = string.Concat(j.FullName.Split(' ').TakeLast(2).Select(w => w.Length > 0 ? w[0].ToString() : ""));
                                                    var clr = j.JudgeRole == "HeadJudge" ? "#dc3545" : j.JudgeRole == "ViceHead" ? "#f59e0b" : "#6c757d";
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="avatar-placeholder text-white" style="background:@clr">@initials</div>
                                                                <div>
                                                                    <div class="fw-bold text-dark">@j.FullName</div>
                                                                    <div class="small text-muted">@j.Email</div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td><span class="badge @RoleBadge(j.JudgeRole)">@RoleText(j.JudgeRole)</span></td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(j.Expertise))
                                                            { <span class="badge bg-light text-dark border">@j.Expertise</span> }
                                                            else { <span class="text-muted small">—</span> }
                                                        </td>
                                                        <td>
                                                            <div class="fw-bold">@j.TotalAssigned bài</div>
                                                            <div class="small text-muted">Xong: @j.Completed · Đang: @j.InProgress</div>
                                                        </td>
                                                        <td>
                                                            <div class="d-flex justify-content-between small mb-1">
                                                                <span class="text-muted">@j.Completed / @j.TotalAssigned</span>
                                                                <span class="fw-bold">@j.CompletionRate%</span>
                                                            </div>
                                                            <div class="workload-bar">
                                                                <div class="progress-bar @ProgressColor(j.CompletionRate)"
                                                                     style="width:@j.CompletionRate%;height:100%;border-radius:10px"></div>
                                                            </div>
                                                        </td>
                                                        <td class="text-center">
                                                            <button class="btn btn-sm btn-light text-primary"
                                                                    onclick="openEditJudgeModal(@j.JudgeId,'@j.FullName.Replace("'","\\'")', '@j.JudgeRole','@(j.Expertise ?? "")')"
                                                                    title="Chỉnh sửa vai trò">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-light text-info"
                                                                    onclick="openJudgeAssignmentsModal(@j.JudgeId,'@j.FullName.Replace("'","\\'")', '@RoleText(j.JudgeRole)')"
                                                                    title="Xem & hủy phân công bài">
                                                                <i class="bi bi-list-task"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-light text-danger"
                                                                    onclick="removeJudge(@j.JudgeId,'@j.FullName.Replace("'","\\'")')"
                                                                    title="Xóa khỏi vòng">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            @{
                                var submissionsInRound = Model.Submissions
                                    .Where(s => s.CompetitionRoundId == r.RoundId)
                                    .OrderBy(s => s.Title)
                                    .ToList();
                            }

                            <!-- ── Phân công Bài nộp ─────────────────────────────── -->
                            <div class="submission-assign-section mt-3">
                                <div class="submission-assign-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark-person text-primary"></i>
                                        <span class="fw-bold text-dark" style="font-size:.9rem;">Phân công Bài nộp</span>
                                        <span class="badge bg-primary rounded-pill">@submissionsInRound.Count bài</span>
                                    </div>
                                    @if (submissionsInRound.Any())
                                    {
                                        <div class="position-relative">
                                            <input type="text"
                                                   class="form-control form-control-sm sub-filter-input"
                                                   data-round="@r.RoundId"
                                                   placeholder="Tìm bài nộp..."
                                                   style="width:200px; padding-left: 30px;">
                                            <i class="bi bi-search position-absolute text-muted"
                                               style="left:9px; top:50%; transform:translateY(-50%); font-size:.75rem; pointer-events:none;"></i>
                                        </div>
                                    }
                                </div>

                                @if (!submissionsInRound.Any())
                                {
                                    <div class="submission-empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <p class="mb-0 fw-semibold">Chưa có bài nộp nào trong vòng này</p>
                                        <small class="text-muted">Thí sinh chưa nộp bài hoặc bài chưa được gán vào vòng này.</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table grade-table mb-0 sub-assign-table" data-round="@r.RoundId">
                                            <thead>
                                                <tr>
                                                    <th style="width:30%">Tên bài / Thí sinh</th>
                                                    <th style="width:12%">Trạng thái</th>
                                                    <th>Đã phân công cho</th>
                                                    <th class="text-center" style="width:130px">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var sub in submissionsInRound)
                                                {
                                                    var subStatusBadge = sub.SubmissionStatus switch
                                                    {
                                                        "Submitted"    => "bg-primary",
                                                        "Under Review" => "bg-warning text-dark",
                                                        "Evaluated"    => "bg-success",
                                                        "Draft"        => "bg-light text-dark border",
                                                        _              => "bg-secondary"
                                                    };
                                                    var subStatusText = sub.SubmissionStatus switch
                                                    {
                                                        "Submitted"    => "Đã nộp",
                                                        "Under Review" => "Đang chấm",
                                                        "Evaluated"    => "Đã chấm",
                                                        "Draft"        => "Nháp",
                                                        _              => sub.SubmissionStatus
                                                    };
                                                    var activeAssigns = sub.CurrentAssignments
                                                        .Where(a => a.Status != "Reassigned")
                                                        .ToList();
                                                    <tr class="sub-row">
                                                        <td>
                                                            <div class="fw-bold text-dark" style="font-size:.85rem;">@sub.Title</div>
                                                            <div class="text-muted" style="font-size:.75rem;">
                                                                <i class="bi bi-person me-1"></i>@sub.TeamOrRepresentative
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <span class="badge @subStatusBadge" style="font-size:.7rem;">@subStatusText</span>
                                                        </td>
                                                        <td>
                                                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                                                @if (!activeAssigns.Any())
                                                                {
                                                                    <span class="text-muted small fst-italic">Chưa phân công</span>
                                                                }
                                                                else
                                                                {
                                                                    @foreach (var a in activeAssigns)
                                                                    {
                                                                        var aStatusBadge = a.Status switch
                                                                        {
                                                                            "Completed"  => "assign-chip-done",
                                                                            "InProgress" => "assign-chip-inprogress",
                                                                            _            => "assign-chip-pending"
                                                                        };
                                                                        <span class="assign-chip @aStatusBadge" title="@AssignText(a.Status)">
                                                                            <i class="bi bi-person-check me-1"></i>@a.JudgeName
                                                                            @if (a.Status != "Completed")
                                                                            {
                                                                                <button type="button"
                                                                                        class="assign-chip-remove"
                                                                                        onclick="revokeAssignment(@a.AssignmentId, '@a.JudgeName.Replace("'","\\'")')"
                                                                                        title="Thu hồi phân công">×</button>
                                                                            }
                                                                        </span>
                                                                    }
                                                                }
                                                            </div>
                                                        </td>
                                                        <td class="text-center">
                                                            @if (!roundJudges.Any())
                                                            {
                                                                <span class="text-muted small">Chưa có GK</span>
                                                            }
                                                            else
                                                            {
                                                                <button class="btn btn-sm btn-outline-primary assign-btn"
                                                                        onclick="openAssignModal(@sub.SubmissionId, '@sub.Title.Replace("'","\\'")', '@sub.TeamOrRepresentative.Replace("'","\\'")', @r.RoundId)"
                                                                        title="Phân công giám khảo">
                                                                    <i class="bi bi-person-plus me-1"></i>Phân công
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- ═══ TAB 3: THEO DÕI & CẢNH BÁO ═══ -->
            <div class="tab-pane fade" id="tab-monitor">
                <div class="row g-4 mt-0">
                    <div class="col-lg-5">
                        <div class="bg-white p-4 rounded-3 border shadow-sm">
                            <h6 class="fw-bold mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Trạng thái Bài đã chấm</h6>
                            @{
                                var pending   = Model.Assignments.Count(a => a.Status == "Pending");
                                var inProg    = Model.Assignments.Count(a => a.Status == "InProgress");
                                var completed = Model.CompletedAssignments;
                            }
                            @if (Model.TotalAssignments == 0)
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-pie-chart" style="font-size:2.5rem;opacity:.25"></i>
                                    <p class="mt-2 small">Chưa có phân công nào.</p>
                                </div>
                            }
                            else
                            {
                                <div style="position:relative;height:220px">
                                    <canvas id="gradingStatusChart"></canvas>
                                </div>
                                <div class="row g-2 mt-3 text-center">
                                    <div class="col-4">
                                        <div class="fw-bold text-success">@completed</div>
                                        <div class="text-muted" style="font-size:.7rem">Xong</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="fw-bold text-primary">@inProg</div>
                                        <div class="text-muted" style="font-size:.7rem">Đang chấm</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="fw-bold text-warning">@pending</div>
                                        <div class="text-muted" style="font-size:.7rem">Chờ</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="bg-white p-4 rounded-3 border border-start border-4 border-danger shadow-sm">
                            <h6 class="fw-bold text-danger mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Cảnh báo chậm tiến độ
                                @if (Model.Alerts.Any())
                                { <span class="badge bg-danger ms-1">@Model.Alerts.Count</span> }
                            </h6>
                            @if (!Model.Alerts.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-check-circle-fill text-success" style="font-size:2rem"></i>
                                    <p class="mt-2 small">Không có cảnh báo nào. Tất cả đang đúng tiến độ.</p>
                                </div>
                            }
                            else
                            {
                                <div style="max-height:350px;overflow-y:auto">
                                    @foreach (var alert in Model.Alerts)
                                    {
                                        var alertClass = alert.IsOverdue ? "danger" : alert.HoursUntilDeadline < 24 ? "warning" : "secondary";
                                        <div class="alert alert-light border mb-2 py-2">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <div class="fw-bold text-dark">@alert.JudgeName</div>
                                                    <div class="small text-muted">
                                                        Đã chấm <strong>@alert.Completed</strong>/@alert.TotalAssigned bài
                                                        (<span class="text-@alertClass fw-bold">@alert.CompletionRate%</span>)
                                                    </div>
                                                    @if (alert.NearestDeadline.HasValue)
                                                    {
                                                        <div class="small mt-1">
                                                            @if (alert.IsOverdue)
                                                            { <span class="text-danger fw-bold"><i class="bi bi-clock-fill"></i> Quá hạn @Math.Abs(alert.HoursUntilDeadline) giờ</span> }
                                                            else
                                                            { <span class="text-warning fw-bold"><i class="bi bi-clock"></i> Còn @alert.HoursUntilDeadline giờ</span> }
                                                        </div>
                                                    }
                                                </div>
                                                <button class="btn btn-sm btn-warning fw-bold"
                                                        onclick="sendReminder(@alert.JudgeId,'@alert.JudgeName')"
                                                        title="Gửi nhắc nhở">
                                                    <i class="bi bi-envelope-fill"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- /tab-content -->
    </div>
</div>

