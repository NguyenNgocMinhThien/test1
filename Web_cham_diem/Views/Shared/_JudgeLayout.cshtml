<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Judge Portal</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-bg: #f0f2f5;
            --sidebar-color: #ffffff;
            --judge-accent: #7c3aed;
            --judge-light: #ede9fe;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --sidebar-width: 280px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--primary-bg);
            color: var(--text-dark);
            overflow-x: hidden;
        }

        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: var(--sidebar-color);
            border-right: 1px solid var(--border-color);
            z-index: 1030;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .nav-section-title {
            padding: 1.5rem 1.5rem 0.5rem;
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.8rem 1.5rem;
            color: var(--text-dark);
            font-weight: 500;
            transition: var(--transition);
            border-radius: 0 50px 50px 0;
            margin-right: 1rem;
            text-decoration: none;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--judge-accent);
            background: var(--judge-light);
        }

        .nav-link.active {
            border-left: 4px solid var(--judge-accent);
            font-weight: 600;
        }

        .nav-link i { font-size: 1.2rem; flex-shrink: 0; }

        .main-wrapper {
            margin-left: var(--sidebar-width);
            transition: var(--transition);
            min-height: 100vh;
        }

        .navbar-top {
            height: 70px;
            background: #fff;
            border-bottom: 1px solid var(--border-color);
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .bg-soft-judge { background: var(--judge-light); color: var(--judge-accent); }

        .user-profile-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px;
            border-radius: 25px;
            background: #f8f9fa;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .user-profile-btn:hover { background: #e9ecef; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }

        .user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 13px;
            flex-shrink: 0;
        }

        .user-avatar-lg {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 20px;
            border: 2px solid rgba(255,255,255,0.6);
            flex-shrink: 0;
        }

        .dropdown-header-judge {
            padding: 1.25rem;
            background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
            color: white;
        }

        .dropdown-menu-user {
            min-width: 300px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            margin-top: 8px;
            overflow: hidden;
            padding: 0 !important;
        }

        .dropdown-item-user {
            padding: 0.75rem 1.25rem !important;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid transparent;
            transition: all 0.2s;
            color: #212529;
        }

        .dropdown-item-user:hover {
            background: #f8f9fa;
            color: var(--judge-accent);
            border-left-color: var(--judge-accent);
            transform: translateX(2px);
        }

        .dropdown-item-user i { width: 18px; font-size: 14px; color: var(--judge-accent); }

        .dropdown-item-logout { color: #dc3545 !important; }
        .dropdown-item-logout:hover { background: #ffe5e5 !important; color: #dc3545 !important; border-left-color: #dc3545 !important; }
        .dropdown-item-logout i { color: #dc3545 !important; }

        .judge-alert { border-radius: 10px; border: none; }

        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1029; }
        .sidebar-overlay.show { display: block; }

        @@media (max-width: 992px) {
            .sidebar { left: calc(-1 * var(--sidebar-width)); }
            .main-wrapper { margin-left: 0; }
            .sidebar.mobile-show { left: 0; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>

@{
    var userFullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Giám Khảo";
    var userEmail    = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var userInitials = !string.IsNullOrEmpty(userFullName)
        ? string.Concat(userFullName.Split(' ').Where(x => x.Length > 0).Select(x => x[0])).ToUpper()
        : "GK";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
}

<body>
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <aside class="sidebar" id="mainSidebar">
        <div class="sidebar-header">
            <div class="stat-icon bg-soft-judge"><i class="bi bi-person-badge-fill"></i></div>
            <div>
                <span class="fw-bold text-dark d-block fs-6">JUDGE PORTAL</span>
                <small class="text-muted" style="font-size: 0.68rem;">Ban Giám Khảo</small>
            </div>
        </div>

        <div class="overflow-y-auto flex-grow-1">
            <div class="nav-section-title">Tổng quan</div>
            <a href="/Judge/Dashboard" class="nav-link @(currentAction == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section-title">Chấm điểm</div>
            <a href="/Judge/Assignments" class="nav-link @((currentAction == "Assignments" || currentAction == "Grade") ? "active" : "")">
                <i class="bi bi-pencil-square"></i> Bài được phân công
            </a>
            <a href="/Judge/Review" class="nav-link @(currentAction == "Review" ? "active" : "")">
                <i class="bi bi-patch-check"></i> Duyệt điểm
                @{
                    var pendingCount = ViewBag.PendingApprovalCount as int?;
                }
                @if (pendingCount > 0)
                {
                    <span class="badge rounded-pill ms-auto" style="background:var(--judge-accent);font-size:0.65rem;">@pendingCount</span>
                }
            </a>
            <a href="/Judge/ScoreHistory" class="nav-link @(currentAction == "ScoreHistory" ? "active" : "")">
                <i class="bi bi-clock-history"></i> Lịch sử chấm điểm
            </a>
        </div>

        <div class="p-4 border-top flex-shrink-0">
            <div class="bg-light p-3 rounded-4 small">
                <div class="fw-bold mb-1">
                    <i class="bi bi-info-circle text-primary"></i> Hỗ trợ IT
                </div>
                <div class="text-muted" style="font-size: 0.75rem;">
                    Nếu gặp lỗi hệ thống, vui lòng liên hệ Admin.
                </div>
                <a href="mailto:admin@university.edu.vn"
                   class="btn btn-sm btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-envelope me-1"></i>Gửi Ticket hỗ trợ
                </a>
            </div>
        </div>
    </aside>

    <div class="main-wrapper">
        <nav class="navbar-top shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light border-0 d-lg-none" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <span class="fw-semibold text-muted d-none d-md-block">
                    <i class="bi bi-person-badge me-1" style="color: var(--judge-accent);"></i>
                    Cổng Giám Khảo
                </span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button type="button" class="user-profile-btn dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar-sm">@userInitials</div>
                        <div class="d-none d-lg-block text-start lh-1">
                            <div class="fw-bold small text-dark" style="font-size:13px;">@userFullName</div>
                            <span class="text-muted" style="font-size: 0.68rem;">Ban Giám Khảo</span>
                        </div>
                        <i class="bi bi-chevron-down text-muted d-none d-lg-block" style="font-size:11px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-user">
                        <li class="dropdown-header-judge">
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar-lg">@userInitials</div>
                                <div>
                                    <div class="fw-bold" style="font-size:14px;">@userFullName</div>
                                    <div style="font-size:12px; opacity:0.9;">@userEmail</div>
                                    <div class="mt-1" style="font-size:11px; opacity:0.8;">
                                        <i class="bi bi-shield-check me-1"></i>Ban Giám Khảo (Judge)
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider m-0"></li>
                        <li>
                            <a class="dropdown-item dropdown-item-user" href="/Judge/Dashboard">
                                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider m-0"></li>
                        <li>
                            <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                                <button type="submit"
                                        class="dropdown-item dropdown-item-user dropdown-item-logout w-100 text-start border-0 bg-transparent">
                                    <i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show judge-alert mx-4 mt-3 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show judge-alert mx-4 mt-3 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="p-4 p-md-5">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('mainSidebar').classList.toggle('mobile-show');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        }
        function closeSidebar() {
            document.getElementById('mainSidebar').classList.remove('mobile-show');
            document.getElementById('sidebarOverlay').classList.remove('show');
        }
        document.querySelectorAll('.judge-alert').forEach(a => {
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(a).close(), 5000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
