    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
        (function () {
            let _loaded = false;

            function iconClass(type) {
                const m = { 'Success': ['bi-check-circle-fill', 'ni-success'], 'Warning': ['bi-exclamation-triangle-fill', 'ni-warning'], 'Error': ['bi-x-circle-fill', 'ni-error'] };
                return m[type] ?? ['bi-info-circle-fill', 'ni-info'];
            }

            window.loadNotifications = async function (force = false) {
                if (_loaded && !force) return;
                try {
                    const res = await fetch('/api/user/notifications?take=8');
                    if (!res.ok) return;
                    const data = await res.json();
                    _loaded = true;
                    updateBadge(data.unread);
                    renderList(data.items ?? [], data.unread);
                } catch { /* silent */ }
            };

            function updateBadge(count) {
                const badge = document.getElementById('notifBadge');
                const markBtn = document.getElementById('markAllBtn');
                if (!badge) return;
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.classList.add('visible');
                    if (markBtn) markBtn.style.display = 'inline-block';
                } else {
                    badge.classList.remove('visible');
                    if (markBtn) markBtn.style.display = 'none';
                }
                const hdr = document.getElementById('notifHdrCount');
                if (hdr) hdr.textContent = count > 0 ? count + ' chưa đọc' : 'Đã đọc hết';
            }

            function renderList(items, unreadCount) {
                const el = document.getElementById('notifList');
                if (!el) return;
                if (items.length === 0) {
                    el.innerHTML = '<div class="notif-empty"><i class="bi bi-bell-slash fs-4 d-block mb-2 text-muted"></i>Chưa có thông báo</div>';
                    return;
                }
                el.innerHTML = items.map(n => {
                    const [ic, cls] = iconClass(n.type);
                    const unread = !n.isRead ? ' unread' : '';
                    return `<a class="notif-item${unread}" href="#" onclick="readNotif(event,${n.notificationId})">
                        <div class="notif-icon-wrap ${cls}"><i class="bi ${ic}"></i></div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="notif-title">${escHtml(n.title)}</div>
                            <div class="notif-msg">${escHtml(n.message)}</div>
                            <div class="notif-time"><i class="bi bi-clock me-1"></i>${escHtml(n.timeAgo)}</div>
                        </div>
                    </a>`;
                }).join('');
            }

            window.readNotif = async function (e, id) {
                e.preventDefault();
                await fetch(`/api/user/notifications/${id}/read`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgery() } });
                _loaded = false;
                loadNotifications(true);
            };

            window.markAllRead = async function (e) {
                e.stopPropagation();
                await fetch('/api/user/notifications/read-all', { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgery() } });
                _loaded = false;
                loadNotifications(true);
            };

            function getAntiForgery() {
                const el = document.querySelector('input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            function escHtml(s) {
                if (!s) return '';
                return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }

            // Load badge count on page load (silent)
            fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && updateBadge(d.unread)).catch(() => {});

            // Refresh count every 3 minutes
            setInterval(() => {
                _loaded = false;
                fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && updateBadge(d.unread)).catch(() => {});
            }, 180000);
        })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
