<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Quản lý Cuộc thi Sinh viên</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web_cham_diem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .custom-header-container {
            display: flex !important;
            flex-wrap: nowrap !important;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 15px;
        }

        .brand-zone {
            flex-shrink: 0;
            min-width: 260px;
        }

        .menu-zone {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: center;
            gap: 2px !important;
            margin: 0 !important;
            padding: 0 !important;
            list-style: none;
            flex-grow: 1;
        }

            .menu-zone .nav-link {
                display: flex !important;
                align-items: center;
                white-space: nowrap !important;
                padding: 7px 11px !important;
                font-size: 13px;
                border-radius: 20px;
                color: #212529 !important;
                transition: all 0.2s ease-in-out;
                gap: 5px;
            }

                .menu-zone .nav-link:hover {
                    background-color: #fff5f5;
                    color: #dc3545 !important;
                }

                .menu-zone .nav-link.active {
                    color: #dc3545 !important;
                    font-weight: 700;
                    background-color: #fff1f2;
                }

        .auth-zone {
            display: flex !important;
            flex-wrap: nowrap !important;
            gap: 10px;
            flex-shrink: 0;
            align-items: center;
            margin-left: auto;
        }

            .auth-zone .btn {
                white-space: nowrap !important;
                padding: 8px 16px !important;
                font-size: 13px;
            }

        .user-profile-wrapper {
            display: flex !important;
            align-items: center;
            gap: 10px;
            padding: 6px 12px;
            border-radius: 25px;
            background-color: #f8f9fa;
            transition: all 0.3s ease;
            cursor: pointer;
            border: none;
            outline: none;
            background-clip: padding-box;
            appearance: none;
        }

            .user-profile-wrapper:hover {
                background-color: #e9ecef;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            }

        .dropdown-menu-user {
            min-width: 320px !important;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
            margin-top: 8px;
            z-index: 1050;
        }

        .user-avatar-small {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #dc3545, #ff6b6b);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 14px;
            flex-shrink: 0;
            border: 2px solid white;
            box-shadow: 0 2px 4px rgba(220, 53, 69, 0.2);
        }

        .user-info-compact {
            display: flex;
            flex-direction: column;
            font-size: 12px;
            line-height: 1.4;
        }

        .user-fullname-compact {
            font-weight: 600;
            color: #212529;
            font-size: 13px;
        }

        .user-email-compact {
            font-size: 11px;
            color: #6c757d;
        }

        .dropdown-header-user {
            padding: 1.25rem;
            background: linear-gradient(135deg, #dc3545 0%, #ff6b6b 100%);
            color: white;
            border-radius: 8px 8px 0 0;
        }

        .dropdown-user-card-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar-large {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 20px;
            border: 2px solid white;
        }

        .dropdown-user-info { flex: 1; }
        .dropdown-user-name { font-weight: 600; color: white; font-size: 14px; }
        .dropdown-user-email { font-size: 12px; color: rgba(255,255,255,0.9); margin-top: 2px; }
        .dropdown-user-role { font-size: 11px; color: rgba(255,255,255,0.8); margin-top: 4px; }

        .dropdown-menu-user .dropdown-divider { margin: 0.5rem 0; }

        .dropdown-item-user {
            padding: 0.85rem 1.25rem !important;
            font-size: 13px;
            color: #212529;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .dropdown-item-user:hover {
                background-color: #f8f9fa;
                color: #dc3545;
                border-left-color: #dc3545;
                transform: translateX(2px);
            }

            .dropdown-item-user i {
                width: 18px;
                color: #dc3545;
                font-size: 14px;
            }

        .dropdown-item-logout { color: #dc3545 !important; }
            .dropdown-item-logout:hover { background-color: #ffe5e5 !important; }

        .btn-outline-danger.rounded-pill:hover {
            background-color: #dc3545;
            color: #ffffff !important;
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.15);
        }

        .btn-danger.rounded-pill:hover {
            background-color: #bb2d3b !important;
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.2);
        }

        .topbar-links a { transition: color 0.2s ease; }
            .topbar-links a:hover { color: #ffc107 !important; }

        .main-footer a { color: #b3b3b3 !important; transition: color 0.2s ease; }
            .main-footer a:hover { color: #ffc107 !important; }

        /* Notification Bell */
        .notif-bell-btn {
            position: relative; background: #f8f9fa; border: none; border-radius: 50%;
            width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: all .2s ease; color: #495057; font-size: 18px; padding: 0;
        }
        .notif-bell-btn:hover { background: #e9ecef; color: #dc3545; }
        .notif-badge {
            position: absolute; top: 1px; right: 1px; background: #dc3545; color: #fff;
            border-radius: 50%; min-width: 18px; height: 18px; font-size: 10px; font-weight: 700;
            display: none; align-items: center; justify-content: center; border: 2px solid #fff; padding: 0 2px;
        }
        .notif-badge.visible { display: flex; }
        .notif-dropdown-menu {
            width: 360px; border: none; box-shadow: 0 8px 28px rgba(0,0,0,.14);
            border-radius: 12px; overflow: hidden; padding: 0; margin-top: 8px !important;
        }
        .notif-hdr {
            background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff;
            padding: 14px 16px; display: flex; align-items: center; justify-content: space-between;
        }
        .notif-hdr-title { font-size: 14px; font-weight: 600; }
        .notif-hdr-count { font-size: 12px; background: rgba(255,255,255,.2); border-radius: 20px; padding: 2px 8px; }
        .notif-item {
            display: flex; align-items: flex-start; gap: 10px; padding: 11px 16px;
            border-bottom: 1px solid #f1f3f5; cursor: pointer; transition: background .15s;
            text-decoration: none; color: inherit;
        }
        .notif-item:hover { background: #f8f9fa; color: inherit; text-decoration: none; }
        .notif-item.unread { background: #f0f4ff; border-left: 3px solid #6366f1; }
        .notif-item.unread:hover { background: #e8eeff; }
        .notif-icon-wrap {
            width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center;
            justify-content: center; flex-shrink: 0; font-size: 14px;
        }
        .ni-info    { background: #dbeafe; color: #2563eb; }
        .ni-success { background: #dcfce7; color: #16a34a; }
        .ni-warning { background: #fef3c7; color: #d97706; }
        .ni-error   { background: #fee2e2; color: #dc2626; }
        .notif-title { font-size: 12.5px; font-weight: 600; color: #212529; margin: 0; line-height: 1.3; }
        .notif-msg   { font-size: 11.5px; color: #6c757d; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 255px; margin: 2px 0 0; }
        .notif-time  { font-size: 10.5px; color: #9ca3af; margin-top: 2px; }
        .notif-empty { padding: 28px 16px; text-align: center; color: #9ca3af; font-size: 13px; }
        .notif-footer { padding: 10px 16px; text-align: center; border-top: 1px solid #f1f3f5; }
        .notif-footer a { font-size: 13px; color: #6366f1; text-decoration: none; font-weight: 500; }
        .notif-footer a:hover { text-decoration: underline; }

        @@media (max-width: 992px) {
            .user-info-compact { display: none !important; }
            .menu-zone { display: none !important; }
            .custom-header-container { gap: 8px; }
        }

        @@media (max-width: 576px) {
            .brand-zone { min-width: auto; }
            .auth-zone { gap: 4px; }
            .auth-zone .btn { padding: 6px 10px !important; font-size: 12px; }
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <header class="main-header shadow-sm bg-white">
        <div class="topbar py-1 bg-dark text-white font-monospace" style="font-size: 13px;">
            <div class="container d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-telephone-fill text-warning me-2"></i>Hotline Hỗ Trợ: <strong>1800.XXXX (Miễn phí)</strong>
                </div>
                <div class="topbar-links d-none d-md-flex gap-3">
                    <a href="/HuongDan" class="text-white text-decoration-none"><i class="bi bi-book me-1"></i>Thể lệ tham gia</a>
                    <a href="/LichTrinh" class="text-white text-decoration-none"><i class="bi bi-calendar3 me-1"></i>Lịch trình cuộc thi</a>
                    <a href="/Notifications" class="text-white text-decoration-none"><i class="bi bi-newspaper me-1"></i>Tin tức & Sự kiện</a>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light py-2 border-bottom">
            <div class="container-fluid custom-header-container">

                <a class="navbar-brand d-flex align-items-center brand-zone" href="/">
                    <img src="~/images/logo-uni.png" alt="Logo" width="40" class="me-2"
                         onerror="this.style.display='none'">
                    <div>
                        <span class="fw-bold text-danger d-block lh-1" style="font-size: 13px; letter-spacing: 0.3px;">HỆ THỐNG QUẢN LÝ CUỘC THI</span>
                        <small class="text-secondary fw-semibold d-none d-sm-block" style="font-size: 10px;">SINH VIÊN CẤP TRƯỜNG</small>
                    </div>
                </a>

                @{
                    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
                    var userFullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Người dùng";
                    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
                    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";
                    var userInitial = !string.IsNullOrEmpty(userFullName)
                        ? string.Concat(userFullName.Split(' ').Select(x => x[0])).ToUpper()
                        : "U";
                }

                <ul class="menu-zone fw-semibold">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house-door text-secondary"></i>
                            <span>Trang chủ</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Competitions">
                            <i class="bi bi-trophy text-danger"></i>
                            <span>Cuộc thi</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Results">
                            <i class="bi bi-award text-warning"></i>
                            <span>Kết quả</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Notifications">
                            <i class="bi bi-bell text-info"></i>
                            <span>Thông báo</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/HuongDan">
                            <i class="bi bi-question-circle text-success"></i>
                            <span>Hướng dẫn</span>
                        </a>
                    </li>

                    @if (isAuthenticated && User.IsInRole("Student"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/MyRegistrations">
                                <i class="bi bi-journal-check text-primary"></i>
                                <span>Cuộc thi đã đăng ký</span>
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Organizer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Organizer/Dashboard">
                                <i class="bi bi-bar-chart-line text-warning"></i>
                                <span>Ban tổ chức</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="auth-zone">
                    @if (isAuthenticated)
                    {
                        <!-- Notification Bell -->
                        <div class="dropdown" id="notifDropdownWrapper">
                            <button class="notif-bell-btn"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    id="notifBellBtn"
                                    onclick="loadNotifications()"
                                    title="Thông báo">
                                <i class="bi bi-bell"></i>
                                <span class="notif-badge" id="notifBadge"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end notif-dropdown-menu" id="notifDropdownMenu">
                                <li class="notif-hdr">
                                    <span class="notif-hdr-title"><i class="bi bi-bell-fill me-2"></i>Thông báo</span>
                                    <span class="notif-hdr-count" id="notifHdrCount">...</span>
                                </li>
                                <li>
                                    <div id="notifList">
                                        <div class="notif-empty">
                                            <i class="bi bi-bell-slash fs-4 d-block mb-2 text-muted"></i>
                                            Chưa có thông báo
                                        </div>
                                    </div>
                                </li>
                                <li class="notif-footer">
                                    <button class="btn btn-sm btn-link p-0 me-3" onclick="markAllRead(event)" id="markAllBtn" style="color:#6366f1;font-size:12px;display:none;">
                                        <i class="bi bi-check-all me-1"></i>Đánh dấu đã đọc
                                    </button>
                                    <a href="/Notifications">Xem tất cả</a>
                                </li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button type="button"
                                    class="user-profile-wrapper dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    data-bs-auto-close="outside">
                                <div class="user-avatar-small" title="@userFullName">@userInitial</div>
                                <div class="user-info-compact d-none d-lg-flex">
                                    <span class="user-fullname-compact">@userFullName</span>
                                    <span class="user-email-compact">@userEmail</span>
                                </div>
                                <i class="bi bi-chevron-down text-muted" style="font-size: 12px;"></i>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-user">
                                <li class="dropdown-header-user">
                                    <div class="dropdown-user-card-header">
                                        <div class="user-avatar-large">@userInitial</div>
                                        <div class="dropdown-user-info">
                                            <div class="dropdown-user-name">@userFullName</div>
                                            <div class="dropdown-user-email">@userEmail</div>
                                            <div class="dropdown-user-role">
                                                <i class="bi bi-shield me-1" style="font-size: 10px;"></i>@userRole
                                            </div>
                                        </div>
                                    </div>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item dropdown-item-user" href="/Profile">
                                        <i class="bi bi-person-circle"></i>
                                        <span>Hồ sơ cá nhân</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-user" href="/MyRegistrations">
                                        <i class="bi bi-journal-check"></i>
                                        <span>Cuộc thi đã đăng ký</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-user" href="/MySubmissions">
                                        <i class="bi bi-file-earmark-arrow-up"></i>
                                        <span>Bài nộp của tôi</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-user" href="/MyScores">
                                        <i class="bi bi-graph-up"></i>
                                        <span>Kết quả chấm điểm</span>
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item dropdown-item-user" href="/Settings">
                                        <i class="bi bi-gear"></i>
                                        <span>Cài đặt tài khoản</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dropdown-item-user" href="/Help">
                                        <i class="bi bi-question-circle"></i>
                                        <span>Trợ giúp</span>
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form asp-controller="Login" asp-action="Logout" method="post" style="margin: 0;">
                                        <button type="submit"
                                                class="dropdown-item dropdown-item-user dropdown-item-logout w-100 text-start"
                                                style="border: none; background: none; cursor: pointer;">
                                            <i class="bi bi-box-arrow-right"></i>
                                            <span>Đăng xuất</span>
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Login" class="btn btn-outline-danger btn-sm rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span class="d-none d-sm-inline">Đăng nhập</span>
                        </a>
                        <a href="/Register" class="btn btn-danger btn-sm rounded-pill d-flex align-items-center gap-2">
                            <i class="bi bi-person-plus"></i>
                            <span class="d-none d-sm-inline">Đăng ký</span>
                        </a>
                    }
                </div>

            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 @(ViewData["UseFluidContainer"] as bool? == true ? "container-fluid px-0" : "container my-4")">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="main-footer bg-dark text-light-50 pt-5 pb-3 mt-auto border-top border-4 border-danger"
            style="background-color: #1a1a1a !important; color: #b3b3b3;">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">VỀ HỆ THỐNG</h5>
                    <p class="small" style="line-height: 1.7;">
                        Nền tảng quản lý cuộc thi sinh viên cấp trường trực tuyến, hỗ trợ toàn bộ quy trình từ tổ chức, đăng ký, nộp bài, chấm điểm đến công bố kết quả và kết xuất báo cáo thống kê chính xác, minh bạch.
                    </p>
                    <div class="social-links d-flex gap-3 mt-3">
                        <a href="#" class="text-light fs-5" title="Facebook"><i class="bi bi-facebook text-primary"></i></a>
                        <a href="#" class="text-light fs-5" title="YouTube"><i class="bi bi-youtube text-danger"></i></a>
                        <a href="#" class="text-light fs-5" title="Website trường"><i class="bi bi-globe2 text-info"></i></a>
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">TIỆN ÍCH</h5>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="/Competitions" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Tất cả cuộc thi</a></li>
                        <li><a href="/Results" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Kết quả cuộc thi</a></li>
                        <li><a href="/HuongDan" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Thể lệ tham gia</a></li>
                        <li><a href="/Statistics" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Thống kê số liệu</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">QUY ĐỊNH & BẢO MẬT</h5>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="/Terms" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Điều khoản sử dụng</a></li>
                        <li><a href="/Privacy" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Chính sách bảo mật</a></li>
                        <li><a href="/AntiCheat" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Cơ chế chống gian lận</a></li>
                        <li><a href="/Support" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Giải đáp thắc mắc</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">BAN TỔ CHỨC</h5>
                    <ul class="list-unstyled small d-grid gap-2 text-white-50">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                            <span>Phòng Quản lý Khoa học & Công nghệ, Tòa nhà Trung tâm, Trường Đại học.</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-warning"></i>
                            <span>cuocthi&#64;university.edu.vn</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill text-success"></i>
                            <span>Hotline: 1800.XXXX (Miễn phí)</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-building-fill text-info"></i>
                            <span>Văn phòng: Tầng 3 - P.302</span>
                        </li>
