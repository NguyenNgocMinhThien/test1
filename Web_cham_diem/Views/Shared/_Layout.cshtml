<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Quản lý Cuộc thi Sinh viên</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web_cham_diem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        /* --- ÉP TOÀN BỘ NAVBAR TRÊN 1 HÀNG DUY NHẤT --- */
        .custom-header-container {
            display: flex !important;
            flex-wrap: nowrap !important; /* Tuyệt đối không cho xuống hàng */
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        /* Giới hạn kích thước vùng logo để nhường chỗ cho các thành phần khác */
        .brand-zone {
            flex-shrink: 0;
            min-width: 260px;
        }

        /* Ô tìm kiếm co giãn thông minh nhưng không chiếm quá nhiều diện tích */
        .search-zone {
            flex-grow: 1;
            max-width: 320px;
            margin: 0 15px !important;
        }

        /* Thanh menu chứa Cuộc thi, Đội thi... */
        .menu-zone {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: center;
            gap: 4px !important;
            margin: 0 !important;
            padding: 0 !important;
            list-style: none;
        }

            .menu-zone .nav-link {
                display: flex !important;
                align-items: center;
                white-space: nowrap !important; /* Khóa chữ không cho tự rớt dòng */
                padding: 6px 10px !important; /* Thu nhỏ padding để vừa vặn hơn */
                font-size: 14px;
                border-radius: 20px;
                color: #212529 !important;
                transition: all 0.2s ease-in-out;
            }

                /* Hiệu ứng Hover đổi màu nền và màu chữ */
                .menu-zone .nav-link:hover {
                    background-color: #fff5f5;
                    color: #dc3545 !important;
                }

                .menu-zone .nav-link.active {
                    color: #dc3545 !important;
                    font-weight: 700;
                    background-color: #fff1f2;
                }

        /* Cụm nút Đăng nhập / Đăng ký */
        .auth-zone {
            display: flex !important;
            flex-wrap: nowrap !important;
            gap: 8px;
            flex-shrink: 0;
        }

            .auth-zone .btn {
                white-space: nowrap !important;
                padding: 6px 14px !important;
                font-size: 14px;
            }

        /* Hover hiệu ứng nút bấm */
        .btn-outline-danger.rounded-pill:hover {
            background-color: #dc3545;
            color: #ffffff !important;
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.15);
        }

        .btn-danger.rounded-pill:hover {
            background-color: #bb2d3b !important;
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.2);
        }

        /* Topbar links */
        .topbar-links a {
            transition: color 0.2s ease;
        }

            .topbar-links a:hover {
                color: #ffc107 !important;
            }

        /* Footer links */
        .main-footer a {
            color: #b3b3b3 !important;
            transition: color 0.2s ease;
        }

            .main-footer a:hover {
                color: #ffc107 !important;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <header class="main-header shadow-sm bg-white">
        <div class="topbar py-1 bg-dark text-white font-monospace" style="font-size: 13px;">
            <div class="container d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-telephone-fill text-warning me-2"></i>Hotline Hỗ Trợ: <strong>1800.XXXX (Miễn phí)</strong>
                </div>
                <div class="topbar-links d-none d-md-flex gap-3">
                    <a href="/HuongDan" class="text-white text-decoration-none"><i class="bi bi-info-circle me-1"></i>Hướng dẫn đăng ký thi</a>
                    <a href="/LichTrinh" class="text-white text-decoration-none"><i class="bi bi-calendar3 me-1"></i>Lịch trình cuộc thi</a>
                    <a href="/TinTuc" class="text-white text-decoration-none"><i class="bi bi-newspaper me-1"></i>Tin tức & Sự kiện</a>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light py-2 border-bottom">
            <div class="container custom-header-container">

                <a class="navbar-brand d-flex align-items-center brand-zone" href="/">
                    <img src="~/images/logo-uni.png" alt="Logo" width="42" class="me-2" onerror="this.src='https://via.placeholder.com/42'">
                    <div>
                        <span class="fw-bold text-danger d-block lh-1" style="font-size: 14px; letter-spacing: 0.3px;">HỆ THỐNG QUẢN LÝ CUỘC THI</span>
                        <small class="text-secondary fw-semibold" style="font-size: 11px;">ĐẠI HỌC CÔNG NGHỆ & KHẢO THÍ</small>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <form class="d-flex mx-auto my-3 my-lg-0 col-12 col-lg-5 position-relative">
                        <input class="form-control rounded-pill pe-5 shadow-none" type="search" placeholder="Tìm kiếm cuộc thi, đề tài, kết quả..." aria-label="Search">
                        <button class="btn btn-danger rounded-pill position-absolute end-0 top-0 h-100 px-3 border-0" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>

                    <ul class="navbar-nav mb-2 mb-lg-0 fw-semibold align-items-lg-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Competitions" title="Xem danh sách tất cả cuộc thi">
                                <i class="bi bi-trophy me-1 text-danger"></i>Cuộc thi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Teams" title="Xem danh sách đội thi và đăng ký">
                                <i class="bi bi-people me-1 text-primary"></i>Đội thi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Submissions" title="Nộp bài dự thi">
                                <i class="bi bi-cloud-upload me-1 text-success"></i>Nộp bài
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Scores" title="Xem bảng điểm xếp hạng">
                                <i class="bi bi-bar-chart-line me-1 text-warning"></i>Bảng điểm
                            </a>
                        </li>
                    </ul>

                <ul class="menu-zone fw-semibold">
                    <li class="nav-item">
                        <a class="nav-link active" href="/Competitions"><i class="bi bi-trophy me-1 text-danger"></i>Cuộc thi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Teams"><i class="bi bi-people me-1 text-primary"></i>Đội thi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Submissions"><i class="bi bi-cloud-upload me-1 text-success"></i>Nộp bài</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Scores"><i class="bi bi-bar-chart-line me-1 text-warning"></i>Bảng điểm</a>
                    </li>
                </ul>

                <div class="auth-zone fw-semibold">
                    <a href="/Login" class="btn btn-outline-danger btn-sm rounded-pill d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-in-right"></i>Đăng nhập
                    </a>
                    <a href="/Register" class="btn btn-danger btn-sm rounded-pill d-flex align-items-center gap-1">
                        <i class="bi bi-person-plus"></i>Đăng ký
                    </a>
                </div>

            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 @(ViewData["UseFluidContainer"] as bool? == true ? "container-fluid px-0" : "container my-4")">
        @RenderBody()
    </main>

    <footer class="main-footer bg-dark text-light-50 pt-5 pb-3 mt-auto border-top border-4 border-danger" style="background-color: #1a1a1a !important; color: #b3b3b3;">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">VỀ HỆ THỐNG</h5>
                    <p class="small text-justify" style="line-height: 1.6;">
                        Hệ thống quản lý cuộc thi và xét duyệt kết quả sinh viên trực tuyến, tối ưu hóa quy trình đăng ký, nộp bài đề tài nghiên cứu, chấm điểm từ hội đồng giám khảo và kết xuất báo cáo thống kê chính xác, minh bạch.
                    </p>
                    <div class="social-links d-flex gap-3 mt-3">
                        <a href="#" class="text-light fs-5"><i class="bi bi-facebook text-primary"></i></a>
                        <a href="#" class="text-light fs-5"><i class="bi bi-youtube text-danger"></i></a>
                        <a href="#" class="text-light fs-5"><i class="bi bi-globe2 text-info"></i></a>
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">TIỆN ÍCH</h5>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="/Competitions" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Tất cả cuộc thi</a></li>
                        <li><a href="/Guidelines" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Thể lệ tham gia</a></li>
                        <li><a href="/Criteria" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Tiêu chí chấm điểm</a></li>
                        <li><a href="/Statistics" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Thống kê số liệu</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">QUY ĐỊNH & BẢO MẬT</h5>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="/Terms" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Điều khoản sử dụng</a></li>
                        <li><a href="/Privacy" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Chính sách bảo mật JWT</a></li>
                        <li><a href="/AntiCheat" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Cơ chế chống gian lận</a></li>
                        <li><a href="/Support" class="text-decoration-none text-white-50"><i class="bi bi-chevron-right me-1 small"></i>Giải đáp thắc mắc (Q&A)</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-danger pb-2 d-inline-block">BAN TỔ CHỨC</h5>
                    <ul class="list-unstyled small d-grid gap-2 text-white-50">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                            <span>Phòng Quản lý Khoa học & Công nghệ, Tòa nhà Trung tâm, Trường Đại học.</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-warning"></i>
                            <span>khoahocsinhvien@university.edu.vn</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-building-fill text-info"></i>
                            <span>Văn phòng: Tầng 3 - P.302</span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="my-4 border-secondary">

            <div class="row align-items-center">
                <div class="col-12 col-md-6 text-center text-md-start small text-white-50">
                    &copy; 2026 Hệ thống Quản lý Cuộc thi Sinh viên. Phát triển dựa trên nền tảng ASP.NET Core & Postgresql.
                </div>
                <div class="col-12 col-md-6 text-center text-md-end small mt-2 mt-md-0 text-white-50">
                    Mã nguồn dự án thuộc bản quyền ban đề tài nghiên cứu cấp Trường.
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>