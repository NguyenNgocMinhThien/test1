<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ban Quản Trị</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            background-color: #f4f6f9;
        }

        /* ================= BIẾN ĐỔI MÀU HOVER SIDEBAR ================= */
        .admin-sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            color: #e2e8f0;
            transition: all 0.3s ease;
        }

            .admin-sidebar .brand-zone {
                padding: 20px;
                background-color: rgba(0, 0, 0, 0.15);
            }

            .admin-sidebar .nav-link {
                color: #94a3b8;
                padding: 12px 24px;
                font-weight: 500;
                display: flex;
                align-items: center;
                border-radius: 8px;
                margin: 4px 12px;
                transition: all 0.25s ease-in-out;
                text-decoration: none;
            }

                .admin-sidebar .nav-link:hover {
                    color: #ffffff !important;
                    background-color: rgba(255, 255, 255, 0.08);
                    transform: translateX(6px);
                }

                .admin-sidebar .nav-link.active {
                    color: #ffffff !important;
                    background: linear-gradient(90deg, #dc3545 0%, #b02a37 100%);
                    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.25);
                }

        /* ================= BIẾN ĐỔI MÀU HOVER HEADER ================= */
        .admin-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 28px !important;
        }

        .search-box-container {
            position: relative;
        }

            .search-box-container .form-control {
                background-color: #f1f5f9;
                border: 1px solid #e2e8f0;
                padding: 10px 16px 10px 42px;
                border-radius: 30px;
                font-size: 14px;
                transition: all 0.25s ease;
            }

                .search-box-container .form-control:focus {
                    background-color: #ffffff;
                    border-color: #dc3545;
                    box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.15);
                }

            .search-box-container::before {
                content: "\f52a";
                font-family: "bootstrap-icons";
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 15px;
                z-index: 5;
            }

        .header-icon-btn {
            position: relative;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #64748b;
            background-color: #f8fafc;
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .header-icon-btn:hover {
                color: #dc3545;
                background-color: #fff5f5;
                transform: scale(1.05);
            }

        .user-profile-block {
            padding: 6px 14px 6px 6px;
            border-radius: 30px;
            background-color: #f8fafc;
            transition: all 0.2s ease;
            cursor: pointer;
            border: 1px solid #e2e8f0;
        }

            .user-profile-block:hover {
                background-color: #f1f5f9;
                border-color: #cbd5e1;
            }

        .btn-logout-admin {
            transition: all 0.2s ease;
        }

            .btn-logout-admin:hover {
                background-color: #dc3545 !important;
                color: #ffffff !important;
                box-shadow: 0 4px 10px rgba(220, 53, 69, 0.2);
            }

        /* ================= FOOTER DESIGN ================= */
        .admin-footer {
            background-color: #ffffff;
            color: #64748b;
            font-size: 13px;
            border-top: 1px solid #e2e8f0;
            padding: 20px 0;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="container-fluid">
        <div class="row">

            <nav class="col-md-3 col-lg-2 d-md-block admin-sidebar collapse p-0 shadow-sm">
                <div class="brand-zone text-center border-bottom border-dark border-opacity-25">
                    <h6 class="m-0 text-white fw-bold tracking-wide">
                        <i class="bi bi-shield-lock-fill text-danger me-2 fs-5"></i>ADMIN PANEL
                    </h6>
                </div>
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item">
                            <a class="nav-link active" href="/Account/Admin"><i class="bi bi-grid-1x2-fill me-3"></i> System Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"><i class="bi bi-people-fill me-3"></i> Quản lý người dùng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"><i class="bi bi-trophy-fill me-3"></i> Quản lý cuộc thi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"><i class="bi bi-bar-chart-line-fill me-3"></i> Chấm điểm & Báo cáo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"><i class="bi bi-sliders me-3"></i> Cấu hình hệ thống</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"><i class="bi bi-terminal-dash me-3"></i> Lịch sử hệ thống (Logs)</a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 p-0 d-flex flex-column" style="min-height: 100vh;">

                <header class="navbar navbar-light admin-header sticky-top shadow-sm">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <div class="search-box-container col-12 col-md-5">
                            <input class="form-control" type="text" placeholder="Tìm kiếm tài khoản, cuộc thi, bài nộp...">
                        </div>

                        <div class="d-flex align-items-center gap-3">
                            <a href="#" class="header-icon-btn">
                                <i class="bi bi-bell-fill fs-5"></i>
                                <span class="position-absolute top-1 start-75 translate-middle badge border border-white rounded-pill bg-danger p-1">
                                    <span class="visually-hidden">Thông báo mới</span>
                                </span>
                            </a>

                            <div class="user-profile-block d-flex align-items-center gap-2">
                                <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=80&q=80" class="rounded-circle border" width="32" height="32" alt="Avatar Admin">
                                <span class="fw-semibold text-dark small d-none d-sm-inline">Admin John Doe</span>
                                <i class="bi bi-chevron-down text-muted small pe-1"></i>
                            </div>

                            <div class="vr h-25 my-auto text-black-50"></div>

                            <a class="btn btn-sm btn-light border fw-medium px-3 text-danger rounded-pill btn-logout-admin" href="/">
                                <i class="bi bi-box-arrow-right me-1"></i> Thoát Admin
                            </a>
                        </div>
                    </div>
                </header>

                <div class="container-fluid p-4 flex-grow-1">
                    @RenderBody()
                </div>

                <footer class="admin-footer text-center mt-auto">
                    <div class="container">
                        <div class="fw-semibold text-dark opacity-75 text-uppercase" style="font-size: 12px; letter-spacing: 0.5px;">Hệ thống Khảo thí & Quản lý Cuộc thi - Khu vực bảo mật</div>
                        <div class="text-muted mt-1" style="font-size: 11px;">&copy; 2026 Toàn quyền quản trị ban đề tài nghiên cứu cấp Trường.</div>
                    </div>
                </footer>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>