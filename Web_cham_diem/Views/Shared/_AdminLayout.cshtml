<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Portal</title>

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <style>
            :root {
                --primary-bg: #f0f2f5;
                --sidebar-color: #ffffff;
                --navy-blue: #003d7a;
                --accent-blue: #0d6efd;
                --text-dark: #1e293b;
                --text-muted: #64748b;
                --border-color: #e2e8f0;
                --sidebar-width: 280px;
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--primary-bg);
                color: var(--text-dark);
                overflow-x: hidden;
            }

            /* --- SIDEBAR --- */
            .sidebar {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: var(--sidebar-color);
                border-right: 1px solid var(--border-color);
                z-index: 1030;
                transition: var(--transition);
            }

            .sidebar-header {
                padding: 1.5rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .nav-section-title {
                padding: 1.5rem 1.5rem 0.5rem;
                font-size: 0.7rem;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.8rem 1.5rem;
                color: var(--text-dark);
                font-weight: 500;
                transition: var(--transition);
                border-radius: 0 50px 50px 0;
                margin-right: 1rem;
            }

                .nav-link:hover, .nav-link.active {
                    color: var(--accent-blue);
                    background: #f0f7ff;
                }

                .nav-link.active {
                    border-left: 4px solid var(--accent-blue);
                    font-weight: 600;
                }

                .nav-link i {
                    font-size: 1.2rem;
                }

            /* --- MAIN CONTENT & NAVBAR --- */
            .main-wrapper {
                margin-left: var(--sidebar-width);
                transition: var(--transition);
            }

            .navbar-top {
                height: 70px;
                background: #fff;
                border-bottom: 1px solid var(--border-color);
                padding: 0 2rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 1020;
            }

            .search-container {
                width: 400px;
                position: relative;
            }

                .search-container input {
                    padding-left: 2.5rem;
                    border-radius: 8px;
                    background: #f8fafc;
                    border: 1px solid var(--border-color);
                }

                .search-container i {
                    position: absolute;
                    left: 1rem;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                }

                        /* Các style khác dùng chung */
            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
            }

            .bg-soft-primary {
                background: #e0f2fe;
                color: #0ea5e9;
            }

            /* Sử dụng @@media thay vì media trong file .cshtml */
            @@media (max-width: 992px) {
                .sidebar {
                    left: -var(--sidebar-width);
                }

                .main-wrapper {
                    margin-left: 0;
                }

                .sidebar.mobile-show {
                    left: 0;
                }
            }

            /* Render nội dung block CSS của trang con nếu có */
            
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Sidebar Section -->
    <aside class="sidebar d-flex flex-column">
        <div class="sidebar-header">
            <div class="stat-icon bg-soft-primary"><i class="bi bi-mortarboard-fill"></i></div>
            <span class="fw-bold text-dark fs-5">UNI PORTAL</span>
        </div>

        <div class="overflow-y-auto">
            <div class="nav-section-title">Chính</div>

            <!-- 1. Dashboard -->
            <a href="/Account/Admin" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Admin" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <!-- 2. Quản lý tài khoản -->
            <a href="/Account/UserManagement" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "UserManagement" ? "active" : "")">
                <i class="bi bi-people-fill"></i> Quản lý tài khoản
            </a>

            <div class="nav-section-title">Hoạt động</div>

            <!-- 3. Tổng quan cuộc thi -->
            <!-- Cập nhật link Tổng quan cuộc thi -->
            <a href="/Account/ContestOverview" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ContestOverview" ? "active" : "")">
                <i class="bi bi-trophy"></i> Tổng quan cuộc thi
            </a>

            <!-- 4. Báo cáo & thống kê -->
            <a href="/Account/Reports" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Reports" ? "active" : "")">
                <i class="bi bi-bar-chart-line"></i> Báo cáo & thống kê
            </a>

            <!-- 5. Thông báo -->
            <a href="/Account/SystemNotifications" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "SystemNotifications" ? "active" : "")">
                <i class="bi bi-bell"></i> Thông báo <span class="badge bg-danger rounded-pill ms-auto">3</span>
            </a>

            <div class="nav-section-title">Hệ thống & Cấu hình</div>

            <!-- 6. Cài đặt hệ thống -->
            <a href="/Account/SystemSettings" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "SystemSettings" ? "active" : "")">
                <i class="bi bi-gear"></i> Cài đặt hệ thống
            </a>

            <!-- 7. Nhật ký hoạt động -->
            <a href="/Account/ActivityLogs" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ActivityLogs" ? "active" : "")">
                <i class="bi bi-terminal"></i> Nhật ký hoạt động
            </a>
        </div>

        <!-- System Storage Status (Giữ lại hoặc xóa tùy ý - đang đặt ở dưới cùng) -->
        <div class="mt-auto p-4 border-top">
            <div class="bg-light p-3 rounded-4 small">
                <div class="fw-bold mb-1">Dung lượng Server</div>
                <div class="progress mb-2" style="height: 6px;">
                    <div class="progress-bar bg-primary" style="width: 75%"></div>
                </div>
                <span class="text-muted">75% của 100GB đã dùng</span>
            </div>
        </div>
    </aside>

    <!-- Main Wrapper Section -->
    <div class="main-wrapper">

        <!-- Navbar -->
        <nav class="navbar-top">
            <div class="search-container">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control border-0" placeholder="Tìm kiếm dữ liệu toàn hệ thống...">
            </div>

            <div class="d-flex align-items-center gap-4">
                <div class="dropdown">
                    <button class="btn btn-light rounded-pill px-3 shadow-sm btn-sm" id="quickAdd" data-bs-toggle="dropdown">
                        <i class="bi bi-plus-lg me-1"></i> Quick Action
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 mt-2">
                        <li><a class="dropdown-item rounded-2" href="/Account/UserManagement"><i class="bi bi-person-plus me-2"></i>Tạo tài khoản</a></li>
                        <li>
                            <a class="dropdown-item rounded-2" href="javascript:void(0);" onclick="handleQuickCreateContest()">
                                <i class="bi bi-plus-square me-2"></i>Tạo cuộc thi
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="position-relative">
                    <i class="bi bi-chat-dots fs-5 text-muted"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-end lh-1">
                        <div class="fw-bold small">Admin University</div>
                        <span class="text-muted" style="font-size: 0.7rem;">Quản trị viên root</span>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=Admin&background=003d7a&color=fff" class="rounded-circle shadow-sm" width="40">
                </div>
            </div>
        </nav>

        <!-- Content Body Render -->
        <div class="p-4 p-md-5">
            @RenderBody()
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function handleQuickCreateContest() {
            if (typeof openCompModal === "function") {
                openCompModal();
            } else {
                window.location.href = "/Account/ContestOverview#openCreate";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (window.location.hash === "#openCreate") {
                history.replaceState(null, null, window.location.pathname);
                setTimeout(function() {
                    if (typeof openCompModal === "function") {
                        openCompModal();
                    }
                }, 400);
            }
        });
    </script>
</body>

</html>