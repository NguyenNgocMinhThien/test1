<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Portal</title>

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <style>
            :root {
                --primary-bg: #f0f2f5;
                --sidebar-color: #ffffff;
                --navy-blue: #003d7a;
                --accent-blue: #0d6efd;
                --text-dark: #1e293b;
                --text-muted: #64748b;
                --border-color: #e2e8f0;
                --sidebar-width: 280px;
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--primary-bg);
                color: var(--text-dark);
                overflow-x: hidden;
            }

            /* --- SIDEBAR --- */
            .sidebar {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: var(--sidebar-color);
                border-right: 1px solid var(--border-color);
                z-index: 1030;
                transition: var(--transition);
            }

            .sidebar-header {
                padding: 1.5rem;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .nav-section-title {
                padding: 1.5rem 1.5rem 0.5rem;
                font-size: 0.7rem;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.8rem 1.5rem;
                color: var(--text-dark);
                font-weight: 500;
                transition: var(--transition);
                border-radius: 0 50px 50px 0;
                margin-right: 1rem;
            }

                .nav-link:hover, .nav-link.active {
                    color: var(--accent-blue);
                    background: #f0f7ff;
                }

                .nav-link.active {
                    border-left: 4px solid var(--accent-blue);
                    font-weight: 600;
                }

                .nav-link i {
                    font-size: 1.2rem;
                }

            /* --- MAIN CONTENT & NAVBAR --- */
            .main-wrapper {
                margin-left: var(--sidebar-width);
                transition: var(--transition);
            }

            .navbar-top {
                height: 70px;
                background: #fff;
                border-bottom: 1px solid var(--border-color);
                padding: 0 2rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 1020;
            }

            .search-container {
                width: 400px;
                position: relative;
            }

                .search-container input {
                    padding-left: 2.5rem;
                    border-radius: 8px;
                    background: #f8fafc;
                    border: 1px solid var(--border-color);
                }

                .search-container i {
                    position: absolute;
                    left: 1rem;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                }

                        /* Các style khác dùng chung */
            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
            }

            .bg-soft-primary {
                background: #e0f2fe;
                color: #0ea5e9;
            }

            /* --- NOTIFICATION BELL --- */
            .notif-bell-btn {
                position: relative; background: #f8fafc; border: none; border-radius: 50%;
                width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
                cursor: pointer; transition: all .2s ease; color: #64748b; font-size: 18px; padding: 0;
            }
            .notif-bell-btn:hover { background: #e9ecef; color: var(--accent-blue); }
            .notif-badge {
                position: absolute; top: 1px; right: 1px; background: #dc3545; color: #fff;
                border-radius: 50%; min-width: 18px; height: 18px; font-size: 10px; font-weight: 700;
                display: none; align-items: center; justify-content: center; border: 2px solid #fff; padding: 0 2px;
            }
            .notif-badge.visible { display: flex; }
            .notif-dropdown-menu {
                width: 360px; border: none; box-shadow: 0 8px 28px rgba(0,0,0,.14);
                border-radius: 12px; overflow: hidden; padding: 0; margin-top: 8px !important;
            }
            .notif-hdr {
                background: linear-gradient(135deg, var(--navy-blue), var(--accent-blue)); color: #fff;
                padding: 14px 16px; display: flex; align-items: center; justify-content: space-between;
            }
            .notif-hdr-title { font-size: 14px; font-weight: 600; }
            .notif-hdr-count { font-size: 12px; background: rgba(255,255,255,.2); border-radius: 20px; padding: 2px 8px; }
            .notif-item {
                display: flex; align-items: flex-start; gap: 10px; padding: 11px 16px;
                border-bottom: 1px solid #f1f3f5; cursor: pointer; transition: background .15s;
                text-decoration: none; color: inherit;
            }
            .notif-item:hover { background: #f8fafc; color: inherit; text-decoration: none; }
            .notif-item.unread { background: #eff6ff; border-left: 3px solid var(--accent-blue); }
            .notif-item.unread:hover { background: #dbeafe; }
            .notif-icon-wrap {
                width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center;
                justify-content: center; flex-shrink: 0; font-size: 14px;
            }
            .ni-info    { background: #dbeafe; color: #2563eb; }
            .ni-success { background: #dcfce7; color: #16a34a; }
            .ni-warning { background: #fef3c7; color: #d97706; }
            .ni-error   { background: #fee2e2; color: #dc2626; }
            .notif-title { font-size: 12.5px; font-weight: 600; color: #1e293b; margin: 0; line-height: 1.3; }
            .notif-msg   { font-size: 11.5px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 255px; margin: 2px 0 0; }
            .notif-time  { font-size: 10.5px; color: #94a3b8; margin-top: 2px; }
            .notif-empty { padding: 28px 16px; text-align: center; color: #94a3b8; font-size: 13px; }
            .notif-footer { padding: 10px 16px; text-align: center; border-top: 1px solid #f1f3f5; }
            .notif-footer a { font-size: 13px; color: var(--accent-blue); text-decoration: none; font-weight: 500; }
            .notif-footer a:hover { text-decoration: underline; }

            /* --- USER PROFILE DROPDOWN --- */
            .user-profile-btn {
                display: flex; align-items: center; gap: 10px; padding: 6px 12px;
                border-radius: 25px; background: #f8fafc; border: none; cursor: pointer;
                transition: all 0.2s;
            }
            .user-profile-btn:hover { background: #e9ecef; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
            .user-avatar-sm {
                width: 36px; height: 36px; border-radius: 50%;
                background: linear-gradient(135deg, var(--navy-blue), var(--accent-blue));
                display: flex; align-items: center; justify-content: center;
                color: white; font-weight: 700; font-size: 13px; flex-shrink: 0;
            }
            .user-avatar-lg {
                width: 50px; height: 50px; border-radius: 50%;
                background: rgba(255,255,255,0.25);
                display: flex; align-items: center; justify-content: center;
                color: white; font-weight: 700; font-size: 20px;
                border: 2px solid rgba(255,255,255,0.6); flex-shrink: 0;
            }
            .dropdown-header-admin {
                padding: 1.25rem;
                background: linear-gradient(135deg, var(--navy-blue) 0%, var(--accent-blue) 100%);
                color: white;
            }
            .dropdown-menu-user {
                min-width: 300px; border: 1px solid #dee2e6; border-radius: 8px;
                box-shadow: 0 6px 20px rgba(0,0,0,0.15); margin-top: 8px;
                overflow: hidden; padding: 0 !important;
            }
            .dropdown-item-user {
                padding: 0.75rem 1.25rem !important; font-size: 13px;
                display: flex; align-items: center; gap: 10px;
                border-left: 3px solid transparent; transition: all 0.2s; color: #212529;
            }
            .dropdown-item-user:hover {
                background: #f8fafc; color: var(--accent-blue);
                border-left-color: var(--accent-blue); transform: translateX(2px);
            }
            .dropdown-item-user i { width: 18px; font-size: 14px; color: var(--accent-blue); }
            .dropdown-item-logout { color: #dc3545 !important; }
            .dropdown-item-logout:hover { background: #ffe5e5 !important; color: #dc3545 !important; border-left-color: #dc3545 !important; }
            .dropdown-item-logout i { color: #dc3545 !important; }

            /* Sử dụng @@media thay vì media trong file .cshtml */
            @@media (max-width: 992px) {
                .sidebar {
                    left: -var(--sidebar-width);
                }

                .main-wrapper {
                    margin-left: 0;
                }

                .sidebar.mobile-show {
                    left: 0;
                }
            }

            /* --- NOTIFICATION BELL --- */
            .admin-notif-badge {
                display: none; position: absolute; top: 1px; right: 1px;
                background: #dc3545; color: #fff; border-radius: 50%;
                min-width: 18px; height: 18px; font-size: 10px; font-weight: 700;
                align-items: center; justify-content: center;
                border: 2px solid #fff; padding: 0 2px;
            }
            .admin-notif-badge.visible { display: flex; }

            .admin-noti-dropdown {
                width: 370px; max-height: 460px; overflow-y: auto;
                padding: 0 !important;
            }

            .admin-noti-item {
                padding: 12px 16px; border-bottom: 1px solid var(--border-color);
                cursor: pointer; transition: background 0.2s;
            }
            .admin-noti-item:hover { background: #f8fafc; }
            .admin-noti-item.unread { background: #eff6ff; border-left: 3px solid var(--accent-blue); }
            .admin-noti-item.unread:hover { background: #dbeafe; }

            /* --- USER DROPDOWN --- */
            .admin-user-btn {
                display: flex; align-items: center; gap: 10px;
                padding: 6px 12px; border-radius: 25px;
                background: #f8f9fa; border: none; cursor: pointer;
                transition: all 0.2s;
            }
            .admin-user-btn:hover { background: #e9ecef; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }

            .admin-avatar-sm {
                width: 36px; height: 36px; border-radius: 50%;
                background: linear-gradient(135deg, #003d7a, #0d6efd);
                display: flex; align-items: center; justify-content: center;
                color: white; font-weight: 700; font-size: 13px; flex-shrink: 0;
            }
            .admin-avatar-lg {
                width: 50px; height: 50px; border-radius: 50%;
                background: rgba(255,255,255,0.25);
                display: flex; align-items: center; justify-content: center;
                color: white; font-weight: 700; font-size: 20px;
                border: 2px solid rgba(255,255,255,0.6); flex-shrink: 0;
            }

            .admin-dropdown-header {
                padding: 1.25rem;
                background: linear-gradient(135deg, #003d7a 0%, #0d6efd 100%);
                color: white;
            }

            .admin-dropdown-menu {
                min-width: 300px; border: 1px solid #dee2e6;
                border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.15);
                margin-top: 8px; overflow: hidden; padding: 0 !important;
            }

            .admin-dropdown-item {
                padding: 0.75rem 1.25rem !important; font-size: 13px;
                display: flex; align-items: center; gap: 10px;
                border-left: 3px solid transparent; transition: all 0.2s;
                color: #212529; text-decoration: none;
            }
            .admin-dropdown-item:hover {
                background: #f0f7ff; color: var(--accent-blue);
                border-left-color: var(--accent-blue);
                transform: translateX(2px);
            }
            .admin-dropdown-item i { width: 18px; font-size: 14px; color: var(--accent-blue); }

            .admin-dropdown-item-logout { color: #dc3545 !important; }
            .admin-dropdown-item-logout:hover { background: #ffe5e5 !important; color: #dc3545 !important; border-left-color: #dc3545 !important; }
            .admin-dropdown-item-logout i { color: #dc3545 !important; }

    </style>
    @RenderSection("Styles", required: false)
</head>

@{
    var adminUserFullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Quản trị viên";
    var adminUserEmail    = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var adminUserInitials = !string.IsNullOrEmpty(adminUserFullName)
        ? string.Concat(adminUserFullName.Split(' ').Where(x => x.Length > 0).Select(x => x[0])).ToUpper()
        : "AD";
}

<body>

    <!-- Sidebar Section -->
    <aside class="sidebar d-flex flex-column">
        <div class="sidebar-header">
            <div class="stat-icon bg-soft-primary"><i class="bi bi-mortarboard-fill"></i></div>
            <span class="fw-bold text-dark fs-5">UNI PORTAL</span>
        </div>

        <div class="overflow-y-auto">
            <div class="nav-section-title">Chính</div>

            <!-- 1. Dashboard -->
            <a href="/Account/Admin" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Admin" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <!-- 2. Quản lý tài khoản -->
            <a href="/Account/UserManagement" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "UserManagement" ? "active" : "")">
                <i class="bi bi-people-fill"></i> Quản lý tài khoản
            </a>

            <div class="nav-section-title">Hoạt động</div>

            <!-- 3. Tổng quan cuộc thi -->
            <!-- Cập nhật link Tổng quan cuộc thi -->
            <a href="/Account/ContestOverview" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ContestOverview" ? "active" : "")">
                <i class="bi bi-trophy"></i> Tổng quan cuộc thi
            </a>

            <!-- 4. Báo cáo & thống kê -->
            <a href="/Account/Reports" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Reports" ? "active" : "")">
                <i class="bi bi-bar-chart-line"></i> Báo cáo & thống kê
            </a>

            <!-- 5. Thông báo -->
            <a href="/Account/SystemNotifications" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "SystemNotifications" ? "active" : "")">
                <i class="bi bi-bell"></i> Thông báo <span class="badge bg-danger rounded-pill ms-auto">3</span>
            </a>

            <div class="nav-section-title">Hệ thống & Cấu hình</div>

            <!-- 6. Cài đặt hệ thống -->
            <a href="/Account/SystemSettings" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "SystemSettings" ? "active" : "")">
                <i class="bi bi-gear"></i> Cài đặt hệ thống
            </a>

            <!-- 7. Nhật ký hoạt động -->
            <a href="/Account/ActivityLogs" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ActivityLogs" ? "active" : "")">
                <i class="bi bi-terminal"></i> Nhật ký hoạt động
            </a>
        </div>

        <!-- System Storage Status (Giữ lại hoặc xóa tùy ý - đang đặt ở dưới cùng) -->
        <div class="mt-auto p-4 border-top">
            <div class="bg-light p-3 rounded-4 small">
                <div class="fw-bold mb-1">Dung lượng Server</div>
                <div class="progress mb-2" style="height: 6px;">
                    <div class="progress-bar bg-primary" style="width: 75%"></div>
                </div>
                <span class="text-muted">75% của 100GB đã dùng</span>
            </div>
        </div>
    </aside>

    <!-- Main Wrapper Section -->
    <div class="main-wrapper">

        <!-- Navbar -->
        <nav class="navbar-top">
            <div class="search-container">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control border-0" placeholder="Tìm kiếm dữ liệu toàn hệ thống...">
            </div>

            <div class="d-flex align-items-center gap-4">
                <div class="dropdown">
                    <button class="btn btn-light rounded-pill px-3 shadow-sm btn-sm" id="quickAdd" data-bs-toggle="dropdown">
                        <i class="bi bi-plus-lg me-1"></i> Quick Action
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 mt-2">
                        <li><a class="dropdown-item rounded-2" href="/Account/UserManagement"><i class="bi bi-person-plus me-2"></i>Tạo tài khoản</a></li>
                        <li>
                            <a class="dropdown-item rounded-2" href="javascript:void(0);" onclick="handleQuickCreateContest()">
                                <i class="bi bi-plus-square me-2"></i>Tạo cuộc thi
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Notification Bell -->
                <div class="dropdown" id="adminNotifWrapper">
                    <button class="btn btn-light border-0 position-relative rounded-circle p-2"
                            style="width:38px;height:38px;"
                            data-bs-toggle="dropdown"
                            id="adminNotifBtn"
                            onclick="adminLoadNotifications()"
                            title="Thông báo">
                        <i class="bi bi-bell fs-6 text-muted"></i>
                        <span id="adminNotifBadge" class="admin-notif-badge"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 admin-noti-dropdown" style="padding:0!important;">
                        <li class="px-3 py-2 border-bottom bg-light d-flex justify-content-between align-items-center sticky-top">
                            <span class="fw-bold text-dark"><i class="bi bi-bell-fill me-2"></i>Thông báo</span>
                            <span id="adminNotifHdrCount" class="small text-muted">...</span>
                        </li>
                        <li>
                            <div id="adminNotifList">
                                <div class="text-center py-4 text-muted" style="font-size:13px;">
                                    <i class="bi bi-bell-slash fs-4 d-block mb-2"></i>Chưa có thông báo
                                </div>
                            </div>
                        </li>
                        <li class="border-top d-flex align-items-center justify-content-between px-3 py-2">
                            <button id="adminMarkAllBtn" onclick="adminMarkAllRead(event)"
                                    class="btn btn-sm btn-link p-0"
                                    style="color:var(--accent-blue);font-size:12px;display:none;">
                                <i class="bi bi-check-all me-1"></i>Đánh dấu đã đọc
                            </button>
                            <a href="/Notifications" class="small text-decoration-none fw-semibold"
                               style="color:var(--accent-blue);">
                                <i class="bi bi-arrow-right-circle me-1"></i>Xem tất cả
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <button type="button"
                            class="admin-user-btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        <div class="admin-avatar-sm">@adminUserInitials</div>
                        <div class="d-none d-lg-block text-start lh-1">
                            <div class="fw-bold small text-dark" style="font-size:13px;">@adminUserFullName</div>
                            <span class="text-muted" style="font-size:0.68rem;">Quản trị viên</span>
                        </div>
                        <i class="bi bi-chevron-down text-muted d-none d-lg-block" style="font-size:11px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end admin-dropdown-menu">
                        <!-- Header -->
                        <li class="admin-dropdown-header">
                            <div class="d-flex align-items-center gap-3">
                                <div class="admin-avatar-lg">@adminUserInitials</div>
                                <div>
                                    <div class="fw-bold" style="font-size:14px;">@adminUserFullName</div>
                                    <div style="font-size:12px;opacity:0.9;">@adminUserEmail</div>
                                    <div class="mt-1" style="font-size:11px;opacity:0.8;">
                                        <i class="bi bi-shield-fill-check me-1"></i>Quản trị viên hệ thống
                                    </div>
                                </div>
                            </div>
                        </li>

                        <li><hr class="dropdown-divider m-0"></li>

                        <li>
                            <a class="admin-dropdown-item" href="/Account/Admin">
                                <i class="bi bi-speedometer2"></i><span>Dashboard quản trị</span>
                            </a>
                        </li>
                        <li>
                            <a class="admin-dropdown-item" href="/Account/UserManagement">
                                <i class="bi bi-people-fill"></i><span>Quản lý người dùng</span>
                            </a>
                        </li>
                        <li>
                            <a class="admin-dropdown-item" href="/Account/Reports">
                                <i class="bi bi-bar-chart-line"></i><span>Báo cáo & thống kê</span>
                            </a>
                        </li>

                        <li><hr class="dropdown-divider m-0"></li>

                        <li>
                            <a class="admin-dropdown-item" href="/Profile">
                                <i class="bi bi-person-circle"></i><span>Hồ sơ cá nhân</span>
                            </a>
                        </li>
                        <li>
                            <a class="admin-dropdown-item" href="/HuongDan">
                                <i class="bi bi-question-circle"></i><span>Trợ giúp</span>
                            </a>
                        </li>

                        <li><hr class="dropdown-divider m-0"></li>

                        <li>
                            <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                                <button type="submit"
                                        class="admin-dropdown-item admin-dropdown-item-logout w-100 text-start border-0 bg-transparent"
                                        style="cursor:pointer;">
                                    <i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Content Body Render -->
        <div class="p-4 p-md-5">
            @RenderBody()
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    // --- Notification Bell ---
    (function () {
        let _adminLoaded = false;

        function adminIconClass(type) {
            const m = { 'Success': ['bi-check-circle-fill','#16a34a','#dcfce7'], 'Warning': ['bi-exclamation-triangle-fill','#d97706','#fef3c7'], 'Error': ['bi-x-circle-fill','#dc2626','#fee2e2'] };
            return m[type] ?? ['bi-info-circle-fill','#0d6efd','#dbeafe'];
        }

        window.adminLoadNotifications = async function (force = false) {
            if (_adminLoaded && !force) return;
            try {
                const res = await fetch('/api/user/notifications?take=8');
                if (!res.ok) return;
                const data = await res.json();
                _adminLoaded = true;
                adminUpdateBadge(data.unread);
                adminRenderList(data.items ?? []);
            } catch { }
        };

        function adminUpdateBadge(count) {
            const badge = document.getElementById('adminNotifBadge');
            const markBtn = document.getElementById('adminMarkAllBtn');
            const hdr = document.getElementById('adminNotifHdrCount');
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.classList.add('visible');
                if (markBtn) markBtn.style.display = 'inline-block';
            } else {
                badge.classList.remove('visible');
                if (markBtn) markBtn.style.display = 'none';
            }
            if (hdr) hdr.textContent = count > 0 ? count + ' chưa đọc' : 'Đã đọc hết';
        }

        function adminRenderList(items) {
            const el = document.getElementById('adminNotifList');
            if (!el) return;
            if (items.length === 0) {
                el.innerHTML = '<div class="text-center py-4 text-muted" style="font-size:13px;"><i class="bi bi-bell-slash fs-4 d-block mb-2"></i>Chưa có thông báo</div>';
                return;
            }
            el.innerHTML = items.map(n => {
                const [ic, color, bg] = adminIconClass(n.type);
                const unreadCls = !n.isRead ? ' unread' : '';
                return `<div class="admin-noti-item${unreadCls}" onclick="adminReadNotif(event,${n.notificationId})">
                    <div class="d-flex gap-2 align-items-start">
                        <div style="width:30px;height:30px;border-radius:50%;background:${bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi ${ic}" style="color:${color};font-size:13px;"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="small fw-bold text-dark mb-1">${escHtml(n.title)}</div>
                            <div class="text-muted" style="font-size:0.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:270px;">${escHtml(n.message)}</div>
                            <div class="text-muted mt-1" style="font-size:0.7rem;"><i class="bi bi-clock me-1"></i>${escHtml(n.timeAgo)}</div>
                        </div>
                    </div>
                </div>`;
            }).join('');
        }

        window.adminReadNotif = async function (e, id) {
            e.preventDefault();
            await fetch(`/api/user/notifications/${id}/read`, { method: 'POST', headers: { 'RequestVerificationToken': getAdminAntiForgery() } });
            _adminLoaded = false;
            adminLoadNotifications(true);
        };

        window.adminMarkAllRead = async function (e) {
            e.stopPropagation();
            await fetch('/api/user/notifications/read-all', { method: 'POST', headers: { 'RequestVerificationToken': getAdminAntiForgery() } });
            _adminLoaded = false;
            adminLoadNotifications(true);
        };

        function getAdminAntiForgery() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function escHtml(s) {
            if (!s) return '';
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // Load badge count on page load
        fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && adminUpdateBadge(d.unread)).catch(() => {});

        // Refresh every 3 minutes
        setInterval(() => {
            _adminLoaded = false;
            fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && adminUpdateBadge(d.unread)).catch(() => {});
        }, 180000);
    })();
    </script>
    <script>
        function handleQuickCreateContest() {
            if (typeof openCompModal === "function") {
                openCompModal();
            } else {
                window.location.href = "/Account/ContestOverview#openCreate";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (window.location.hash === "#openCreate") {
                history.replaceState(null, null, window.location.pathname);
                setTimeout(function() {
                    if (typeof openCompModal === "function") {
                        openCompModal();
                    }
                }, 400);
            }
        });
    </script>

    <script>
    (function () {
        let _loaded = false;

        function iconClass(type) {
            const m = { 'Success': ['bi-check-circle-fill', 'ni-success'], 'Warning': ['bi-exclamation-triangle-fill', 'ni-warning'], 'Error': ['bi-x-circle-fill', 'ni-error'] };
            return m[type] ?? ['bi-info-circle-fill', 'ni-info'];
        }

        window.loadNotifications = async function (force = false) {
            if (_loaded && !force) return;
            try {
                const res = await fetch('/api/user/notifications?take=8');
                if (!res.ok) return;
                const data = await res.json();
                _loaded = true;
                updateBadge(data.unread);
                renderList(data.items ?? [], data.unread);
            } catch { /* silent */ }
        };

        function updateBadge(count) {
            const badge = document.getElementById('notifBadge');
            const markBtn = document.getElementById('markAllBtn');
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.classList.add('visible');
                if (markBtn) markBtn.style.display = 'inline-block';
            } else {
                badge.classList.remove('visible');
                if (markBtn) markBtn.style.display = 'none';
            }
            const hdr = document.getElementById('notifHdrCount');
            if (hdr) hdr.textContent = count > 0 ? count + ' chưa đọc' : 'Đã đọc hết';
        }

        function renderList(items, unreadCount) {
            const el = document.getElementById('notifList');
            if (!el) return;
            if (items.length === 0) {
                el.innerHTML = '<div class="notif-empty"><i class="bi bi-bell-slash fs-4 d-block mb-2 text-muted"></i>Chưa có thông báo</div>';
                return;
            }
            el.innerHTML = items.map(n => {
                const [ic, cls] = iconClass(n.type);
                const unread = !n.isRead ? ' unread' : '';
                return `<a class="notif-item${unread}" href="#" onclick="readNotif(event,${n.notificationId})">
                    <div class="notif-icon-wrap ${cls}"><i class="bi ${ic}"></i></div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="notif-title">${escHtml(n.title)}</div>
                        <div class="notif-msg">${escHtml(n.message)}</div>
                        <div class="notif-time"><i class="bi bi-clock me-1"></i>${escHtml(n.timeAgo)}</div>
                    </div>
                </a>`;
            }).join('');
        }

        window.readNotif = async function (e, id) {
            e.preventDefault();
            await fetch(`/api/user/notifications/${id}/read`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgery() } });
            _loaded = false;
            loadNotifications(true);
        };

        window.markAllRead = async function (e) {
            e.stopPropagation();
            await fetch('/api/user/notifications/read-all', { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgery() } });
            _loaded = false;
            loadNotifications(true);
        };

        function getAntiForgery() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function escHtml(s) {
            if (!s) return '';
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // Load badge count on page load (silent)
        fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && updateBadge(d.unread)).catch(() => {});

        // Refresh count every 3 minutes
        setInterval(() => {
            _loaded = false;
            fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && updateBadge(d.unread)).catch(() => {});
        }, 180000);
    })();
    </script>
