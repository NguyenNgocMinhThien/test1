<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Organizer Portal</title>

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-bg: #f0f2f5;
            --sidebar-color: #ffffff;
            --navy-blue: #003d7a;
            --accent-blue: #0d6efd;
            --organizer-accent: #059669;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --sidebar-width: 280px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--primary-bg);
            color: var(--text-dark);
            overflow-x: hidden;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: var(--sidebar-color);
            border-right: 1px solid var(--border-color);
            z-index: 1030;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .nav-section-title {
            padding: 1.5rem 1.5rem 0.5rem;
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.8rem 1.5rem;
            color: var(--text-dark);
            font-weight: 500;
            transition: var(--transition);
            border-radius: 0 50px 50px 0;
            margin-right: 1rem;
            text-decoration: none;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--organizer-accent);
            background: #ecfdf5;
        }

        .nav-link.active {
            border-left: 4px solid var(--organizer-accent);
            font-weight: 600;
        }

        .nav-link i {
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        /* --- MAIN CONTENT & NAVBAR --- */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            transition: var(--transition);
            min-height: 100vh;
        }

        .navbar-top {
            height: 70px;
            background: #fff;
            border-bottom: 1px solid var(--border-color);
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .search-container {
            width: 380px;
            position: relative;
        }

        .search-container input {
            padding-left: 2.5rem;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
        }

        .search-container input:focus {
            border-color: var(--organizer-accent);
            box-shadow: 0 0 0 0.15rem rgba(5, 150, 105, 0.15);
        }

        .search-container i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .bg-soft-organizer {
            background: #d1fae5;
            color: #059669;
        }

        /* --- NOTIFICATION DROPDOWN --- */
        .noti-dropdown {
            width: 370px;
            max-height: 460px;
            overflow-y: auto;
            padding: 0 !important;
        }

        .noti-dd-item {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background 0.2s;
        }

        .noti-dd-item:hover {
            background: #f8fafc;
        }

        .noti-dd-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
            margin-top: 5px;
        }

        /* --- USER PROFILE --- */
        .user-profile-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px;
            border-radius: 25px;
            background: #f8f9fa;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .user-profile-btn:hover {
            background: #e9ecef;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #059669, #34d399);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 13px;
            flex-shrink: 0;
        }

        .user-avatar-lg {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 20px;
            border: 2px solid rgba(255,255,255,0.6);
            flex-shrink: 0;
        }

        .dropdown-header-org {
            padding: 1.25rem;
            background: linear-gradient(135deg, #059669 0%, #34d399 100%);
            color: white;
        }

        .dropdown-menu-user {
            min-width: 300px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            margin-top: 8px;
            overflow: hidden;
            padding: 0 !important;
        }

        .dropdown-item-user {
            padding: 0.75rem 1.25rem !important;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid transparent;
            transition: all 0.2s;
            color: #212529;
        }

        .dropdown-item-user:hover {
            background: #f8f9fa;
            color: var(--organizer-accent);
            border-left-color: var(--organizer-accent);
            transform: translateX(2px);
        }

        .dropdown-item-user i {
            width: 18px;
            font-size: 14px;
            color: var(--organizer-accent);
        }

        .dropdown-item-logout {
            color: #dc3545 !important;
        }

        .dropdown-item-logout:hover {
            background: #ffe5e5 !important;
            color: #dc3545 !important;
            border-left-color: #dc3545 !important;
        }

        .dropdown-item-logout i {
            color: #dc3545 !important;
        }

        /* --- ALERT DISMISSIBLE --- */
        .org-alert {
            border-radius: 10px;
            border: none;
        }

        /* --- SIDEBAR OVERLAY (MOBILE) --- */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 1029;
        }

        .sidebar-overlay.show {
            display: block;
        }

        @@media (max-width: 992px) {
            .sidebar {
                left: calc(-1 * var(--sidebar-width));
            }
            .main-wrapper {
                margin-left: 0;
            }
            .sidebar.mobile-show {
                left: 0;
            }
            .search-container {
                width: 220px;
            }
        }

        @@media (max-width: 576px) {
            .search-container {
                display: none;
            }
            .navbar-top {
                padding: 0 1rem;
            }
        }

    </style>
    @RenderSection("Styles", required: false)
</head>

@{
    var userFullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Ban Tổ Chức";
    var userEmail    = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var userInitials = !string.IsNullOrEmpty(userFullName)
        ? string.Concat(userFullName.Split(' ').Where(x => x.Length > 0).Select(x => x[0])).ToUpper()
        : "BTC";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var isAdminViewing = User.IsInRole("Admin");
}

<body>
    <!-- SIDEBAR OVERLAY (mobile tap to close) -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR SECTION -->
    <aside class="sidebar" id="mainSidebar">
        <div class="sidebar-header">
            <div class="stat-icon bg-soft-organizer"><i class="bi bi-diagram-3-fill"></i></div>
            <div>
                <span class="fw-bold text-dark d-block fs-6">ORGANIZER</span>
                <small class="text-muted" style="font-size: 0.68rem;">Ban Tổ Chức Cuộc thi</small>
            </div>
        </div>

        @if (isAdminViewing)
        {
            <div class="px-3 pt-3">
                <a href="/Account/Admin" class="btn btn-sm btn-outline-secondary w-100">
                    <i class="bi bi-arrow-left-circle me-1"></i>Quay lại Admin
                </a>
            </div>
        }

        <div class="overflow-y-auto flex-grow-1">
            <div class="nav-section-title">Tổng quan</div>

            <a href="/Organizer/Dashboard"
               class="nav-link @(currentAction == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section-title">Hoạt động Cuộc thi</div>

            <a href="/Organizer/Contests"
               class="nav-link @(currentAction == "Contests" || currentAction == "Create" || currentAction == "Edit" ? "active" : "")">
                <i class="bi bi-trophy"></i> Quản lý cuộc thi
            </a>

            <a href="/Organizer/Submissions"
               class="nav-link @(currentAction == "Submissions" ? "active" : "")">
                <i class="bi bi-file-earmark-text"></i> Khảo thí & Bài dự thi
            </a>

            <a href="/Organizer/Grading"
               class="nav-link @(currentAction == "Grading" ? "active" : "")">
                <i class="bi bi-ui-checks"></i> Quản lý chấm điểm
            </a>

            <div class="nav-section-title">Giám sát & Tương tác</div>

            <a href="/Organizer/Results"
               class="nav-link @(currentAction == "Results" ? "active" : "")">
                <i class="bi bi-bar-chart-steps"></i> Kết quả & Báo cáo
            </a>

            <a href="/Organizer/Statistics"
               class="nav-link @(currentAction == "Statistics" ? "active" : "")">
                <i class="bi bi-clipboard-data"></i> Thống kê & Báo cáo
            </a>

            <a href="/Organizer/Notifications"
               class="nav-link @(currentAction == "Notifications" ? "active" : "")">
                <i class="bi bi-megaphone"></i> Thông báo cuộc thi
            </a>
        </div>

        <!-- Hỗ trợ IT ở dưới cùng -->
        <div class="p-4 border-top flex-shrink-0">
            <div class="bg-light p-3 rounded-4 small">
                <div class="fw-bold mb-1">
                    <i class="bi bi-info-circle text-primary"></i> Hỗ trợ IT
                </div>
                <div class="text-muted" style="font-size: 0.75rem;">
                    Nếu gặp lỗi hệ thống, vui lòng liên hệ Admin.
                </div>
                <a href="mailto:admin@university.edu.vn"
                   class="btn btn-sm btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-envelope me-1"></i>Gửi Ticket hỗ trợ
                </a>
            </div>
        </div>
    </aside>

    <!-- MAIN WRAPPER SECTION -->
    <div class="main-wrapper">

        <!-- HEADER (NAVBAR TOP) -->
        <nav class="navbar-top shadow-sm">

            <!-- Trái: toggle (mobile) + search -->
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light border-0 d-lg-none" onclick="toggleSidebar()" title="Menu">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <div class="search-container">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control border-0" id="globalSearch"
                           placeholder="Tìm bài thi, sinh viên, giám khảo..."
                           onkeydown="handleSearch(event)">
                </div>
            </div>

            <!-- Phải: quick action + bell + user -->
            <div class="d-flex align-items-center gap-3">

                <!-- Quick Action dropdown -->
                <div class="dropdown">
                    <button class="btn border-0 rounded-pill px-3 shadow-sm btn-sm text-white fw-semibold"
                            style="background-color: var(--organizer-accent);"
                            data-bs-toggle="dropdown">
                        <i class="bi bi-plus-lg me-1"></i>
                        <span class="d-none d-md-inline">Tạo nhanh</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 mt-2">
                        <li>
                            <a class="dropdown-item rounded-2 py-2" href="/Organizer/Create">
                                <i class="bi bi-trophy me-2 text-warning"></i>Tạo cuộc thi mới
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item rounded-2 py-2" href="/Organizer/Notifications">
                                <i class="bi bi-megaphone me-2 text-primary"></i>Gửi thông báo
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item rounded-2 py-2" href="/Organizer/Grading">
                                <i class="bi bi-person-badge me-2 text-info"></i>Phân công Giám khảo
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item rounded-2 py-2" href="/Organizer/Submissions">
                                <i class="bi bi-card-checklist me-2 text-success"></i>Duyệt hồ sơ
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item rounded-2 py-2" href="/Organizer/Results">
                                <i class="bi bi-bar-chart me-2 text-danger"></i>Xem kết quả
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item rounded-2 py-2" href="/Organizer/Statistics">
                                <i class="bi bi-clipboard-data me-2 text-secondary"></i>Thống kê & Báo cáo
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Notification Bell dropdown -->
                <div class="dropdown" id="orgNotifWrapper">
                    <button class="btn btn-light border-0 position-relative rounded-circle p-2"
                            style="width:38px;height:38px;"
                            data-bs-toggle="dropdown"
                            id="orgNotifBtn"
                            onclick="orgLoadNotifications()"
                            title="Thông báo">
                        <i class="bi bi-bell fs-6 text-muted"></i>
                        <span id="orgNotifBadge"
                              style="display:none;position:absolute;top:1px;right:1px;background:#dc3545;color:#fff;
                                     border-radius:50%;min-width:18px;height:18px;font-size:10px;font-weight:700;
                                     align-items:center;justify-content:center;border:2px solid #fff;padding:0 2px;"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 noti-dropdown" style="padding:0!important;">
                        <li class="px-3 py-2 border-bottom bg-light d-flex justify-content-between align-items-center sticky-top">
                            <span class="fw-bold text-dark"><i class="bi bi-bell-fill me-2"></i>Thông báo</span>
                            <span id="orgNotifHdrCount" class="small text-muted">...</span>
                        </li>
                        <li>
                            <div id="orgNotifList">
                                <div class="text-center py-4 text-muted" style="font-size:13px;">
                                    <i class="bi bi-bell-slash fs-4 d-block mb-2"></i>Chưa có thông báo
                                </div>
                            </div>
                        </li>
                        <li class="border-top d-flex align-items-center justify-content-between px-3 py-2">
                            <button id="orgMarkAllBtn" onclick="orgMarkAllRead(event)"
                                    class="btn btn-sm btn-link p-0"
                                    style="color:var(--organizer-accent);font-size:12px;display:none;">
                                <i class="bi bi-check-all me-1"></i>Đánh dấu đã đọc
                            </button>
                            <a href="/Notifications" class="small text-decoration-none fw-semibold"
                               style="color:var(--organizer-accent);">
                                <i class="bi bi-arrow-right-circle me-1"></i>Xem tất cả
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- User Profile dropdown -->
                <div class="dropdown">
                    <button type="button"
                            class="user-profile-btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        <div class="user-avatar-sm">@userInitials</div>
                        <div class="d-none d-lg-block text-start lh-1">
                            <div class="fw-bold small text-dark" style="font-size:13px;">@userFullName</div>
                            <span class="text-muted" style="font-size: 0.68rem;">@(isAdminViewing ? "Quản trị viên" : "Ban Tổ Chức")</span>
                        </div>
                        <i class="bi bi-chevron-down text-muted d-none d-lg-block" style="font-size:11px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-user">
                        <!-- Header -->
                        <li class="dropdown-header-org">
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar-lg">@userInitials</div>
                                <div>
                                    <div class="fw-bold" style="font-size:14px;">@userFullName</div>
                                    <div style="font-size:12px; opacity:0.9;">@userEmail</div>
                                    <div class="mt-1" style="font-size:11px; opacity:0.8;">
                                        <i class="bi bi-shield-check me-1"></i>@(isAdminViewing ? "Quản trị viên (Admin)" : "Ban Tổ Chức (Organizer)")
                                    </div>
                                </div>
                            </div>
                        </li>

                        <li><hr class="dropdown-divider m-0"></li>

                        <li>
                            <a class="dropdown-item dropdown-item-user" href="/Organizer/Dashboard">
                                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item dropdown-item-user" href="/Organizer/Contests">
                                <i class="bi bi-trophy"></i><span>Cuộc thi của tôi</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item dropdown-item-user" href="/Organizer/Notifications">
                                <i class="bi bi-bell"></i><span>Thông báo cuộc thi</span>
                            </a>
                        </li>

                        @if (isAdminViewing)
                        {
                            <li>
                                <a class="dropdown-item dropdown-item-user" href="/Account/Admin">
                                    <i class="bi bi-arrow-left-circle"></i><span>Quay lại Admin</span>
                                </a>
                            </li>
                        }

                        <li><hr class="dropdown-divider m-0"></li>

                        <li>
                            <a class="dropdown-item dropdown-item-user" href="/Profile">
                                <i class="bi bi-person-circle"></i><span>Hồ sơ cá nhân</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item dropdown-item-user" href="/HuongDan">
                                <i class="bi bi-question-circle"></i><span>Trợ giúp</span>
                            </a>
                        </li>

                        <li><hr class="dropdown-divider m-0"></li>

                        <li>
                            <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                                <button type="submit"
                                        class="dropdown-item dropdown-item-user dropdown-item-logout w-100 text-start border-0 bg-transparent"
                                        style="cursor:pointer;">
                                    <i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>

        <!-- TEMPDATA ALERTS -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show org-alert mx-4 mt-3 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show org-alert mx-4 mt-3 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show org-alert mx-4 mt-3 shadow-sm" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <strong>Cảnh báo!</strong> @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- CONTENT BODY RENDER -->
        <div class="p-4 p-md-5">
            @RenderBody()
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Mobile sidebar toggle
        function toggleSidebar() {
            const sidebar = document.getElementById('mainSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('mobile-show');
            overlay.classList.toggle('show');
        }

        function closeSidebar() {
            const sidebar = document.getElementById('mainSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.remove('mobile-show');
            overlay.classList.remove('show');
        }

        // Global search (Enter key)
        function handleSearch(event) {
            if (event.key === 'Enter') {
                const query = document.getElementById('globalSearch').value.trim();
                if (query) {
                    window.location.href = `/Organizer/Submissions?search=${encodeURIComponent(query)}`;
                }
            }
        }

        // Auto dismiss alerts after 5 seconds
        document.querySelectorAll('.org-alert').forEach(function (alert) {
            setTimeout(function () {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bsAlert.close();
            }, 5000);
        });
    </script>

    <script>
    (function () {
        let _orgLoaded = false;

        function orgIconClass(type) {
            const m = { 'Success': ['bi-check-circle-fill','#16a34a','#dcfce7'], 'Warning': ['bi-exclamation-triangle-fill','#d97706','#fef3c7'], 'Error': ['bi-x-circle-fill','#dc2626','#fee2e2'] };
            return m[type] ?? ['bi-info-circle-fill','#059669','#d1fae5'];
        }

        window.orgLoadNotifications = async function (force = false) {
            if (_orgLoaded && !force) return;
            try {
                const res = await fetch('/api/user/notifications?take=8');
                if (!res.ok) return;
                const data = await res.json();
                _orgLoaded = true;
                orgUpdateBadge(data.unread);
                orgRenderList(data.items ?? [], data.unread);
            } catch { }
        };

        function orgUpdateBadge(count) {
            const badge = document.getElementById('orgNotifBadge');
            const markBtn = document.getElementById('orgMarkAllBtn');
            const hdr = document.getElementById('orgNotifHdrCount');
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.style.display = 'flex';
                if (markBtn) markBtn.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
                if (markBtn) markBtn.style.display = 'none';
            }
            if (hdr) hdr.textContent = count > 0 ? count + ' chưa đọc' : 'Đã đọc hết';
        }

        function orgRenderList(items, unreadCount) {
            const el = document.getElementById('orgNotifList');
            if (!el) return;
            if (items.length === 0) {
                el.innerHTML = '<div class="text-center py-4 text-muted" style="font-size:13px;"><i class="bi bi-bell-slash fs-4 d-block mb-2"></i>Chưa có thông báo</div>';
                return;
            }
            el.innerHTML = items.map(n => {
                const [ic, color, bg] = orgIconClass(n.type);
                const unread = !n.isRead ? 'background:#f0fdf4;border-left:3px solid #059669;' : '';
                return `<div class="noti-dd-item" style="${unread}cursor:pointer;" onclick="orgReadNotif(event,${n.notificationId})">
                    <div class="d-flex gap-2 align-items-start">
                        <div style="width:30px;height:30px;border-radius:50%;background:${bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi ${ic}" style="color:${color};font-size:13px;"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="small fw-bold text-dark mb-1" style="white-space:normal;">${escHtml(n.title)}</div>
                            <div class="text-muted" style="font-size:0.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px;">${escHtml(n.message)}</div>
                            <div class="text-muted mt-1" style="font-size:0.7rem;"><i class="bi bi-clock me-1"></i>${escHtml(n.timeAgo)}</div>
                        </div>
                    </div>
                </div>`;
            }).join('');
        }

        window.orgReadNotif = async function (e, id) {
            e.preventDefault();
            await fetch(`/api/user/notifications/${id}/read`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgery() } });
            _orgLoaded = false;
            orgLoadNotifications(true);
        };

        window.orgMarkAllRead = async function (e) {
            e.stopPropagation();
            await fetch('/api/user/notifications/read-all', { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgery() } });
            _orgLoaded = false;
            orgLoadNotifications(true);
        };

        function getAntiForgery() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function escHtml(s) {
            if (!s) return '';
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // Load badge count on page load
        fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && orgUpdateBadge(d.unread)).catch(() => {});

        // Refresh every 3 minutes
        setInterval(() => {
            _orgLoaded = false;
            fetch('/api/user/notifications?take=1').then(r => r.ok && r.json()).then(d => d && orgUpdateBadge(d.unread)).catch(() => {});
        }, 180000);
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
